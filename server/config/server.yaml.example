# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  Vigo Server Configuration — Full Option Reference                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Copy to server.yaml and edit. Required options are uncommented.
# Optional sections are commented out with their defaults shown.
#
# Fields that accept "secret:path" are resolved through the secrets backend
# at startup (e.g. secret:vigo/db/dsn → /srv/vigo/secrets/vigo/db/dsn).


# ── Server ────────────────────────────────────────────────────────────────
# Ports and TLS. TLS certs are auto-generated on first start.

server:
  grpc_listen: ":1530"
  api_listen: ":8443"
  tls:
    cert_file: "tls/cert"
    key_file: "tls/key"
    ca_file: "tls/ca"
    ca_key_file: "tls/ca_key"
  # tls_sans:                                  # extra SANs for auto-generated certs
  #   - "192.168.1.2"                          # host LAN IP (needed in Docker)
  #   - "vigo.example.com"                   # DNS name agents use


# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default): dsn is a file path.
# Postgres: dsn is a connection string. Set driver: postgres.

database:
  dsn: "secret:vigo/db/dsn"
  # driver: postgres
  retention: "30d"                             # auto-prune runs/tasks/workflows older than this; daily background pruner. Empty disables.


# ── Secrets ───────────────────────────────────────────────────────────────
# How secret: references are resolved. Only one backend is active.

secrets:
  backend: local
  # key_file: "/srv/vigo/master.key"         # AES-256-GCM key (0600); omit to auto-generate
  # secrets_dir: "/srv/vigo/secrets"          # encrypted secret files (default)

# --- Isopass backend (external secrets API) ---
# secrets:
#   backend: isopass
#   url: "https://isopass.internal:8443"
#   token_file: "/srv/vigo/isopass-token"    # bearer token file (0600)
#   tls_skip_verify: false

# --- HashiCorp Vault (KV v2) ---
# secrets:
#   backend: vault
#   url: "https://vault.example.com:8200"
#   token_file: "/srv/vigo/vault-token"      # Vault token file (0600)
#   mount_path: "secret"                     # KV engine mount path

# --- AWS Secrets Manager ---
# secrets:
#   backend: aws
#   region: "us-east-1"                      # uses default credential chain

# --- Azure Key Vault ---
# secrets:
#   backend: azure
#   vault_name: "mycompany-vigo"             # Key Vault name (uses managed identity)

# --- GCP Secret Manager ---
# secrets:
#   backend: gcp
#   project_id: "my-project-123"             # uses application default credentials


# ── Check-in ──────────────────────────────────────────────────────────────

checkin:
  interval: "5m"                               # agent poll frequency
  jitter_percent: 20                           # randomize timing by 0-N%
  bundle_max_age: "24h"                        # signed bundle TTL on agents (0 = forever)
  # offline_threshold: "15m"                   # override staleness boundary (default: 2.5 × interval)
  # fleet_lookup_ttl: "30s"                    # how long a resolved fleet: cross-node lookup is reused before recomputing
  # observe_only: false                        # global observe-only: all envoys report drift only, no changes applied


# ── Bootstrap ─────────────────────────────────────────────────────────────
# Requires server.tls.ca_key_file. Without it, bootstrap is disabled.

bootstrap:
  cert_validity: "8760h"                       # agent cert lifetime (default: 1 year)
  trusted_enrollment:                          # token-free enrollment by pattern + source IP
    - pattern: "*"
      cidrs: ["192.168.0.0/16", "127.0.0.0/8", "172.16.0.0/12", "10.0.0.0/8"]


# ── Authentication ────────────────────────────────────────────────────────
# Web UI and REST API auth. Default: basic (username/password).
# Passwords stored as bcrypt hashes in the local secrets provider
# at vigo/web/auth/<username>. Set via: vigocli secrets set web

# auth:
#   method: basic                              # basic | none | oidc | isowebauth
#   session_idle_timeout: "15m"                # idle timeout (default 15m, HIPAA compliant)
#
# --- Disable auth (development only) ---
# auth:
#   method: none
#
# --- OIDC (OpenID Connect SSO) ---
# auth:
#   method: oidc
#   oidc:
#     issuer: "https://accounts.google.com"
#     client_id: "your-client-id"
#     client_secret: "secret:vigo/auth/oidc_client_secret"
#     redirect_url: "https://localhost:8443/auth/callback"
#     scopes: [openid, profile, email]
#
# --- Isowebauth (SSH key signing) ---
# auth:
#   method: isowebauth
#   isowebauth:
#     namespace: "vigo"


# ── Audit Trail ──────────────────────────────────────────────────────────
# The tamper-evident audit trail is always on — no configuration needed.
# Security-sensitive events (config changes, enrollment, revocation, task
# dispatch) are recorded in a SHA-256 hash chain. Each entry includes the
# hash of the previous entry, making modifications or deletions detectable.
# Verify with: vigocli audit verify, GET /api/v1/audit/verify, or the
# web UI audit page.


# ── Webhooks ──────────────────────────────────────────────────────────────
# Configure endpoints via vigocli or REST API. This section controls dispatch.

webhooks:
  timeout: "10s"
  max_retries: 3


# ── Secret Rotation Watcher ──────────────────────────────────────────────
# Polls for secret version changes and force-pushes affected envoys.

watcher:
  enabled: true
  poll_interval: "5m"


# ── SMTP Notifications ───────────────────────────────────────────────────
# Disabled when host is empty. Omit events to enable all with default recipients.

# smtp:
#   host: "smtp.example.com"
#   port: 587
#   from: "vigo@example.com"
#   username: "vigo"
#   password: "secret:vigo/smtp/password"
#   tls: true
#   recipients:
#     - "admin@example.com"
#   events:
#     envoy.enrolled: {}
#     run.success: {}
#     run.failure:
#       recipients: ["ops@example.com"]
#     drift.detected: {}
#     secret.rotated: {}
#     config.reload.failure: {}
#     envoy.stale: {}
#     convergence.threshold:
#       threshold: 90
#     security.rootkit: {}                      # chkrootkit/rkhunter detection
#     security.malware: {}                      # ClamAV malware detection
#     security.integrity: {}                    # AIDE file integrity breach
#     security.cve_critical: {}                 # new critical CVEs from Trivy
#     security.hardening_drop: {}               # Lynis score drop > 10 points
#   digest:
#     interval: "1h"
#     events:
#       - "run.success"
#       - "drift.detected"
#
#   # Scheduled evidence delivery — sends compliance summary + evidence link
#   evidence:
#     schedule: "weekly"              # "weekly" or "monthly" (empty = disabled)
#     recipients:                     # override default recipients
#       - "compliance@example.com"
#     frameworks:                     # which frameworks (empty = all)
#       - "hipaa"
#       - "pci"


# ── Spanner ────────────────────────────────────────────────────────────
# Hub-spoke scaling. Omit for single-server deployments.

# spanner:
#   role: standalone                           # standalone | hub | spoke
#
# --- Hub: aggregates admin queries from spokes ---
# spanner:
#   role: hub
#   spokes:
#     - id: dc1
#       addr: "spoke1.example.com:1530"
#       patterns: ["*.dc1.*"]
#     - id: dc2
#       addr: "spoke2.example.com:1530"
#       patterns: ["*.dc2.*"]
#   auto_failover:
#     enabled: true                              # auto-drain unhealthy spokes
#     threshold: 3                               # consecutive failures before drain
#     interval: "30s"                            # health check interval
#
# --- Spoke: handles agent check-ins only ---
# spanner:
#   role: spoke
#   spoke_id: "dc1"
#   hub_addr: "hub.example.com:1530"            # enables spoke→hub status reporting
#   hub_fallback_addrs:                          # fallback hub addresses for failover
#     - "hub-standby.example.com:1530"


# ── Peer Replication ──────────────────────────────────────────────────────
# Primary/peer server redundancy. Omit for single-server deployments.
# The primary pushes config, secrets, and TLS files to peers via gRPC.
# Peer addresses are returned to agents on registration as fallback_servers.

# peers:
#   role: primary                              # primary (default) | peer
#   servers:
#     - addr: "peer1.example.com:1530"
#     - addr: "peer2.example.com:1530"


# ── AI Assistant ──────────────────────────────────────────────────────────
# Disabled by default. Claude or OpenAI recommended for best results.
# Ollama (free, local) is the default provider but requires a dedicated GPU
# for acceptable performance. See docs/operations/ai-providers.md.
#
# If using an external provider, verify your agreement prohibits using
# your data for model training. For air-gapped environments, use ollama
# or openai-compat pointed at a local vLLM/llama.cpp server.

# ai:
#   enabled: true
#   provider: "ollama"                         # claude | openai | ollama | openai-compat
#   model: "qwen2.5:7b"
#   max_tokens: 4096
#   base_url: ""                               # auto for ollama; required for openai-compat
#   api_key: "secret:vigo/ai/api_key"        # for claude/openai/openai-compat
#   rate_limit: 0                              # requests/minute (0 = unlimited)
#   max_tool_rounds: 10
#   context_mode: "auto"                       # tools | prefetch | auto
#   docs_mode: "full"                          # full | condensed | off


# ── Backup (Litestream — SQLite only) ────────────────────────────────────
# Streams WAL changes to a replica for disaster recovery.

# backup:
#   url: "s3://my-bucket/vigo"
#   access_key_id: "secret:vigo/backup/aws_access_key"
#   secret_access_key: "secret:vigo/backup/aws_secret_key"
#   region: "us-east-1"
#   endpoint: ""                               # S3-compatible (MinIO, Backblaze)
#   force_path_style: false                    # required for MinIO
#   retention: "720h"                          # snapshot retention (default: 30 days)
#   sync_interval: "1s"


# ── Risk ─────────────────────────────────────────────────────────────────
# NVD CVE enrichment for risk scoring. Optional — increases accuracy of
# CVE-based risk factors by looking up CVSS scores from the NVD API.

# risk:
#   nvd:
#     enabled: false
#     api_key: "secret:vigo/nvd/api_key"  # optional — increases NVD API rate limit


# ── Compliance Export ─────────────────────────────────────────────────────
# Feed data to external compliance tools. Each type is independent.

# export:
#   siem: false                                # /api/v1/export/siem
#   cmdb: false                                # /api/v1/export/cmdb
#   oscal: false                               # /api/v1/export/oscal


# ── Compliance Standards ──────────────────────────────────────────────────
# Which compliance frameworks are active. Only listed standards appear in
# the UI, reports, CLI, and daily snapshots.
# Omit this section or leave standards empty to enable all 21 frameworks.
#
# Valid keys: hipaa, hitrust, soc2, pci-dss, nist-800-53, iso-27001, gdpr,
# nerc-cip, cyber-essentials, iec-62443, sox, finra, mifid2, ccss,
# fda-21cfr11, gaming, cis-windows, cis-ubuntu, cis-rhel, aba-cyber,
# ny-dfs-cyber

# compliance:
#   standards:
#     - hipaa
#     - soc2
#     - pci-dss
#     - nist-800-53
#     - cis-ubuntu
#
#   # Approved package-manager source allowlist. URL prefixes that count
#   # as acceptable apt/yum/dnf sources. The package_source_audit trait
#   # adds an `approved: true/false` field to each source row based on
#   # whether the URL starts with any listed prefix. Empty or omitted
#   # disables the annotation (approved field is not added to any row).
#   #
#   approved_sources:
#     - "http://archive.ubuntu.com/"
#     - "http://security.ubuntu.com/"
#     - "https://download.docker.com/"
#     - "https://packages.cloud.google.com/"
#
#   # Compliance documentation store — operator-uploaded artifacts that
#   # satisfy documented-scope controls (BAA, IR plan, risk assessment,
#   # training records, signed contracts). Files land envelope-encrypted
#   # at <docs_dir>/<id>; metadata in compliance_docs / compliance_doc_links.
#   #
#   docs:
#     docs_dir: "/srv/vigo/compliance-docs"
#     max_doc_bytes: 52428800             # 50 MiB per uploaded doc
#     max_per_framework_bytes: 5368709120 # 5 GiB total per framework
#     max_total_bytes: 53687091200        # 50 GiB total across all frameworks


# ── Publish / Blast Radius ────────────────────────────────────────────────
# Auto-rollback when a config change tanks fleet compliance.
# After each config reload, the server monitors compliance for the rollback
# window. If the fleet-wide compliant percentage drops below the threshold,
# it restores the previous config snapshot automatically.

# publish:
#   compliance_threshold: 80                   # 0 = disabled (default), 1-100 = minimum %
#   rollback_window: "5m"                      # how long to watch after reload
#   retraction:
#     enabled: false                           # auto-generate retract modules when modules are removed
#                                              # requires ai.enabled: true — uses AI to improve exec reversals
#                                              # writes .retract files to stockpile/ for operator review


# ── Swarm — Peer-to-Peer Content Distribution ───────────────────────────
# Agents distribute content-addressed blobs to each other over mTLS HTTPS
# on port 1531. The server (itself an envoy) coordinates distribution; once
# a few agents have the blob, they fan it out via peer exchange and UDP
# multicast discovery. Four-layer discovery: local multicast → peer exchange
# → server peer list → direct from seeder.

# swarm:
#   # Substrate gate. Empty list disables swarm fleet-wide. Pattern
#   # semantics (every `enabled:` field below): first-match-wins,
#   # `-` prefix denies, default-deny on no match. Both this AND the
#   # per-subsystem list must allow a host before any subsystem
#   # activates there.
#   enabled: ["*"]                              # all enrolled envoys participate; ["-rasp1", "*"] denies one host
#   seed_dir: "/var/lib/vigo/swarm/seed"        # where vigocli distribute writes seeds
#   port: 1531                                  # agent peer-server port (mTLS HTTPS)
#   max_bandwidth_percent: 50                   # max % of detected link speed agents use for transfers
#   manifest_liveness_ttl: 24h                  # active manifest entries unrefreshed for this long get revoked
#
#   # Filecast (admin-pushed file distribution).
#   filecast:
#     enabled: ["*"]                            # which envoys may receive admin-pushed filecasts
#     max_size_bytes: 0                         # per-distribute upload cap. 0 = no cap (today's behavior)
#     default_retention: "7d"                   # default retention when --retention omitted on `vigocli swarm filecast distribute`
#
#   # Gitback (git-over-swarm). Authorization gate + bundle size +
#   # envelope retention. Bundle cap is enforced publisher-side at
#   # fan-out time; envelope retention controls when revoke/leave
#   # gossip envelopes are reaped.
#   gitback:
#     enabled: ["*"]
#     max_bundle_bytes: 1073741824              # 1 GiB. 0 = no cap.
#     envelope_retention: "90d"                 # revoke/leave envelope reap window. Empty = compile-time default (90d).
#
#   # Longdrawer (LAN plaintext directory mirror). Per-user opt-in still
#   # requires the user creating ~/longdrawer/.
#   longdrawer:
#     enabled: ["*"]
#     max_file_bytes: 2147483648                # 2 GiB. 0 = no cap.
#
#   # Puddle (per-user identity, ADR-014). Lockbox derives ITS
#   # AUTHORIZATION from this section per ADR-020 — there is no
#   # `enabled` field under lockbox below.
#   puddle:
#     enabled: ["*"]
#
#   # Lockbox operational tuning. Authorization derives from puddle
#   # above; this section is size + envelope retention only.
#   lockbox:
#     max_file_bytes: 1073741824                # 1 GiB per-file ciphertext cap on auto-encrypt + push. 0 = no cap.
#     envelope_retention: "90d"                 # LEAVE/RESURRECT/TOMBSTONE reap window. Empty = compile-time default (90d).
#
#   # Curator (P2P artifact registry, ADR-024). Publisher + artifact-blob-holder
#   # gate. Reading is ungated — every envoy can `vigo swarm curator pull`
#   # regardless. `enabled` only controls who may PUBLISH and who holds the
#   # P2P DR replica. Publishing additionally requires `curator: true` on the
#   # user's usercrate AND an unlocked puddle (a heavier grant than `gitback:`).
#   curator:
#     enabled: ["*"]
#     max_bytes: 2147483648                     # 2 GiB per-blob cap. 0 = the 2 GiB compile-time default; raise for large container images.
#
#   # hostdox — when true, each swarm-enabled agent maintains a
#   # delimited block in /etc/hosts mapping every announced peer hostname to
#   # its LAN IP. Additive only: lines outside the managed block are
#   # untouched, and any name the swarm doesn't hold still resolves via DNS.
#   # Off (or omitted) leaves /etc/hosts alone. Turn it on for fleets whose
#   # DNS doesn't authoritatively own the local domain. A plain bool, not a
#   # pattern list — it follows swarm.enabled per host. NOTE: on hosts where
#   # this is on, do NOT also manage /etc/hosts with a whole-file `type: file`
#   # module — it'll clobber the managed block and the two will flap. Use
#   # `type: host` (per-entry) or `type: blockinfile` (own markers) instead.
#   hostdox: false


# ── Gossip & Fleet Primitives ────────────────────────────────────────────
# Peer-to-peer state awareness and coordination between envoys.
#
# gossip is the foundation — envoys share lightweight state (health,
# convergence status, config version) via UDP multicast. All fleet
# primitives below require gossip to be enabled.
#
# swarm (above) is independent — it handles content distribution.
# Swarm and gossip share the multicast group (224.0.0.42:1531) and
# mTLS transport but serve different purposes. Either can be enabled
# without the other.
#
# Features that DON'T need their own toggle:
#   - Quorum operations      — when: "quorum('role:db', 3)"
#   - Fleet rate limiting    — resource attribute: fleet_limit: 3
#   - Workload placement     — when: "my_load_rank(1)"
#   - Cross-machine deps     — when: "peer_converged('role:db', 'migrate')"
#   - Self-organizing alerts — when: "peer_alert('disk_critical')"
#   - Partition detection    — computed from gossip reachability data
#   These are all when: builtins or module attributes that evaluate from
#   the gossip peer table. If gossip is on, they're available. If no module
#   uses them, they cost nothing.

# gossip:
#   enabled: false                              # master switch for peer awareness
#   announce_interval: "5s"                     # how often envoys broadcast state
#   peer_ttl: "30s"                             # expire peer after this many missed announces

# --- Staking rollback (requires: gossip) ---
# Auto-snapshot before risky changes, auto-rollback on health check failure.
# Server tracks stakes fleet-wide: too many failures in a batch halts the rollout.
# Risk is declared per-module (risk: high) or auto-detected for service restarts,
# kernel params, and package upgrades.

# staking:
#   enabled: false                              # enable auto-rollback for risky changes
#   max_failures: 3                             # failures in a batch before halting rollout
#   health_timeout: "60s"                       # default timeout for post-change health checks

# --- Network segmentation verification (requires: gossip) ---
# Envoys probe expected network peers (defined in module config) and report
# results. Server builds a live network graph. Compare actual vs expected:
# edges that shouldn't exist = violation, missing edges = connectivity problem.
# Probe targets are defined in modules, not here.

# segmentation:
#   enabled: false                              # enable network probes + topology graph
#   probe_interval: "1h"                        # how often envoys run probes
#   probe_timeout: "5s"                         # per-target TCP connect timeout

# --- Distributed locking (requires: gossip) ---
# Envoys coordinate exclusive operations via gossip — only one machine runs
# a database migration or restarts a service at a time. Declared per-resource
# with lock: "name". Server mediates for cross-subnet locks where gossip
# doesn't reach.

# locking:
#   enabled: false                              # enable gossip-based distributed locks
#   lock_ttl: "5m"                              # auto-release if holder goes silent

# --- Peer-to-peer secrets (requires: gossip, swarm) ---
# Secrets encrypted to the recipient envoy's public key, distributed via
# swarm P2P. The server never sees plaintext in transit. Falls back to
# inline delivery if disabled.

# p2p_secrets:
#   enabled: false                              # enable P2P secret distribution


# ── Task Dispatch ────────────────────────────────────────────────────────
# When require_definition is true, only named task definitions (from the
# stacks/stockpile/tasks/ directory) can be dispatched. Ad-hoc commands are rejected with 403.

# task:
#   require_definition: false                  # default false — allow ad-hoc commands

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Token-bucket throttling on check-in RPCs.

# rate_limit:
#   enabled: false
#   checkin_per_envoy: 6                       # requests/minute per envoy
#   checkin_global: 500                        # requests/second globally


# ── Maintenance ───────────────────────────────────────────────────────────
# Global change freeze. Blocks config publish while active.

# maintenance:
#   freeze_until: ""                           # RFC3339 timestamp (empty = no freeze)


# ── Stream Edit ──────────────────────────────────────────────────────────
# Guardrails for stream_edit pipelines in file resources.
# Scripts run as root — restrict which directories are allowed.

# stream_edit:
#   enabled: true                              # false = strip all stream_edit globally
#   allowed_paths:                             # directories where scripts must reside
#     - "/srv/vigo/scripts"                    # default if omitted
#   default_timeout: "10s"                     # per-script timeout (kills hung scripts)


# ── Tuning ────────────────────────────────────────────────────────────────
# Advanced. All fields optional with sensible defaults.

# tuning:
#   signature_window: "5m"
#   last_seen_flush: "10s"
#   traits_prune_interval: "5m"
#   metrics_interval: "30s"
#   traits_scanner_ttl: "30s"
#   run_store: "database"                      # "database" or "memory"
#   run_store_capacity: 20                     # per-envoy depth in memory mode
#   max_concurrent_streams: 5000
#
#   # Go runtime (large fleets only)
#   # gogc: 50                                 # GC target % (default: 100)
#   # memory_limit: "4GiB"                     # GOMEMLIMIT hard ceiling
#
#   # gRPC transport (large fleets only)
#   # grpc_read_buffer: 16384
#   # grpc_write_buffer: 16384
#   # max_connection_age: "1h"
#   # max_connection_idle: "15m"
#   # keepalive_time: "30s"
#   # keepalive_timeout: "10s"
#   # stream_send_buffer: 8


# ── License ───────────────────────────────────────────────────────────
# Controls how nodes are counted for license enforcement.
#
# license:
#   mode: "local"      # "local" (default): count nodes on this server
#                      # "aggregate": hub sums nodes across all spanner
#                      #   spokes. Spokes skip enforcement entirely.
#                      #   Only valid when spanner role is "hub".


# ── Branding ──────────────────────────────────────────────────────────
# Custom branding for the web UI. When set, overrides the default Vigo
# logo and title with your organization's branding.
#
# branding:
#   org_name: "ACME Corp"                      # shown in sidebar and footer
#   logo_path: "/srv/vigo/branding/logo.svg"   # sidebar logo (SVG or PNG)
#   favicon_path: "/srv/vigo/branding/icon.svg" # browser tab icon
#   theme: "light"                             # "light" (default), "dark", "auto" (OS preference)


# ── GRC Integration ──────────────────────────────────────────────────
# Push compliance evidence to external GRC platforms on a schedule.
# Each integration runs independently with its own endpoint and interval.
#
# grc:
#   integrations:
#     - name: vanta
#       enabled: true
#       endpoint: "https://api.vanta.com/v1/evidence"
#       api_key: "secret:vigo/grc/vanta-api-key"
#       push_interval: "6h"
#       frameworks:
#         hipaa: "hipaa-2013"
#         soc2: "soc2-2017"
#         pci-dss: "pci-dss-4.0"
#     - name: drata
#       enabled: true
#       endpoint: "https://api.drata.com/v1/compliance/evidence"
#       api_key: "secret:vigo/grc/drata-api-key"
#       push_interval: "6h"
#       frameworks:
#         hipaa: "HIPAA"
#         soc2: "SOC2"


# ── Scrier — Remote Access ──────────────────────────────────────────��
# Browser-based remote access to envoys via the Vigo web UI.
# SSH sessions use xterm.js (no guacd needed).
# RDP sessions require the guacd sidecar: docker compose --profile scrier up
#
# scrier:
#   enabled: true
#   guacd_addr: "guacd:4822"          # guacd sidecar address (RDP only)
#   proxy_hostname: "vigo"            # hostname for tunnel proxy listeners
#   allowed_ports: [22, 3389]         # SSH + RDP (default)
#   max_sessions: 10                  # concurrent tunnel limit


# ── Integrations ─────────────────────────────────────────────────────
# External platform integrations. Each forwards Vigo events to its
# target platform's API. Events are dispatched asynchronously.
# All API keys support the secret: prefix for secure storage.
#
# integrations:
#
#   # Slack — send formatted messages to a channel
#   slack:
#     enabled: true
#     webhook_url: "https://hooks.slack.com/services/T.../B.../xxx"
#     events: ["drift.detected", "convergence.drift", "run.failure"]
#
#   # PagerDuty — trigger incidents via Events API v2
#   pagerduty:
#     enabled: true
#     routing_key: "secret:vigo/pagerduty/routing-key"
#     events: ["security.rootkit", "security.malware", "run.failure"]
#
#   # Opsgenie — create alerts
