name: package-upgrade
description: Upgrade all system packages across Linux, macOS, FreeBSD, OpenBSD, NetBSD, illumos, and Windows

vars:
  upgrade_reboot: true
  upgrade_auto_remove: true

resources:
  # --- Debian / Ubuntu ---

  - name: apt-update
    type: exec
    command: "apt-get update -qq"
    when: "os_family('debian')"

  - name: apt-upgrade
    type: exec
    command: "DEBIAN_FRONTEND=noninteractive apt-get upgrade -y -o Dpkg::Options::='--force-confold' -o Dpkg::Options::='--force-confdef'"
    when: "os_family('debian')"
    unless: "apt-get upgrade --simulate 2>/dev/null | grep -q '0 upgraded, 0 newly installed'"
    depends_on: [apt-update]
    timeout_secs: 600
    notify: [apt-autoremove, reboot-if-needed]

  - name: apt-autoremove
    type: exec
    command: "apt-get autoremove -y -qq"
    when: changed
    depends_on: [apt-upgrade]

  # --- RHEL / Fedora / Rocky / Alma ---

  - name: dnf-upgrade
    type: exec
    command: "dnf upgrade -y --refresh"
    when: "os_family('redhat') && has_command('dnf')"
    unless: "dnf check-update 2>/dev/null; test $? -eq 0"
    timeout_secs: 600
    notify: [dnf-autoremove, reboot-if-needed]

  - name: dnf-autoremove
    type: exec
    command: "dnf autoremove -y"
    when: changed
    depends_on: [dnf-upgrade]

  # --- Legacy RHEL / CentOS (yum without dnf) ---

  - name: yum-upgrade
    type: exec
    command: "yum update -y"
    when: "os_family('redhat') && !has_command('dnf')"
    unless: "yum check-update 2>/dev/null; test $? -eq 0"
    timeout_secs: 600
    notify: [reboot-if-needed]

  # --- SUSE / openSUSE ---

  - name: zypper-upgrade
    type: exec
    command: "zypper --non-interactive update"
    when: "os_family('suse')"
    unless: "zypper --non-interactive list-updates 2>/dev/null | grep -q 'No updates found'"
    timeout_secs: 600
    notify: [reboot-if-needed]

  # --- Alpine ---

  - name: apk-upgrade
    type: exec
    command: "apk update && apk upgrade"
    when: "os_family('alpine')"
    unless: "apk version -l '<' 2>/dev/null | wc -l | grep -q '^0$'"
    timeout_secs: 300

  # --- Arch / Manjaro ---

  - name: pacman-upgrade
    type: exec
    command: "pacman -Syu --noconfirm"
    when: "os_family('arch')"
    unless: "pacman -Qu 2>/dev/null | wc -l | grep -q '^0$'"
    timeout_secs: 600
    notify: [reboot-if-needed]

  # --- FreeBSD ---

  - name: pkg-upgrade
    type: exec
    command: "pkg update -q && pkg upgrade -y"
    when: "os('freebsd')"
    unless: "pkg upgrade -n 2>/dev/null | grep -q 'Your packages are up to date'"
    timeout_secs: 600
    notify: [reboot-if-needed]

  # --- OpenBSD ---

  - name: pkg-add-upgrade
    type: exec
    command: "pkg_add -u"
    when: "os('openbsd')"
    timeout_secs: 600

  # --- NetBSD ---

  - name: pkgin-upgrade
    type: exec
    command: "pkgin update && pkgin -y full-upgrade"
    when: "os('netbsd')"
    timeout_secs: 600
    notify: [reboot-if-needed]

  # --- illumos ---

  - name: ips-upgrade
    type: exec
    command: "pkg update"
    when: "os('illumos')"
    unless: "pkg update -n 2>/dev/null | grep -q 'No updates available'"
    timeout_secs: 600
    notify: [reboot-if-needed]

  # --- macOS ---

  - name: brew-upgrade
    type: exec
    command: "brew update && brew upgrade"
    when: "os('darwin')"
    unless: "brew outdated 2>/dev/null | wc -l | grep -q '^0$'"
    user: "{{ .Traits.system.primary_user }}"
    timeout_secs: 300

  # --- Windows ---

  - name: choco-upgrade
    type: exec
    command: "choco upgrade all -y --no-progress"
    when: "os('windows') && has_command('choco')"
    timeout_secs: 600
    notify: [reboot-if-needed-windows]

  # --- Reboot handling ---

  - name: reboot-if-needed
    type: exec
    command: "shutdown -r +1 'Rebooting after package upgrade'"
    when: changed
    onlyif: "test -f /var/run/reboot-required || needs-restarting -r 2>/dev/null; test $? -eq 1"

  - name: reboot-if-needed-windows
    type: exec
    command: "shutdown /r /t 60 /c \"Rebooting after package upgrade\""
    when: changed
    onlyif: "powershell -Command \"(Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue) -ne $null\""
