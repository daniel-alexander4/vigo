# CIS RHEL 9 Benchmark — Section 2: Services
# Level 1 controls for disabling unnecessary services

name: cis-services

resources:
  # ── 2.1.x — Time synchronization ──────────────────────────────────

  - name: "2.1.1-install-chrony"
    type: package
    package: chrony
    state: present

  - name: "2.1.1-enable-chronyd"
    type: service
    service: chronyd
    enabled: true
    state: running
    depends_on: ["2.1.1-install-chrony"]

  # ── 2.2.x — Disable unnecessary services ──────────────────────────

  - name: "2.2.1-disable-xserver"
    type: exec
    command: "systemctl set-default multi-user.target"
    onlyif: "systemctl get-default | grep -q graphical"

  - name: "2.2.2-remove-avahi"
    type: package
    package: avahi
    state: absent

  - name: "2.2.3-disable-cups"
    type: service
    service: cups
    enabled: false
    state: stopped

  - name: "2.2.4-disable-dhcp"
    type: service
    service: dhcpd
    enabled: false
    state: stopped

  - name: "2.2.5-remove-openldap-servers"
    type: package
    package: openldap-servers
    state: absent

  - name: "2.2.6-disable-nfs"
    type: service
    service: nfs-server
    enabled: false
    state: stopped

  - name: "2.2.7-remove-bind"
    type: package
    package: bind
    state: absent

  - name: "2.2.8-remove-vsftpd"
    type: package
    package: vsftpd
    state: absent

  - name: "2.2.9-remove-httpd"
    type: package
    package: httpd
    state: absent

  - name: "2.2.10-remove-dovecot"
    type: package
    package: dovecot
    state: absent

  - name: "2.2.11-disable-smb"
    type: service
    service: smb
    enabled: false
    state: stopped

  - name: "2.2.12-remove-squid"
    type: package
    package: squid
    state: absent

  - name: "2.2.13-remove-net-snmp"
    type: package
    package: net-snmp
    state: absent

  - name: "2.2.14-disable-rpcbind"
    type: service
    service: rpcbind
    enabled: false
    state: stopped

  - name: "2.2.15-disable-rsync"
    type: service
    service: rsyncd
    enabled: false
    state: stopped

  # ── 2.3.x — Remove unnecessary clients ────────────────────────────

  - name: "2.3.1-remove-ypbind"
    type: package
    package: ypbind
    state: absent

  - name: "2.3.2-remove-rsh"
    type: package
    package: rsh
    state: absent

  - name: "2.3.3-remove-talk"
    type: package
    package: talk
    state: absent

  - name: "2.3.4-remove-telnet"
    type: package
    package: telnet
    state: absent

  - name: "2.3.5-remove-openldap-clients"
    type: package
    package: openldap-clients
    state: absent
