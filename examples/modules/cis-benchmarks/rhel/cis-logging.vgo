# CIS RHEL 9 Benchmark — Section 4: Logging and Auditing
# Level 1 controls for auditd and rsyslog

name: cis-logging

vars:
  audit_max_log_file: "8"
  audit_space_left_action: "email"
  audit_admin_space_left_action: "halt"

resources:
  # ── 4.1.x — Configure auditd ──────────────────────────────────────

  - name: "4.1.1-install-audit"
    type: package
    package: audit
    state: present

  - name: "4.1.1-enable-auditd"
    type: service
    service: auditd
    enabled: true
    state: running
    depends_on: ["4.1.1-install-audit"]

  - name: "4.1.2-auditd-conf"
    type: file
    target_path: /etc/audit/auditd.conf
    content: |
      log_file = /var/log/audit/audit.log
      log_format = ENRICHED
      log_group = root
      max_log_file = {{ .Vars.audit_max_log_file }}
      max_log_file_action = keep_logs
      space_left_action = {{ .Vars.audit_space_left_action }}
      admin_space_left_action = {{ .Vars.audit_admin_space_left_action }}
      disk_full_action = halt
      disk_error_action = halt
      flush = INCREMENTAL_ASYNC
      freq = 50
      name_format = hostname
    owner: root
    group: root
    mode: "0640"
    depends_on: ["4.1.1-install-audit"]
    notify: ["restart-auditd"]

  - name: "4.1.3-audit-rules"
    type: file
    target_path: /etc/audit/rules.d/cis.rules
    content: |
      # CIS RHEL 9 — Audit Rules
      # Managed by Vigo

      # Time changes
      -a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time-change
      -a always,exit -F arch=b64 -S clock_settime -k time-change
      -w /etc/localtime -p wa -k time-change

      # User/group changes
      -w /etc/group -p wa -k identity
      -w /etc/passwd -p wa -k identity
      -w /etc/gshadow -p wa -k identity
      -w /etc/shadow -p wa -k identity
      -w /etc/security/opasswd -p wa -k identity

      # Network changes
      -a always,exit -F arch=b64 -S sethostname -S setdomainname -k system-locale
      -w /etc/issue -p wa -k system-locale
      -w /etc/issue.net -p wa -k system-locale
      -w /etc/hosts -p wa -k system-locale
      -w /etc/sysconfig/network -p wa -k system-locale

      # SELinux changes
      -w /etc/selinux/ -p wa -k MAC-policy
      -w /usr/share/selinux/ -p wa -k MAC-policy

      # Login events
      -w /var/log/lastlog -p wa -k logins
      -w /var/run/faillock/ -p wa -k logins
      -w /var/run/utmp -p wa -k session
      -w /var/log/wtmp -p wa -k logins
      -w /var/log/btmp -p wa -k logins

      # Permission changes
      -a always,exit -F arch=b64 -S chmod -S fchmod -S fchmodat -F auid>=1000 -F auid!=4294967295 -k perm_mod
      -a always,exit -F arch=b64 -S chown -S fchown -S fchownat -S lchown -F auid>=1000 -F auid!=4294967295 -k perm_mod

      # Unauthorized access attempts
      -a always,exit -F arch=b64 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=4294967295 -k access
      -a always,exit -F arch=b64 -S creat -S open -S openat -S truncate -S ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=4294967295 -k access

      # Privileged commands
      -w /usr/bin/sudo -p x -k privileged
      -w /etc/sudoers -p wa -k scope
      -w /etc/sudoers.d/ -p wa -k scope

      # File deletion
      -a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=4294967295 -k delete

      # Kernel modules
      -w /sbin/insmod -p x -k modules
      -w /sbin/rmmod -p x -k modules
      -w /sbin/modprobe -p x -k modules
      -a always,exit -F arch=b64 -S init_module -S delete_module -k modules

      # Immutable
      -e 2
    owner: root
    group: root
    mode: "0640"
    depends_on: ["4.1.1-install-audit"]
    notify: ["restart-auditd"]

  - name: restart-auditd
    type: exec
    command: "service auditd restart"

  # ── 4.2.x — Configure rsyslog ─────────────────────────────────────

  - name: "4.2.1-install-rsyslog"
    type: package
    package: rsyslog
    state: present

  - name: "4.2.1-enable-rsyslog"
    type: service
    service: rsyslog
    enabled: true
    state: running
    depends_on: ["4.2.1-install-rsyslog"]

  - name: "4.2.2-rsyslog-permissions"
    type: file
    target_path: /etc/rsyslog.d/50-cis-permissions.conf
    content: |
      $FileCreateMode 0640
    owner: root
    group: root
    mode: "0644"
    depends_on: ["4.2.1-install-rsyslog"]
    notify: ["restart-rsyslog"]

  - name: restart-rsyslog
    type: exec
    command: "systemctl restart rsyslog"
