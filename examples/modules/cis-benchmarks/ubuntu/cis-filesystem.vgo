# CIS Ubuntu 22.04 LTS Benchmark — Section 1: Filesystem Configuration
# Level 1 controls for filesystem hardening

name: cis-filesystem

resources:
  # ── 1.1.1.x — Disable unused filesystems ──────────────────────────

  - name: "1.1.1.1-disable-cramfs"
    type: file
    target_path: /etc/modprobe.d/cis-cramfs.conf
    content: |
      install cramfs /bin/true
      blacklist cramfs
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.2-disable-freevxfs"
    type: file
    target_path: /etc/modprobe.d/cis-freevxfs.conf
    content: |
      install freevxfs /bin/true
      blacklist freevxfs
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.3-disable-jffs2"
    type: file
    target_path: /etc/modprobe.d/cis-jffs2.conf
    content: |
      install jffs2 /bin/true
      blacklist jffs2
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.4-disable-hfs"
    type: file
    target_path: /etc/modprobe.d/cis-hfs.conf
    content: |
      install hfs /bin/true
      blacklist hfs
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.5-disable-hfsplus"
    type: file
    target_path: /etc/modprobe.d/cis-hfsplus.conf
    content: |
      install hfsplus /bin/true
      blacklist hfsplus
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.6-disable-squashfs"
    type: file
    target_path: /etc/modprobe.d/cis-squashfs.conf
    content: |
      install squashfs /bin/true
      blacklist squashfs
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.7-disable-udf"
    type: file
    target_path: /etc/modprobe.d/cis-udf.conf
    content: |
      install udf /bin/true
      blacklist udf
    owner: root
    group: root
    mode: "0644"

  - name: "1.1.1.8-disable-usb-storage"
    type: file
    target_path: /etc/modprobe.d/cis-usb-storage.conf
    content: |
      install usb-storage /bin/true
      blacklist usb-storage
    owner: root
    group: root
    mode: "0644"

  # ── 1.4.x — Secure boot settings ──────────────────────────────────

  - name: "1.4.1-grub-permissions"
    type: exec
    command: "chmod 600 /boot/grub/grub.cfg"
    onlyif: "test -f /boot/grub/grub.cfg && test $(stat -c %a /boot/grub/grub.cfg) != 600"

  # ── 1.5.x — Process hardening ─────────────────────────────────────

  - name: "1.5.1-aslr-enabled"
    type: file
    target_path: /etc/sysctl.d/60-cis-aslr.conf
    content: |
      kernel.randomize_va_space = 2
    owner: root
    group: root
    mode: "0644"
    notify: ["apply-cis-sysctl"]

  - name: "1.5.3-disable-core-dumps"
    type: file
    target_path: /etc/security/limits.d/cis-core-dumps.conf
    content: |
      * hard core 0
    owner: root
    group: root
    mode: "0644"

  - name: "1.5.3-sysctl-core-dumps"
    type: file
    target_path: /etc/sysctl.d/60-cis-coredump.conf
    content: |
      fs.suid_dumpable = 0
    owner: root
    group: root
    mode: "0644"
    notify: ["apply-cis-sysctl"]

  - name: apply-cis-sysctl
    type: exec
    command: "sysctl --system"
