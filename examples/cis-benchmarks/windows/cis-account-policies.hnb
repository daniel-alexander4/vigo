# CIS Windows Server 2022 Benchmark — Section 1: Account Policies
# Level 1 controls for password and lockout policy

name: cis-account-policies

resources:
  # ── 1.1.x — Password Policy ───────────────────────────────────────

  - name: "1.1.1-password-history"
    type: local_security_policy
    policy: "Enforce password history"
    value: "24"

  - name: "1.1.2-maximum-password-age"
    type: local_security_policy
    policy: "Maximum password age"
    value: "365"

  - name: "1.1.3-minimum-password-age"
    type: local_security_policy
    policy: "Minimum password age"
    value: "1"

  - name: "1.1.4-minimum-password-length"
    type: local_security_policy
    policy: "Minimum password length"
    value: "14"

  - name: "1.1.5-password-complexity"
    type: local_security_policy
    policy: "Password must meet complexity requirements"
    value: "Enabled"

  - name: "1.1.6-reversible-encryption"
    type: local_security_policy
    policy: "Store passwords using reversible encryption"
    value: "Disabled"

  # ── 1.2.x — Account Lockout Policy ────────────────────────────────

  - name: "1.2.1-account-lockout-duration"
    type: local_security_policy
    policy: "Account lockout duration"
    value: "15"

  - name: "1.2.2-account-lockout-threshold"
    type: local_security_policy
    policy: "Account lockout threshold"
    value: "5"

  - name: "1.2.3-reset-lockout-counter"
    type: local_security_policy
    policy: "Reset account lockout counter after"
    value: "15"
