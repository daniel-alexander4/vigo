# CIS Windows Server 2022 Benchmark — Section 17: Advanced Audit Policy
# Level 1 controls for Windows audit policy

name: cis-audit-policy

resources:
  # ── 17.1.x — Account Logon ────────────────────────────────────────

  - name: "17.1.1-audit-credential-validation"
    type: powershell
    command: 'auditpol /set /subcategory:"Credential Validation" /success:enable /failure:enable'
    onlyif: 'auditpol /get /subcategory:"Credential Validation" | Select-String "No Auditing"'

  # ── 17.2.x — Account Management ───────────────────────────────────

  - name: "17.2.1-audit-user-account-management"
    type: powershell
    command: 'auditpol /set /subcategory:"User Account Management" /success:enable /failure:enable'
    onlyif: 'auditpol /get /subcategory:"User Account Management" | Select-String "No Auditing"'

  - name: "17.2.5-audit-security-group-management"
    type: powershell
    command: 'auditpol /set /subcategory:"Security Group Management" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Security Group Management" | Select-String "No Auditing"'

  # ── 17.3.x — Detailed Tracking ────────────────────────────────────

  - name: "17.3.1-audit-process-creation"
    type: powershell
    command: 'auditpol /set /subcategory:"Process Creation" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Process Creation" | Select-String "No Auditing"'

  # ── 17.5.x — Logon/Logoff ─────────────────────────────────────────

  - name: "17.5.1-audit-logon"
    type: powershell
    command: 'auditpol /set /subcategory:"Logon" /success:enable /failure:enable'
    onlyif: 'auditpol /get /subcategory:"Logon" | Select-String "No Auditing"'

  - name: "17.5.2-audit-logoff"
    type: powershell
    command: 'auditpol /set /subcategory:"Logoff" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Logoff" | Select-String "No Auditing"'

  - name: "17.5.3-audit-special-logon"
    type: powershell
    command: 'auditpol /set /subcategory:"Special Logon" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Special Logon" | Select-String "No Auditing"'

  # ── 17.6.x — Object Access ────────────────────────────────────────

  - name: "17.6.1-audit-removable-storage"
    type: powershell
    command: 'auditpol /set /subcategory:"Removable Storage" /success:enable /failure:enable'
    onlyif: 'auditpol /get /subcategory:"Removable Storage" | Select-String "No Auditing"'

  # ── 17.7.x — Policy Change ────────────────────────────────────────

  - name: "17.7.1-audit-policy-change"
    type: powershell
    command: 'auditpol /set /subcategory:"Audit Policy Change" /success:enable /failure:enable'
    onlyif: 'auditpol /get /subcategory:"Audit Policy Change" | Select-String "No Auditing"'

  - name: "17.7.2-audit-authentication-policy-change"
    type: powershell
    command: 'auditpol /set /subcategory:"Authentication Policy Change" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Authentication Policy Change" | Select-String "No Auditing"'

  # ── 17.9.x — System ───────────────────────────────────────────────

  - name: "17.9.1-audit-security-state-change"
    type: powershell
    command: 'auditpol /set /subcategory:"Security State Change" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Security State Change" | Select-String "No Auditing"'

  - name: "17.9.2-audit-security-system-extension"
    type: powershell
    command: 'auditpol /set /subcategory:"Security System Extension" /success:enable'
    onlyif: 'auditpol /get /subcategory:"Security System Extension" | Select-String "No Auditing"'

  - name: "17.9.3-audit-system-integrity"
    type: powershell
    command: 'auditpol /set /subcategory:"System Integrity" /success:enable /failure:enable'
    onlyif: 'auditpol /get /subcategory:"System Integrity" | Select-String "No Auditing"'
