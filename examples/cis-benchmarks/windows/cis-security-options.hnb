# CIS Windows Server 2022 Benchmark — Section 2: Local Policies / Security Options
# Level 1 controls for security options and user rights

name: cis-security-options

resources:
  # ── 2.3.1.x — Accounts ────────────────────────────────────────────

  - name: "2.3.1.1-block-microsoft-accounts"
    type: registry
    path: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    name: "NoConnectedUser"
    type_name: "REG_DWORD"
    value: "3"

  - name: "2.3.1.2-disable-guest-account"
    type: powershell
    command: 'net user Guest /active:no'
    onlyif: 'net user Guest | Select-String "Account active.*Yes"'

  # ── 2.3.7.x — Interactive Logon ───────────────────────────────────

  - name: "2.3.7.1-no-last-username"
    type: registry
    path: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    name: "DontDisplayLastUserName"
    type_name: "REG_DWORD"
    value: "1"

  - name: "2.3.7.4-machine-inactivity-limit"
    type: registry
    path: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    name: "InactivityTimeoutSecs"
    type_name: "REG_DWORD"
    value: "900"

  # ── 2.3.8.x — Microsoft Network Client ────────────────────────────

  - name: "2.3.8.1-digitally-sign-communications-always"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters'
    name: "RequireSecuritySignature"
    type_name: "REG_DWORD"
    value: "1"

  - name: "2.3.8.3-send-unencrypted-password-disabled"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters'
    name: "EnablePlainTextPassword"
    type_name: "REG_DWORD"
    value: "0"

  # ── 2.3.9.x — Microsoft Network Server ────────────────────────────

  - name: "2.3.9.1-server-idle-disconnect"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'
    name: "AutoDisconnect"
    type_name: "REG_DWORD"
    value: "15"

  - name: "2.3.9.2-server-sign-communications"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'
    name: "RequireSecuritySignature"
    type_name: "REG_DWORD"
    value: "1"

  # ── 2.3.10.x — Network Access ─────────────────────────────────────

  - name: "2.3.10.2-no-anonymous-enum-accounts"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Control\Lsa'
    name: "RestrictAnonymous"
    type_name: "REG_DWORD"
    value: "1"

  - name: "2.3.10.5-no-anonymous-sid-translation"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Control\Lsa'
    name: "RestrictAnonymousSAM"
    type_name: "REG_DWORD"
    value: "1"

  # ── 2.3.11.x — Network Security ───────────────────────────────────

  - name: "2.3.11.6-ntlm-minimum-session-security"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0'
    name: "NTLMMinClientSec"
    type_name: "REG_DWORD"
    value: "537395200"

  - name: "2.3.11.7-ntlm-server-minimum-session-security"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0'
    name: "NTLMMinServerSec"
    type_name: "REG_DWORD"
    value: "537395200"

  # ── 18.x — Administrative Templates ───────────────────────────────

  - name: "18.3.1-enable-smb-signing"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'
    name: "EnableSecuritySignature"
    type_name: "REG_DWORD"
    value: "1"

  - name: "18.4.1-disable-autoplay"
    type: registry
    path: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer'
    name: "NoDriveTypeAutoRun"
    type_name: "REG_DWORD"
    value: "255"

  - name: "18.9.4-disable-wdigest"
    type: registry
    path: 'HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest'
    name: "UseLogonCredential"
    type_name: "REG_DWORD"
    value: "0"

  # ── Windows Firewall ──────────────────────────────────────────────

  - name: "9.1.1-firewall-domain-on"
    type: powershell
    command: 'Set-NetFirewallProfile -Profile Domain -Enabled True'
    onlyif: '(Get-NetFirewallProfile -Profile Domain).Enabled -eq $false'

  - name: "9.2.1-firewall-private-on"
    type: powershell
    command: 'Set-NetFirewallProfile -Profile Private -Enabled True'
    onlyif: '(Get-NetFirewallProfile -Profile Private).Enabled -eq $false'

  - name: "9.3.1-firewall-public-on"
    type: powershell
    command: 'Set-NetFirewallProfile -Profile Public -Enabled True'
    onlyif: '(Get-NetFirewallProfile -Profile Public).Enabled -eq $false'
