# CIS RHEL 9 Benchmark — Section 3: Network Configuration
# Level 1 controls for network hardening via sysctl

name: cis-network

resources:
  # ── 3.1.x — Network interfaces ────────────────────────────────────

  - name: "3.1.1-disable-ipv6"
    type: file
    target_path: /etc/sysctl.d/60-cis-ipv6.conf
    content: |
      # CIS 3.1.1 — Disable IPv6 (enable if IPv6 is required)
      # Comment out these lines if your environment uses IPv6
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
    owner: root
    group: root
    mode: "0644"
    notify: ["apply-cis-network-sysctl"]

  # ── 3.2.x — Network parameters (host only) ────────────────────────

  - name: "3.2-network-host-params"
    type: file
    target_path: /etc/sysctl.d/60-cis-network-host.conf
    content: |
      # CIS 3.2.1 — Disable packet redirect sending
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0

      # CIS 3.2.2 — Disable IP forwarding
      net.ipv4.ip_forward = 0
      net.ipv6.conf.all.forwarding = 0
    owner: root
    group: root
    mode: "0644"
    notify: ["apply-cis-network-sysctl"]

  # ── 3.3.x — Network parameters (host and router) ──────────────────

  - name: "3.3-network-general-params"
    type: file
    target_path: /etc/sysctl.d/60-cis-network-general.conf
    content: |
      # CIS 3.3.1 — Disable source routed packets
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0

      # CIS 3.3.2 — Disable ICMP redirects
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0

      # CIS 3.3.3 — Disable secure ICMP redirects
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv4.conf.default.secure_redirects = 0

      # CIS 3.3.4 — Log suspicious packets
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1

      # CIS 3.3.5 — Ignore ICMP broadcast requests
      net.ipv4.icmp_echo_ignore_broadcasts = 1

      # CIS 3.3.6 — Ignore bogus ICMP responses
      net.ipv4.icmp_ignore_bogus_error_responses = 1

      # CIS 3.3.7 — Enable reverse path filtering
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1

      # CIS 3.3.8 — Enable TCP SYN cookies
      net.ipv4.tcp_syncookies = 1

      # CIS 3.3.9 — Disable IPv6 router advertisements
      net.ipv6.conf.all.accept_ra = 0
      net.ipv6.conf.default.accept_ra = 0
    owner: root
    group: root
    mode: "0644"
    notify: ["apply-cis-network-sysctl"]

  # ── 3.4.x — Uncommon network protocols ────────────────────────────

  - name: "3.4.1-disable-dccp"
    type: file
    target_path: /etc/modprobe.d/cis-dccp.conf
    content: |
      install dccp /bin/true
      blacklist dccp
    owner: root
    group: root
    mode: "0644"

  - name: "3.4.2-disable-sctp"
    type: file
    target_path: /etc/modprobe.d/cis-sctp.conf
    content: |
      install sctp /bin/true
      blacklist sctp
    owner: root
    group: root
    mode: "0644"

  - name: "3.4.3-disable-rds"
    type: file
    target_path: /etc/modprobe.d/cis-rds.conf
    content: |
      install rds /bin/true
      blacklist rds
    owner: root
    group: root
    mode: "0644"

  - name: "3.4.4-disable-tipc"
    type: file
    target_path: /etc/modprobe.d/cis-tipc.conf
    content: |
      install tipc /bin/true
      blacklist tipc
    owner: root
    group: root
    mode: "0644"

  - name: apply-cis-network-sysctl
    type: exec
    command: "sysctl --system"
