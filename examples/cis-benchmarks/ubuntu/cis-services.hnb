# CIS Ubuntu 22.04 LTS Benchmark — Section 2: Services
# Level 1 controls for disabling unnecessary services

name: cis-services

resources:
  # ── 2.1.x — Ensure time synchronization is configured ─────────────

  - name: "2.1.1-install-chrony"
    type: package
    package: chrony
    state: present

  - name: "2.1.1-enable-chrony"
    type: service
    service: chrony
    enabled: true
    state: running
    depends_on: ["2.1.1-install-chrony"]

  # ── 2.2.x — Disable unnecessary services ──────────────────────────

  - name: "2.2.1-disable-xserver"
    type: exec
    command: "systemctl set-default multi-user.target"
    onlyif: "systemctl get-default | grep -q graphical"

  - name: "2.2.2-remove-avahi"
    type: package
    package: avahi-daemon
    state: absent

  - name: "2.2.3-disable-cups"
    type: service
    service: cups
    enabled: false
    state: stopped

  - name: "2.2.4-disable-isc-dhcp"
    type: service
    service: isc-dhcp-server
    enabled: false
    state: stopped

  - name: "2.2.5-disable-slapd"
    type: package
    package: slapd
    state: absent

  - name: "2.2.6-disable-nfs"
    type: service
    service: nfs-kernel-server
    enabled: false
    state: stopped

  - name: "2.2.7-disable-bind"
    type: package
    package: bind9
    state: absent

  - name: "2.2.8-disable-vsftpd"
    type: package
    package: vsftpd
    state: absent

  - name: "2.2.9-disable-apache"
    type: package
    package: apache2
    state: absent

  - name: "2.2.10-disable-dovecot"
    type: package
    package: dovecot-core
    state: absent

  - name: "2.2.11-disable-smbd"
    type: service
    service: smbd
    enabled: false
    state: stopped

  - name: "2.2.12-disable-squid"
    type: package
    package: squid
    state: absent

  - name: "2.2.13-disable-snmpd"
    type: package
    package: snmpd
    state: absent

  - name: "2.2.14-disable-rpcbind"
    type: service
    service: rpcbind
    enabled: false
    state: stopped

  - name: "2.2.15-disable-rsync"
    type: service
    service: rsync
    enabled: false
    state: stopped

  # ── 2.3.x — Remove unnecessary clients ────────────────────────────

  - name: "2.3.1-remove-nis-client"
    type: package
    package: nis
    state: absent

  - name: "2.3.2-remove-rsh-client"
    type: package
    package: rsh-client
    state: absent

  - name: "2.3.3-remove-talk-client"
    type: package
    package: talk
    state: absent

  - name: "2.3.4-remove-telnet-client"
    type: package
    package: telnet
    state: absent

  - name: "2.3.5-remove-ldap-client"
    type: package
    package: ldap-utils
    state: absent
