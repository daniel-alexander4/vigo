# Modules and vars inherited by ALL envoy entries in subdirectories.
# This file has no match: entries — it defines what every machine gets.
#
# Subdirectories can have their own common.vgo to add environment-specific
# inheritance (e.g., production/common.vgo adds monitoring to all prod hosts).

modules: [os-users, diag-tools, motd]

vars:
  org_name: "ACME Corp"
  contact_email: "ops@example.com"
