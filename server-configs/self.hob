# self.hob — Server self-management configuration
#
# When enabled, the hobnob server manages its own host using an embedded
# agent loop. No separate hob process is needed on the server machine.
# Resources defined here are applied on a timer and results are recorded
# in the runs table like any other node.
#
# Set enabled: false (or delete this file) to disable self-management.

enabled: true
interval: 30m

resources:
  # -------------------------------------------------------------------------
  # Service account
  # -------------------------------------------------------------------------
  # Dedicated user for running hobnob daemons. Locked password, no shell.
  - name: hobnob-user
    type: user
    username: hobnob
    system: "true"
    shell: /usr/sbin/nologin

  # -------------------------------------------------------------------------
  # Directory permissions
  # -------------------------------------------------------------------------
  # Lock down the config directory so only the hobnob user can read secrets.
  - name: config-dir
    type: file
    path: /etc/hobnob
    ensure: directory
    owner: hobnob
    group: hobnob
    mode: "0750"

  # -------------------------------------------------------------------------
  # Log rotation
  # -------------------------------------------------------------------------
  # Rotate hobnob logs daily, keep 14 days compressed.
  - name: logrotate
    type: file
    path: /etc/logrotate.d/hobnob
    content: |
      /var/log/hobnob/*.log {
        daily
        rotate 14
        compress
        delaycompress
        missingok
        notifempty
        create 0640 hobnob hobnob
      }
    owner: root
    group: root
    mode: "0644"

  # -------------------------------------------------------------------------
  # Time synchronization
  # -------------------------------------------------------------------------
  # TLS and signature verification depend on accurate clocks.
  - name: chrony-package
    type: package
    package: chrony
    state: present

  - name: chrony-service
    type: service
    service: chronyd
    state: running
    enabled: "true"

  # -------------------------------------------------------------------------
  # Automatic security updates
  # -------------------------------------------------------------------------
  # Keep the server patched. Only installs security updates, not full upgrades.
  # On RHEL/Fedora, replace with dnf-automatic.
  - name: unattended-upgrades
    type: package
    package: unattended-upgrades
    state: present

  # =========================================================================
  # DANGER ZONE — do NOT uncomment these unless you understand the risks.
  # =========================================================================
  #
  # PostgreSQL service — NEVER manage this here. If the agent restarts
  # postgres, hobd loses its database connection and crashes. Manage
  # postgres through its own systemd unit or an external node.
  #
  # - name: postgresql
  #   type: service
  #   service: postgresql
  #   state: running
  #
  # hobd service — the server cannot restart itself. If you need to
  # restart hobd after a config change, do it manually or via a
  # separate orchestration tool.
  #
  # - name: hobd-service
  #   type: service
  #   service: hobd
  #   state: running
