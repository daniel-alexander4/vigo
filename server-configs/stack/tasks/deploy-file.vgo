name: deploy-file
description: Write content to a file with specified ownership and mode.
timeout: 30
parameters:
  target_path:
    type: string
    required: true
    description: Absolute path to write the file
  content:
    type: string
    required: true
    description: File content
  owner:
    type: string
    default: "root"
    description: File owner
  group:
    type: string
    default: "root"
    description: File group
  mode:
    type: string
    default: "0644"
    description: File permissions
script: |
  printf '%s' "$PARAM_CONTENT" > "$PARAM_TARGET_PATH"
  chown "${PARAM_OWNER}:${PARAM_GROUP}" "$PARAM_TARGET_PATH"
  chmod "$PARAM_MODE" "$PARAM_TARGET_PATH"
