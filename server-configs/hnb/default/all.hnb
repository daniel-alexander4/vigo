# Catch-all entry — matches every thrall that isn't matched by a more
# specific entry in another subdirectory. Inherits modules from common.hnb.
#
# As your fleet grows, create subdirectories for different groups:
#   production/web/web.hnb    → match: "web*.prod.example.com"
#   staging/staging.hnb       → match: "*.staging.example.com"
#
# Each subdirectory can have its own common.hnb for additional inheritance.

thralls:
  - match: "*"
