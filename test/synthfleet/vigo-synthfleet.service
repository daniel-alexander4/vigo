# Synthetic demo fleet — one freshness pass. Driven by vigo-synthfleet.timer.
# Build the binary first:  go build -o /usr/local/bin/vigo-synthfleet ./test/synthfleet
# Stateless and idempotent: each run checks in + reports every synthetic
# envoy once, then exits. A server restart / outage just means the next
# timer-fired run retries. Reads the root-only local-admin token itself.
[Unit]
Description=Vigo synthetic demo fleet — freshness tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vigo-synthfleet tick
# tick is the only privileged-token reader; runs as root to read
# /srv/vigo/cli-admin-token and /srv/vigo/synthfleet/state.json.
Nice=10
IOSchedulingClass=idle
