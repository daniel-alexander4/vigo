# Synthetic demo fleet — one freshness pass. Driven by vigo-fakefleet.timer.
# Build the binary first:  go build -o /usr/local/bin/vigo-fakefleet ./test/fakefleet
# Stateless and idempotent: each run checks in + reports every synthetic
# envoy once, then exits. A server restart / outage just means the next
# timer-fired run retries. Reads the root-only local-admin token itself.
[Unit]
Description=Vigo synthetic demo fleet — freshness tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vigo-fakefleet tick
# tick is the only privileged-token reader; runs as root to read
# /srv/vigo/cli-admin-token and /srv/vigo/fakefleet/state.json.
Nice=10
IOSchedulingClass=idle
