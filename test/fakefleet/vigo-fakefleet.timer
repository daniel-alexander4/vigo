# Fires the synthetic-fleet freshness tick every 2 minutes, and ~1 minute
# after boot so the fleet resumes on its own after a host reboot. The 2m
# cadence is reported to the server as the check-in cycle, so the default
# freshness window (2.5x -> ~5m stale) keeps the fleet Online with margin.
# Match `--cadence` on the tick if you change the interval here.
[Unit]
Description=Vigo synthetic demo fleet — freshness timer

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
