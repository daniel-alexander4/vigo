# subsystem. They no longer run — vigo sigil verbs were folded into
# `vigo swarm lockbox`. Kept as historical context until Dan deletes.
internal.docs/sigil-peers-probe.sh:*:sigil
internal.docs/sigil-tombstone-probe.sh:*:sigil

# Substrate audit + phase-rollout docs were authored under the legacy
# vocabulary. They describe the substrate before this rename and stay
# as-was for historical accuracy.
internal.docs/substrate-audit.md:*:cairn
internal.docs/substrate-livetest-all.sh:*:cairn
internal.docs/substrate-livetests.md:*:cairn
internal.docs/substrate-perms-repair.sh:*:cairn
internal.docs/substrate-phase-b-deploy.sh:*:cairn
internal.docs/substrate-phase-b-livetest.md:*:cairn
internal.docs/substrate-phase-b-livetest.sh:*:cairn
internal.docs/substrate-phase-b.md:*:cairn
internal.docs/substrate-phase-c-livetest.sh:*:cairn
internal.docs/substrate-phase-d-livetest.sh:*:cairn
internal.docs/substrate-unified-plan.md:*:cairn

# scripts/migrate-0.30.sh handles upgrades from 0.29.x to 0.30.x and
# references the older state-on-disk paths.
scripts/migrate-0.30.sh:*:cairn

# The verification script itself contains the legacy tokens as the
# patterns it greps for.
scripts/check-legacy-naming.sh:*:cairn

# CLAUDE.md previously referenced ~/cairn/vigo-lic for the license
# repo; that's now ~/swarmgit/tessera, so no `cairn` token remains
# to allowlist there.

# Pre-existing references to the historical "cairn"-era reset incident —
# the tshoot archive file is named log-archive-cairn-resolved-20260424-…
# (its name can't change), and the prose pointing at it cites it by that
# name. Not introduced by the 0.50.0 rename; allowlisted by line so the
# checker stays green.
