name: motd

resources:
  - name: motd-file
    type: file
    target_path: /etc/motd
    content: |
      ========================================
        Managed by Vigo
        Hostname:  {{ .Traits.network.hostname }}
        OS:        {{ .Traits.os.distro }} {{ .Traits.os.version }}
        Agent:     {{ .Traits.identity.agent_version }}
        Updates:   {{ .Traits.package_updates.count }} packages available
      ========================================
    owner: root
    group: root
    mode: "0644"
