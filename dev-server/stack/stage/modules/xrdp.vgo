name: xrdp
description: Install and configure xrdp for Scrier remote desktop access on Linux

vars:
  xrdp_port: 3389
  xrdp_max_sessions: 10

resources:
  - name: xrdp-package
    type: package
    package: xrdp
    state: present

  - name: xorgxrdp-package
    type: package
    package: xorgxrdp
    state: present
    depends_on:
      - xrdp-package

  - name: xrdp-user
    type: user
    username: xrdp
    system: true
    shell: /usr/sbin/nologin
    home: /run/xrdp
    create_home: false
    depends_on:
      - xrdp-package

  - name: xrdp-confdir
    type: directory
    target_path: /etc/xrdp
    owner: root
    group: xrdp
    mode: "0755"
    depends_on:
      - xrdp-package
      - xrdp-user

  - name: xrdp-rsakeys
    type: exec
    command: xrdp-keygen xrdp /etc/xrdp/rsakeys.ini
    onlyif: test ! -f /etc/xrdp/rsakeys.ini
    depends_on:
      - xrdp-package

  - name: xrdp-ssl-group
    type: exec
    command: usermod -a -G ssl-cert xrdp
    onlyif: getent group ssl-cert && ! id -nG xrdp | grep -qw ssl-cert
    depends_on:
      - xrdp-user

  - name: xrdp-config
    type: file
    target_path: /etc/xrdp/xrdp.ini
    content: |
      [Globals]
      ini_version=1
      fork=true
      port={{ .Vars.xrdp_port }}
      use_vsock=false
      security_layer=tls
      crypt_level=high
      certificate=/etc/xrdp/cert.pem
      key_file=/etc/xrdp/key.pem
      ssl_protocols=TLSv1.2, TLSv1.3
      autorun=
      allow_channels=true
      allow_multimon=true
      bitmap_cache=true
      bitmap_compression=true
      bulk_compression=true
      max_bpp=32
      new_cursors=true
      use_fastpath=both
      tcp_send_buffer_bytes=32768

      [Logging]
      LogFile=/var/log/xrdp.log
      LogLevel=INFO
      EnableSyslog=true
      SyslogLevel=INFO

      [LoggingPerLogger]

      [Xorg]
      name=Xorg
      lib=libxup.so
      username=ask
      password=ask
      ip=127.0.0.1
      port=-1
      code=20

      [Xvnc]
      name=Xvnc
      lib=libvnc.so
      username=ask
      password=ask
      ip=127.0.0.1
      port=-1

      [channels]
      rdpdr=true
      rdpsnd=true
      drdynvc=true
      cliprdr=true
      rail=false
      xrdpvr=true
      tcutils=true
    owner: root
    group: root
    mode: "0644"
    notify:
      - xrdp-service
    depends_on:
      - xrdp-package

  - name: xrdp-startwm
    type: file
    target_path: /etc/xrdp/startwm.sh
    content: |
      #!/bin/sh
      if [ -r /etc/default/locale ]; then
        . /etc/default/locale
        export LANG LANGUAGE
      fi
      # Prevent desktop session from attaching to the console's D-Bus/display.
      unset DBUS_SESSION_BUS_ADDRESS
      unset XDG_RUNTIME_DIR
      # Fix HOME if xrdp/PAM sets it to just the username.
      if [ "${HOME#/}" = "$HOME" ]; then
        HOME=$(getent passwd "$(whoami)" | cut -d: -f6)
        export HOME
      fi
      if [ -x "$HOME/.xsession" ]; then
        exec "$HOME/.xsession"
      fi
      exec xterm
    owner: root
    group: root
    mode: "0755"
    depends_on:
      - xrdp-package

  - name: xrdp-sesman-service
    type: service
    service: xrdp-sesman
    state: running
    enabled: true
    depends_on:
      - xrdp-package
      - xrdp-user

  - name: xrdp-service
    type: service
    service: xrdp
    state: running
    enabled: true
    depends_on:
      - xrdp-package
      - xrdp-user
      - xrdp-rsakeys
      - xrdp-ssl-group
      - xrdp-config
      - xrdp-startwm
      - xrdp-sesman-service

compliance:
  nist-800-53: ["AC-17"]
  pci-dss: ["8.3.1"]
  hipaa: ["AC-1"]
  iso-27001: ["A.9.4.1"]
