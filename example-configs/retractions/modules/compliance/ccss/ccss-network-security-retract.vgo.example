name: ccss-network-security-uninstall
description: Retraction module for ccss-network-security. Removes all resources installed by the ccss-network-security module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-firewall-allow-ssh
    type: exec
    command: "echo 'TODO: reverse of: iptables -A INPUT -p tcp --dport 22 -j ACCEPT'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-firewall-default-deny
    type: exec
    command: "echo 'TODO: reverse of: iptables -P INPUT DROP'"
    onlyif: "false"

  # file_line: ssh-no-root — revert line change manually

  # file_line: ssh-key-only — revert line change manually
