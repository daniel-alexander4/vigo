name: aba-network-security-uninstall
description: Retraction module for aba-network-security. Removes all resources installed by the aba-network-security module. Review before activating.

resources:
  # file_line: ssh-strong-kex — revert line change manually

  # file_line: ssh-strong-macs — revert line change manually

  # file_line: ssh-strong-ciphers — revert line change manually

  # REVIEW: exec reversal requires manual logic
  - name: undo-ufw-default-deny
    type: exec
    command: "echo 'TODO: reverse of: ufw default deny incoming'"
    onlyif: "false"
    when: "os_family('debian')"

  - name: stop-ufw-enabled
    type: service
    service: ufw
    state: stopped
    enabled: false
    when: "os_family('debian')"
