name: ce-firewalls-uninstall
description: Retraction module for ce-firewalls. Removes all resources installed by the ce-firewalls module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-save-iptables
    type: exec
    command: "echo 'TODO: reverse of: iptables-save > /etc/iptables/rules.v4'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-allow-ssh
    type: exec
    command: "echo 'TODO: reverse of: iptables -A INPUT -p tcp --dport 22 -j ACCEPT'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-allow-loopback
    type: exec
    command: "echo 'TODO: reverse of: iptables -A INPUT -i lo -j ACCEPT'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-allow-established
    type: exec
    command: "echo 'TODO: reverse of: iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-default-forward-drop
    type: exec
    command: "echo 'TODO: reverse of: iptables -P FORWARD DROP'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-default-input-drop
    type: exec
    command: "echo 'TODO: reverse of: iptables -P INPUT DROP'"
    onlyif: "false"

  - name: remove-iptables-package
    type: package
    package: iptables
    state: absent
