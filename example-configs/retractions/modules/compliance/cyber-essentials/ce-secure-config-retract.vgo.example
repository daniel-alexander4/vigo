name: ce-secure-config-retract
description: Retraction module for ce-secure-config. Removes all resources installed by the ce-secure-config module. Review before activating.

resources:
  - name: remove-login-banner
    type: file
    target_path: /etc/issue.net
    state: absent

  - name: remove-tmout-profile
    type: file
    target_path: /etc/profile.d/tmout.sh
    state: absent

  - name: remove-disable-usb-storage
    type: file
    target_path: /etc/modprobe.d/usb-storage.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-disable-guest-account
    type: exec
    command: "echo 'TODO: reverse of: usermod -L guest'"
    onlyif: "false"

  - name: remove-remove-talk
    type: package
    package: talk
    state: absent

  - name: remove-remove-rsh-client
    type: package
    package: rsh-client
    state: absent

  - name: remove-remove-telnet
    type: package
    package: telnet
    state: absent
