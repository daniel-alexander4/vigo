name: cis-rhel-services-uninstall
description: Retraction module for cis-rhel-services. Removes all resources installed by the cis-rhel-services module. Review before activating.

resources:
  - name: remove-2.2.5-remove-openldap-clients
    type: package
    package: openldap-clients
    state: absent

  - name: remove-2.2.4-remove-talk
    type: package
    package: talk
    state: absent

  - name: remove-2.2.3-remove-rsh
    type: package
    package: rsh
    state: absent

  - name: remove-2.2.2-remove-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-2.2.1-remove-ypbind
    type: package
    package: ypbind
    state: absent

  - name: stop-2.1.11-disable-dovecot
    type: service
    service: dovecot
    state: stopped
    enabled: false

  - name: stop-2.1.10-disable-httpd
    type: service
    service: httpd
    state: stopped
    enabled: false

  - name: stop-2.1.9-disable-vsftpd
    type: service
    service: vsftpd
    state: stopped
    enabled: false

  - name: stop-2.1.8-disable-named
    type: service
    service: named
    state: stopped
    enabled: false

  - name: stop-2.1.7-disable-nfs
    type: service
    service: nfs-server
    state: stopped
    enabled: false

  - name: stop-2.1.6-disable-slapd
    type: service
    service: slapd
    state: stopped
    enabled: false

  - name: stop-2.1.5-disable-dhcpd
    type: service
    service: dhcpd
    state: stopped
    enabled: false

  - name: stop-2.1.4-disable-cups
    type: service
    service: cups
    state: stopped
    enabled: false

  - name: stop-2.1.3-disable-avahi
    type: service
    service: avahi-daemon
    state: stopped
    enabled: false

  - name: remove-2.1.2-remove-xorg
    type: package
    package: xorg-x11-server-Xorg
    state: absent

  - name: stop-2.1.1-chrony-service
    type: service
    service: chronyd
    state: stopped
    enabled: false

  - name: remove-2.1.1-chrony-config
    type: file
    target_path: /etc/chrony.conf.d/cis.conf
    state: absent

  - name: remove-2.1.1-chrony-installed
    type: package
    package: chrony
    state: absent
