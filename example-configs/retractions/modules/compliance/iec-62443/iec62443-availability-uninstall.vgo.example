name: iec62443-availability-uninstall
description: Retraction module for iec62443-availability. Removes all resources installed by the iec62443-availability module. Review before activating.

resources:
  - name: remove-remove-rsh
    type: package
    package: rsh-client
    state: absent
    when: "os_family('debian')"

  - name: remove-remove-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-inventory-script
    type: file
    target_path: /usr/local/bin/iec62443-inventory.sh
    state: absent

  - name: remove-crypto-policy
    type: file
    target_path: /etc/ssl/openssl-iec62443.cnf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-restrict-shadow-perms
    type: exec
    command: "echo 'TODO: reverse of: chmod 0640 /etc/shadow && chown root:shadow /etc/shadow'"
    onlyif: "false"

  - name: remove-recovery-verification
    type: file
    target_path: /usr/local/bin/iec62443-verify-recovery.sh
    state: absent

  - name: remove-backup-cron
    type: file
    target_path: /etc/cron.d/iec62443-backup
    state: absent

  - name: remove-backup-script
    type: file
    target_path: /usr/local/bin/iec62443-backup.sh
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-backup-directory
    type: exec
    command: "echo 'TODO: reverse of: mkdir -p {{.Vars.backup_dir}} && chmod 0700 {{.Vars.backup_dir}}'"
    onlyif: "false"

  - name: remove-disk-monitor-cron
    type: file
    target_path: /etc/cron.d/iec62443-disk-monitor
    state: absent

  - name: remove-disk-monitor-script
    type: file
    target_path: /usr/local/bin/iec62443-disk-check.sh
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-apply-sysctl
    type: exec
    command: "echo 'TODO: reverse of: sysctl --system'"
    onlyif: "false"
    when: "changed"

  - name: remove-dos-protection-sysctl
    type: file
    target_path: /etc/sysctl.d/99-iec62443-availability.conf
    state: absent

  - name: remove-system-limits
    type: file
    target_path: /etc/security/limits.d/99-iec62443.conf
    state: absent
