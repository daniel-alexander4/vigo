name: iec62443-system-integrity-retract
description: Retraction module for iec62443-system-integrity. Removes all resources installed by the iec62443-system-integrity module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-enable-verify-service
    type: exec
    command: "echo 'TODO: reverse of: systemctl daemon-reload && systemctl enable iec62443-verify.service'"
    onlyif: "false"
    when: "changed"

  - name: remove-systemd-verify-services
    type: file
    target_path: /etc/systemd/system/iec62443-verify.service
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-protect-audit-logs
    type: exec
    command: "echo 'TODO: reverse of: chattr +a /var/log/syslog /var/log/auth.log 2>/dev/null || true'"
    onlyif: "false"

  - name: remove-session-timeout
    type: file
    target_path: /etc/profile.d/iec62443-timeout.sh
    state: absent

  - name: remove-disable-usb-storage
    type: file
    target_path: /etc/modprobe.d/iec62443-usb.conf
    state: absent

  - name: remove-aide-daily-check
    type: file
    target_path: /etc/cron.d/iec62443-aide
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-aide-init-db
    type: exec
    command: "echo 'TODO: reverse of: aide --init && cp /var/lib/aide/aide.db.new {{.Vars.aide_db_path}}'"
    onlyif: "false"
    when: "os_family('debian')"

  - name: remove-aide-config
    type: file
    target_path: /etc/aide/aide.conf.d/90-iec62443.conf
    state: absent
    when: "os_family('debian')"

  - name: remove-aide-package
    type: package
    package: aide
    state: absent
    when: "os_family('debian')"

  - name: remove-clamav-weekly-scan
    type: file
    target_path: /etc/cron.d/iec62443-clamav
    state: absent

  - name: stop-clamav-daemon
    type: service
    service: clamav-daemon
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: remove-clamav-freshclam
    type: package
    package: clamav-freshclam
    state: absent
    when: "os_family('debian')"

  - name: remove-clamav-package
    type: package
    package: clamav
    state: absent
    when: "os_family('debian')"

  - name: remove-ca-certificates
    type: package
    package: ca-certificates
    state: absent
