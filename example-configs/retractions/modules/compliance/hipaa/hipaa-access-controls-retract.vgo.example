name: hipaa-access-controls-retract
description: Retraction module for hipaa-access-controls. Removes all resources installed by the hipaa-access-controls module. Review before activating.

resources:
  - name: stop-restart-sshd-redhat
    type: service
    service: sshd
    state: stopped
    enabled: false
    when: "changed && !os_family('debian')"

  - name: stop-restart-sshd-debian
    type: service
    service: ssh
    state: stopped
    enabled: false
    when: "changed && os_family('debian')"

  - name: remove-no-root-ssh
    type: file
    target_path: /etc/ssh/sshd_config.d/90-hipaa-access.conf
    state: absent

  - name: remove-session-timeout
    type: file
    target_path: /etc/profile.d/hipaa-timeout.sh
    state: absent

  - name: remove-faillock-config
    type: file
    target_path: /etc/security/faillock.conf
    state: absent

  - name: remove-pwquality-config
    type: file
    target_path: /etc/security/pwquality.conf
    state: absent

  - name: remove-libpam-pwquality
    type: package
    package: libpam-pwquality
    state: absent
