name: hipaa-encryption-uninstall
description: Retraction module for hipaa-encryption. Removes all resources installed by the hipaa-encryption module. Review before activating.

resources:
  - name: stop-restart-sshd-redhat
    type: service
    service: sshd
    state: stopped
    enabled: false
    when: "changed && !os_family('debian')"

  - name: stop-restart-sshd-debian
    type: service
    service: ssh
    state: stopped
    enabled: false
    when: "changed && os_family('debian')"

  - name: remove-ssh-ciphers
    type: file
    target_path: /etc/ssh/sshd_config.d/90-hipaa-crypto.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-apply-crypto-policy
    type: exec
    command: "echo 'TODO: reverse of: update-crypto-policies'"
    onlyif: "false"
    when: "changed"

  - name: remove-crypto-policy
    type: file
    target_path: /etc/crypto-policies/config
    state: absent

  - name: remove-cryptsetup-package
    type: package
    package: cryptsetup
    state: absent
