name: hipaa-media-disposal-uninstall
description: Retraction module for hipaa-media-disposal. Removes all resources installed by the hipaa-media-disposal module. Review before activating.

resources:
  - name: remove-tmp-cleanup-cron
    type: cron
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-shred-available
    type: exec
    command: "echo 'TODO: reverse of: which shred'"
    onlyif: "false"

  - name: remove-nwipe
    type: package
    package: nwipe
    state: absent

  - name: remove-secure-delete
    type: package
    package: secure-delete
    state: absent
