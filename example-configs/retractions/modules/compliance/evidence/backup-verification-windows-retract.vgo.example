name: backup-verification-windows-retract
description: Retract backup-verification-windows.

resources:
  - name: remove-task
    type: powershell
    command: "Unregister-ScheduledTask -TaskName 'VigoBackupVerify' -Confirm:$false -ErrorAction SilentlyContinue"
    skip_validation: true
    when: "os_family('windows')"

  - name: remove-script
    type: file
    target_path: "C:\\ProgramData\\Vigo\\evidence\\backup-verify.ps1"
    state: absent
    when: "os_family('windows')"
