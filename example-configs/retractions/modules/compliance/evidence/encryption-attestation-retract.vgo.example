name: encryption-attestation-retract
description: Retract encryption-attestation. Evidence dir NOT cleaned.

resources:
  - name: remove-cron
    type: cron
    user: root
    name: encryption-attest
    command: "/usr/local/sbin/encryption-attest.sh"
    schedule: "30 1 * * 0"
    state: absent
    when: "os_family('linux')"

  - name: remove-script
    type: file
    target_path: "/usr/local/sbin/encryption-attest.sh"
    state: absent
    when: "os_family('linux')"
