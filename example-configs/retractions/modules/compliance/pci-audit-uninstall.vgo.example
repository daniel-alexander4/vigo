name: pci-audit-uninstall
description: Retraction module for pci-audit. Removes all resources installed by the pci-audit module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-restart-auditd
    type: exec
    command: "echo 'TODO: reverse of: service auditd restart'"
    onlyif: "false"

  - name: remove-audit-log-permissions
    type: directory
    target_path: /var/log/audit
    state: absent

  - name: remove-pci-audit-rules
    type: file
    target_path: /etc/audit/rules.d/pci-dss.rules
    state: absent

  - name: remove-install-auditd
    type: package
    package: auditd
    state: absent
