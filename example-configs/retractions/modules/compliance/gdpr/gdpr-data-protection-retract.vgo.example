name: gdpr-data-protection-retract
description: Retraction module for gdpr-data-protection. Removes all resources installed by the gdpr-data-protection module. Review before activating.

resources:
  - name: remove-secure-log-permissions
    type: cron
    name: gdpr-log-permissions
    state: absent

  - name: remove-world-writable-check
    type: cron
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-apply-sysctl
    type: exec
    command: "echo 'TODO: reverse of: sysctl --system'"
    onlyif: "false"

  - name: remove-sysctl-core-dumps
    type: file
    target_path: /etc/sysctl.d/99-gdpr-coredump.conf
    state: absent

  - name: remove-disable-core-dumps
    type: file
    target_path: /etc/security/limits.d/99-gdpr-coredump.conf
    state: absent

  - name: remove-tls-hardening
    type: file
    target_path: /etc/ssl/openssl-gdpr.cnf
    state: absent

  - name: remove-cryptsetup
    type: package
    package: cryptsetup
    state: absent
