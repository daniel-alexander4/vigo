name: finra-infrastructure-uninstall
description: Retraction module for finra-infrastructure. Removes all resources installed by the finra-infrastructure module. Review before activating.

resources:
  - name: stop-monitoring-agent
    type: service
    service: prometheus-node-exporter
    state: stopped
    enabled: false

  - name: stop-syslog-running
    type: service
    service: rsyslog
    state: stopped
    enabled: false

  - name: stop-ntp-running
    type: service
    service: chrony
    state: stopped
    enabled: false
