name: fda-system-integrity-uninstall
description: Retraction module for fda-system-integrity. Removes all resources installed by the fda-system-integrity module. Review before activating.

resources:
  - name: stop-ntp-sync
    type: service
    service: chrony
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: remove-aide-fda-paths
    type: file
    target_path: /etc/aide/aide.conf.d/fda-paths
    state: absent

  - name: remove-aide-installed
    type: package
    package: aide
    state: absent
