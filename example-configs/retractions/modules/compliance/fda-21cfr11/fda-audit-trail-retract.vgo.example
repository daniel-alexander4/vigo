name: fda-audit-trail-retract
description: Retraction module for fda-audit-trail. Removes all resources installed by the fda-audit-trail module. Review before activating.

resources:
  - name: remove-log-retention-fda
    type: file
    target_path: /etc/logrotate.d/fda-audit
    state: absent

  - name: remove-audit-rules-fda
    type: file
    target_path: /etc/audit/rules.d/fda-21cfr11.rules
    state: absent

  - name: stop-auditd-service
    type: service
    service: auditd
    state: stopped
    enabled: false
