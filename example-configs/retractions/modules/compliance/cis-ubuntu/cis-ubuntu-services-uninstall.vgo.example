name: cis-ubuntu-services-uninstall
description: Retraction module for cis-ubuntu-services. Removes all resources installed by the cis-ubuntu-services module. Review before activating.

resources:
  - name: remove-2.2.6-remove-ftp
    type: package
    package: ftp
    state: absent

  - name: remove-2.2.5-remove-rpcbind
    type: package
    package: rpcbind
    state: absent

  - name: remove-2.2.4-remove-ldap-utils
    type: package
    package: ldap-utils
    state: absent

  - name: remove-2.2.3-remove-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-2.2.2-remove-talk
    type: package
    package: talk
    state: absent

  - name: remove-2.2.1-remove-rsh
    type: package
    package: rsh-client
    state: absent

  - name: remove-2.1.17-disable-nis
    type: package
    package: nis
    state: absent

  - name: stop-2.1.16-disable-rsync
    type: service
    service: rsync
    state: stopped
    enabled: false

  - name: stop-2.1.15-disable-rpcbind
    type: service
    service: rpcbind
    state: stopped
    enabled: false

  - name: stop-2.1.14-disable-snmpd
    type: service
    service: snmpd
    state: stopped
    enabled: false

  - name: stop-2.1.13-disable-squid
    type: service
    service: squid
    state: stopped
    enabled: false

  - name: stop-2.1.12-disable-smbd
    type: service
    service: smbd
    state: stopped
    enabled: false

  - name: stop-2.1.11-disable-dovecot
    type: service
    service: dovecot
    state: stopped
    enabled: false

  - name: stop-2.1.10-disable-apache
    type: service
    service: apache2
    state: stopped
    enabled: false

  - name: stop-2.1.9-disable-vsftpd
    type: service
    service: vsftpd
    state: stopped
    enabled: false

  - name: stop-2.1.8-disable-bind
    type: service
    service: named
    state: stopped
    enabled: false

  - name: stop-2.1.7-disable-nfs
    type: service
    service: nfs-kernel-server
    state: stopped
    enabled: false

  - name: stop-2.1.6-disable-slapd
    type: service
    service: slapd
    state: stopped
    enabled: false

  - name: stop-2.1.5-disable-dhcp-server
    type: service
    service: isc-dhcp-server
    state: stopped
    enabled: false

  - name: stop-2.1.4-disable-cups
    type: service
    service: cups
    state: stopped
    enabled: false

  - name: stop-2.1.3-disable-avahi
    type: service
    service: avahi-daemon
    state: stopped
    enabled: false

  - name: remove-2.1.2-remove-xserver
    type: package
    package: xserver-xorg
    state: absent

  - name: stop-2.1.1-chrony-service
    type: service
    service: chrony
    state: stopped
    enabled: false

  - name: remove-2.1.1-chrony-config
    type: file
    target_path: /etc/chrony/conf.d/cis.conf
    state: absent

  - name: remove-2.1.1-chrony-installed
    type: package
    package: chrony
    state: absent
