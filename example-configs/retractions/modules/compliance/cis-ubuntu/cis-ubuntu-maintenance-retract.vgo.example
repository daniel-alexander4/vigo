name: cis-ubuntu-maintenance-uninstall
description: Retraction module for cis-ubuntu-maintenance. Removes all resources installed by the cis-ubuntu-maintenance module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-6.2.5-home-dir-permissions
    type: exec
    command: "echo 'TODO: reverse of: for dir in $(awk -F: '\''($3 >= 1000 && $7 != \"/usr/sbin/nologin\" && $7 != \"/bin/false\") {print $6}'\'' /etc/passwd); do if [ -d \"$dir\" ]; then chmod g-w,o-rwx \"$dir\" fi done'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.2.3-root-path-integrity
    type: exec
    command: "echo 'TODO: reverse of: true'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.2.2-no-uid-0-except-root
    type: exec
    command: "echo 'TODO: reverse of: true'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.2.1-no-empty-passwords
    type: exec
    command: "echo 'TODO: reverse of: for user in $(awk -F: '\''($2 == \"\") {print $1}'\'' /etc/shadow); do passwd -l \"$user\" done'"
    onlyif: "false"

  - name: remove-6.1.10-no-world-writable
    type: cron
    name: cis-world-writable-scan
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.9-gshadow-dash-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 640 /etc/gshadow- && chown root:shadow /etc/gshadow-'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.8-gshadow-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 640 /etc/gshadow && chown root:shadow /etc/gshadow'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.7-group-dash-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 644 /etc/group- && chown root:root /etc/group-'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.6-group-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 644 /etc/group && chown root:root /etc/group'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.5-shadow-dash-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 640 /etc/shadow- && chown root:shadow /etc/shadow-'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.4-shadow-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 640 /etc/shadow && chown root:shadow /etc/shadow'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.3-passwd-dash-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 644 /etc/passwd- && chown root:root /etc/passwd-'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-6.1.2-passwd-permissions
    type: exec
    command: "echo 'TODO: reverse of: chmod 644 /etc/passwd && chown root:root /etc/passwd'"
    onlyif: "false"
