name: cis-ubuntu-network-retract
description: Retraction module for cis-ubuntu-network. Removes all resources installed by the cis-ubuntu-network module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-3.4.4-ufw-enable
    type: exec
    command: "echo 'TODO: reverse of: echo \"y\" | ufw enable'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-3.4.3-ufw-loopback
    type: exec
    command: "echo 'TODO: reverse of: ufw allow in on lo ufw allow out on lo ufw deny in from 127.0.0.0/8 ufw deny in from ::1'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-3.4.2-ufw-default-deny
    type: exec
    command: "echo 'TODO: reverse of: ufw default deny incoming && ufw default allow outgoing'"
    onlyif: "false"

  - name: remove-3.4.1-ufw-installed
    type: package
    package: ufw
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-apply-sysctl
    type: exec
    command: "echo 'TODO: reverse of: sysctl --system'"
    onlyif: "false"

  - name: remove-3.2.1-sysctl-network
    type: file
    target_path: /etc/sysctl.d/60-cis-network.conf
    state: absent

  - name: remove-3.1.1-disable-dccp
    type: file
    target_path: /etc/modprobe.d/cis-protocols.conf
    state: absent
