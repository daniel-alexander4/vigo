name: pci-hardening-uninstall
description: Retraction module for pci-hardening. Removes all resources installed by the pci-hardening module. Review before activating.

resources:
  - name: remove-debsecan-package
    type: package
    package: debsecan
    state: absent
    when: "os_family('debian')"

  - name: remove-openscap-weekly-scan
    type: cron
    state: absent

  - name: remove-openscap-scanner
    type: package
    package: libopenscap8
    state: absent

  - name: stop-chrony-service
    type: service
    service: chronyd
    state: stopped
    enabled: false

  - name: remove-chrony-package
    type: package
    package: chrony
    state: absent

  - name: remove-hosts-allow-ssh
    type: file
    target_path: /etc/hosts.allow
    state: absent

  - name: remove-hosts-deny-all
    type: file
    target_path: /etc/hosts.deny
    state: absent

  - name: remove-tcp-wrappers
    type: package
    package: tcpd
    state: absent

  - name: stop-disable-rpcbind
    type: service
    service: rpcbind
    state: stopped
    enabled: false

  - name: stop-disable-xinetd
    type: service
    service: xinetd
    state: stopped
    enabled: false
