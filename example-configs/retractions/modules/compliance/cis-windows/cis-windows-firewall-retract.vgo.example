name: cis-windows-firewall-retract
description: Retraction module for cis-windows-firewall. Removes all resources installed by the cis-windows-firewall module. Review before activating.

resources:
  - name: remove-firewall-public-on
    type: firewall_windows
    profile: public
    state: absent

  - name: remove-firewall-private-on
    type: firewall_windows
    profile: private
    state: absent

  - name: remove-firewall-domain-on
    type: firewall_windows
    profile: domain
    state: absent
