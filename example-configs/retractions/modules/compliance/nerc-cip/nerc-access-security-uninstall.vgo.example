name: nerc-access-security-uninstall
description: Retraction module for nerc-access-security. Removes all resources installed by the nerc-access-security module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-encrypt-at-rest-check
    type: exec
    command: "echo 'TODO: reverse of: cryptsetup status /dev/mapper/* 2>/dev/null || true'"
    onlyif: "false"

  - name: remove-faillock-config
    type: file
    target_path: /etc/security/faillock.conf
    state: absent

  - name: stop-clamav-daemon
    type: service
    service: clamav-daemon
    state: stopped
    enabled: false

  - name: remove-clamav
    type: package
    package: clamav
    state: absent

  - name: stop-auto-upgrades-enabled
    type: service
    service: unattended-upgrades
    state: stopped
    enabled: false

  - name: remove-unattended-upgrades
    type: package
    package: unattended-upgrades
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-inactive-lock
    type: exec
    command: "echo 'TODO: reverse of: useradd -D -f 35'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-password-aging
    type: exec
    command: "echo 'TODO: reverse of: sed -i '\''s/^PASS_MAX_DAYS.*/PASS_MAX_DAYS 90/'\'' /etc/login.defs\nsed -i '\''s/^PASS_MIN_DAYS.*/PASS_MIN_DAYS 1/'\'' /etc/login.defs'"
    onlyif: "false"

  - name: remove-security-policy-banner
    type: file
    target_path: /etc/issue.net
    state: absent
