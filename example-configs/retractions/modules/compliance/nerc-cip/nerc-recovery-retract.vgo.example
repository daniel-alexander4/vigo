name: nerc-recovery-retract
description: Retraction module for nerc-recovery. Removes all resources installed by the nerc-recovery module. Review before activating.

resources:
  - name: remove-aide-daily-check
    type: cron
    state: absent

  - name: remove-aide-package
    type: package
    package: aide
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-etckeeper-init
    type: exec
    command: "echo 'TODO: reverse of: etckeeper init'"
    onlyif: "false"

  - name: remove-etckeeper-package
    type: package
    package: etckeeper
    state: absent

  - name: remove-daily-baseline-backup
    type: cron
    state: absent

  - name: remove-daily-config-backup
    type: cron
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-backup-directory
    type: exec
    command: "echo 'TODO: reverse of: mkdir -p /var/backups/nerc && chmod 0700 /var/backups/nerc'"
    onlyif: "false"

  - name: remove-rsync-package
    type: package
    package: rsync
    state: absent
