name: gaming-rng-monitoring-retract
description: Retraction module for gaming-rng-monitoring. Removes all resources installed by the gaming-rng-monitoring module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-rng-config-exists
    type: exec
    command: "echo 'TODO: reverse of: test -f /etc/rng/config.yml && echo '\''RNG config present'\'''"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-rng-service-check
    type: exec
    command: "echo 'TODO: reverse of: systemctl is-active rng-daemon 2>/dev/null || echo '\''not-installed'\'''"
    onlyif: "false"
