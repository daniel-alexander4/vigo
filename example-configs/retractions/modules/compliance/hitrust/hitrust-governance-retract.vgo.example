name: hitrust-governance-retract
description: Retraction module for hitrust-governance. Removes all resources installed by the hitrust-governance module. Review before activating.

resources:
  - name: remove-cert-expiry-check
    type: cron
    state: absent

  - name: remove-openssl-package
    type: package
    package: openssl
    state: absent

  - name: stop-sysstat-enabled
    type: service
    service: sysstat
    state: stopped
    enabled: false

  - name: remove-sysstat-package
    type: package
    package: sysstat
    state: absent

  - name: remove-weekly-compliance-audit
    type: cron
    state: absent

  - name: remove-lynis-package
    type: package
    package: lynis
    state: absent

  - name: remove-weekly-asset-inventory
    type: cron
    state: absent

  - name: remove-lshw
    type: package
    package: lshw
    state: absent

  - name: remove-dmidecode
    type: package
    package: dmidecode
    state: absent
