name: nist-access-control-uninstall
description: Retraction module for nist-access-control. Removes all resources installed by the nist-access-control module. Review before activating.

resources:
  - name: stop-restart-sshd-redhat
    type: service
    service: sshd
    state: stopped
    enabled: false
    when: "changed && !os_family('debian')"

  - name: stop-restart-sshd-debian
    type: service
    service: ssh
    state: stopped
    enabled: false
    when: "changed && os_family('debian')"

  - name: remove-sshd-session-timeout
    type: file
    target_path: /etc/ssh/sshd_config.d/90-nist-session.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-faillock-common-auth
    type: exec
    command: "echo 'TODO: reverse of: pam-auth-update --enable faillock'"
    onlyif: "false"

  - name: remove-vlock-package
    type: package
    package: vlock
    state: absent

  - name: remove-home-dir-permissions
    type: cron
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-inactive-account-lock
    type: exec
    command: "echo 'TODO: reverse of: useradd -D -f 30'"
    onlyif: "false"

  - name: remove-restrict-su
    type: file
    target_path: /etc/pam.d/su
    state: absent
