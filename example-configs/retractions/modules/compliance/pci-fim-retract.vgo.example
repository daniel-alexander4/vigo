name: pci-fim-uninstall
description: Retraction module for pci-fim. Removes all resources installed by the pci-fim module. Review before activating.

resources:
  - name: remove-aide-cron
    type: cron
    name: "pci-fim-daily-check"
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-aide-init-db
    type: exec
    command: "echo 'TODO: reverse of: aide --init && mv {{ .Vars.aide_db_path }}.new {{ .Vars.aide_db_path }}'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-aide-log-dir
    type: exec
    command: "echo 'TODO: reverse of: mkdir -p /var/log/aide && chmod 700 /var/log/aide'"
    onlyif: "false"

  - name: remove-aide-conf
    type: file
    target_path: /etc/aide/aide.conf
    state: absent

  - name: remove-install-aide-redhat
    type: package
    package: aide
    state: absent
    when: "os_family('redhat')"

  - name: remove-install-aide-debian
    type: package
    package: aide
    state: absent
    when: "os_family('debian')"
