name: sox-system-integrity-uninstall
description: Retraction module for sox-system-integrity. Removes all resources installed by the sox-system-integrity module. Review before activating.

resources:
  - name: remove-aide-cron
    type: cron
    state: absent

  - name: remove-aide-config
    type: file
    target_path: /etc/aide/aide.conf.d/sox-critical-paths
    state: absent

  - name: remove-install-aide
    type: package
    package: aide
    state: absent
