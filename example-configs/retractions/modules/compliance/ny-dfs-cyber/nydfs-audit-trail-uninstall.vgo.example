name: nydfs-audit-trail-uninstall
description: Retraction module for nydfs-audit-trail. Removes all resources installed by the nydfs-audit-trail module. Review before activating.

resources:
  # file_line: audit-rules-sudo — revert line change manually
  # file_line: audit-rules-auth — revert line change manually
  # file_line: audit-num-logs — revert line change manually
  # file_line: audit-log-retention — revert line change manually

  - name: stop-auditd-running
    type: service
    service: auditd
    state: stopped
    enabled: false
    when: "os_family('debian') || os_family('redhat')"

  - name: remove-auditd-installed
    type: package
    package: auditd
    state: absent
    when: "os_family('debian') || os_family('redhat')"
