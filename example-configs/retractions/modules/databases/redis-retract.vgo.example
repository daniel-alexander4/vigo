name: redis-retract
description: Retraction module for redis. Removes all resources installed by the redis module. Review before activating.

resources:
  - name: stop-redis-service
    type: service
    service: redis-server
    state: stopped
    enabled: false

  # logrotate: redis-logrotate — remove /etc/logrotate.d/redis-logrotate manually if needed

  - name: remove-redis-conf
    type: file
    target_path: /etc/redis/redis.conf
    state: absent

  - name: remove-install-redis
    type: package
    package: redis-server
    state: absent
