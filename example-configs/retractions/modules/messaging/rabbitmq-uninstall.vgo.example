name: rabbitmq-uninstall
description: Retraction module for rabbitmq. Removes all resources installed by the rabbitmq module. Review before activating.

resources:
  - name: stop-rabbitmq-service
    type: service
    service: rabbitmq-server
    state: stopped
    enabled: false

  # REVIEW: exec reversal requires manual logic
  - name: undo-enable-management-plugin
    type: exec
    command: "echo 'TODO: reverse of: rabbitmq-plugins enable rabbitmq_management'"
    onlyif: "false"

  - name: remove-rabbitmq-conf
    type: file
    target_path: /etc/rabbitmq/rabbitmq.conf
    state: absent

  - name: remove-install-rabbitmq
    type: package
    package: rabbitmq-server
    state: absent

  - name: remove-rabbitmq-repo
    type: repository
    repository: rabbitmq-server
    state: absent
    when: "os_family('debian')"

  - name: remove-erlang-repo
    type: repository
    repository: erlang
    state: absent
    when: "os_family('debian')"
