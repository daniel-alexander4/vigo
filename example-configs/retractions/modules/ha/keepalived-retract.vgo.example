name: keepalived-retract
description: Retraction module for keepalived. Removes all resources installed by the keepalived module. Review before activating.

resources:
  - name: stop-keepalived-service
    type: service
    service: keepalived
    state: stopped
    enabled: false

  - name: remove-keepalived-conf
    type: file
    target_path: /etc/keepalived/keepalived.conf
    state: absent

  - name: remove-install-keepalived
    type: package
    package: keepalived
    state: absent
