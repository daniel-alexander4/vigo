name: kopia-retract
description: >-
  Retract kopia. Repository data + secret-vault entries NOT removed.

resources:
  - name: remove-cron
    type: cron
    user: root
    name: kopia-scheduled
    command: ". /etc/kopia/kopia.env && export KOPIA_PASSWORD KOPIA_CONFIG_PATH && kopia snapshot create /etc /home /var/lib"
    schedule: "15 2 * * *"
    state: absent
    when: "os_family('linux')"

  - name: remove-init-script
    type: file
    target_path: "/usr/local/sbin/kopia-init.sh"
    state: absent
    when: "os_family('linux')"

  - name: remove-env
    type: file
    target_path: "/etc/kopia/kopia.env"
    state: absent
    when: "os_family('linux')"

  - name: remove-kopia-binary
    type: file
    target_path: "/usr/local/bin/kopia"
    state: absent
    when: "os_family('linux')"
