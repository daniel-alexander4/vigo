name: restic-retract
description: >-
  Retract restic backup module. Removes the cron, scripts, and config.
  Does NOT delete the repository or the secret-vault entries — operator
  decision (the repo may hold the only copy of recoverable data).

resources:
  - name: remove-cron
    type: cron
    user: root
    name: restic-scheduled
    command: "/usr/local/sbin/restic-backup.sh"
    schedule: "0 * * * *"
    state: absent
    when: "os_family('linux')"

  - name: remove-backup-script
    type: file
    target_path: "/usr/local/sbin/restic-backup.sh"
    state: absent
    when: "os_family('linux')"

  - name: remove-init-script
    type: file
    target_path: "/usr/local/sbin/restic-init.sh"
    state: absent
    when: "os_family('linux')"

  - name: remove-env
    type: file
    target_path: "/etc/restic/restic.env"
    state: absent
    when: "os_family('linux')"

  - name: uninstall-restic
    type: package
    package: restic
    state: absent
    when: "os_family('linux')"

  # Repository data + secret:vigo/backup/restic_{password,repo} intentionally
  # left intact. Removing the repo destroys recoverable history.
