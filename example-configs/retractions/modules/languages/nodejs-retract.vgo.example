name: nodejs-retract
description: Retraction module for nodejs. Removes all resources installed by the nodejs module. Review before activating.

resources:
  # npm: install-yarn — manual cleanup required
  # npm: install-pm2 — manual cleanup required

  - name: remove-install-nodejs
    type: package
    package: nodejs
    state: absent

  - name: remove-nodesource-repo-rhel
    type: repository
    repository: nodesource-20
    state: absent
    when: "os_family('redhat')"

  - name: remove-nodesource-repo-debian
    type: repository
    repository: nodesource-20
    state: absent
    when: "os_family('debian')"
