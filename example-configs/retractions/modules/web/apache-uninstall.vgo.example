name: apache-uninstall
description: Retraction module for apache. Removes all resources installed by the apache module. Review before activating.

resources:
  - name: stop-apache-service-redhat
    type: service
    service: httpd
    state: stopped
    enabled: false
    when: "!os_family('debian')"

  - name: stop-apache-service-debian
    type: service
    service: apache2
    state: stopped
    enabled: false
    when: "os_family('debian')"

  # logrotate: apache-logrotate-redhat — remove /etc/logrotate.d/apache-logrotate-redhat manually if needed
  # logrotate: apache-logrotate-debian — remove /etc/logrotate.d/apache-logrotate-debian manually if needed

  - name: remove-apache-conf-redhat
    type: file
    target_path: /etc/httpd/conf/httpd.conf
    state: absent
    when: "!os_family('debian')"

  - name: remove-apache-conf-debian
    type: file
    target_path: /etc/apache2/apache2.conf
    state: absent
    when: "os_family('debian')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-enable-mod-ssl
    type: exec
    command: "echo 'TODO: reverse of: a2enmod ssl'"
    onlyif: "false"
    when: "os_family('debian')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-enable-mod-rewrite
    type: exec
    command: "echo 'TODO: reverse of: a2enmod rewrite'"
    onlyif: "false"
    when: "os_family('debian')"

  - name: remove-install-mod-ssl
    type: package
    package: mod_ssl
    state: absent
    when: "os_family('redhat')"

  - name: remove-install-apache-redhat
    type: package
    package: httpd
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-apache-debian
    type: package
    package: apache2
    state: absent
    when: "os_family('debian')"
