name: php-fpm-uninstall
description: Retraction module for php-fpm. Removes all resources installed by the php-fpm module. Review before activating.

resources:
  - name: stop-php-fpm-service-redhat
    type: service
    service: php-fpm
    state: stopped
    enabled: false
    when: "!os_family('debian')"

  - name: stop-php-fpm-service-debian
    type: service
    service: php8.2-fpm
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: remove-php-fpm-log-dir-redhat
    type: directory
    target_path: /var/log/php-fpm
    state: absent
    when: "!os_family('debian')"

  - name: remove-php-fpm-log-dir-debian
    type: directory
    target_path: /var/log/php-fpm
    state: absent
    when: "os_family('debian')"

  - name: remove-php-fpm-pool-redhat
    type: file
    target_path: /etc/php-fpm.d/www.conf
    state: absent
    when: "!os_family('debian')"

  - name: remove-php-fpm-pool-debian
    type: file
    target_path: /etc/php/8.2/fpm/pool.d/www.conf
    state: absent
    when: "os_family('debian')"

  - name: remove-install-php-fpm-redhat
    type: package
    package: php-fpm
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-php-fpm-debian
    type: package
    package: php8.2-fpm
    state: absent
    when: "os_family('debian')"
