name: grafana-uninstall
description: Retraction module for grafana. Removes all resources installed by the grafana module. Review before activating.

resources:
  - name: stop-grafana-service
    type: service
    service: grafana-server
    state: stopped
    enabled: false

  # pip: grafana-pip-deps — manual cleanup required

  # logrotate: grafana-logrotate — remove /etc/logrotate.d/grafana-logrotate manually if needed

  # REVIEW: exec reversal requires manual logic
  - name: undo-grafana-set-password
    type: exec
    command: "echo 'TODO: reverse of: grafana-cli admin reset-admin-password --password-from-stdin'"
    onlyif: "false"

  - name: remove-grafana-ini
    type: file
    target_path: /etc/grafana/grafana.ini
    state: absent

  - name: remove-install-grafana
    type: package
    package: grafana
    state: absent

  - name: remove-grafana-repo
    type: repository
    repository: grafana
    state: absent
