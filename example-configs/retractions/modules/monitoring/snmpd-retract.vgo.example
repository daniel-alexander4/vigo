name: snmpd-retract
description: Retract snmpd.

resources:
  - name: stop-snmpd
    type: service
    service: snmpd
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-snmpd
    type: package
    package: snmpd
    state: absent
    when: "os_family('linux')"
