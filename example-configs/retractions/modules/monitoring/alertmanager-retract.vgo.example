name: alertmanager-retract
description: Retract alertmanager.

resources:
  - name: stop-alertmanager
    type: service
    service: alertmanager
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: remove-alertmanager-unit
    type: file
    target_path: "/etc/systemd/system/alertmanager.service"
    state: absent
    when: "os_family('linux')"

  - name: alertmanager-daemon-reload
    type: exec
    command: "systemctl daemon-reload"
    subscribes: [remove-alertmanager-unit]
    when: "os_family('linux')"

  - name: remove-alertmanager-binary
    type: file
    target_path: "/usr/local/bin/alertmanager"
    state: absent
    when: "os_family('linux')"
