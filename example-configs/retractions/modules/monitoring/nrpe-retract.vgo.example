name: nrpe-retract
description: Retraction module for nrpe. Removes all resources installed by the nrpe module. Review before activating.

resources:
  - name: stop-nrpe-service-redhat
    type: service
    service: nrpe
    state: stopped
    enabled: false
    when: "!os_family('debian')"

  - name: stop-nrpe-service-debian
    type: service
    service: nagios-nrpe-server
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: remove-nrpe-cfg
    type: file
    target_path: /etc/nagios/nrpe.cfg
    state: absent

  - name: remove-install-nagios-plugins-redhat
    type: package
    package: nagios-plugins-all
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-nagios-plugins-debian
    type: package
    package: nagios-plugins-basic
    state: absent
    when: "os_family('debian')"

  - name: remove-install-nrpe-redhat
    type: package
    package: nrpe
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-nrpe-debian
    type: package
    package: nagios-nrpe-server
    state: absent
    when: "os_family('debian')"
