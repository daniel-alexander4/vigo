name: blackbox-exporter-windows-retract
description: Retract blackbox-exporter-windows.

resources:
  - name: stop-blackbox
    type: service
    service: VigoBlackboxExporter
    state: stopped
    enabled: false
    when: "os_family('windows')"

  - name: remove-service
    type: powershell
    command: "Remove-Service -Name VigoBlackboxExporter -ErrorAction SilentlyContinue"
    skip_validation: true
    when: "os_family('windows')"

  - name: remove-blackbox-binary
    type: file
    target_path: "C:\\Program Files\\blackbox_exporter\\blackbox_exporter.exe"
    state: absent
    when: "os_family('windows')"
