name: collectd-retract
description: Retraction module for collectd. Removes all resources installed by the collectd module. Review before activating.

resources:
  - name: stop-collectd-service
    type: service
    service: collectd
    state: stopped
    enabled: false

  - name: remove-collectd-conf-disk
    type: file
    target_path: /etc/collectd.conf
    state: absent
    when: "!os_family('debian')"

  - name: remove-collectd-conf-base
    type: file
    target_path: /etc/collectd/collectd.conf
    state: absent
    when: "os_family('debian')"

  - name: remove-install-collectd
    type: package
    package: collectd
    state: absent
