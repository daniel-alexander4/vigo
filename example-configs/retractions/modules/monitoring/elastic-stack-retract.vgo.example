name: elastic-stack-uninstall
description: Retraction module for elastic-stack. Removes all resources installed by the elastic-stack module. Review before activating.

resources:
  - name: stop-logstash-service
    type: service
    service: logstash
    state: stopped
    enabled: false

  - name: stop-kibana-service
    type: service
    service: kibana
    state: stopped
    enabled: false

  - name: stop-elasticsearch-service
    type: service
    service: elasticsearch
    state: stopped
    enabled: false

  # logrotate: logstash-logrotate — remove /etc/logrotate.d/logstash-logrotate manually if needed
  # logrotate: elasticsearch-logrotate — remove /etc/logrotate.d/elasticsearch-logrotate manually if needed

  - name: remove-logstash-yml
    type: file
    target_path: /etc/logstash/logstash.yml
    state: absent

  - name: remove-kibana-yml
    type: file
    target_path: /etc/kibana/kibana.yml
    state: absent

  - name: remove-elasticsearch-heap
    type: file
    target_path: /etc/elasticsearch/jvm.options.d/heap.options
    state: absent

  - name: remove-elasticsearch-yml
    type: file
    target_path: /etc/elasticsearch/elasticsearch.yml
    state: absent

  - name: remove-install-logstash
    type: package
    package: logstash
    state: absent

  - name: remove-install-kibana
    type: package
    package: kibana
    state: absent

  - name: remove-install-elasticsearch
    type: package
    package: elasticsearch
    state: absent

  - name: remove-elastic-repo-redhat
    type: repository
    repository: elastic-8.x
    state: absent
    when: "!os_family('debian')"

  - name: remove-elastic-repo-debian
    type: repository
    repository: elastic-8.x
    state: absent
    when: "os_family('debian')"
