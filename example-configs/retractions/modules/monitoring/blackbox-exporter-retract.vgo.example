name: blackbox-exporter-retract
description: Retract blackbox-exporter.

resources:
  - name: stop-blackbox
    type: service
    service: blackbox_exporter
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: remove-blackbox-unit
    type: file
    target_path: "/etc/systemd/system/blackbox_exporter.service"
    state: absent
    when: "os_family('linux')"

  - name: blackbox-daemon-reload
    type: exec
    command: "systemctl daemon-reload"
    subscribes: [remove-blackbox-unit]
    when: "os_family('linux')"

  - name: remove-blackbox-binary
    type: file
    target_path: "/usr/local/bin/blackbox_exporter"
    state: absent
    when: "os_family('linux')"
