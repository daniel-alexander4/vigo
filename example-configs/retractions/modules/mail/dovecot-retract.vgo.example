name: dovecot-retract
description: Retract dovecot.

resources:
  - name: stop-dovecot
    type: service
    service: dovecot
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-dovecot
    type: package
    package: dovecot-imapd
    state: absent
    when: "os_family('linux')"
