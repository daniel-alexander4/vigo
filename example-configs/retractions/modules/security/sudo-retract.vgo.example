name: sudo-retract
description: >-
  Retraction module for sudo. Removes all resources installed by the
  sudo module. Review before activating.

resources:
  - name: remove-sudoers-vigo
    type: file
    target_path: /etc/sudoers.d/vigo
    state: absent

  - name: remove-sudoers
    type: file
    target_path: /etc/sudoers
    state: absent

  - name: remove-install-sudo
    type: package
    package: sudo
    state: absent
