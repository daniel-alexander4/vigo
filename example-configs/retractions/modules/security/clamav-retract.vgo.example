name: clamav-retract
description: Retract clamav.

resources:
  - name: stop-clamav-daemon
    type: service
    service: clamav-daemon
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: stop-freshclam
    type: service
    service: clamav-freshclam
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-clamav-daemon
    type: package
    package: clamav-daemon
    state: absent
    when: "os_family('linux')"

  - name: uninstall-clamav-freshclam
    type: package
    package: clamav-freshclam
    state: absent
    when: "os_family('linux')"

  - name: uninstall-clamav
    type: package
    package: clamav
    state: absent
    when: "os_family('linux')"
