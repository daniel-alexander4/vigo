name: security-scanning-windows-uninstall
description: >-
  Retraction module for security-scanning-windows. Removes all resources installed by the
  security-scanning-windows module. Review before activating.

resources:
  # powershell: updates-sentinel — manual cleanup required
  # powershell: check-updates — manual cleanup required
  # powershell: defender-sentinel — manual cleanup required
  # powershell: defender-status — manual cleanup required
  # powershell: trivy-sentinel — manual cleanup required
  # powershell: run-trivy — manual cleanup required

  - name: remove-install-trivy
    type: package
    package: trivy
    state: absent
    when: "os_family('windows')"

  - name: remove-scan-dir
    type: directory
    target_path: "C:\\ProgramData\\Vigo\\security"
    state: absent
    when: "os_family('windows')"
