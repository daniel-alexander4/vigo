name: selinux-uninstall
description: >-
  Retraction module for selinux. Removes all resources installed by the
  selinux module. Review before activating.

resources:
  - name: undo-selinux-enforce
    type: exec
    command: "echo 'TODO: reverse of: setenforce enforcing'"
    onlyif: "false"
    when: "os_family('redhat') && command_succeeds('which getenforce')"
    # REVIEW: exec reversal requires manual logic

  - name: remove-selinux-config
    type: file
    target_path: /etc/selinux/config
    state: absent
    when: "os_family('redhat')"
