name: kerberos-client-retract
description: Retract kerberos-client.

resources:
  - name: uninstall-krb5-user
    type: package
    package: krb5-user
    state: absent
    when: "os_family('debian')"

  - name: uninstall-krb5-workstation
    type: package
    package: krb5-workstation
    state: absent
    when: "os_family('rhel')"
