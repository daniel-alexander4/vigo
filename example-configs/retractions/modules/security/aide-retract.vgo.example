name: aide-retract
description: Retract aide. Database at /var/lib/aide/ NOT removed (forensic evidence).

resources:
  - name: remove-aide-cron
    type: cron
    user: root
    name: aide-check
    command: "aide --check"
    schedule: "30 5 * * *"
    state: absent
    when: "os_family('linux')"

  - name: uninstall-aide
    type: package
    package: aide
    state: absent
    when: "os_family('linux')"
