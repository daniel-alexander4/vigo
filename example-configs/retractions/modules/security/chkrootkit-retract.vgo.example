name: chkrootkit-retract
description: Retract chkrootkit.

resources:
  - name: remove-cron
    type: cron
    user: root
    name: chkrootkit-check
    command: "chkrootkit -q"
    schedule: "30 4 * * *"
    state: absent
    when: "os_family('linux')"

  - name: uninstall-chkrootkit
    type: package
    package: chkrootkit
    state: absent
    when: "os_family('linux')"
