name: fail2ban-uninstall
description: >-
  Retraction module for fail2ban. Removes all resources installed by the
  fail2ban module. Review before activating.

resources:
  - name: stop-fail2ban-service
    type: service
    service: fail2ban
    state: stopped
    enabled: false

  # logrotate: fail2ban-logrotate — remove /etc/logrotate.d/fail2ban-logrotate manually if needed

  - name: remove-fail2ban-jail
    type: file
    target_path: /etc/fail2ban/jail.local
    state: absent

  - name: remove-install-fail2ban
    type: package
    package: fail2ban
    state: absent
