name: pwquality-retract
description: Retract pwquality.

resources:
  - name: remove-pwquality-conf
    type: file
    target_path: "/etc/security/pwquality.conf"
    state: absent
    when: "os_family('linux')"

  - name: uninstall-libpam-pwquality
    type: package
    package: libpam-pwquality
    state: absent
    when: "os_family('debian')"
