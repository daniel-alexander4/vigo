name: tcp-wrappers-uninstall
description: >-
  Retraction module for tcp-wrappers. Removes all resources installed by the
  tcp-wrappers module. Review before activating.

resources:
  - name: remove-hosts-deny
    type: file
    target_path: /etc/hosts.deny
    state: absent

  - name: remove-hosts-allow
    type: file
    target_path: /etc/hosts.allow
    state: absent

  - name: remove-install-tcp-wrappers-redhat
    type: package
    package: tcp_wrappers
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-tcp-wrappers-debian
    type: package
    package: tcpd
    state: absent
    when: "os_family('debian')"
