name: lvm-uninstall
description: >-
  Retraction module for lvm. Removes all resources installed by the
  lvm module. Review before activating.

resources:
  # mount: mount-lv — unmount and remove fstab entry manually

  - name: remove-mount-dir
    type: directory
    target_path: /data
    state: absent

  - name: undo-format-lv
    type: exec
    command: "echo 'TODO: reverse of: mkfs.ext4 /dev/data_vg/data_lv'"
    onlyif: "false"
    # REVIEW: exec reversal requires manual logic

  - name: undo-create-lv
    type: exec
    command: "echo 'TODO: reverse of: lvcreate -l 100%FREE -n data_lv data_vg'"
    onlyif: "false"
    # REVIEW: exec reversal requires manual logic

  - name: undo-create-vg
    type: exec
    command: "echo 'TODO: reverse of: vgcreate data_vg /dev/sdb'"
    onlyif: "false"
    # REVIEW: exec reversal requires manual logic

  - name: undo-create-pv
    type: exec
    command: "echo 'TODO: reverse of: pvcreate /dev/sdb'"
    onlyif: "false"
    # REVIEW: exec reversal requires manual logic

  - name: remove-install-lvm
    type: package
    package: lvm2
    state: absent
