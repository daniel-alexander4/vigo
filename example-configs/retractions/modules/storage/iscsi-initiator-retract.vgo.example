name: iscsi-initiator-retract
description: Retract iscsi-initiator. Operator runs `iscsiadm -m node --logoutall=all` manually first.

resources:
  - name: stop-iscsid
    type: service
    service: iscsid
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-open-iscsi
    type: package
    package: open-iscsi
    state: absent
    when: "os_family('linux')"
