name: nfs-uninstall
description: >-
  Retraction module for nfs. Removes all resources installed by the
  nfs module. Review before activating.

resources:
  # mount: nfs-mount — unmount and remove fstab entry manually

  - name: remove-nfs-mount-dir
    type: directory
    target_path: /mnt/nfs
    state: absent

  - name: stop-nfs-service-redhat
    type: service
    service: nfs-server
    state: stopped
    enabled: false
    when: "!os_family('debian')"

  - name: stop-nfs-service-debian
    type: service
    service: nfs-kernel-server
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: undo-reload-exports
    type: exec
    command: "echo 'TODO: reverse of: exportfs -ra'"
    onlyif: "false"
    # REVIEW: exec reversal requires manual logic

  - name: remove-nfs-exports
    type: file
    target_path: /etc/exports
    state: absent

  - name: remove-nfs-export-dir
    type: directory
    target_path: /srv/nfs
    state: absent

  - name: remove-install-nfs-redhat
    type: package
    package: nfs-utils
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-nfs-debian
    type: package
    package: nfs-kernel-server
    state: absent
    when: "os_family('debian')"
