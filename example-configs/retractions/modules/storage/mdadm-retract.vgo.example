name: mdadm-retract
description: Retract mdadm. Does NOT touch existing RAID arrays.

resources:
  - name: stop-mdmonitor
    type: service
    service: mdmonitor
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-mdadm
    type: package
    package: mdadm
    state: absent
    when: "os_family('linux')"
