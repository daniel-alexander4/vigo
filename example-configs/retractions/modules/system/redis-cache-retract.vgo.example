name: redis-cache-retract
description: >-
  Retraction module for redis-cache. Removes the redis container and its
  on-disk data. Review before activating — wipes /var/lib/redis.

resources:
  - name: remove-redis-cache
    type: container
    container: redis-cache
    state: absent
    when: "has_command('docker')"

  - name: remove-redis-data-dir
    type: directory
    target_path: /var/lib/redis
    state: absent
    depends_on: [remove-redis-cache]
    when: "has_command('docker')"
