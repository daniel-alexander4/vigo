name: systemd-units-retract
description: >-
  Retraction module for systemd-units. Removes all resources installed by the
  systemd-units module. Review before activating.

resources:
  - name: stop-app-service
    type: service
    service: myapp
    state: stopped
    enabled: false

  - name: undo-daemon-reload
    type: exec
    command: "echo 'TODO: reverse of: systemctl daemon-reload'"
    onlyif: "false"
    # REVIEW: exec reversal requires manual logic

  - name: remove-app-unit-file
    type: file
    target_path: /etc/systemd/system/myapp.service
    state: absent

  - name: remove-app-workdir
    type: directory
    target_path: /opt/myapp
    state: absent

  - name: remove-app-user
    type: user
    username: myapp
    state: absent
    # home directory may contain data
