name: diag-tools-uninstall
description: >-
  Retraction module for diag-tools. Removes all resources installed by the
  diag-tools module. Review before activating.

resources:
  - name: stop-sysstat-service
    type: service
    service: sysstat
    state: stopped
    enabled: false

  - name: remove-install-dmidecode
    type: package
    package: dmidecode
    state: absent

  - name: remove-install-usbutils
    type: package
    package: usbutils
    state: absent

  - name: remove-install-pciutils
    type: package
    package: pciutils
    state: absent

  - name: remove-install-unzip
    type: package
    package: unzip
    state: absent

  - name: remove-install-zip
    type: package
    package: zip
    state: absent

  - name: remove-install-file
    type: package
    package: file
    state: absent

  - name: remove-install-rsync
    type: package
    package: rsync
    state: absent

  - name: remove-install-jq
    type: package
    package: jq
    state: absent

  - name: remove-install-tree
    type: package
    package: tree
    state: absent

  - name: remove-install-psmisc
    type: package
    package: psmisc
    state: absent

  - name: remove-install-lsof
    type: package
    package: lsof
    state: absent

  - name: remove-install-ltrace
    type: package
    package: ltrace
    state: absent

  - name: remove-install-strace
    type: package
    package: strace
    state: absent

  - name: remove-install-htop
    type: package
    package: htop
    state: absent

  - name: remove-install-hdparm
    type: package
    package: hdparm
    state: absent

  - name: remove-install-iotop
    type: package
    package: iotop
    state: absent

  - name: remove-install-sysstat
    type: package
    package: sysstat
    state: absent

  - name: remove-install-iperf3
    type: package
    package: iperf3
    state: absent

  - name: remove-install-ethtool
    type: package
    package: ethtool
    state: absent

  - name: remove-install-whois
    type: package
    package: whois
    state: absent

  - name: remove-install-wget
    type: package
    package: wget
    state: absent

  - name: remove-install-curl
    type: package
    package: curl
    state: absent

  - name: remove-install-socat
    type: package
    package: socat
    state: absent

  - name: remove-install-mtr
    type: package
    package: mtr
    state: absent

  - name: remove-install-dnsutils-rhel
    type: package
    package: bind-utils
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-dnsutils-debian
    type: package
    package: dnsutils
    state: absent
    when: "os_family('debian')"

  - name: remove-install-nmap
    type: package
    package: nmap
    state: absent

  - name: remove-install-tcpdump
    type: package
    package: tcpdump
    state: absent

  - name: remove-install-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-install-netcat-rhel
    type: package
    package: nmap-ncat
    state: absent
    when: "!os_family('debian')"

  - name: remove-install-netcat-debian
    type: package
    package: netcat-openbsd
    state: absent
    when: "os_family('debian')"

  - name: remove-install-traceroute
    type: package
    package: traceroute
    state: absent
