name: epel-uninstall
description: >-
  Retraction module for epel. Removes all resources installed by the
  epel module. Review before activating.

resources:
  - name: remove-install-epel-release
    type: package
    package: epel-release
    state: absent
    when: "os_family('redhat')"

  - name: remove-epel-repo
    type: repository
    repository: epel
    state: absent
    when: "os_family('redhat')"
