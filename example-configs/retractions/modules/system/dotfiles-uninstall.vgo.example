name: dotfiles-uninstall
description: >-
  Retraction module for dotfiles. Removes all resources installed by the
  dotfiles module. Review before activating.

resources:
  - name: "remove-bashrc-{{ .Item }}"
    type: file
    foreach: users
    target_path: "/home/{{ .Item }}/.bashrc"
    state: absent

  - name: "remove-vimrc-{{ .Item }}"
    type: file
    foreach: users
    target_path: "/home/{{ .Item }}/.vimrc"
    state: absent
