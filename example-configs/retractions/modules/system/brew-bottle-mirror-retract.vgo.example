name: brew-bottle-mirror-retract
description: >-
  Retraction module for brew-bottle-mirror. Removes the nginx site that
  proxies brew bottles — leaves the cached blobs on disk under
  /var/cache/nginx/brew-bottles for the operator to delete manually
  after confirming no client is still pointing HOMEBREW_BOTTLE_DOMAIN
  at this host. Review before activating.

resources:
  - name: remove-mirror-nginx-site
    type: file
    target_path: /etc/nginx/conf.d/brew-bottle-mirror.conf
    state: absent
