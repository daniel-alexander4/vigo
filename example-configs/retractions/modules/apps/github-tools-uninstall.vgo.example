name: github-tools-uninstall
description: Retraction module for github-tools. Removes all resources installed by the github-tools module. Review before activating.

resources:
  # extracted contents not removed
  - name: remove-install-ripgrep
    type: file
    target_path: /usr/local/bin/rg
    state: absent

  # extracted contents not removed
  - name: remove-install-fd
    type: file
    target_path: /usr/local/bin/fd
    state: absent

  # extracted contents not removed
  - name: remove-install-bat
    type: file
    target_path: /usr/local/bin/bat
    state: absent
