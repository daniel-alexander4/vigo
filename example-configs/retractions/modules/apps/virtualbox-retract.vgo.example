name: virtualbox-retract
description: Retraction module for virtualbox. Removes all resources installed by the virtualbox module. Review before activating.

vars:
  virtualbox_version: "7.1"

resources:
  - name: stop-vboxdrv-service
    type: service
    service: vboxdrv
    state: stopped
    enabled: false
    when: "has_display() and os_family('linux')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-vboxdrv-setup
    type: exec
    command: "echo 'TODO: reverse of: /sbin/vboxconfig'"
    onlyif: "false"
    when: "has_display() and os_family('linux')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-install-ext-pack-linux
    type: exec
    command: "echo 'TODO: reverse of: VBOX_VER=$(VBoxManage --version | sed '\''s/r.*/'\'') EXT_URL=\"https://download.virtualbox.org/virtualbox/${VBOX_VER}/Oracle_VirtualBox_Extension_Pack-${VBOX_VER}.vbox-extpack\" curl -fsSL -o /tmp/oracle-extpack.vbox-extpack \"$EXT_URL\" && echo \"y\" | VBoxManage extpack install --replace /tmp/oracle-extpack.vbox-extpack && rm -f /tmp/oracle-extpack.vbox-extpack'"
    onlyif: "false"
    when: "has_display() and os_family('linux')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-install-ext-pack-windows
    type: exec
    command: "echo 'TODO: reverse of: $vboxVer = (& \"C:\\Program Files\\Oracle\\VirtualBox\\VBoxManage.exe\" --version) -replace '\''r.*'\'','\'''\'' $extUrl = \"https://download.virtualbox.org/virtualbox/$vboxVer/Oracle_VirtualBox_Extension_Pack-$vboxVer.vbox-extpack\" Invoke-WebRequest -Uri $extUrl -OutFile \"$env:TEMP\\oracle-extpack.vbox-extpack\" echo \"y\" | & \"C:\\Program Files\\Oracle\\VirtualBox\\VBoxManage.exe\" extpack install --replace \"$env:TEMP\\oracle-extpack.vbox-extpack\" Remove-Item \"$env:TEMP\\oracle-extpack.vbox-extpack\" -Force'"
    onlyif: "false"
    when: "os('windows')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-install-virtualbox-windows
    type: exec
    command: "echo 'TODO: reverse of: $installer = \"$env:TEMP\\VirtualBox-Win.exe\" Invoke-WebRequest -Uri \"https://download.virtualbox.org/virtualbox/{{ .Vars.virtualbox_version }}.0/VirtualBox-{{ .Vars.virtualbox_version }}.0-Win.exe\" -OutFile $installer Start-Process -FilePath $installer -ArgumentList \"--silent --accept-license=sha256\" -Wait Remove-Item $installer -Force'"
    onlyif: "false"
    when: "os('windows')"

  - name: remove-install-virtualbox-rhel
    type: package
    package: "VirtualBox-{{ .Vars.virtualbox_version }}"
    state: absent
    when: "has_display() and os_family('redhat')"

  - name: remove-virtualbox-deps-rhel
    type: package
    package: "dkms gcc make perl kernel-devel kernel-headers"
    state: absent
    when: "has_display() and os_family('redhat')"

  - name: remove-virtualbox-repo-rhel
    type: repository
    repository: virtualbox
    state: absent
    when: "has_display() and os_family('redhat')"

  - name: remove-install-virtualbox-debian
    type: package
    package: "virtualbox-{{ .Vars.virtualbox_version }}"
    state: absent
    when: "has_display() and os_family('debian')"

  - name: remove-virtualbox-deps-debian
    type: package
    package: "dkms gcc make perl linux-headers-{{ .Traits.os.kernel_release }}"
    state: absent
    when: "has_display() and os_family('debian')"

  - name: remove-virtualbox-repo-debian
    type: repository
    repository: virtualbox-repo-debian
    state: absent
    when: "has_display() and os_family('debian')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-virtualbox-repo-key-debian
    type: exec
    command: "echo 'TODO: reverse of: curl -fsSL https://www.virtualbox.org/download/oracle_vbox_2016.asc | gpg --dearmor -o /etc/apt/keyrings/oracle-virtualbox.gpg && chmod a+r /etc/apt/keyrings/oracle-virtualbox.gpg'"
    onlyif: "false"
    when: "has_display() and os_family('debian')"
