name: promtail-retract
description: Retract promtail.

resources:
  - name: stop-promtail
    type: service
    service: promtail
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: remove-promtail-unit
    type: file
    target_path: "/etc/systemd/system/promtail.service"
    state: absent
    when: "os_family('linux')"

  - name: promtail-daemon-reload
    type: exec
    command: "systemctl daemon-reload"
    subscribes: [remove-promtail-unit]
    when: "os_family('linux')"

  - name: remove-promtail-binary
    type: file
    target_path: "/usr/local/bin/promtail"
    state: absent
    when: "os_family('linux')"

  - name: remove-promtail-config
    type: file
    target_path: "/etc/promtail/promtail.yaml"
    state: absent
    when: "os_family('linux')"
