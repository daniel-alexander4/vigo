name: loki-retract
description: Retract loki. Storage dir /var/lib/loki NOT removed.

resources:
  - name: stop-loki
    type: service
    service: loki
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: remove-loki-unit
    type: file
    target_path: "/etc/systemd/system/loki.service"
    state: absent
    when: "os_family('linux')"

  - name: loki-daemon-reload
    type: exec
    command: "systemctl daemon-reload"
    subscribes: [remove-loki-unit]
    when: "os_family('linux')"

  - name: remove-loki-binary
    type: file
    target_path: "/usr/local/bin/loki"
    state: absent
    when: "os_family('linux')"

  - name: remove-loki-config
    type: file
    target_path: "/etc/loki/loki.yaml"
    state: absent
    when: "os_family('linux')"
