name: mifid2-capacity-retract
description: Retraction module for mifid2-capacity. Removes all resources installed by the mifid2-capacity module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-kill-switch-installed
    type: exec
    command: "echo 'TODO: reverse of: test -x /usr/local/bin/trading-killswitch && echo '\''kill switch binary present'\'''"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-disk-space-check
    type: exec
    command: "echo 'TODO: reverse of: df --output=pcent / | tail -1 | tr -d '\'' %'\'' | awk '\''{if($1 > {{ .Vars.disk_alert_threshold }}) exit 1}'\'''"
    onlyif: "false"
