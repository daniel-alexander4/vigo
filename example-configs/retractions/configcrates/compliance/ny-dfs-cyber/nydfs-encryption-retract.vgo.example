name: nydfs-encryption-retract
description: Retraction module for nydfs-encryption. Removes all resources installed by the nydfs-encryption module. Review before activating.

resources:
  - name: remove-tls-min-version
    type: file
    target_path: /etc/ssl/openssl-vigo.cnf
    state: absent

  # file_line: ssh-strong-macs — revert line change manually
  # file_line: ssh-strong-ciphers — revert line change manually
