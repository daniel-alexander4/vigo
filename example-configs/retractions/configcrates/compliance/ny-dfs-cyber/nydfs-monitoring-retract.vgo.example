name: nydfs-monitoring-retract
description: Retraction module for nydfs-monitoring. Removes all resources installed by the nydfs-monitoring module. Review before activating.

resources:
  - name: remove-secure-delete-tool
    type: package
    package: secure-delete
    state: absent
    when: "os_family('debian')"

  - name: remove-aide-cron
    type: file
    target_path: /etc/cron.daily/aide-check
    state: absent
    when: "os_family('debian') || os_family('redhat')"

  - name: remove-aide-installed
    type: package
    package: aide
    state: absent
    when: "os_family('debian') || os_family('redhat')"

  - name: remove-rkhunter-installed
    type: package
    package: rkhunter
    state: absent
    when: "os_family('debian') || os_family('redhat')"

  - name: remove-chkrootkit-installed
    type: package
    package: chkrootkit
    state: absent
    when: "os_family('debian')"
