name: nerc-asset-management-retract
description: Retraction module for nerc-asset-management. Removes all resources installed by the nerc-asset-management module. Review before activating.

resources:
  - name: remove-nwipe
    type: package
    package: nwipe
    state: absent

  - name: remove-secure-delete
    type: package
    package: secure-delete
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-etckeeper-init
    type: exec
    command: "echo 'TODO: reverse of: etckeeper init'"
    onlyif: "false"

  - name: remove-etckeeper
    type: package
    package: etckeeper
    state: absent

  - name: remove-weekly-sw-inventory
    type: cron
    state: absent

  - name: remove-weekly-hw-inventory
    type: cron
    state: absent

  - name: remove-dmidecode
    type: package
    package: dmidecode
    state: absent

  - name: remove-lshw
    type: package
    package: lshw
    state: absent
