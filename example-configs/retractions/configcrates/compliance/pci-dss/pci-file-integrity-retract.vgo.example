name: pci-file-integrity-retract
description: Retraction module for pci-file-integrity. Removes all resources installed by the pci-file-integrity module. Review before activating.

resources:
  - name: remove-aide-check-cron
    type: cron
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-init-aide-db
    type: exec
    command: "echo 'TODO: reverse of: aide --init && mv /var/lib/aide/aide.db.new /var/lib/aide/aide.db'"
    onlyif: "false"

  - name: remove-aide-config
    type: file
    target_path: /etc/aide/aide.conf
    state: absent

  - name: remove-aide-package
    type: package
    package: aide
    state: absent
