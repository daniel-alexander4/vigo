name: pci-network-security-retract
description: Retraction module for pci-network-security. Removes all resources installed by the pci-network-security module. Review before activating.

resources:
  # REVIEW: exec reversal requires manual logic
  - name: undo-apply-sysctl
    type: exec
    command: "echo 'TODO: reverse of: sysctl --system'"
    onlyif: "false"
    when: "changed"

  - name: remove-disable-ipv6
    type: file
    target_path: /etc/sysctl.d/99-pci-ipv6.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-reload-nftables
    type: exec
    command: "echo 'TODO: reverse of: nft -f /etc/nftables.conf'"
    onlyif: "false"
    when: "changed"

  - name: stop-nftables-enabled
    type: service
    service: nftables
    state: stopped
    enabled: false

  - name: remove-nftables-config
    type: file
    target_path: /etc/nftables.conf
    state: absent

  - name: remove-nftables-package
    type: package
    package: nftables
    state: absent
