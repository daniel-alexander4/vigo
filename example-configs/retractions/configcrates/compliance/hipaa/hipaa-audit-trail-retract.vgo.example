name: hipaa-audit-trail-retract
description: Retraction module for hipaa-audit-trail. Removes all resources installed by the hipaa-audit-trail module. Review before activating.

resources:
  - name: remove-audit-logrotate
    type: file
    target_path: /etc/logrotate.d/audit
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-reload-auditd
    type: exec
    command: "echo 'TODO: reverse of: augenrules --load'"
    onlyif: "false"
    when: "changed"

  - name: remove-hipaa-audit-rules
    type: file
    target_path: /etc/audit/rules.d/hipaa.rules
    state: absent
