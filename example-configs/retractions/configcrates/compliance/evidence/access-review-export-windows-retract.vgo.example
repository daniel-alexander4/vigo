name: access-review-export-windows-retract
description: Retract access-review-export-windows.

resources:
  - name: remove-task
    type: powershell
    command: "Unregister-ScheduledTask -TaskName 'VigoAccessReviewExport' -Confirm:$false -ErrorAction SilentlyContinue"
    skip_validation: true
    when: "os_family('windows')"

  - name: remove-script
    type: file
    target_path: "C:\\ProgramData\\Vigo\\evidence\\access-review-export.ps1"
    state: absent
    when: "os_family('windows')"
