name: log-shipping-attestation-windows-retract
description: Retract log-shipping-attestation-windows.

resources:
  - name: remove-scheduled-task
    type: powershell
    command: "Unregister-ScheduledTask -TaskName 'VigoLogShipAttest' -Confirm:$false -ErrorAction SilentlyContinue"
    skip_validation: true
    when: "os_family('windows')"

  - name: remove-script
    type: file
    target_path: "C:\\ProgramData\\Vigo\\evidence\\log-ship-attest.ps1"
    state: absent
    when: "os_family('windows')"
