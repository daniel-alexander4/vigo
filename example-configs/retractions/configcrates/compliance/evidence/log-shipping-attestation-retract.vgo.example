name: log-shipping-attestation-retract
description: Retract log-shipping-attestation. Evidence under /var/lib/vigo/evidence/ NOT removed.

resources:
  - name: remove-cron
    type: cron
    user: root
    name: log-shipping-attest
    command: "/usr/local/sbin/log-ship-attest.sh"
    schedule: "0 1 * * *"
    state: absent
    when: "os_family('linux')"

  - name: remove-script
    type: file
    target_path: "/usr/local/sbin/log-ship-attest.sh"
    state: absent
    when: "os_family('linux')"
