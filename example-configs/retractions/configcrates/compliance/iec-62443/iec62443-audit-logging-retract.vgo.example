name: iec62443-audit-logging-retract
description: Retraction module for iec62443-audit-logging. Removes all resources installed by the iec62443-audit-logging module. Review before activating.

resources:
  - name: stop-time-sync-service
    type: service
    service: chronyd
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: remove-systemd-timesyncd
    type: package
    package: systemd-timesyncd
    state: absent
    when: "os_family('redhat')"

  - name: remove-chrony-package
    type: package
    package: chrony
    state: absent
    when: "os_family('debian')"

  - name: remove-syslog-retention
    type: file
    target_path: /etc/logrotate.d/iec62443-syslog
    state: absent

  - name: remove-audit-log-rotation
    type: file
    target_path: /etc/logrotate.d/iec62443-audit
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-restart-auditd
    type: exec
    command: "echo 'TODO: reverse of: systemctl restart auditd'"
    onlyif: "false"
    when: "changed"

  - name: remove-auditd-config
    type: file
    target_path: /etc/audit/auditd.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-reload-audit-rules
    type: exec
    command: "echo 'TODO: reverse of: augenrules --load'"
    onlyif: "false"
    when: "changed"

  - name: remove-audit-rules-iec62443
    type: file
    target_path: /etc/audit/rules.d/90-iec62443.rules
    state: absent

  - name: stop-auditd-service
    type: service
    service: auditd
    state: stopped
    enabled: false

  - name: remove-auditd-package
    type: package
    package: auditd
    state: absent
    when: "os_family('debian') || os_family('redhat')"
