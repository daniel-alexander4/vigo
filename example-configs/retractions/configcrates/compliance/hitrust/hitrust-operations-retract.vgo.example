name: hitrust-operations-retract
description: Retraction module for hitrust-operations. Removes all resources installed by the hitrust-operations module. Review before activating.

resources:
  - name: remove-needrestart
    type: package
    package: needrestart
    state: absent

  - name: remove-apt-listchanges
    type: package
    package: apt-listchanges
    state: absent

  - name: stop-psacct-service
    type: service
    service: acct
    state: stopped
    enabled: false

  - name: remove-psacct-package
    type: package
    package: acct
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-reload-auditd
    type: exec
    command: "echo 'TODO: reverse of: augenrules --load'"
    onlyif: "false"
    when: "changed"

  - name: remove-hitrust-audit-rules
    type: file
    target_path: /etc/audit/rules.d/hitrust.rules
    state: absent

  - name: stop-auditd-service
    type: service
    service: auditd
    state: stopped
    enabled: false

  - name: remove-auditd-package
    type: package
    package: auditd
    state: absent
