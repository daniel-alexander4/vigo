name: ce-monitoring-retract
description: Retraction module for ce-monitoring. Removes all resources installed by the ce-monitoring module. Review before activating.

resources:
  - name: remove-process-monitoring
    type: cron
    state: absent

  - name: remove-syslog-anomaly-detection
    type: cron
    state: absent

  - name: stop-ossec-service
    type: service
    service: ossec
    state: stopped
    enabled: false

  - name: remove-ossec-hids
    type: package
    package: ossec-hids
    state: absent
