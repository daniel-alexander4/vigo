name: pci-hardening-retract
description: Retraction module for pci-hardening. Removes all resources installed by the pci-hardening module. Review before activating.

resources:
  - name: remove-disable-rsh
    type: package
    package: rsh-server
    state: absent
    when: "os_family('debian') or os_family('redhat')"

  - name: remove-disable-telnet
    type: package
    package: telnetd
    state: absent
    when: "os_family('debian')"

  - name: remove-shell-timeout
    type: file
    target_path: /etc/profile.d/pci-timeout.sh
    state: absent

  - name: remove-login-defs
    type: file
    target_path: /etc/login.defs
    state: absent
    when: "os_family('debian') or os_family('redhat')"

  - name: remove-pam-faillock
    type: file
    target_path: /etc/security/faillock.conf
    state: absent
    when: "os_family('debian') or os_family('redhat')"

  # REVIEW: exec reversal requires manual logic
  - name: undo-apply-sysctl
    type: exec
    command: "echo 'TODO: reverse of: sysctl --system'"
    onlyif: "false"

  - name: remove-sysctl-hardening
    type: file
    target_path: /etc/sysctl.d/99-pci-hardening.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-lock-lp-user
    type: exec
    command: "echo 'TODO: reverse of: usermod -L -s /usr/sbin/nologin lp'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-lock-games-user
    type: exec
    command: "echo 'TODO: reverse of: usermod -L -s /usr/sbin/nologin games'"
    onlyif: "false"

  - name: stop-disable-rpcbind
    type: service
    service: rpcbind
    state: stopped
    enabled: false
    when: "os_family('debian') or os_family('redhat')"

  - name: stop-disable-cups
    type: service
    service: cups
    state: stopped
    enabled: false
    when: "os_family('debian') or os_family('redhat')"

  - name: stop-disable-avahi
    type: service
    service: avahi-daemon
    state: stopped
    enabled: false
    when: "os_family('debian') or os_family('redhat')"
