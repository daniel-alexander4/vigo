name: soc2-availability-retract
description: Retraction module for soc2-availability. Removes all resources installed by the soc2-availability module. Review before activating.

resources:
  - name: stop-restart-chrony
    type: service
    service: chronyd
    state: stopped
    enabled: false
    when: "changed"

  - name: remove-chrony-config
    type: file
    target_path: /etc/chrony/chrony.conf
    state: absent

  - name: stop-chrony-service
    type: service
    service: chronyd
    state: stopped
    enabled: false

  - name: remove-chrony-package
    type: package
    package: chrony
    state: absent

  - name: remove-disk-check-cron
    type: cron
    state: absent

  - name: stop-sysstat-enabled
    type: service
    service: sysstat
    state: stopped
    enabled: false

  - name: remove-sysstat-package
    type: package
    package: sysstat
    state: absent
