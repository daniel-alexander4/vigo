name: aba-endpoint-hardening-retract
description: Retraction module for aba-endpoint-hardening. Removes all resources installed by the aba-endpoint-hardening module. Review before activating.

resources:
  # home directory may contain data
  - name: remove-remove-guest-account
    type: user
    username: guest
    state: absent

  # file_line: sudo-group-only — revert line change manually

  # file_line: ssh-key-only — revert line change manually

  # file_line: ssh-no-root — revert line change manually

  - name: remove-usb-storage-disabled
    type: file
    target_path: /etc/modprobe.d/usb-storage.conf
    state: absent

  # file_line: screen-lock-timeout — revert line change manually
