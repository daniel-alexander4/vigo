name: chrony-retract
description: Retraction module for chrony. Removes all resources installed by the chrony module. Review before activating.

resources:
  - name: stop-chrony-service-redhat
    type: service
    service: chronyd
    state: stopped
    enabled: false
    when: "!os_family('debian')"

  - name: stop-chrony-service-debian
    type: service
    service: chrony
    state: stopped
    enabled: false
    when: "os_family('debian')"

  - name: remove-chrony-conf-redhat
    type: file
    target_path: /etc/chrony.conf
    state: absent
    when: "!os_family('debian')"

  - name: remove-chrony-conf-debian
    type: file
    target_path: /etc/chrony/chrony.conf
    state: absent
    when: "os_family('debian')"

  - name: remove-install-chrony
    type: package
    package: chrony
    state: absent
