name: unbound-retract
description: Retract unbound.

resources:
  - name: stop-unbound
    type: service
    service: unbound
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-unbound
    type: package
    package: unbound
    state: absent
    when: "os_family('linux')"
