name: cpupower-retract
description: Retract cpupower. Reverts CPU governor to ondemand before uninstall.

resources:
  - name: reset-governor
    type: exec
    command: "cpupower frequency-set -g ondemand"
    unless: "cpupower frequency-info -p | grep -q 'governor \"ondemand\"'"
    when: "os_family('linux')"

  - name: uninstall-cpupower
    type: package
    package: linux-tools-common
    state: absent
    when: "os_family('debian')"

  - name: uninstall-cpupower-rhel
    type: package
    package: cpupowerutils
    state: absent
    when: "os_family('rhel')"
