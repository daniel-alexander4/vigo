name: pacman-mirror-retract
description: >-
  Retraction module for pacman-mirror. Removes all resources installed
  by the pacman-mirror module — leaves the mirrored tree on disk under
  /var/spool/pacman-mirror for the operator to delete manually after
  the fleet has flipped back to upstream. Review before activating.

resources:
  - name: remove-mirror-nginx-site
    type: file
    target_path: /etc/nginx/conf.d/pacman-mirror.conf
    state: absent

  - name: remove-pacman-mirror-cron
    type: cron
    command: "/usr/local/sbin/pacman-mirror-sync"
    state: absent

  - name: remove-pacman-mirror-sync-script
    type: file
    target_path: /usr/local/sbin/pacman-mirror-sync
    state: absent

  - name: remove-install-rsync
    type: package
    package: rsync
    state: absent
