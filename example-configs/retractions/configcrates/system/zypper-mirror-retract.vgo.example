name: zypper-mirror-retract
description: >-
  Retraction module for zypper-mirror. Removes all resources installed
  by the zypper-mirror module — leaves the mirrored tree on disk under
  /var/spool/zypper-mirror for the operator to delete manually after
  the fleet has flipped back to upstream. Review before activating.

resources:
  - name: remove-mirror-nginx-site
    type: file
    target_path: /etc/nginx/conf.d/zypper-mirror.conf
    state: absent

  - name: remove-zypper-mirror-cron
    type: cron
    command: "/usr/local/sbin/zypper-mirror-sync"
    state: absent

  - name: remove-zypper-mirror-sync-script
    type: file
    target_path: /usr/local/sbin/zypper-mirror-sync
    state: absent

  - name: remove-install-rsync
    type: package
    package: rsync
    state: absent
