name: dnf-mirror-retract
description: >-
  Retraction module for dnf-mirror. Removes all resources installed by
  the dnf-mirror module — leaves the mirrored tree on disk under
  /var/spool/dnf-mirror for the operator to delete manually after the
  fleet has flipped back to upstream. Review before activating.

resources:
  - name: remove-mirror-nginx-site
    type: file
    target_path: /etc/nginx/conf.d/dnf-mirror.conf
    state: absent

  - name: remove-dnf-mirror-cron
    type: cron
    command: "/usr/local/sbin/dnf-mirror-sync"
    state: absent

  - name: remove-dnf-mirror-sync-script
    type: file
    target_path: /usr/local/sbin/dnf-mirror-sync
    state: absent

  - name: remove-install-createrepo-c
    type: package
    package: createrepo_c
    state: absent

  - name: remove-install-dnf-utils
    type: package
    package: dnf-utils
    state: absent
