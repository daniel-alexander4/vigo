name: package-cache-retract
description: >-
  Retraction module for package-cache. Removes all resources installed by the
  package-cache module. Review before activating.

resources:
  - name: undo-dnf-clean-all
    type: exec
    command: "echo 'TODO: reverse of: dnf clean all -q'"
    onlyif: "false"
    when: "os_family('redhat')"
    # REVIEW: exec reversal requires manual logic

  - name: undo-dnf-keepcache-off
    type: exec
    command: "echo 'TODO: reverse of: sed -i '\''s/^keepcache=.*/keepcache=0/'\'' /etc/dnf/dnf.conf'"
    onlyif: "false"
    when: "os_family('redhat')"
    # REVIEW: exec reversal requires manual logic

  - name: remove-apt-autoclean
    type: file
    target_path: /etc/apt/apt.conf.d/99vigo-autoclean
    state: absent
    when: "os_family('debian')"
