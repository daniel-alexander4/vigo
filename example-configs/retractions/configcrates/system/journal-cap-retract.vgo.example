name: journal-cap-retract
description: >-
  Retraction module for journal-cap. Removes all resources installed by the
  journal-cap module. Review before activating.

resources:
  - name: stop-restart-journald
    type: service
    service: systemd-journald
    state: stopped
    enabled: false

  - name: remove-journald-size-limit
    type: file
    target_path: /etc/systemd/journald.conf.d/size-limit.conf
    state: absent

  - name: remove-journald-conf-dir
    type: directory
    target_path: /etc/systemd/journald.conf.d
    state: absent
