name: apk-mirror-retract
description: >-
  Retraction module for apk-mirror. Removes all resources installed by
  the apk-mirror module — leaves the mirrored tree on disk under
  /var/spool/apk-mirror for the operator to delete manually after the
  fleet has flipped back to upstream. Review before activating.

resources:
  - name: remove-mirror-nginx-site
    type: file
    target_path: /etc/nginx/conf.d/apk-mirror.conf
    state: absent

  - name: remove-apk-mirror-cron
    type: cron
    command: "/usr/local/sbin/apk-mirror-sync"
    state: absent

  - name: remove-apk-mirror-sync-script
    type: file
    target_path: /usr/local/sbin/apk-mirror-sync
    state: absent

  - name: remove-install-rsync
    type: package
    package: rsync
    state: absent
