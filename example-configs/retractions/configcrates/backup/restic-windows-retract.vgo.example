name: restic-windows-retract
description: >-
  Retract restic-windows. Removes the scheduled task, scripts, config.
  Does NOT delete the repository or secret-vault entries.

resources:
  - name: remove-scheduled-task
    type: powershell
    command: "Unregister-ScheduledTask -TaskName 'VigoResticBackup' -Confirm:$false -ErrorAction SilentlyContinue"
    skip_validation: true
    when: "os_family('windows')"

  - name: remove-backup-script
    type: file
    target_path: "C:\\ProgramData\\Vigo\\restic\\restic-backup.ps1"
    state: absent
    when: "os_family('windows')"

  - name: remove-env
    type: file
    target_path: "C:\\ProgramData\\Vigo\\restic\\restic.env"
    state: absent
    when: "os_family('windows')"

  - name: uninstall-restic
    type: package
    package: restic
    state: absent
    when: "os_family('windows')"
