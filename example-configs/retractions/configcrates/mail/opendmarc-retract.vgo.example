name: opendmarc-retract
description: Retract opendmarc.

resources:
  - name: stop-opendmarc
    type: service
    service: opendmarc
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-opendmarc
    type: package
    package: opendmarc
    state: absent
    when: "os_family('linux')"
