name: postgresql-retract
description: Retraction module for postgresql. Removes all resources installed by the postgresql module. Review before activating.

resources:
  - name: stop-postgresql-service
    type: service
    service: postgresql
    state: stopped
    enabled: false

  # logrotate: pg-logrotate — remove /etc/logrotate.d/pg-logrotate manually if needed

  - name: remove-backup-dir
    type: directory
    target_path: /var/backups/postgresql
    state: absent

  - name: remove-pg-hba
    type: file
    target_path: /etc/postgresql/16/main/pg_hba.conf
    state: absent

  - name: remove-pg-conf
    type: file
    target_path: /etc/postgresql/16/main/postgresql.conf
    state: absent

  - name: remove-install-postgresql
    type: package
    package: postgresql-16
    state: absent
