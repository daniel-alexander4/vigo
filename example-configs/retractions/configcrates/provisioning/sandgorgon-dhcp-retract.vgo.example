name: sandgorgon-dhcp-retract
description: Retraction module for sandgorgon-dhcp. Removes all resources installed by the sandgorgon-dhcp module. Review before activating.

vars:
  tftp_root: "/var/lib/tftpboot"

resources:
  - name: remove-dnsmasq-logrotate
    type: file
    target_path: /etc/logrotate.d/dnsmasq-sandgorgon
    state: absent

  - name: stop-dnsmasq-service
    type: service
    service: dnsmasq
    state: stopped
    enabled: false

  - name: remove-dnsmasq-sandgorgon-config
    type: file
    target_path: /etc/dnsmasq.d/sandgorgon-pxe.conf
    state: absent

  # REVIEW: exec reversal requires manual logic
  - name: undo-ipxe-uefi-binary
    type: exec
    command: "echo 'TODO: reverse of: curl -sSfL -o {{ .Vars.tftp_root }}/ipxe.efi https://boot.ipxe.org/ipxe.efi'"
    onlyif: "false"

  # REVIEW: exec reversal requires manual logic
  - name: undo-ipxe-bios-binary
    type: exec
    command: "echo 'TODO: reverse of: curl -sSfL -o {{ .Vars.tftp_root }}/undionly.kpxe https://boot.ipxe.org/undionly.kpxe'"
    onlyif: "false"

  - name: remove-tftp-directory
    type: directory
    target_path: "{{ .Vars.tftp_root }}"
    state: absent

  - name: stop-disable-systemd-resolved
    type: service
    service: systemd-resolved
    state: running
    enabled: true
    when: "os_family('debian') && has_service('systemd-resolved')"

  - name: remove-dnsmasq-package
    type: package
    package: dnsmasq
    state: absent
