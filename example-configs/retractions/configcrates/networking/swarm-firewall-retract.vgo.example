name: swarm-firewall-retract
description: >-
  Retraction module for swarm-firewall. Removes all resources installed by the
  swarm-firewall module. Review before activating.

resources:
  - name: remove-allow-swarm-peer-tcp
    type: firewall
    port: "1531"
    proto: tcp
    action: allow
    comment: "vigo: swarm peer-to-peer (chunks)"
    state: absent

  - name: remove-allow-swarm-discovery-udp
    type: firewall
    port: "1531"
    proto: udp
    action: allow
    comment: "vigo: swarm multicast discovery"
    state: absent
