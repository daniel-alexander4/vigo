name: wireguard-retract
description: Retract wireguard.

resources:
  - name: stop-wg0
    type: service
    service: "wg-quick@wg0"
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: remove-wg0-conf
    type: file
    target_path: "/etc/wireguard/wg0.conf"
    state: absent
    when: "os_family('linux')"

  - name: uninstall-wireguard
    type: package
    package: wireguard
    state: absent
    when: "os_family('linux')"
