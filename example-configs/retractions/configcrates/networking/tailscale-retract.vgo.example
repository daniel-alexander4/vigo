name: tailscale-retract
description: Retract tailscale. Logs out of the tailnet before uninstall.

resources:
  - name: tailscale-logout
    type: exec
    command: "tailscale logout"
    unless: "! tailscale status >/dev/null 2>&1"
    when: "os_family('linux')"

  - name: stop-tailscaled
    type: service
    service: tailscaled
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-tailscale
    type: package
    package: tailscale
    state: absent
    when: "os_family('linux')"
