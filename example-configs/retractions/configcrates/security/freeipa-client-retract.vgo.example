name: freeipa-client-retract
description: Retract freeipa-client. Unenrolls the host before package removal.

resources:
  - name: ipa-unenroll
    type: exec
    command: "ipa-client-install --uninstall --unattended"
    unless: "test ! -f /etc/ipa/default.conf"
    when: "os_family('linux')"

  - name: uninstall-freeipa-client
    type: package
    package: freeipa-client
    state: absent
    depends_on: [ipa-unenroll]
    when: "os_family('linux')"
