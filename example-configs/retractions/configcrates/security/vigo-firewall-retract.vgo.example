name: vigo-firewall-retract
description: >-
  Retraction module for vigo-firewall. Closes the ports vigo-firewall
  opened. Does NOT disable UFW itself (other modules may rely on it).
  Review before activating — closing ports on a live vigosrv host will
  break agent check-ins, the UI, and swarm peering.

resources:
  - name: deny-lockbox
    type: firewall
    port: "1533"
    proto: udp
    action: deny
    comment: "vigo: lockbox LAN sync (retract)"
    state: absent
    when: "os_family('linux')"

  - name: deny-longdrawer
    type: firewall
    port: "1532"
    proto: udp
    action: deny
    comment: "vigo: longdrawer LAN sync (retract)"
    state: absent
    when: "os_family('linux')"

  - name: deny-swarm-discovery
    type: firewall
    port: "1531"
    proto: udp
    action: deny
    comment: "vigo: swarm discovery (retract)"
    state: absent
    when: "os_family('linux')"

  - name: deny-swarm-tcp
    type: firewall
    port: "1531"
    proto: tcp
    action: deny
    comment: "vigo: swarm content (retract)"
    state: absent
    when: "os_family('linux')"

  - name: deny-https
    type: firewall
    port: "8443"
    proto: tcp
    action: deny
    comment: "vigo: HTTPS UI (retract)"
    state: absent
    when: "os_family('linux')"

  - name: deny-grpc
    type: firewall
    port: "1530"
    proto: tcp
    action: deny
    comment: "vigo: gRPC (retract)"
    state: absent
    when: "os_family('linux')"

  # ssh: not retracted — keeping operator access. Remove manually if intended.
  # ufw: not disabled — other modules may rely on it. Disable manually if intended.
