name: rkhunter-retract
description: Retract rkhunter.

resources:
  - name: remove-cron
    type: cron
    user: root
    name: rkhunter-check
    command: "rkhunter --update --quiet && rkhunter --check --skip-keypress --quiet"
    schedule: "0 4 * * *"
    state: absent
    when: "os_family('linux')"

  - name: uninstall-rkhunter
    type: package
    package: rkhunter
    state: absent
    when: "os_family('linux')"
