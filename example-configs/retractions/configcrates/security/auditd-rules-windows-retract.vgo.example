name: auditd-rules-windows-retract
description: Retract auditd-rules-windows. Resets the configured audit categories to "No Auditing".

resources:
  - name: disable-account-mgmt-audit
    type: powershell
    command: "auditpol /set /category:'Account Management' /success:disable /failure:disable"
    skip_validation: true
    when: "os_family('windows')"

  - name: disable-privilege-use-audit
    type: powershell
    command: "auditpol /set /category:'Privilege Use' /success:disable /failure:disable"
    skip_validation: true
    when: "os_family('windows')"

  - name: disable-process-tracking
    type: powershell
    command: "auditpol /set /subcategory:'Process Creation' /success:disable /failure:disable"
    skip_validation: true
    when: "os_family('windows')"
