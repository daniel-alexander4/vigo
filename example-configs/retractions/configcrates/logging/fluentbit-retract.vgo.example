name: fluentbit-retract
description: Retract fluentbit.

resources:
  - name: stop-fluentbit
    type: service
    service: fluent-bit
    state: stopped
    enabled: false
    when: "os_family('linux')"

  - name: uninstall-fluentbit
    type: package
    package: fluent-bit
    state: absent
    when: "os_family('linux')"
