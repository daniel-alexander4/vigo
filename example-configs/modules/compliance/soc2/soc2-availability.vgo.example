name: soc2-availability
compliance:
  hipaa: []
  iso-27001: [A.17.1.1]
  nist-800-53: [CP-9, CP-10]
  soc2: [A1.1, A1.2]
resources:
  # A1.1: Capacity management — monitoring tools
  - name: sysstat-package
    type: package
    package: sysstat
    state: present

  - name: sysstat-enabled
    type: service
    service: sysstat
    state: running
    enabled: true

  # Disk space monitoring
  - name: disk-check-cron
    type: cron
    job: |
      df -h / | awk 'NR==2{gsub(/%/,"",$5); if($5>85) print "DISK WARNING: "$5"% used on /" | "logger -t disk-monitor -p local0.warning"}'
    schedule: "0 */2 * * *"
    hour: "*/2"
    minute: "0"
    user: root

  # A1.2: Environmental protections — NTP sync
  - name: chrony-package
    type: package
    package: chrony
    state: present

  - name: chrony-service
    type: service
    service: chronyd
    state: running
    enabled: true

  - name: chrony-config
    type: file
    target_path: /etc/chrony/chrony.conf
    content: |
      pool ntp.ubuntu.com iburst maxsources 4
      pool 0.ubuntu.pool.ntp.org iburst maxsources 1
      pool 1.ubuntu.pool.ntp.org iburst maxsources 1
      keyfile /etc/chrony/chrony.keys
      driftfile /var/lib/chrony/chrony.drift
      logdir /var/log/chrony
      maxupdateskew 100.0
      rtcsync
      makestep 1 3
    owner: root
    group: root
    mode: "0644"
    notify: [restart-chrony]

  - name: restart-chrony
    type: service
    service: chronyd
    state: restarted
    when: "changed"
