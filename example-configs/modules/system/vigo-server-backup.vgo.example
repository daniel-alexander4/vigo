#~ Incremental hardlink-based backup of the Vigo server data directories.
#~ Creates dated snapshots that the web UI displays at /backups.
#~
#~ Backs up what the old "Download Backup" button captured:
#~   - server.yaml (bootstrap config)
#~   - Database (SQLite VACUUM INTO — atomic, safe with concurrent WAL)
#~   - Stockpile (modules, roles, node mappings, waivers, tasks, workflows)
#~   - Secrets (encrypted secret files + master key)
#~   - TLS (CA key/cert, server cert/key)
#~
#~ Snapshots use hardlink dedup: unchanged files share inodes with the
#~ previous snapshot, consuming zero additional disk.
#~
#~ The snapshot directory must match paths.snapshots in server.yaml
#~ (default: /srv/vigo/snapshots). The web UI reads this directory.
#~
#~ Assign to the node running the Vigo server:
#~   roles: [vigo-server-backup]
#~   vars:
#~     backup_retain: "90"
name: vigo-server-backup

vars:
  vigo_root: "/srv/vigo"
  snapshot_dir: "/srv/vigo/snapshots"
  backup_retain: "30"
  backup_schedule: "daily"
  backup_hour_start: "2"
  backup_hour_end: "5"

resources:
  #~ Ensure the snapshot destination exists.
  - name: snapshot-dir
    type: exec
    command: "mkdir -p {{ .Vars.snapshot_dir }}/db"
    onlyif: "test ! -d {{ .Vars.snapshot_dir }}/db"

  #~ Copy server.yaml into the snapshot directory.
  #~ Without this file, a restore can't find the database or secrets.
  - name: backup-server-yaml
    type: exec
    command: 'cp -p "{{ .Vars.vigo_root }}/server.yaml" "{{ .Vars.snapshot_dir }}/server.yaml"'
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}')"
    depends_on: [snapshot-dir]

  #~ Snapshot the SQLite database atomically via VACUUM INTO.
  #~ Safe with concurrent WAL writes (SQLite 3.27+).
  #~ Written to a fixed path so the backup executor can hardlink it
  #~ on subsequent runs when the DB hasn't changed.
  - name: db-snapshot
    type: exec
    command: 'sqlite3 "{{ .Vars.vigo_root }}/db/vigo.db" "VACUUM INTO ''{{ .Vars.snapshot_dir }}/db/vigo.db''"'
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}') and has_command('sqlite3')"
    depends_on: [snapshot-dir, backup-server-yaml]

  #~ Stockpile: modules, roles, node mappings, waivers, tasks, workflows.
  - name: backup-stockpile
    type: backup
    source_dir: "{{ .Vars.vigo_root }}/stockpile"
    backup_dir: "{{ .Vars.snapshot_dir }}/stockpile"
    retain: "{{ .Vars.backup_retain }}"
    schedule: "{{ .Vars.backup_schedule }}"
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}')"
    depends_on: [db-snapshot]

  #~ Secrets: encrypted secret files and master key.
  - name: backup-secrets
    type: backup
    source_dir: "{{ .Vars.vigo_root }}/secrets"
    backup_dir: "{{ .Vars.snapshot_dir }}/secrets"
    retain: "{{ .Vars.backup_retain }}"
    schedule: "{{ .Vars.backup_schedule }}"
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}')"
    depends_on: [db-snapshot]

  #~ TLS: CA key/cert, server cert/key, agent certs.
  - name: backup-tls
    type: backup
    source_dir: "{{ .Vars.vigo_root }}/tls"
    backup_dir: "{{ .Vars.snapshot_dir }}/tls"
    retain: "{{ .Vars.backup_retain }}"
    schedule: "{{ .Vars.backup_schedule }}"
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}')"
    depends_on: [db-snapshot]
