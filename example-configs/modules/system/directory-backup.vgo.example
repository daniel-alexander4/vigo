#~ Hardlink-based incremental directory backup with optional SQLite snapshot
name: directory-backup

vars:
  backup_src: "/srv/myapp"
  backup_dest: "/srv/backups/myapp"
  backup_db: ""
  backup_retain: "30"
  backup_schedule: "daily"
  backup_hour_start: "2"
  backup_hour_end: "4"
  backup_exclude: "*.swp,*.tmp"

resources:
  #~ Optional: snapshot SQLite database before backup (skipped if backup_db is empty)
  - name: sqlite-snapshot
    type: exec
    command: |
      mkdir -p "{{ .Vars.backup_dest }}/db" && sqlite3 "{{ .Vars.backup_db }}" "VACUUM INTO '{{ .Vars.backup_dest }}/db/$(basename {{ .Vars.backup_db }})'"
    when: "has_command('sqlite3')"
    onlyif: "test -n '{{ .Vars.backup_db }}' && test -f '{{ .Vars.backup_db }}'"

  #~ Hardlink-based incremental snapshot of the source directory
  - name: backup-snapshot
    type: backup
    source_dir: "{{ .Vars.backup_src }}"
    backup_dir: "{{ .Vars.backup_dest }}"
    retain: "{{ .Vars.backup_retain }}"
    schedule: "{{ .Vars.backup_schedule }}"
    exclude: "{{ .Vars.backup_exclude }}"
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}')"
    depends_on: [sqlite-snapshot]
