#~ Hardlink-based incremental directory backup with separate database snapshots.
#~
#~ The backup executor creates dated snapshot directories using hardlinks
#~ for unchanged files. Databases are backed up separately using db_backup
#~ which dumps to compressed SQL — this produces deterministic output that
#~ hardlinks effectively, unlike raw DB files which change every transaction.
name: directory-backup

vars:
  backup_src: "/srv/myapp"
  backup_dest: "/srv/backups/myapp"
  backup_db: ""
  backup_retain: "14"
  backup_schedule: "daily"
  backup_exclude: "*.swp,*.tmp"

resources:
  #~ Hardlink-based incremental snapshot of the source directory
  - name: backup-snapshot
    type: backup
    source_dir: "{{ .Vars.backup_src }}"
    backup_dir: "{{ .Vars.backup_dest }}"
    retain: "{{ .Vars.backup_retain }}"
    schedule: "{{ .Vars.backup_schedule }}"
    exclude: "{{ .Vars.backup_exclude }}"

  #~ Optional: dump SQLite database (skipped if backup_db var is empty)
  - name: db-snapshot
    type: db_backup
    db_type: sqlite
    db_name: "{{ .Vars.backup_db }}"
    backup_dir: "{{ .Vars.backup_dest }}/db"
    retain: "{{ .Vars.backup_retain }}"
    schedule: "{{ .Vars.backup_schedule }}"
    when: "var_set('backup_db')"
