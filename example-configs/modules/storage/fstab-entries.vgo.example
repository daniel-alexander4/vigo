name: fstab-entries

vars:
  nfs_server: "10.0.0.1"
  nfs_share: "/srv/shared"
  nfs_mount_point: "/mnt/shared"
  tmpfs_size: "2G"

resources:
  # --- NFS share mount ---

  - name: nfs-mount-dir
    type: directory
    target_path: /mnt/shared
    owner: root
    group: root
    mode: "0755"

  - name: nfs-share
    type: mount
    path: /mnt/shared
    device: "10.0.0.1:/srv/shared"
    fstype: nfs
    options: "rw,hard,intr,timeo=600,retrans=3"
    state: mounted
    depends_on: [nfs-mount-dir]

  # --- tmpfs for /tmp ---

  - name: tmpfs-tmp
    type: mount
    path: /tmp
    device: tmpfs
    fstype: tmpfs
    options: "defaults,noatime,nosuid,nodev,size=2G"
    state: mounted

  # --- tmpfs for shared memory ---

  - name: tmpfs-shm
    type: mount
    path: /dev/shm
    device: tmpfs
    fstype: tmpfs
    options: "defaults,nosuid,nodev,noexec"
    state: mounted

  # --- Bind mount ---

  - name: bind-mount-dir
    type: directory
    target_path: /srv/www
    owner: root
    group: root
    mode: "0755"

  - name: bind-mount
    type: mount
    path: /srv/www
    device: /var/www
    fstype: none
    options: "bind"
    state: mounted
    depends_on: [bind-mount-dir]
