name: chrony
# Prefer: cis-ubuntu-services or cis-rhel-services (compliance roles configure
# chrony via a .conf.d/ drop-in with compliance tags). Only use this module if
# you are NOT using CIS compliance roles — both manage chrony config and service.

vars:
  chrony_server_1: "0.pool.ntp.org"
  chrony_server_2: "1.pool.ntp.org"
  chrony_allow_network: ""

resources:
  - name: install-chrony
    type: package
    package: chrony
    state: present

  - name: chrony-conf-debian
    type: file
    target_path: /etc/chrony/chrony.conf
    content: |
      # Managed by Vigo — do not edit manually

      # NTP servers
      server {{ .Vars.chrony_server_1 }} iburst
      server {{ .Vars.chrony_server_2 }} iburst

      # Step the clock if offset exceeds 1 second during first 3 updates
      makestep 1.0 3

      # Sync the RTC
      rtcsync

      # Drift file
      driftfile /var/lib/chrony/drift

      # Log tracking, measurements, and statistics
      logdir /var/log/chrony
      {{ if ne .Vars.chrony_allow_network "" }}
      # Allow NTP clients on this network
      allow {{ .Vars.chrony_allow_network }}
      {{ end }}
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-chrony]
    notify: [chrony-service-debian]
    when: "os_family('debian')"

  - name: chrony-conf-redhat
    type: file
    target_path: /etc/chrony.conf
    content: |
      # Managed by Vigo — do not edit manually

      # NTP servers
      server {{ .Vars.chrony_server_1 }} iburst
      server {{ .Vars.chrony_server_2 }} iburst

      # Step the clock if offset exceeds 1 second during first 3 updates
      makestep 1.0 3

      # Sync the RTC
      rtcsync

      # Drift file
      driftfile /var/lib/chrony/drift

      # Log tracking, measurements, and statistics
      logdir /var/log/chrony
      {{ if ne .Vars.chrony_allow_network "" }}
      # Allow NTP clients on this network
      allow {{ .Vars.chrony_allow_network }}
      {{ end }}
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-chrony]
    notify: [chrony-service-redhat]
    when: "!os_family('debian')"

  - name: chrony-service-debian
    type: service
    service: chrony
    enabled: true
    state: running
    depends_on: [chrony-conf-debian]
    when: "os_family('debian')"

  - name: chrony-service-redhat
    type: service
    service: chronyd
    enabled: true
    state: running
    depends_on: [chrony-conf-redhat]
    when: "!os_family('debian')"
