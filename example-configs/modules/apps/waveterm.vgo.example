name: waveterm

vars:
  waveterm_version: "0.14.4"
  waveterm_deb_arch: "amd64"  # override to "arm64" for ARM hosts

resources:
  - name: download-waveterm-deb
    type: archive
    url: "https://github.com/wavetermdev/waveterm/releases/download/v{{ .Vars.waveterm_version }}/waveterm-linux-{{ .Vars.waveterm_deb_arch }}-{{ .Vars.waveterm_version }}.deb"
    target_path: /tmp/waveterm.deb
    when: "os_family('debian')"

  - name: install-waveterm-deb
    type: package
    package: /tmp/waveterm.deb
    state: present
    depends_on: [download-waveterm-deb]
    when: "os_family('debian')"

  - name: download-waveterm-rpm
    type: archive
    url: "https://github.com/wavetermdev/waveterm/releases/download/v{{ .Vars.waveterm_version }}/waveterm-linux-{{ .Traits.os.arch }}-{{ .Vars.waveterm_version }}.rpm"
    target_path: /tmp/waveterm.rpm
    when: "os_family('redhat')"

  - name: install-waveterm-rpm
    type: package
    package: /tmp/waveterm.rpm
    state: present
    depends_on: [download-waveterm-rpm]
    when: "os_family('redhat')"
