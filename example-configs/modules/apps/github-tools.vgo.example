name: github-tools

vars:
  bat_version: "0.25.0"
  fd_version: "10.2.0"
  ripgrep_version: "14.1.1"

resources:
  - name: install-bat
    type: source_package
    url: "https://github.com/sharkdp/bat/releases/download/v{{ .Vars.bat_version }}/bat-v{{ .Vars.bat_version }}-{{ .Traits.os.arch_raw }}-unknown-linux-musl.tar.gz"
    target_path: /usr/local/bin/bat
    binary: bat
    unless: "bat --version | grep {{ .Vars.bat_version }}"

  - name: install-fd
    type: source_package
    url: "https://github.com/sharkdp/fd/releases/download/v{{ .Vars.fd_version }}/fd-v{{ .Vars.fd_version }}-{{ .Traits.os.arch_raw }}-unknown-linux-musl.tar.gz"
    target_path: /usr/local/bin/fd
    binary: fd
    unless: "fd --version | grep {{ .Vars.fd_version }}"

  - name: install-ripgrep
    type: source_package
    url: "https://github.com/BurntSushi/ripgrep/releases/download/{{ .Vars.ripgrep_version }}/ripgrep-{{ .Vars.ripgrep_version }}-{{ .Traits.os.arch_raw }}-unknown-linux-musl.tar.gz"
    target_path: /usr/local/bin/rg
    binary: rg
    unless: "rg --version | grep {{ .Vars.ripgrep_version }}"
