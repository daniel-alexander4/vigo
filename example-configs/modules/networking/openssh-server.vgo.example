#~ Installs and configures OpenSSH server with hardened defaults
name: openssh-server

vars:
  ssh_port: "22"
  ssh_permit_root_login: "no"
  ssh_password_auth: "no"
  ssh_max_auth_tries: "3"

resources:
  - name: install-openssh
    type: package
    package: openssh-server
    state: present

  - name: sshd-config
    type: file
    target_path: /etc/ssh/sshd_config.d/99-vigo.conf
    content: |
      Port {{ .Vars.ssh_port }}
      PermitRootLogin {{ .Vars.ssh_permit_root_login }}
      PasswordAuthentication {{ .Vars.ssh_password_auth }}
      MaxAuthTries {{ .Vars.ssh_max_auth_tries }}
      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding no
      ClientAliveInterval 300
      ClientAliveCountMax 2
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-openssh]
    notify: [sshd-service]

  - name: sshd-service
    type: service
    service: ssh
    enabled: true
    state: running
    depends_on: [install-openssh]
