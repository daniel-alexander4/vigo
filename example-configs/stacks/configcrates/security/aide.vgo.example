#~ AIDE — Advanced Intrusion Detection Environment. File-integrity
#~ monitoring; initializes the database on first run and emails diffs
#~ via daily cron.
name: aide

compliance:
  provides: [file-integrity]
resources:
  - name: install-aide
    type: package
    package: aide
    state: present
    when: "os_family('linux')"

  - name: aide-init
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: "aideinit && mv /var/lib/aide/aide.db.new /var/lib/aide/aide.db"
    unless: "test -f /var/lib/aide/aide.db"
    depends_on: [install-aide]
    when: "os_family('linux')"

  - name: aide-check
    type: cron
    state: present
    user: root
    command: "aide --check"
    schedule: "30 5 * * *"
    depends_on: [aide-init]
    when: "os_family('linux')"
