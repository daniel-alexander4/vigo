#~ Provisions a Let's Encrypt certificate for the Vigo UI hostname and
#~ wires it into vigosrv. By default vigosrv ships with a self-signed
#~ cert generated by `make certs` — fine for internal LAN access, but
#~ operators publishing the UI to the public internet need a real cert.
#~
#~ This module:
#~   1. Installs certbot (with the standalone plugin).
#~   2. Issues a cert on first run via HTTP-01 on port 80 (must be open
#~      and reachable from the public internet during issuance).
#~   3. Installs a renewal hook that copies the live cert into
#~      /srv/vigo/tls/ and restarts the vigosrv container.
#~
#~ NOTE: this is a self-contained stub. When T2 ships the proper
#~ security/certbot module (general-purpose Let's Encrypt orchestration),
#~ fold this module's `package: certbot` + `exec: certbot certonly` into
#~ a depends_on against that module. Until then, the inline install keeps
#~ vigo-tls-public usable on its own.
#~
#~ Apply to the host running vigosrv (the public-facing Linux Docker host).
#~ Composite role: vigo-server.
name: vigo-tls-public

compliance:
  provides: [tls-public-cert]
vars:
  ui_hostname: "vigo.example.com"
  cert_email: "ops@example.com"
  vigo_root: "/srv/vigo"

resources:
  - name: install-certbot
    type: package
    package: certbot
    state: present
    when: "os_family('linux')"

  #~ Issue the cert on first run via HTTP-01. Port 80 must reach this host
  #~ from the public internet during this step. Subsequent renewals use
  #~ the same path (certbot caches state in /etc/letsencrypt).
  - name: issue-cert
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: 'certbot certonly --standalone --non-interactive --agree-tos -m "{{ .Vars.cert_email }}" -d "{{ .Vars.ui_hostname }}"'
    onlyif: 'test ! -f "/etc/letsencrypt/live/{{ .Vars.ui_hostname }}/fullchain.pem"'
    depends_on: [install-certbot]
    when: "os_family('linux')"

  #~ Renewal hook: after certbot renews, copy the live cert into
  #~ /srv/vigo/tls/ where vigosrv reads it, then restart the container so
  #~ the new cert is picked up.
  - name: vigo-renewal-hook
    type: file
    state: present
    target_path: "/etc/letsencrypt/renewal-hooks/deploy/vigo-tls.sh"
    owner: root
    group: root
    mode: "0755"
    content: |
      #!/bin/sh
      # Auto-generated by vigo-tls-public module. Runs after certbot renews.
      set -eu
      LIVE="/etc/letsencrypt/live/{{ .Vars.ui_hostname }}"
      DEST="{{ .Vars.vigo_root }}/tls"
      install -m 0600 "$LIVE/fullchain.pem" "$DEST/server.crt"
      install -m 0600 "$LIVE/privkey.pem"   "$DEST/server.key"
      cd "{{ .Vars.vigo_root }}" && docker compose restart vigo >/dev/null
    when: "os_family('linux')"
    depends_on: [issue-cert]

  #~ Renewal timer — certbot ships its own systemd timer when installed
  #~ via apt/dnf. This resource just ensures it's enabled.
  - name: certbot-renewal-timer
    type: service
    service: certbot.timer
    state: running
    enabled: true
    depends_on: [install-certbot]
    when: "os_family('linux')"
