#~ rkhunter — rootkit hunter. Updates signatures + runs a check daily.
name: rkhunter

compliance:
  provides: [rootkit-detection]
resources:
  - name: install-rkhunter
    type: package
    package: rkhunter
    state: present
    when: "os_family('linux')"

  - name: rkhunter-check
    type: cron
    state: present
    user: root
    command: "rkhunter --update --quiet && rkhunter --check --skip-keypress --quiet"
    schedule: "0 4 * * *"
    depends_on: [install-rkhunter]
    when: "os_family('linux')"
