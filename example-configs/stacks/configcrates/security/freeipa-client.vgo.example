#~ FreeIPA client enrollment. ipa-client-install reads the domain + server
#~ from vars and uses a one-time admin password (from the secret vault).
name: freeipa-client

compliance:
  provides: [central-identity]
vars:
  ipa_domain: "ipa.example.com"
  ipa_server: "ipa01.example.com"
  ipa_admin_password: "secret:vigo/ipa/admin_password"

resources:
  - name: install-freeipa-client
    type: package
    package: freeipa-client
    state: present
    when: "os_family('linux')"

  - name: ipa-enroll
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: "ipa-client-install --uninstall --unattended"
    command: 'ipa-client-install --unattended --domain="{{ .Vars.ipa_domain }}" --server="{{ .Vars.ipa_server }}" --principal=admin --password="{{ .Vars.ipa_admin_password }}"'
    unless: "test -f /etc/ipa/default.conf"
    depends_on: [install-freeipa-client]
    when: "os_family('linux')"
