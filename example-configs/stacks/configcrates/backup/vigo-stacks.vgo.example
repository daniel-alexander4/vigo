#~ Offsite git-push backup of the Vigo stacks (the operator-edited
#~ configuration tree). Catches the case where a host failure takes out
#~ both the live config AND the snapshot directory. Complements
#~ vigo-server-backup (filesystem snapshots) and vigo-litestream (DB WAL).
#~
#~ How it works:
#~   - Init-once: stacks/ becomes a local git repo on first apply.
#~   - Cron commits any changes and pushes to a remote git mirror.
#~   - Auth via SSH deploy key stored in the secret vault:
#~       secret:vigo/backup/stacks_deploy_key  (private key bytes)
#~
#~ Populate with:
#~   sudo vigocli secrets set raw vigo/backup/stacks_deploy_key
#~   (then paste the SSH private key)
#~
#~ The remote URL is a regular var, not a secret — it's not sensitive
#~ on its own (the deploy key gates access).
#~
#~ Apply to the host running vigosrv. Linux-only.
name: vigo-stacks

compliance:
  provides: [vigo-stacks-backup]
vars:
  stacks_dir: "/srv/vigo/stacks"
  remote_url: "git@github.example.com:ops/vigo-stacks-backup.git"
  push_branch: "main"
  push_schedule_hour: "3"
  push_schedule_minute: "45"
  ssh_deploy_key: "secret:vigo/backup/stacks_deploy_key"
  ssh_key_path: "/srv/vigo/secrets/.stacks-deploy.key"

resources:
  - name: install-git
    type: package
    package: git
    state: present
    when: "os_family('linux')"

  - name: deploy-key
    type: file
    state: present
    target_path: "{{ .Vars.ssh_key_path }}"
    owner: root
    group: root
    mode: "0600"
    content: "{{ .Vars.ssh_deploy_key }}"
    when: "os_family('linux')"

  - name: init-stacks-repo
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: 'cd "{{ .Vars.stacks_dir }}" && git init -b {{ .Vars.push_branch }} && git remote add origin "{{ .Vars.remote_url }}"'
    onlyif: 'test ! -d "{{ .Vars.stacks_dir }}/.git"'
    depends_on: [install-git, deploy-key]
    when: "os_family('linux')"

  - name: push-script
    type: file
    state: present
    target_path: "/usr/local/sbin/vigo-stacks-push.sh"
    owner: root
    group: root
    mode: "0755"
    content: |
      #!/bin/sh
      # Auto-generated by vigo-stacks module. Daily backup push.
      set -eu
      export GIT_SSH_COMMAND="ssh -i {{ .Vars.ssh_key_path }} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
      cd "{{ .Vars.stacks_dir }}"
      git add -A
      git diff --cached --quiet && exit 0   # nothing to commit
      git -c user.email=vigo-backup@localhost -c user.name='vigo-backup' commit -m "auto: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
      git push origin {{ .Vars.push_branch }}
    when: "os_family('linux')"

  - name: push-cron
    type: cron
    state: present
    user: root
    name: vigo-stacks-push
    command: "/usr/local/sbin/vigo-stacks-push.sh"
    schedule: "{{ .Vars.push_schedule_minute }} {{ .Vars.push_schedule_hour }} * * *"
    depends_on: [init-stacks-repo, push-script]
    when: "os_family('linux')"
