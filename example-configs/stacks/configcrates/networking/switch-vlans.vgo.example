# switch-vlans — VLAN configuration for Cisco IOS switches.
name: switch-vlans

compliance:
  provides: [network-segmentation]
resources:
  - name: Management
    type: cisco_vlan
    vlan_id: "100"
    state: present

  - name: Servers
    type: cisco_vlan
    vlan_id: "200"
    state: present

  - name: Users
    type: cisco_vlan
    vlan_id: "300"
    state: present

  - name: Deprecated
    type: cisco_vlan
    vlan_id: "999"
    state: absent

  - name: trunk-to-router
    type: cisco_interface
    interface: GigabitEthernet0/1
    description: "Uplink to edge-rtr01"
    switchport_mode: trunk
    depends_on: [Management, Servers, Users]

  - name: server-port
    type: cisco_interface
    interface: GigabitEthernet0/24
    description: "Database Server"
    switchport_mode: access
    access_vlan: "200"
    depends_on: [Servers]
