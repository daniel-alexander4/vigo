name: kernel-modules
# Partial overlap with CIS filesystem modules (both blacklist cramfs).
# Safe to combine — CIS covers more filesystem types, this module
# handles container networking modules (br_netfilter, overlay, ip_vs).

resources:
  # Container networking (required for Kubernetes, Docker Swarm)
  - name: br-netfilter
    type: kernel_module
    module: br_netfilter
    state: present

  # Container storage driver (overlay2)
  - name: overlay
    type: kernel_module
    module: overlay
    state: present

  # IPVS for load balancing (kube-proxy IPVS mode)
  - name: ip-vs
    type: kernel_module
    module: ip_vs
    state: present

  # Disable cramfs — rarely needed, reduces attack surface
  - name: disable-cramfs
    type: kernel_module
    module: cramfs
    state: absent

  # Reboot if kernel module changes require it
  - name: reboot-after-kmod
    type: reboot
    state: present
    delay_secs: "60"
    message: "Kernel module changes require reboot"
    reboot_required_file: /var/run/reboot-required
    subscribes: [br-netfilter, overlay, ip-vs, disable-cramfs]
