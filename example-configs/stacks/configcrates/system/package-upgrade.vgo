name: package-upgrade
description: Upgrade all system packages across Linux, macOS, FreeBSD, OpenBSD, NetBSD, illumos, and Windows

vars:
  upgrade_reboot: true

resources:
  # --- Debian / Ubuntu ---

  - name: apt-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    post_cleanup: true
    flags: "--fix-missing -o Dpkg::Options::='--force-confold' -o Dpkg::Options::='--force-confdef'"
    when: "os_family('debian')"
    notify: [reboot-if-needed]

  # --- RHEL / Fedora / Rocky / Alma ---

  - name: dnf-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    post_cleanup: true
    when: "os_family('redhat') && has_command('dnf')"
    notify: [reboot-if-needed]

  # --- Legacy RHEL / CentOS (yum without dnf) ---

  - name: yum-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    post_cleanup: true
    when: "os_family('redhat') && !has_command('dnf')"
    notify: [reboot-if-needed]

  # --- SUSE / openSUSE ---

  - name: zypper-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    when: "os_family('suse')"
    notify: [reboot-if-needed]

  # --- Alpine ---

  - name: apk-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    when: "os_family('alpine')"

  # --- Arch / Manjaro ---

  - name: pacman-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    when: "os_family('arch')"
    notify: [reboot-if-needed]

  # --- FreeBSD ---

  - name: pkg-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    post_cleanup: true
    when: "os('freebsd')"
    notify: [reboot-if-needed]

  # --- OpenBSD ---

  - name: pkg-add-upgrade
    type: package
    package: "*"
    state: latest
    when: "os('openbsd')"

  # --- NetBSD ---

  - name: pkgin-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    when: "os('netbsd')"
    notify: [reboot-if-needed]

  # --- illumos ---

  - name: ips-upgrade
    type: package
    package: "*"
    state: latest
    when: "os('illumos')"
    notify: [reboot-if-needed]

  # --- macOS ---

  - name: brew-upgrade
    type: package
    package: "*"
    state: latest
    update_cache: true
    when: "os('darwin')"

  # --- Windows ---

  - name: choco-upgrade
    type: package
    package: "*"
    state: latest
    when: "os('windows') && has_command('choco')"
    notify: [reboot-if-needed-windows]

  # --- Reboot handling ---

  - name: reboot-if-needed
    type: exec
    command: "shutdown -r +1 'Rebooting after package upgrade'"
    when: changed
    # Reboot if either signal is present:
    #   Debian/Ubuntu — /var/run/reboot-required flag file
    #   RHEL/Fedora   — needs-restarting -r exits 1
    # Each branch is parenthesised so the success of one short-circuits
    # the other without leaking $? from a partial command.
    onlyif: "(test -f /var/run/reboot-required) || (needs-restarting -r 2>/dev/null; test $? -eq 1)"

  - name: reboot-if-needed-windows
    type: exec
    command: "shutdown /r /t 60 /c \"Rebooting after package upgrade\""
    when: changed
    onlyif: "powershell -Command \"(Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue) -ne $null\""
