name: package-upgrade
description: Upgrade all system packages across Linux, macOS, FreeBSD, OpenBSD, NetBSD, illumos, and Windows

vars:
  # Set false to upgrade packages but never reboot automatically (workstations,
  # anything with an operator sitting in front of it). Consumed by the onlyif
  # guards on reboot-if-needed / reboot-if-needed-windows below.
  upgrade_reboot: true

resources:
  # --- Debian / Ubuntu ---

  - name: apt-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    post_cleanup: true
    flags: "--fix-missing -o Dpkg::Options::='--force-confold' -o Dpkg::Options::='--force-confdef'"
    when: "os_family('debian')"
    notify: [reboot-if-needed]

  # --- RHEL / Fedora / Rocky / Alma ---

  - name: dnf-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    post_cleanup: true
    when: "os_family('redhat') && has_command('dnf')"
    notify: [reboot-if-needed]

  # --- Legacy RHEL / CentOS (yum without dnf) ---

  - name: yum-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    post_cleanup: true
    when: "os_family('redhat') && !has_command('dnf')"
    notify: [reboot-if-needed]

  # --- SUSE / openSUSE ---

  - name: zypper-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    when: "os_family('suse')"
    notify: [reboot-if-needed]

  # --- Alpine ---

  - name: apk-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    when: "os_family('alpine')"

  # --- Arch / Manjaro ---

  - name: pacman-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    when: "os_family('arch')"
    notify: [reboot-if-needed]

  # --- FreeBSD ---

  - name: pkg-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    post_cleanup: true
    when: "os('freebsd')"
    notify: [reboot-if-needed]

  # --- OpenBSD ---

  - name: pkg-add-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    when: "os('openbsd')"

  # --- NetBSD ---

  - name: pkgin-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    when: "os('netbsd')"
    notify: [reboot-if-needed]

  # --- illumos ---

  - name: ips-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    when: "os('illumos')"
    notify: [reboot-if-needed]

  # --- macOS ---

  - name: brew-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    update_cache: true
    when: "os('darwin')"

  # --- Windows ---

  - name: choco-upgrade
    type: package
    package: "*"
    version: latest
    state: present
    when: "os('windows') && has_command('choco')"
    notify: [reboot-if-needed-windows]

  # --- Reboot handling ---

  - name: reboot-if-needed
    type: exec
    command: "shutdown -r +1 'Rebooting after package upgrade'"
    when: changed
    # Reboot only if upgrade_reboot is on AND a reboot signal is present:
    #   Debian/Ubuntu — /var/run/reboot-required flag file
    #   RHEL/Fedora   — needs-restarting -r exits 1
    # Each branch is parenthesised so the success of one short-circuits
    # the other without leaking $? from a partial command.
    #
    # upgrade_reboot is gated here rather than in `when:` on purpose. A var
    # referenced alongside the `changed` sentinel resolves to false on the
    # agent (eval_bundle passes `changed` expressions through unsubstituted,
    # and the runner resolves every non-`changed` VarRef to false), so
    # `when: changed && upgrade_reboot` would never fire. The template
    # renderer has no if/else — only value substitution — so the var is
    # compared as a string in the guard itself.
    onlyif: "test '{{ .Vars.upgrade_reboot }}' = 'true' && (test -f /var/run/reboot-required || (needs-restarting -r 2>/dev/null; test $? -eq 1))"

  - name: reboot-if-needed-windows
    type: exec
    command: "shutdown /r /t 60 /c \"Rebooting after package upgrade\""
    when: changed
    # Same upgrade_reboot gate as the Unix branch, in cmd syntax: `exit /b 1`
    # ends the guard before the pending-rename probe ever runs.
    onlyif: "if /i not \"{{ .Vars.upgrade_reboot }}\"==\"true\" exit /b 1 & powershell -Command \"(Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue) -ne $null\""
