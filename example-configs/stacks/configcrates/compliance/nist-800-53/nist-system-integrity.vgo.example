name: nist-system-integrity
compliance:
  bundle: [nist-system-integrity]
resources:
  # SI-3: Malicious code protection
  - name: clamav-package
    type: package
    package: clamav
    state: present

  - name: clamav-daemon
    type: package
    package: clamav-daemon
    state: present

  - name: clamav-service
    type: service
    service: clamav-daemon
    state: running
    enabled: true

  - name: freshclam-service
    type: service
    service: clamav-freshclam
    state: running
    enabled: true

  # SI-4: System monitoring — process accounting
  - name: acct-package
    type: package
    package: acct
    state: present

  - name: acct-service
    type: service
    service: acct
    state: running
    enabled: true

  # SI-7: Software integrity — debsums for package verification
  - name: debsums-package
    type: package
    package: debsums
    state: present

  - name: debsums-cron
    type: cron
    state: present
    command: "/usr/bin/debsums --changed --silent 2>&1 | logger -t debsums-check"
    schedule: "30 4 * * *"
    hour: "4"
    minute: "30"
    user: root

  # SI-2: Flaw remediation — ensure security updates are applied
  - name: apt-security-check
    type: cron
    state: present
    command: "/usr/bin/apt-get update -q && /usr/lib/update-notifier/apt-check --human-readable | logger -t security-updates"
    schedule: "0 6 * * *"
    hour: "6"
    minute: "0"
    user: root
