name: ce-firewalls
compliance:
  bundle: [ce-firewalls]
resources:
  - name: iptables-package
    type: package
    package: iptables
    state: present

  - name: default-input-drop
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: iptables -P INPUT DROP
    onlyif: "iptables -L INPUT | head -1 | grep -q ACCEPT"
    notify: [save-iptables]

  - name: default-forward-drop
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: iptables -P FORWARD DROP
    onlyif: "iptables -L FORWARD | head -1 | grep -q ACCEPT"
    notify: [save-iptables]

  - name: allow-established
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
    onlyif: "! iptables -C INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null"
    notify: [save-iptables]

  - name: allow-loopback
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: iptables -A INPUT -i lo -j ACCEPT
    onlyif: "! iptables -C INPUT -i lo -j ACCEPT 2>/dev/null"
    notify: [save-iptables]

  - name: allow-ssh
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: "iptables -A INPUT -p tcp --dport 22 -j ACCEPT"
    onlyif: "! iptables -C INPUT -p tcp --dport 22 -j ACCEPT 2>/dev/null"
    notify: [save-iptables]

  - name: save-iptables
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: iptables-save > /etc/iptables/rules.v4
    onlyif: "test -f /etc/iptables/rules.v4"
    when: "changed"
