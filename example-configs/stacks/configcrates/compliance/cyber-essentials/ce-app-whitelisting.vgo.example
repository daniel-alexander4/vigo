name: ce-app-whitelisting
compliance:
  bundle: [ce-app-whitelisting]
resources:
  - name: fapolicyd-package
    type: package
    package: fapolicyd
    state: present
    when: "os_family('rhel')"

  - name: fapolicyd-service
    type: service
    service: fapolicyd
    state: running
    enabled: true
    when: "os_family('rhel')"

  - name: apparmor-package
    type: package
    package: apparmor
    state: present
    when: "os_family('debian')"

  - name: apparmor-utils
    type: package
    package: apparmor-utils
    state: present
    when: "os_family('debian')"

  - name: apparmor-service
    type: service
    service: apparmor
    state: running
    enabled: true
    when: "os_family('debian')"

  - name: apparmor-enforce
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: "aa-complain /etc/apparmor.d/*"
    command: aa-enforce /etc/apparmor.d/*
    onlyif: "aa-status 2>/dev/null | grep -q 'complain mode'"
    when: "os_family('debian')"
