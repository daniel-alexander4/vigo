#~ Compliance evidence: weekly snapshot of who has shell access on this
#~ host. Drops a CSV in the evidence dir; auditors compare snapshots
#~ across access-review windows.
name: access-review-export

compliance:
  bundle: [access-review-export]
vars:
  evidence_dir: "/var/lib/vigo/evidence"

resources:
  - name: evidence-dir
    type: directory
    state: present
    target_path: "{{ .Vars.evidence_dir }}"
    owner: root
    group: root
    mode: "0750"
    when: "os_family('linux')"

  - name: access-export-script
    type: file
    state: present
    target_path: "/usr/local/sbin/access-review-export.sh"
    owner: root
    group: root
    mode: "0750"
    content: |
      #!/bin/sh
      set -eu
      OUT={{ .Vars.evidence_dir }}/access-review-$(date -u +%Y-%m-%d).csv
      printf 'user,uid,gid,shell,sudoers\n' > "$OUT"
      while IFS=: read -r u _ uid gid _ _ shell; do
        case "$shell" in
          */nologin|*/false|"") continue ;;
        esac
        sudoers=$(grep -c "^${u}\\b" /etc/sudoers /etc/sudoers.d/* 2>/dev/null || echo 0)
        printf '%s,%s,%s,%s,%s\n' "$u" "$uid" "$gid" "$shell" "$sudoers" >> "$OUT"
      done < /etc/passwd
    depends_on: [evidence-dir]
    when: "os_family('linux')"

  - name: access-export-cron
    type: cron
    state: present
    user: root
    name: access-review-export
    command: "/usr/local/sbin/access-review-export.sh"
    schedule: "0 2 * * 0"
    depends_on: [access-export-script]
    when: "os_family('linux')"
