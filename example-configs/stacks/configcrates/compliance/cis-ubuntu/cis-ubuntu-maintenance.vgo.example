name: cis-ubuntu-maintenance
# CIS Ubuntu Linux Benchmark — Section 6: System Maintenance
# Level 1 controls
# Applies to: Ubuntu 20.04, 22.04, 24.04

compliance:
  bundle: [cis-ubuntu-maintenance]
resources:
  # --- 6.1: System file permissions ---

  - name: 6.1.2-passwd-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 644 /etc/passwd && chown root:root /etc/passwd
    onlyif: "! stat -c '%a %U:%G' /etc/passwd | grep -q '644 root:root'"

  - name: 6.1.3-passwd-dash-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 644 /etc/passwd- && chown root:root /etc/passwd-
    onlyif: "test -f /etc/passwd- && ! stat -c '%a %U:%G' /etc/passwd- | grep -q '644 root:root'"

  - name: 6.1.4-shadow-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 640 /etc/shadow && chown root:shadow /etc/shadow
    onlyif: "! stat -c '%a' /etc/shadow | grep -q '640'"

  - name: 6.1.5-shadow-dash-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 640 /etc/shadow- && chown root:shadow /etc/shadow-
    onlyif: "test -f /etc/shadow- && ! stat -c '%a' /etc/shadow- | grep -q '640'"

  - name: 6.1.6-group-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 644 /etc/group && chown root:root /etc/group
    onlyif: "! stat -c '%a %U:%G' /etc/group | grep -q '644 root:root'"

  - name: 6.1.7-group-dash-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 644 /etc/group- && chown root:root /etc/group-
    onlyif: "test -f /etc/group- && ! stat -c '%a %U:%G' /etc/group- | grep -q '644 root:root'"

  - name: 6.1.8-gshadow-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 640 /etc/gshadow && chown root:shadow /etc/gshadow
    onlyif: "! stat -c '%a' /etc/gshadow | grep -q '640'"

  - name: 6.1.9-gshadow-dash-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: chmod 640 /etc/gshadow- && chown root:shadow /etc/gshadow-
    onlyif: "test -f /etc/gshadow- && ! stat -c '%a' /etc/gshadow- | grep -q '640'"

  # CIS 6.1.10: No world-writable files — daily cron (expensive full-disk scan).
  - name: 6.1.10-no-world-writable
    type: cron
    state: present
    user: root
    name: cis-world-writable-scan
    command: "find / -xdev -type f -perm -0002 -exec chmod o-w {} + 2>/dev/null"
    schedule: "0 3 * * *"

  # --- 6.2: User/group settings ---

  - name: 6.2.1-no-empty-passwords
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: |
      for user in $(awk -F: '($2 == "") {print $1}' /etc/shadow); do
        passwd -l "$user"
      done
    onlyif: "awk -F: '($2 == \"\") {found=1} END {exit !found}' /etc/shadow"

  # CIS 6.2.2–6.2.7: Audit checks (detection, not remediation)
  # These check for duplicate UIDs, GIDs, user names, group names,
  # and root-owned home directories. Remediation is site-specific.

  - name: 6.2.2-no-uid-0-except-root
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: "true"
    onlyif: "! awk -F: '($3 == 0 && $1 != \"root\") {found=1} END {exit !found}' /etc/passwd"

  - name: 6.2.3-root-path-integrity
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: "true"
    onlyif: "! echo \"$PATH\" | grep -q '::' && ! echo \"$PATH\" | grep -q ':$'"

  - name: 6.2.5-home-dir-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    on_revert: none
    command: |
      for dir in $(awk -F: '($3 >= 1000 && $7 != "/usr/sbin/nologin" && $7 != "/bin/false") {print $6}' /etc/passwd); do
        if [ -d "$dir" ]; then
          chmod g-w,o-rwx "$dir"
        fi
      done
    onlyif: |
      for dir in $(awk -F: '($3 >= 1000 && $7 != "/usr/sbin/nologin" && $7 != "/bin/false") {print $6}' /etc/passwd); do
        if [ -d "$dir" ] && stat -c '%a' "$dir" | grep -qE '[2367][0-9]{0,2}$|[0-7][1-7]$'; then
          exit 0
        fi
      done
      exit 1
