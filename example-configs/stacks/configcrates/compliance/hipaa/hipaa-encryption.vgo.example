name: hipaa-encryption
compliance:
  bundle: [hipaa-encryption]
resources:
  - name: cryptsetup-package
    type: package
    package: cryptsetup
    state: present

  # Enforce TLS 1.2+ system-wide
  - name: crypto-policy
    type: file
    state: present
    target_path: /etc/crypto-policies/config
    content: "FUTURE\n"
    owner: root
    group: root
    mode: "0644"
    notify: [apply-crypto-policy]

  - name: apply-crypto-policy
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: update-crypto-policies
    onlyif: "test -f /etc/crypto-policies/config"
    when: "changed"

  # SSH hardening for data in transit
  - name: ssh-ciphers
    type: file
    state: present
    target_path: /etc/ssh/sshd_config.d/90-hipaa-crypto.conf
    content: |
      Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
      HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256
    owner: root
    group: root
    mode: "0644"
    notify: [restart-sshd-debian, restart-sshd-redhat]

  - name: restart-sshd-debian
    type: service
    service: ssh
    state: restarted
    when: "changed && os_family('debian')"

  - name: restart-sshd-redhat
    type: service
    service: sshd
    state: restarted
    when: "changed && !os_family('debian')"
