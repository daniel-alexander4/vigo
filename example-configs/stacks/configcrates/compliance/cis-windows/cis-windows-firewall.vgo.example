name: cis-windows-firewall
# CIS Windows Server 2022 Level 1 — Windows Firewall
# Status: NON-FUNCTIONAL SCAFFOLDING — does NOT enforce on a real host.
#   The firewall_windows resources below write `profile:`/`enabled:`/
#   `default_inbound:`, but the agent's executor is rule-only
#   (`name:`/`direction:`/`action:`) and ignores firewall profile state, so
#   they no-op. Compliance claims are withheld until firewall_windows gains
#   profile-state support (see deferred.md: "Windows compliance executor reconciliation").
#
# `type: firewall_windows` is a placeholder for a future profile-aware
# Windows-firewall executor that takes per-profile (domain/private/public)
# default-action settings. The current `firewall` executor (which dispatches
# to FirewallWindowsExecutor on Windows hosts) speaks port-based rules
# rather than profile-default rules. Until the executor catches up, each
# resource carries `skip_validation: true` to acknowledge it's scaffolding
# — see deferred.md "Structural-field collision in registry /
# local_security_policy / windows_update / windows_defender executors" for
# the broader CIS-Windows trail this fits into.

compliance:
  bundle: [cis-windows-firewall]
resources:
  - name: firewall-domain-on
    type: firewall_windows
    skip_validation: true
    profile: domain
    enabled: true
    default_inbound: block
    default_outbound: allow

  - name: firewall-private-on
    type: firewall_windows
    skip_validation: true
    profile: private
    enabled: true
    default_inbound: block
    default_outbound: allow

  - name: firewall-public-on
    type: firewall_windows
    skip_validation: true
    profile: public
    enabled: true
    default_inbound: block
    default_outbound: allow
