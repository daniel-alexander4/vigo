name: cis-windows-network
# CIS Windows Server 2022 Level 1 — Network Security
# Status: NON-FUNCTIONAL SCAFFOLDING — does NOT enforce on a real host.
#   The registry resources below write `key:`/`value_name:`/`value_type:`, but
#   the agent's registry executor reads `path:`/`name:`/`type:`, so every
#   resource no-ops. Do not rely on this configcrate for hardening; compliance
#   claims are withheld until the executor/configcrate attribute vocabularies
#   are reconciled (see deferred.md: "Windows compliance executor reconciliation").

compliance:
  bundle: [cis-windows-network]
resources:
  # Disable LLMNR
  - name: disable-llmnr
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient'
    value_name: "EnableMulticast"
    value_data: "0"
    value_type: "REG_DWORD"

  # Disable NetBIOS over TCP/IP (via registry)
  - name: disable-netbios
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Services\NetBT\Parameters'
    value_name: "NodeType"
    value_data: "2"
    value_type: "REG_DWORD"

  # Disable WPAD
  - name: disable-wpad
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Internet Settings\Wpad'
    value_name: "WpadOverride"
    value_data: "1"
    value_type: "REG_DWORD"

  # SMB v1 disabled
  - name: disable-smbv1-server
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'
    value_name: "SMB1"
    value_data: "0"
    value_type: "REG_DWORD"

  # WDigest authentication disabled (prevents plaintext creds in memory)
  - name: disable-wdigest
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest'
    value_name: "UseLogonCredential"
    value_data: "0"
    value_type: "REG_DWORD"

  # SMB signing required (client)
  - name: smb-signing-client
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters'
    value_name: "RequireSecuritySignature"
    value_data: "1"
    value_type: "REG_DWORD"

  # LDAP client signing
  - name: ldap-client-signing
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Services\LDAP'
    value_name: "LDAPClientIntegrity"
    value_data: "1"
    value_type: "REG_DWORD"

  # Refuse LM/NTLM — NTLMv2 only
  - name: ntlm-auth-level
    type: registry
    state: present
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Control\Lsa'
    value_name: "LmCompatibilityLevel"
    value_data: "5"
    value_type: "REG_DWORD"
