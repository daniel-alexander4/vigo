name: cis-windows-account-policies
# CIS Windows Server 2022 Level 1 — Account Policies
# Status: NON-FUNCTIONAL SCAFFOLDING — does NOT enforce on a real host.
#   The local_security_policy resources below write the attr `policy:`, but the
#   agent's executor reads `policy_name:`, so every resource errors / no-ops.
#   Do not rely on this configcrate for hardening; compliance claims are
#   withheld until the executor/configcrate attribute vocabularies are
#   reconciled (see deferred.md: "Windows compliance executor reconciliation").

compliance:
  bundle: [cis-windows-account-policies]
resources:
  - name: password-min-length
    type: local_security_policy
    skip_validation: true
    policy: "MinimumPasswordLength"
    value: "14"

  - name: password-complexity
    type: local_security_policy
    skip_validation: true
    policy: "PasswordComplexity"
    value: "1"

  - name: password-history
    type: local_security_policy
    skip_validation: true
    policy: "PasswordHistorySize"
    value: "24"

  - name: max-password-age
    type: local_security_policy
    skip_validation: true
    policy: "MaximumPasswordAge"
    value: "365"

  - name: min-password-age
    type: local_security_policy
    skip_validation: true
    policy: "MinimumPasswordAge"
    value: "1"

  - name: lockout-threshold
    type: local_security_policy
    skip_validation: true
    policy: "LockoutBadCount"
    value: "5"

  - name: lockout-duration
    type: local_security_policy
    skip_validation: true
    policy: "LockoutDuration"
    value: "15"

  - name: lockout-reset
    type: local_security_policy
    skip_validation: true
    policy: "ResetLockoutCount"
    value: "15"
