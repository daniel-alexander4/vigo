# Role definitions — group configcrates into reusable profiles.
# Assign roles to envoy entries instead of listing configcrates individually.
#
# Roles can include other roles (single level):
#   - name: webserver
#     includes: [bastion]
#     configcrates: [nginx, certbot]
#
# A configcrate reference can carry foreach: (a list var) + key: (the item field
# naming each instance) to stamp the configcrate out once per list item — see the
# webserver-vhosts role below and configcrates/web/vhost.vgo.example.

roles:
  - name: webserver
    includes: [bastion]
    configcrates: [nginx]

  # nginx (singleton: package + service) plus one vhost configcrate instance per
  # entry in the `vhosts` var — supply that var in environments.vgo, a
  # common.vgo, or a match block. Expands to vhost[<server_name>] instances.
  - name: webserver-vhosts
    includes: [bastion]
    configcrates:
      - nginx
      - name: vhost
        foreach: vhosts
        key: server_name

  - name: database
    configcrates: [postgresql]

  - name: monitoring
    configcrates: [prometheus, node-exporter, grafana]

  - name: bastion
    configcrates: [openssh, fail2ban]

  - name: mediaserver
    configcrates: [plex]

  - name: network-switch
    configcrates: [switch-base, switch-vlans]

  - name: network-router
    configcrates: [router-base]

  - name: disk-hygiene
    configcrates: [logrotate, journal-cap, tmp-aging, package-cache, docker-prune]

  # ─── Compliance Evidence (T7) ───────────────────────────────────────
  # Typically composed on top of a framework role (hipaa, pci-dss, etc.) to
  # produce auditor-friendly artifacts: log-shipping attestation, weekly
  # access review export, encryption status, backup restorability checks.
  - name: compliance-evidence
    case:
      linux:
        configcrates:
          - log-shipping-attestation
          - access-review-export
          - encryption-attestation
          - backup-verification
          - compliance-evidence-toolkit
      windows:
        configcrates:
          - log-shipping-attestation-windows
          - access-review-export-windows
          - encryption-attestation-windows
          - backup-verification-windows
          - compliance-evidence-toolkit-windows

  # ─── Security Engineer (T1) ─────────────────────────────────────────
  # Hardening + audit role: file integrity (aide/sysmon), audit rules,
  # MAC, antivirus, rootkit scanners, AD/IPA/LDAP/Kerberos client wiring,
  # YubiKey PAM, password policy, system crypto policy, custom CA anchors,
  # and the security-engineer diagnostic toolkit.
  - name: security-engineer
    case:
      linux:
        configcrates:
          - aide
          - auditd-rules
          - apparmor
          - clamav
          - rkhunter
          - chkrootkit
          - sssd
          - freeipa-client
          - ldap-client
          - kerberos-client
          - yubikey-pam
          - pwquality
          - crypto-policies
          - ca-anchors
          - security-engineer-toolkit
      windows:
        configcrates:
          - aide-windows
          - auditd-rules-windows
          - clamav-windows
          - pwquality-windows
          - ca-anchors-windows
          - security-engineer-toolkit-windows

  # ─── Sysadmin (T2) ──────────────────────────────────────────────────
  # General-purpose host role: backup, cert mgmt, mail, VPN, log shipping,
  # monitoring, storage tools, system tuning, DNS, and the sysadmin
  # diagnostic toolkit. case: dispatch swaps Linux configcrates for Windows
  # functional analogs (where one exists; some are Linux-only stubs that
  # do nothing on Windows by design).
  - name: sysadmin
    case:
      linux:
        configcrates:
          - restic
          - borg
          - kopia
          - certbot
          - step-ca
          - dovecot
          - opendkim
          - opendmarc
          - rspamd
          - wireguard
          - tailscale
          - fluentbit
          - loki
          - promtail
          - alertmanager
          - blackbox-exporter
          - snmpd
          - zfs
          - btrfs
          - iscsi-initiator
          - mdadm
          - tuned
          - cpupower
          - locale
          - swap-config
          - bind
          - unbound
          - sysadmin-toolkit
      windows:
        configcrates:
          - restic-windows
          - kopia-windows
          - certbot-windows
          - step-ca-windows
          - wireguard-windows
          - tailscale-windows
          - fluentbit-windows
          - promtail-windows
          - blackbox-exporter-windows
          - snmpd-windows
          - iscsi-initiator-windows
          - tuned-windows
          - locale-windows
          - swap-config-windows
          - sysadmin-toolkit-windows

  # ─── Vigo server host (T6) ──────────────────────────────────────────
  # Assign to the Linux host running vigosrv. Bundles firewall, secret-
  # vault perms, optional Let's Encrypt cert, three complementary backup
  # tiers (filesystem snapshot, SQLite WAL replication, stockpile git
  # push), a local health probe, container-log forwarding, the operator
  # MOTD warning, Docker keepalive, and the diagnostic toolkit.
  - name: vigo-server
    configcrates:
      - vigo-firewall
      - vigo-secrets-perms
      - vigo-tls-public
      - vigo-server-backup
      - vigo-litestream
      - vigo-stockpile
      - vigo-healthcheck
      - vigo-log-forward
      - vigo-motd
      - vigo-docker-keepalive
      - vigo-server-toolkit

  # ─── Compliance framework roles ─────────────────────────────────────
  # Assign one or more of these to envoys whose configcrates should satisfy
  # the named framework. Configcrates referenced below live under
  # configcrates/compliance/<framework>/.
  #
  # CIS roles use conditional when: to auto-select the right configcrates per OS:
  #   envoys:
  #     - match: "*.example.com"
  #       roles:
  #         - name: cis-ubuntu
  #           when: "distro('ubuntu')"
  #         - name: cis-rhel
  #           when: "distro('rhel') || distro('centos') || distro('rocky') || distro('alma')"
  #         - name: cis-windows
  #           when: "os_family('windows')"

  # ─── Healthcare ───
  - name: hipaa
    configcrates:
      - hipaa-access-controls
      - hipaa-audit-trail
      - hipaa-encryption
      - hipaa-media-disposal

  - name: hitrust
    configcrates:
      - hitrust-endpoint-protection
      - hitrust-governance
      - hitrust-operations

  - name: fda-21cfr11
    configcrates:
      - fda-access-controls
      - fda-audit-trail
      - fda-system-integrity

  # ─── Financial Services ───
  - name: pci-dss
    configcrates:
      - pci-access-control
      - pci-file-integrity
      - pci-hardening
      - pci-logging
      - pci-network-security

  - name: sox
    configcrates:
      - sox-access-controls
      - sox-change-management
      - sox-system-integrity

  - name: finra
    configcrates:
      - finra-bcp-monitoring
      - finra-infrastructure
      - finra-worm-monitoring

  - name: mifid2
    configcrates:
      - mifid2-capacity
      - mifid2-change-management
      - mifid2-resilience

  - name: ccss
    configcrates:
      - ccss-audit-integrity
      - ccss-key-storage
      - ccss-network-security

  # ─── General / Cross-Industry ───
  - name: soc2
    configcrates:
      - soc2-availability
      - soc2-change-management
      - soc2-governance

  - name: nist-800-53
    configcrates:
      - nist-access-control
      - nist-audit-retention
      - nist-config-management
      - nist-key-management
      - nist-login-banner
      - nist-system-integrity

  - name: iso-27001
    configcrates:
      - iso-communications-security
      - iso-operations-security

  - name: gdpr
    configcrates:
      - gdpr-breach-notification
      - gdpr-data-protection
      - gdpr-privacy-controls

  - name: cyber-essentials
    configcrates:
      - ce-app-whitelisting
      - ce-firewalls
      - ce-malware
      - ce-mfa
      - ce-monitoring
      - ce-patching
      - ce-secure-config

  # ─── CIS Benchmarks (platform-specific) ───
  - name: cis-ubuntu
    configcrates:
      - cis-ubuntu-filesystem
      - cis-ubuntu-services
      - cis-ubuntu-network
      - cis-ubuntu-logging
      - cis-ubuntu-access
      - cis-ubuntu-maintenance

  - name: cis-rhel
