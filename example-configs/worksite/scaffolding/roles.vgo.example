# Role definitions — group modules into reusable profiles.
# Assign roles to envoy entries instead of listing modules individually.
#
# Roles can include other roles (single level):
#   - name: webserver
#     includes: [bastion]
#     modules: [nginx, certbot]
#
# A module reference can carry foreach: (a list var) + key: (the item field
# naming each instance) to stamp the module out once per list item — see the
# webserver-vhosts role below and modules/web/vhost.vgo.example.

roles:
  - name: webserver
    includes: [bastion]
    modules: [nginx]

  # nginx (singleton: package + service) plus one vhost module instance per
  # entry in the `vhosts` var — supply that var in environments.vgo, a
  # common.vgo, or a match block. Expands to vhost[<server_name>] instances.
  - name: webserver-vhosts
    includes: [bastion]
    modules:
      - nginx
      - name: vhost
        foreach: vhosts
        key: server_name

  - name: database
    modules: [postgresql]

  - name: monitoring
    modules: [prometheus, node-exporter, grafana]

  - name: bastion
    modules: [openssh, fail2ban]

  - name: mediaserver
    modules: [plex]

  - name: network-switch
    modules: [switch-base, switch-vlans]

  - name: network-router
    modules: [router-base]

  - name: disk-hygiene
    modules: [logrotate, journal-cap, tmp-aging, package-cache, docker-prune]
