# PCI DSS v4.0 Network Security Module
# Enforces: Req 1.2.1 (NSC configured), 1.2.5 (ports restricted),
#           1.3.1 (inbound restricted), 1.4.1 (segmentation)
#
# Baseline firewall rules for systems in PCI scope. Restricts inbound
# access to only the ports required for the system's function.
# Customize allowed_tcp_ports per node via vars overrides.

name: pci-network

compliance:
  bundle: [pci-network]
vars:
  allowed_tcp_ports: "22 443"
  allowed_udp_ports: ""
  log_dropped: "true"

resources:
  - name: install-iptables
    type: package
    package: iptables
    state: present
    when: "os_family('debian') or os_family('redhat')"

  - name: pci-firewall-rules
    type: file
    state: present
    target_path: /etc/iptables/rules.v4
    content: |
      # PCI DSS v4.0 Req 1 — Network Security Controls
      # Managed by Vigo
      *filter
      :INPUT DROP [0:0]
      :FORWARD DROP [0:0]
      :OUTPUT ACCEPT [0:0]

      # Allow loopback
      -A INPUT -i lo -j ACCEPT

      # Allow established connections
      -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

      # Allow ICMP (ping)
      -A INPUT -p icmp --icmp-type echo-request -j ACCEPT

      # Allowed TCP ports
      {{- range $port := split .Vars.allowed_tcp_ports " " }}
      {{- if ne $port "" }}
      -A INPUT -p tcp --dport {{ $port }} -j ACCEPT
      {{- end }}
      {{- end }}

      # Allowed UDP ports
      {{- range $port := split .Vars.allowed_udp_ports " " }}
      {{- if ne $port "" }}
      -A INPUT -p udp --dport {{ $port }} -j ACCEPT
      {{- end }}
      {{- end }}

      {{ if eq .Vars.log_dropped "true" -}}
      # Log dropped packets (Req 10.2.1.4)
      -A INPUT -j LOG --log-prefix "PCI-DROP: " --log-level 4
      {{- end }}

      # Drop everything else
      -A INPUT -j DROP

      COMMIT
    owner: root
    group: root
    mode: "0600"
    depends_on: [install-iptables]
    notify: [apply-iptables]

  - name: apply-iptables
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "iptables-restore < /etc/iptables/rules.v4"
    onlyif: "! iptables -C INPUT -p tcp --dport 22 -j ACCEPT 2>/dev/null"
    depends_on: [pci-firewall-rules]

  - name: iptables-persistent-debian
    type: package
    package: iptables-persistent
    state: present
    when: "os_family('debian')"
    depends_on: [pci-firewall-rules]
