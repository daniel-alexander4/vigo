#~ Compliance evidence: weekly attestation that at-rest encryption is
#~ enabled (LUKS dm-crypt presence on the boot disk, swap file
#~ encrypted, etc.). Output JSON for auditor collection.
name: encryption-attestation

compliance:
  bundle: [encryption-attestation]
vars:
  evidence_dir: "/var/lib/vigo/evidence"

resources:
  - name: evidence-dir
    type: directory
    state: present
    target_path: "{{ .Vars.evidence_dir }}"
    owner: root
    group: root
    mode: "0750"
    when: "os_family('linux')"

  - name: encryption-attest-script
    type: file
    state: present
    target_path: "/usr/local/sbin/encryption-attest.sh"
    owner: root
    group: root
    mode: "0750"
    content: |
      #!/bin/sh
      set -eu
      OUT={{ .Vars.evidence_dir }}/encryption-$(date -u +%Y-%m-%d).json
      LUKS=$(lsblk -o NAME,TYPE | grep -c 'crypt' || echo 0)
      SWAP_ENC=$(grep -E '^/dev/mapper/.*swap' /proc/swaps | wc -l)
      printf '{"timestamp":"%s","host":"%s","luks_volumes":%s,"encrypted_swap":%s}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" "$LUKS" "$SWAP_ENC" > "$OUT"
    depends_on: [evidence-dir]
    when: "os_family('linux')"

  - name: encryption-attest-cron
    type: cron
    state: present
    user: root
    name: encryption-attest
    command: "/usr/local/sbin/encryption-attest.sh"
    schedule: "30 1 * * 0"
    depends_on: [encryption-attest-script]
    when: "os_family('linux')"
