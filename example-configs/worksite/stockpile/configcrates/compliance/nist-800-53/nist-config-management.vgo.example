name: nist-config-management
compliance:
  bundle: [nist-config-management]
resources:
  # CM-7: Least functionality — disable unnecessary services
  - name: disable-avahi
    type: service
    service: avahi-daemon
    state: stopped
    enabled: false

  - name: disable-cups
    type: service
    service: cups
    state: stopped
    enabled: false

  - name: disable-bluetooth
    type: service
    service: bluetooth
    state: stopped
    enabled: false

  # CM-7: Remove unnecessary packages
  - name: remove-avahi
    type: package
    package: avahi-daemon
    state: absent

  - name: remove-cups
    type: package
    package: cups
    state: absent

  # CM-6: Configuration enforcement — kernel hardening
  - name: kernel-hardening
    type: file
    state: present
    target_path: /etc/sysctl.d/99-nist-hardening.conf
    content: |
      # Disable IP forwarding
      net.ipv4.ip_forward = 0
      # Disable source routing
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      # Enable reverse path filtering
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      # Ignore ICMP redirects
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      # Log suspicious packets
      net.ipv4.conf.all.log_martians = 1
      # Ignore broadcast pings
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      # ASLR
      kernel.randomize_va_space = 2
      # Restrict core dumps
      fs.suid_dumpable = 0
      # Restrict kernel pointers
      kernel.kptr_restrict = 2
    owner: root
    group: root
    mode: "0644"
    notify: [apply-sysctl]

  - name: apply-sysctl
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: sysctl --system
    onlyif: "test -f /etc/sysctl.d/99-nist-hardening.conf"
    when: "changed"

  # CM-11: User-installed software restrictions
  - name: restrict-package-install
    type: file
    state: present
    target_path: /etc/apt/apt.conf.d/99restrict
    content: |
      APT::Get::AllowUnauthenticated "false";
    owner: root
    group: root
    mode: "0644"
