name: nist-access-control
compliance:
  bundle: [nist-access-control]
resources:
  # AC-6: Least privilege — restrict su to wheel group
  - name: restrict-su
    type: file
    state: present
    target_path: /etc/pam.d/su
    content: |
      auth required pam_wheel.so use_uid
      auth sufficient pam_rootok.so
      auth required pam_unix.so
    owner: root
    group: root
    mode: "0644"

  # AC-2: Remove inactive accounts after 30 days
  - name: inactive-account-lock
    type: exec
    command: useradd -D -f 30
    onlyif: "! useradd -D | grep -q 'INACTIVE=30'"

  # AC-3: Enforce permission bits on sensitive dirs — daily cron.
  - name: home-dir-permissions
    type: cron
    state: present
    user: root
    name: nist-home-dir-permissions
    command: "find /home -maxdepth 1 -mindepth 1 -type d -perm /g+w,o+rwx -exec chmod 750 {} +"
    schedule: "15 2 * * *"

  # AC-11: Session lock on idle
  - name: vlock-package
    type: package
    package: vlock
    state: present

  # AC-7: Unsuccessful login attempts — pam_faillock
  - name: faillock-common-auth
    type: exec
    command: pam-auth-update --enable faillock
    onlyif: "! grep -q pam_faillock /etc/pam.d/common-auth"

  # AC-12: Session termination
  - name: sshd-session-timeout
    type: file
    state: present
    target_path: /etc/ssh/sshd_config.d/90-nist-session.conf
    content: |
      ClientAliveInterval 300
      ClientAliveCountMax 2
    owner: root
    group: root
    mode: "0644"
    notify: [restart-sshd-debian, restart-sshd-redhat]

  - name: restart-sshd-debian
    type: service
    service: ssh
    state: restarted
    when: "changed && os_family('debian')"

  - name: restart-sshd-redhat
    type: service
    service: sshd
    state: restarted
    when: "changed && !os_family('debian')"
