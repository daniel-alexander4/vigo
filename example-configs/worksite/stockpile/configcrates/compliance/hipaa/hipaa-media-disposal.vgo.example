name: hipaa-media-disposal
compliance:
  bundle: [hipaa-media-disposal]
resources:
  - name: secure-delete
    type: package
    package: secure-delete
    state: present

  - name: nwipe
    type: package
    package: nwipe
    state: present

  - name: shred-available
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "which shred"
    onlyif: "! which shred"

  - name: tmp-cleanup-cron
    type: cron
    state: present
    command: "find /tmp -type f -mtime +7 -exec shred -u {} \\; 2>/dev/null"
    schedule: "0 2 * * *"
    hour: "2"
    minute: "30"
    user: root
