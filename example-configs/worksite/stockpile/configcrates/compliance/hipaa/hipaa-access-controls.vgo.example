name: hipaa-access-controls
compliance:
  bundle: [hipaa-access-controls]
resources:
  - name: libpam-pwquality
    type: package
    package: libpam-pwquality
    state: present

  # Password complexity
  - name: pwquality-config
    type: file
    target_path: /etc/security/pwquality.conf
    content: |
      minlen = 14
      dcredit = -1
      ucredit = -1
      lcredit = -1
      ocredit = -1
      maxrepeat = 3
      maxclassrepeat = 4
      gecoscheck = 1
      dictcheck = 1
    owner: root
    group: root
    mode: "0644"

  # Account lockout after 5 failed attempts
  - name: faillock-config
    type: file
    target_path: /etc/security/faillock.conf
    content: |
      deny = 5
      unlock_time = 900
      fail_interval = 900
      audit
      even_deny_root
      root_unlock_time = 60
    owner: root
    group: root
    mode: "0644"

  # Session timeout
  - name: session-timeout
    type: file
    target_path: /etc/profile.d/hipaa-timeout.sh
    content: |
      readonly TMOUT=900
      export TMOUT
    owner: root
    group: root
    mode: "0644"

  # Disable root login via SSH
  - name: no-root-ssh
    type: file
    target_path: /etc/ssh/sshd_config.d/90-hipaa-access.conf
    content: |
      PermitRootLogin no
      MaxAuthTries 4
      LoginGraceTime 60
      ClientAliveInterval 300
      ClientAliveCountMax 3
    owner: root
    group: root
    mode: "0644"
    notify: [restart-sshd-debian, restart-sshd-redhat]

  - name: restart-sshd-debian
    type: service
    service: ssh
    state: restarted
    when: "changed && os_family('debian')"

  - name: restart-sshd-redhat
    type: service
    service: sshd
    state: restarted
    when: "changed && !os_family('debian')"
