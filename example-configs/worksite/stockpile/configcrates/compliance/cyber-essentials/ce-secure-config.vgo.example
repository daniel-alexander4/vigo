name: ce-secure-config
compliance:
  bundle: [ce-secure-config]
resources:
  # Remove unnecessary packages
  - name: remove-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-rsh-client
    type: package
    package: rsh-client
    state: absent

  - name: remove-talk
    type: package
    package: talk
    state: absent

  # Disable unnecessary accounts
  - name: disable-guest-account
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: usermod -L guest
    onlyif: "getent passwd guest && ! passwd -S guest | grep -q L"

  # Disable USB autorun
  - name: disable-usb-storage
    type: file
    state: present
    target_path: /etc/modprobe.d/usb-storage.conf
    content: "install usb-storage /bin/true\nblacklist usb-storage\n"
    owner: root
    group: root
    mode: "0644"

  # Screen lock timeout (15 minutes)
  - name: tmout-profile
    type: file
    state: present
    target_path: /etc/profile.d/tmout.sh
    content: |
      readonly TMOUT=900
      export TMOUT
    owner: root
    group: root
    mode: "0644"

  # Login banner
  - name: login-banner
    type: file
    state: present
    target_path: /etc/issue.net
    content: |
      Authorized users only. All activity is monitored and recorded.
      Unauthorized access is prohibited and will be prosecuted.
    owner: root
    group: root
    mode: "0644"
