name: ce-monitoring
compliance:
  bundle: [ce-monitoring]
resources:
  - name: ossec-hids
    type: package
    package: ossec-hids
    state: present

  - name: ossec-service
    type: service
    service: ossec
    state: running
    enabled: true

  - name: syslog-anomaly-detection
    type: cron
    state: present
    command: "grep -iE 'failed|error|denied|unauthorized' /var/log/auth.log | tail -50 | logger -t anomaly-detect -p local0.warning"
    schedule: "0 2 * * *"
    minute: "*/15"
    user: root

  - name: process-monitoring
    type: cron
    state: present
    command: "ps aux --sort=-%cpu | head -20 | logger -t proc-monitor"
    schedule: "0 2 * * *"
    minute: "*/30"
    user: root
