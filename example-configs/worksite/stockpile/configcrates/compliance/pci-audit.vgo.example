# PCI DSS v4.0 Audit Logging Module
# Enforces: Req 10.2.1 (audit logs enabled), 10.2.2 (log fields),
#           10.3.1 (log protection), 10.6.1 (time sync)
#
# Extends the base auditd module with PCI-specific audit rules that monitor
# access to cardholder data environments and administrative actions.

name: pci-audit

compliance:
  bundle: [pci-audit]
vars:
  cde_data_dir: "/var/data/cardholder"

resources:
  - name: install-auditd
    type: package
    package: auditd
    state: present

  - name: pci-audit-rules
    type: file
    state: present
    target_path: /etc/audit/rules.d/pci-dss.rules
    content: |
      # PCI DSS v4.0 Audit Rules — managed by Vigo

      # ── Req 10.2.1.1 — User access to cardholder data ──
      -w {{ .Vars.cde_data_dir }} -p rwxa -k cardholder-access

      # ── Req 10.2.1.2 — Administrative actions ──
      -w /etc/sudoers -p wa -k admin-actions
      -w /etc/sudoers.d/ -p wa -k admin-actions
      -a always,exit -F arch=b64 -S execve -F euid=0 -k admin-commands

      # ── Req 10.2.1.3 — Access to audit trails ──
      -w /var/log/audit/ -p wa -k audit-trail-access
      -w /etc/audit/ -p wa -k audit-config

      # ── Req 10.2.1.4 — Invalid logical access attempts ──
      -a always,exit -F arch=b64 -S open -S openat -F exit=-EACCES -k access-denied
      -a always,exit -F arch=b64 -S open -S openat -F exit=-EPERM -k access-denied

      # ── Req 10.2.1.5 — Identity/authentication changes ──
      -w /etc/passwd -p wa -k identity-change
      -w /etc/shadow -p wa -k identity-change
      -w /etc/group -p wa -k identity-change
      -w /etc/pam.d/ -p wa -k auth-config

      # ── Req 10.2.1.7 — Creation/deletion of system objects ──
      -a always,exit -F arch=b64 -S creat -S mkdir -S rmdir -S unlink -S rename -k file-operations

      # ── Make rules immutable (require reboot to change) ──
      -e 2
    owner: root
    group: root
    mode: "0640"
    depends_on: [install-auditd]
    notify: [restart-auditd]

  - name: audit-log-permissions
    type: directory
    state: present
    target_path: /var/log/audit
    owner: root
    group: root
    mode: "0700"
    depends_on: [install-auditd]

  - name: restart-auditd
    type: exec
    command: "service auditd restart"
    onlyif: "systemctl is-active auditd"
    depends_on: [pci-audit-rules]
