name: mifid2-capacity
# MiFID II RTS 7 — Capacity Monitoring
# Status: MONITORED by Vigo (requires external validation)
# Vigo collects and reports capacity traits (CPU, memory, disk, network).
# Actual load/stress testing to prove peak capacity handling requires
# external tools. Kill switch functionality requires dedicated trading
# platform integration — Vigo can verify the kill switch is installed
# and configured but cannot be the kill switch itself.

compliance:
  bundle: [mifid2-capacity]
vars:
  disk_alert_threshold: 85

resources:
  - name: disk-space-check
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: "df --output=pcent / | tail -1 | tr -d ' %' | awk '{if($1 > {{ .Vars.disk_alert_threshold }}) exit 1}'"
    onlyif: "which df"

  - name: kill-switch-installed
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: "test -x /usr/local/bin/trading-killswitch && echo 'kill switch binary present'"
    onlyif: "test -f /usr/local/bin/trading-killswitch"
