name: cis-rhel-access
# CIS Red Hat Enterprise Linux Benchmark — Section 5: Access, Authentication, Authorization
# Level 1 + Level 2 controls
# Applies to: RHEL 8/9, CentOS Stream 8/9, Rocky Linux 8/9, AlmaLinux 8/9

compliance:
  bundle: [cis-rhel-access]
vars:
  ssh_port: "22"
  max_auth_tries: "4"
  client_alive_interval: "300"
  client_alive_count_max: "3"
  login_grace_time: "60"
  pass_max_days: "365"
  pass_min_days: "1"
  pass_warn_age: "7"
  pass_min_len: "14"
  shell_timeout: "900"

resources:
  # --- 5.1: Cron ---

  - name: 5.1.1-crond-enabled
    type: service
    service: crond
    state: running
    enabled: true

  - name: 5.1.2-crontab-permissions
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chown root:root /etc/crontab && chmod 0600 /etc/crontab
    onlyif: "! stat -c '%a %U:%G' /etc/crontab | grep -q '600 root:root'"

  - name: 5.1.3-cron-hourly
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chown root:root /etc/cron.hourly && chmod 0700 /etc/cron.hourly
    onlyif: "test -d /etc/cron.hourly && ! stat -c '%a %U:%G' /etc/cron.hourly | grep -q '700 root:root'"

  - name: 5.1.4-cron-daily
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chown root:root /etc/cron.daily && chmod 0700 /etc/cron.daily
    onlyif: "test -d /etc/cron.daily && ! stat -c '%a %U:%G' /etc/cron.daily | grep -q '700 root:root'"

  - name: 5.1.5-cron-weekly
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chown root:root /etc/cron.weekly && chmod 0700 /etc/cron.weekly
    onlyif: "test -d /etc/cron.weekly && ! stat -c '%a %U:%G' /etc/cron.weekly | grep -q '700 root:root'"

  - name: 5.1.6-cron-monthly
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chown root:root /etc/cron.monthly && chmod 0700 /etc/cron.monthly
    onlyif: "test -d /etc/cron.monthly && ! stat -c '%a %U:%G' /etc/cron.monthly | grep -q '700 root:root'"

  - name: 5.1.7-cron-d
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chown root:root /etc/cron.d && chmod 0700 /etc/cron.d
    onlyif: "test -d /etc/cron.d && ! stat -c '%a %U:%G' /etc/cron.d | grep -q '700 root:root'"

  - name: 5.1.8-cron-restrict
    type: file
    state: present
    target_path: /etc/cron.allow
    content: |
      root
    owner: root
    group: root
    mode: "0640"

  # --- 5.2: SSH server ---

  - name: 5.2.1-sshd-perms
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: chmod 0600 /etc/ssh/sshd_config && chown root:root /etc/ssh/sshd_config
    onlyif: "! stat -c '%a %U:%G' /etc/ssh/sshd_config | grep -q '600 root:root'"

  - name: 5.2-sshd-hardening
    type: file
    state: present
    target_path: /etc/ssh/sshd_config.d/90-cis-rhel.conf
    content: |
      # CIS 5.2.4 — SSH Protocol
      Protocol 2

      # CIS 5.2.5 — LogLevel
      LogLevel VERBOSE

      # CIS 5.2.6 — X11 forwarding
      X11Forwarding no

      # CIS 5.2.7 — MaxAuthTries
      MaxAuthTries {{ .Vars.max_auth_tries }}

      # CIS 5.2.8 — IgnoreRhosts
      IgnoreRhosts yes

      # CIS 5.2.9 — Disable HostbasedAuthentication
      HostbasedAuthentication no

      # CIS 5.2.10 — No root login
      PermitRootLogin no

      # CIS 5.2.11 — No empty passwords
      PermitEmptyPasswords no

      # CIS 5.2.12 — No user environment
      PermitUserEnvironment no

      # CIS 5.2.13 — Strong ciphers
      Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr,aes128-gcm@openssh.com

      # CIS 5.2.14 — Strong MACs
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256

      # CIS 5.2.15 — Strong KEX
      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512

      # CIS 5.2.16 — ClientAliveInterval
      ClientAliveInterval {{ .Vars.client_alive_interval }}
      ClientAliveCountMax {{ .Vars.client_alive_count_max }}

      # CIS 5.2.17 — LoginGraceTime
      LoginGraceTime {{ .Vars.login_grace_time }}

      # CIS 5.2.18 — Banner
      Banner /etc/issue.net

      # CIS 5.2.19 — UsePAM
      UsePAM yes

      # CIS 5.2.20 — AllowTcpForwarding
      AllowTcpForwarding no

      # Port
      Port {{ .Vars.ssh_port }}
    owner: root
    group: root
    mode: "0644"
    notify: [restart-sshd]

  - name: 5.2-ssh-banner
    type: file
    state: present
    target_path: /etc/issue.net
    content: |
      Authorized uses only. All activity may be monitored and reported.
    owner: root
    group: root
    mode: "0644"

  - name: restart-sshd
    type: service
    service: sshd
    state: restarted
    when: "changed"

  # --- 5.3: PAM / authselect ---

  - name: 5.3.1-authselect-profile
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: authselect select sssd with-faillock with-mkhomedir --force
    onlyif: "! authselect current 2>/dev/null | grep -q 'sssd'"

  - name: 5.3.2-pwquality-config
    type: file
    state: present
    target_path: /etc/security/pwquality.conf
    content: |
      # CIS 5.3.2 — Password quality (RHEL)
      minlen = {{ .Vars.pass_min_len }}
      minclass = 4
      dcredit = -1
      ucredit = -1
      ocredit = -1
      lcredit = -1
      maxrepeat = 3
    owner: root
    group: root
    mode: "0644"

  - name: 5.3.3-faillock-config
    type: file
    state: present
    target_path: /etc/security/faillock.conf
    content: |
      # CIS 5.3.3 — Account lockout
      deny = 5
      unlock_time = 900
      fail_interval = 900
    owner: root
    group: root
    mode: "0644"

  - name: 5.3.4-password-history
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: |
      if ! grep -q "remember=" /etc/pam.d/system-auth; then
        sed -i '/pam_unix.so/ s/$/ remember=5/' /etc/pam.d/system-auth
      fi
    onlyif: "! grep -q 'remember=' /etc/pam.d/system-auth"

  # --- 5.4: SELinux ---

  - name: 5.4.1-selinux-enforcing
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: "setenforce 0"
    command: setenforce 1
    onlyif: "getenforce | grep -qi permissive"

  - name: 5.4.2-selinux-config
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
    onlyif: "! grep -q '^SELINUX=enforcing' /etc/selinux/config"

  - name: 5.4.3-selinux-policy
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: sed -i 's/^SELINUXTYPE=.*/SELINUXTYPE=targeted/' /etc/selinux/config
    onlyif: "! grep -q '^SELINUXTYPE=targeted' /etc/selinux/config"

  # --- 5.5: User settings ---

  - name: 5.5.1-password-aging
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: |
      sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS\t{{ .Vars.pass_max_days }}/' /etc/login.defs
      sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS\t{{ .Vars.pass_min_days }}/' /etc/login.defs
      sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE\t{{ .Vars.pass_warn_age }}/' /etc/login.defs
    onlyif: "! grep -q '^PASS_MAX_DAYS.*{{ .Vars.pass_max_days }}' /etc/login.defs"

  - name: 5.5.2-system-accounts-locked
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: |
      for user in $(awk -F: '($3 < 1000 && $1 != "root") {print $1}' /etc/passwd); do
        usermod -L -s /usr/sbin/nologin "$user" 2>/dev/null || true
      done
    onlyif: "awk -F: '($3 < 1000 && $1 != \"root\" && $7 != \"/usr/sbin/nologin\" && $7 != \"/sbin/nologin\" && $7 != \"/bin/false\") {found=1} END {exit !found}' /etc/passwd"

  - name: 5.5.3-root-default-group
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: usermod -g 0 root
    onlyif: "! id -g root | grep -q '^0$'"

  - name: 5.5.4-default-umask
    type: file
    state: present
    target_path: /etc/profile.d/cis-umask.sh
    content: |
      umask 027
    owner: root
    group: root
    mode: "0644"

  - name: 5.5.5-shell-timeout
    type: file
    state: present
    target_path: /etc/profile.d/cis-tmout.sh
    content: |
      readonly TMOUT={{ .Vars.shell_timeout }}
      export TMOUT
    owner: root
    group: root
    mode: "0644"
