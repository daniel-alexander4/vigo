name: hitrust-endpoint-protection
compliance:
  bundle: [hitrust-endpoint-protection]
resources:
  # 09.j: Controls against malicious code
  - name: clamav
    type: package
    package: clamav
    state: present

  - name: clamav-daemon
    type: package
    package: clamav-daemon
    state: present

  - name: clamav-service
    type: service
    service: clamav-daemon
    state: running
    enabled: true

  - name: freshclam-service
    type: service
    service: clamav-freshclam
    state: running
    enabled: true

  # 09.k: Controls against mobile code — disable unnecessary interpreters
  - name: restrict-perl
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: chmod 0750 /usr/bin/perl
    onlyif: "test -f /usr/bin/perl && stat -c '%a' /usr/bin/perl | grep -q 755"

  - name: restrict-python
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: chmod 0750 /usr/bin/python3
    onlyif: "test -f /usr/bin/python3 && stat -c '%a' /usr/bin/python3 | grep -q 755"

  # 01.m: Segregation in networks
  - name: network-segmentation-sysctl
    type: file
    state: present
    target_path: /etc/sysctl.d/99-hitrust-network.conf
    content: |
      net.ipv4.ip_forward = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
    owner: root
    group: root
    mode: "0644"
    notify: [apply-sysctl]

  - name: apply-sysctl
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: sysctl --system
    onlyif: "test -f /etc/sysctl.d/99-hitrust-network.conf"
    when: "changed"
