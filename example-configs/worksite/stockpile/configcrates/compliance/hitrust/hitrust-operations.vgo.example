name: hitrust-operations
compliance:
  bundle: [hitrust-operations]
resources:
  # 09.aa: Audit logging
  - name: auditd-package
    type: package
    package: auditd
    state: present

  - name: auditd-service
    type: service
    service: auditd
    state: running
    enabled: true

  - name: hitrust-audit-rules
    type: file
    state: present
    target_path: /etc/audit/rules.d/hitrust.rules
    content: |
      # Login/logout events
      -w /var/log/lastlog -p wa -k login-events
      -w /var/log/faillog -p wa -k login-events
      -w /var/log/wtmp -p wa -k session-events
      -w /var/log/btmp -p wa -k failed-login

      # Privilege use
      -a always,exit -F arch=b64 -S setuid -S setgid -k privilege-use
      -w /etc/sudoers -p wa -k sudoers-edit
      -w /etc/sudoers.d/ -p wa -k sudoers-edit

      # File system mounts
      -a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=4294967295 -k mounts

      # File deletion
      -a always,exit -F arch=b64 -S unlink -S rename -F auid>=1000 -F auid!=4294967295 -k file-delete
    owner: root
    group: root
    mode: "0640"
    notify: [reload-auditd]

  - name: reload-auditd
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: augenrules --load
    onlyif: "test -f /etc/audit/rules.d/hitrust.rules"
    when: "changed"

  # 09.ab: Monitoring system use
  - name: psacct-package
    type: package
    package: acct
    state: present

  - name: psacct-service
    type: service
    service: acct
    state: running
    enabled: true

  # 10.h: Technical vulnerability management
  - name: apt-listchanges
    type: package
    package: apt-listchanges
    state: present

  - name: needrestart
    type: package
    package: needrestart
    state: present
