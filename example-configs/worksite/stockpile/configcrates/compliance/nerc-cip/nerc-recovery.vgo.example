name: nerc-recovery
compliance:
  bundle: [nerc-recovery]
resources:
  # CIP-009 R1/R2: Recovery plan — backup infrastructure
  - name: rsync-package
    type: package
    package: rsync
    state: present

  - name: backup-directory
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: mkdir -p /var/backups/nerc && chmod 0700 /var/backups/nerc
    onlyif: "! test -d /var/backups/nerc"

  - name: daily-config-backup
    type: cron
    state: present
    command: "tar czf /var/backups/nerc/config-$(date +\\%Y\\%m\\%d).tar.gz /etc/ 2>/dev/null && find /var/backups/nerc -name 'config-*.tar.gz' -mtime +90 -delete"
    schedule: "0 1 * * *"
    hour: "1"
    minute: "0"
    user: root

  - name: daily-baseline-backup
    type: cron
    state: present
    command: "dpkg --get-selections > /var/backups/nerc/packages-$(date +\\%Y\\%m\\%d).list 2>/dev/null"
    schedule: "15 1 * * *"
    hour: "1"
    minute: "15"
    user: root

  # CIP-010 R1: Configuration change management — baseline tracking
  - name: etckeeper-package
    type: package
    package: etckeeper
    state: present

  - name: etckeeper-init
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: etckeeper init
    onlyif: "! test -d /etc/.git"

  # CIP-010 R2: Configuration monitoring
  - name: aide-package
    type: package
    package: aide
    state: present

  - name: aide-daily-check
    type: cron
    state: present
    command: "/usr/bin/aide --check 2>&1 | logger -t nerc-aide"
    schedule: "0 5 * * *"
    hour: "5"
    minute: "0"
    user: root
