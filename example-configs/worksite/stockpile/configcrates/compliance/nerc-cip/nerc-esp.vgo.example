name: nerc-esp
compliance:
  bundle: [nerc-esp]
resources:
  # CIP-005 R1: Electronic Security Perimeter
  - name: nftables-package
    type: package
    package: nftables
    state: present

  - name: esp-firewall-rules
    type: file
    state: present
    target_path: /etc/nftables.conf
    content: |
      #!/usr/sbin/nft -f
      flush ruleset

      table inet esp {
        chain input {
          type filter hook input priority 0; policy drop;

          # Allow established connections
          ct state established,related accept

          # Loopback
          iif lo accept

          # Management access (restrict to management VLAN)
          tcp dport 22 ip saddr 10.100.0.0/24 accept

          # SCADA/EMS traffic (restrict to control network)
          tcp dport { 502, 2404 } ip saddr 10.200.0.0/24 accept

          # Logging
          log prefix "ESP-DROPPED: " limit rate 5/minute
        }
        chain forward {
          type filter hook forward priority 0; policy drop;
        }
        chain output {
          type filter hook output priority 0; policy accept;
        }
      }
    owner: root
    group: root
    mode: "0600"
    notify: [reload-nftables]

  - name: nftables-enabled
    type: service
    service: nftables
    state: running
    enabled: true

  - name: reload-nftables
    type: exec
    command: nft -f /etc/nftables.conf
    onlyif: "test -f /etc/nftables.conf"
    when: "changed"

  # CIP-007 R1: Disable unnecessary ports and services
  - name: disable-nfs
    type: service
    service: nfs-server
    state: stopped
    enabled: false

  - name: disable-rpcbind
    type: service
    service: rpcbind
    state: stopped
    enabled: false

  # CIP-005 R2: Remote access — SSH hardening
  - name: ssh-nerc-config
    type: file
    state: present
    target_path: /etc/ssh/sshd_config.d/90-nerc-esp.conf
    content: |
      AllowUsers admin@10.100.0.*
      PermitRootLogin no
      MaxAuthTries 3
      MaxSessions 2
      ClientAliveInterval 300
      ClientAliveCountMax 2
      Banner /etc/issue.net
    owner: root
    group: root
    mode: "0644"
    notify: [restart-sshd-debian, restart-sshd-redhat]

  - name: restart-sshd-debian
    type: service
    service: ssh
    state: restarted
    when: "changed && os_family('debian')"

  - name: restart-sshd-redhat
    type: service
    service: sshd
    state: restarted
    when: "changed && !os_family('debian')"
