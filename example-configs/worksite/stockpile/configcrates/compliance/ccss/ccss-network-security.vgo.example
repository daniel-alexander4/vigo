name: ccss-network-security
# CCSS Aspect 3 — Key Usage / Network Security
# Status: ENFORCED by Vigo
# Enforces network segmentation, SSH hardening, and firewall rules
# on signing servers and hot wallet infrastructure.

compliance:
  bundle: [ccss-network-security]
resources:
  - name: ssh-key-only
    type: file_line
    state: present
    target_path: /etc/ssh/sshd_config
    line: "PasswordAuthentication no"
    match_pattern: "^#?PasswordAuthentication"

  - name: ssh-no-root
    type: file_line
    state: present
    target_path: /etc/ssh/sshd_config
    line: "PermitRootLogin no"
    match_pattern: "^#?PermitRootLogin"

  - name: firewall-default-deny
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: ""  # no safe automatic inverse — supply manually
    command: "iptables -P INPUT DROP"
    onlyif: "iptables -L INPUT | head -1 | grep -q ACCEPT"

  - name: firewall-allow-ssh
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: "iptables -D INPUT -p tcp --dport 22 -j ACCEPT"
    command: "iptables -A INPUT -p tcp --dport 22 -j ACCEPT"
    unless: "iptables -L INPUT -n | grep -q 'tcp dpt:22'"
