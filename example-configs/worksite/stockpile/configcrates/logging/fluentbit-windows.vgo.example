#~ Fluent Bit on Windows. Native MSI via chocolatey; reads Windows event
#~ log + tails configured paths and forwards to the same downstream.
name: fluentbit-windows

compliance:
  provides: [log-processing-pci]
vars:
  forward_host: "loki.example.com"
  forward_port: "3100"

resources:
  - name: install-fluentbit
    type: package
    package: fluent-bit
    state: present
    when: "os_family('windows')"

  - name: fluentbit-conf
    type: file
    state: present
    target_path: "C:\\Program Files\\fluent-bit\\conf\\fluent-bit.conf"
    owner: SYSTEM
    group: Administrators
    mode: "0644"
    content: |
      [SERVICE]
        Daemon Off
        Log_Level info

      [INPUT]
        Name winlog
        Channels Application,System,Security
        Interval_Sec 5

      [OUTPUT]
        Name loki
        Match *
        Host {{ .Vars.forward_host }}
        Port {{ .Vars.forward_port }}
        Labels host=$HOSTNAME,job=fluentbit
    when: "os_family('windows')"

  - name: fluentbit-service
    type: service
    service: "fluent-bit"
    enabled: true
    state: running
    subscribes: [fluentbit-conf]
    when: "os_family('windows')"
