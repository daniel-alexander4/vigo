name: lvm

vars:
  lvm_disk: "/dev/sdb"
  vg_name: "data_vg"
  lv_name: "data_lv"
  lv_size: "100%FREE"
  fs_type: "ext4"
  mount_point: "/data"

resources:
  - name: install-lvm
    type: package
    package: lvm2
    state: present

  # --- Physical volume ---

  - name: create-pv
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "pvcreate /dev/sdb"
    onlyif: "! pvs /dev/sdb 2>/dev/null | grep -q /dev/sdb"
    depends_on: [install-lvm]

  # --- Volume group ---

  - name: create-vg
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "vgcreate data_vg /dev/sdb"
    onlyif: "! vgs data_vg 2>/dev/null | grep -q data_vg"
    depends_on: [create-pv]

  # --- Logical volume ---

  - name: create-lv
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "lvcreate -l 100%FREE -n data_lv data_vg"
    onlyif: "! lvs data_vg/data_lv 2>/dev/null"
    depends_on: [create-vg]

  # --- Filesystem ---

  - name: format-lv
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "mkfs.ext4 /dev/data_vg/data_lv"
    onlyif: "! blkid /dev/data_vg/data_lv 2>/dev/null | grep -q ext4"
    depends_on: [create-lv]

  # --- Mount ---

  - name: mount-dir
    type: directory
    state: present
    target_path: /data
    owner: root
    group: root
    mode: "0755"

  - name: mount-lv
    type: mount
    path: /data
    device: /dev/data_vg/data_lv
    fstype: ext4
    options: "defaults,noatime"
    state: mounted
    depends_on: [format-lv, mount-dir]
