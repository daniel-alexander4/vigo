#~ Encrypted, deduplicated backup with Restic on Windows. Cross-platform
#~ companion to the restic.vgo.example Linux module. Installs via
#~ chocolatey (preferred) or downloads the Windows binary directly.
#~ Uses a scheduled task instead of cron.
#~
#~ Source paths and retention vars match the Linux module shape so
#~ operators can keep one set of vars across the fleet.
name: restic-windows

compliance:
  provides: [host-backup-encrypted]
vars:
  source_paths: "C:\\Users C:\\ProgramData"
  schedule_hour: "*"
  schedule_minute: "0"
  retain_hourly: "7"
  retain_daily: "30"
  retain_weekly: "26"
  retain_monthly: "12"
  restic_password: "secret:vigo/backup/restic_password"
  restic_repo: "secret:vigo/backup/restic_repo"

resources:
  - name: install-restic
    type: package
    package: restic
    state: present
    when: "os_family('windows')"

  - name: restic-config
    type: file
    state: present
    target_path: "C:\\ProgramData\\Vigo\\restic\\restic.env"
    owner: SYSTEM
    group: Administrators
    mode: "0600"
    content: |
      RESTIC_PASSWORD={{ .Vars.restic_password }}
      RESTIC_REPOSITORY={{ .Vars.restic_repo }}
    when: "os_family('windows')"

  - name: restic-backup-script
    type: file
    state: present
    target_path: "C:\\ProgramData\\Vigo\\restic\\restic-backup.ps1"
    owner: SYSTEM
    group: Administrators
    mode: "0750"
    content: |
      # Auto-generated by restic-windows module.
      $envFile = "C:\ProgramData\Vigo\restic\restic.env"
      Get-Content $envFile | ForEach-Object {
        if ($_ -match '^([^=]+)=(.*)$') {
          [System.Environment]::SetEnvironmentVariable($Matches[1], $Matches[2])
        }
      }
      restic snapshots > $null 2>&1
      if ($LASTEXITCODE -ne 0) { restic init }
      restic backup {{ .Vars.source_paths }} --tag scheduled --quiet
      restic forget `
        --keep-hourly  {{ .Vars.retain_hourly }} `
        --keep-daily   {{ .Vars.retain_daily }} `
        --keep-weekly  {{ .Vars.retain_weekly }} `
        --keep-monthly {{ .Vars.retain_monthly }} `
        --prune --quiet
    when: "os_family('windows')"

  - name: restic-scheduled-task
    type: powershell
    command: >-
      Register-ScheduledTask -TaskName 'VigoResticBackup' -Force
      -Action (New-ScheduledTaskAction -Execute 'powershell.exe'
        -Argument '-NoProfile -File C:\ProgramData\Vigo\restic\restic-backup.ps1')
      -Trigger (New-ScheduledTaskTrigger -Daily -At 03:00)
      -RunLevel Highest -User SYSTEM
    skip_validation: true
    when: "os_family('windows')"
