#~ AIDE — Advanced Intrusion Detection Environment. File-integrity
#~ monitoring; initializes the database on first run and emails diffs
#~ via daily cron.
name: aide

compliance:
  provides: [file-integrity]
resources:
  - name: install-aide
    type: package
    package: aide
    state: present
    when: "os_family('linux')"

  - name: aide-init
    type: exec
    # reversible — declare `on_revert: "<undo command>"` and set `revert: true` to undo this action
    command: "aideinit && mv /var/lib/aide/aide.db.new /var/lib/aide/aide.db"
    unless: "test -f /var/lib/aide/aide.db"
    depends_on: [install-aide]
    when: "os_family('linux')"

  - name: aide-cron
    type: cron
    state: present
    user: root
    name: aide-check
    command: "aide --check"
    schedule: "30 5 * * *"
    depends_on: [aide-init]
    when: "os_family('linux')"
