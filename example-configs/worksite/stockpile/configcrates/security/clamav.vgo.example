#~ ClamAV antivirus daemon + freshclam updater. Detects on-demand and
#~ via clamonacc real-time scanning (requires kernel fanotify).
name: clamav

compliance:
  provides: [anti-malware]
resources:
  - name: install-clamav
    type: package
    package: clamav
    state: present
    when: "os_family('linux')"

  - name: install-clamav-daemon
    type: package
    package: clamav-daemon
    state: present
    when: "os_family('linux')"

  - name: install-clamav-freshclam
    type: package
    package: clamav-freshclam
    state: present
    when: "os_family('linux')"

  - name: freshclam-service
    type: service
    service: clamav-freshclam
    enabled: true
    state: running
    depends_on: [install-clamav-freshclam]
    when: "os_family('linux')"

  - name: clamav-daemon-service
    type: service
    service: clamav-daemon
    enabled: true
    state: running
    depends_on: [install-clamav-daemon]
    when: "os_family('linux')"
