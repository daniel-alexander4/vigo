#~ WireGuard VPN — minimal point-to-point config. Reads private key
#~ and peer public key from the secret vault.
name: wireguard

compliance:
  provides: [vpn]
vars:
  wg_address: "10.99.0.1/24"
  wg_listen_port: "51820"
  wg_private_key: "secret:vigo/wireguard/private_key"
  wg_peer_pubkey: "secret:vigo/wireguard/peer_pubkey"
  wg_peer_endpoint: "vpn.example.com:51820"
  wg_peer_allowed_ips: "10.99.0.2/32"

resources:
  - name: install-wireguard
    type: package
    package: wireguard
    state: present
    when: "os_family('linux')"

  - name: wg0-conf
    type: file
    state: present
    target_path: "/etc/wireguard/wg0.conf"
    owner: root
    group: root
    mode: "0600"
    content: |
      [Interface]
      Address = {{ .Vars.wg_address }}
      ListenPort = {{ .Vars.wg_listen_port }}
      PrivateKey = {{ .Vars.wg_private_key }}

      [Peer]
      PublicKey = {{ .Vars.wg_peer_pubkey }}
      Endpoint = {{ .Vars.wg_peer_endpoint }}
      AllowedIPs = {{ .Vars.wg_peer_allowed_ips }}
      PersistentKeepalive = 25
    depends_on: [install-wireguard]
    when: "os_family('linux')"

  - name: wg0-service
    type: service
    service: "wg-quick@wg0"
    enabled: true
    state: running
    subscribes: [wg0-conf]
    when: "os_family('linux')"
