name: apache

vars:
  apache_port: "80"
  server_admin: "webmaster@localhost"
  server_name: "localhost"
  keepalive_timeout: "5"
  max_request_workers: "150"

resources:
  - name: install-apache-debian
    type: package
    package: apache2
    state: present
    when: "os_family('debian')"

  - name: install-apache-redhat
    type: package
    package: httpd
    state: present
    when: "!os_family('debian')"

  # mod_ssl is bundled on Debian; RHEL needs a separate package
  - name: install-mod-ssl
    type: package
    package: mod_ssl
    state: present
    when: "os_family('redhat')"
    depends_on: [install-apache-redhat]

  - name: enable-mod-rewrite
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: "a2dismod rewrite"
    command: a2enmod rewrite
    onlyif: "! apache2ctl -M 2>/dev/null | grep -q rewrite"
    when: "os_family('debian')"
    depends_on: [install-apache-debian]
    notify: [apache-service-debian]

  - name: enable-mod-ssl
    type: exec
    # reversible — declare 'revert: true' and `on_revert: "<undo command>"` to undo this action. Double check the below commands to ensure they are correct.
    #~ revert: false
    #~ on_revert: "a2dismod ssl"
    command: a2enmod ssl
    onlyif: "! apache2ctl -M 2>/dev/null | grep -q ssl_module"
    when: "os_family('debian')"
    depends_on: [install-apache-debian]
    notify: [apache-service-debian]

  - name: apache-conf-debian
    type: file
    state: present
    target_path: /etc/apache2/apache2.conf
    content: |
      # Managed by Vigo — do not edit manually

      ServerRoot "/etc/apache2"
      ServerAdmin {{ .Vars.server_admin }}
      ServerName {{ .Vars.server_name }}

      Listen {{ .Vars.apache_port }}

      # Timeout and keepalive
      Timeout 60
      KeepAlive On
      MaxKeepAliveRequests 100
      KeepAliveTimeout {{ .Vars.keepalive_timeout }}

      # MPM event settings
      <IfModule mpm_event_module>
          StartServers             2
          MinSpareThreads         25
          MaxSpareThreads         75
          ThreadLimit             64
          ThreadsPerChild         25
          MaxRequestWorkers       {{ .Vars.max_request_workers }}
          MaxConnectionsPerChild  0
      </IfModule>

      # MPM prefork fallback
      <IfModule mpm_prefork_module>
          StartServers             5
          MinSpareServers          5
          MaxSpareServers         10
          MaxRequestWorkers       {{ .Vars.max_request_workers }}
          MaxConnectionsPerChild  0
      </IfModule>

      # Logging
      ErrorLog "${APACHE_LOG_DIR}/error.log"
      LogLevel warn

      IncludeOptional mods-enabled/*.load
      IncludeOptional mods-enabled/*.conf
      IncludeOptional conf-enabled/*.conf
      IncludeOptional sites-enabled/*.conf
    owner: root
    group: root
    mode: "0644"
    when: "os_family('debian')"
    depends_on: [install-apache-debian]
    notify: [apache-service-debian]

  - name: apache-conf-redhat
    type: file
    state: present
    target_path: /etc/httpd/conf/httpd.conf
    content: |
      # Managed by Vigo — do not edit manually

      ServerRoot "/etc/httpd"
      ServerAdmin {{ .Vars.server_admin }}
      ServerName {{ .Vars.server_name }}

      Listen {{ .Vars.apache_port }}

      # Timeout and keepalive
      Timeout 60
      KeepAlive On
      MaxKeepAliveRequests 100
      KeepAliveTimeout {{ .Vars.keepalive_timeout }}

      # MPM event settings
      <IfModule mpm_event_module>
          StartServers             2
          MinSpareThreads         25
          MaxSpareThreads         75
          ThreadLimit             64
          ThreadsPerChild         25
          MaxRequestWorkers       {{ .Vars.max_request_workers }}
          MaxConnectionsPerChild  0
      </IfModule>

      # MPM prefork fallback
      <IfModule mpm_prefork_module>
          StartServers             5
          MinSpareServers          5
          MaxSpareServers         10
          MaxRequestWorkers       {{ .Vars.max_request_workers }}
          MaxConnectionsPerChild  0
      </IfModule>

      # Logging
      ErrorLog "logs/error_log"
      LogLevel warn

      IncludeOptional conf.d/*.conf
      IncludeOptional conf.modules.d/*.conf
    owner: root
    group: root
    mode: "0644"
    when: "!os_family('debian')"
    depends_on: [install-apache-redhat]
    notify: [apache-service-redhat]

  - name: apache-logrotate-debian
    type: logrotate
    state: present
    path: /var/log/apache2/*.log
    frequency: daily
    rotate: "14"
    compress: "true"
    missingok: "true"
    notifempty: "true"
    create: "0640 root adm"
    postrotate: "/usr/sbin/apachectl graceful > /dev/null 2>&1 || true"
    when: "os_family('debian')"
    depends_on: [install-apache-debian]

  - name: apache-logrotate-redhat
    type: logrotate
    state: present
    path: /var/log/httpd/*log
    frequency: daily
    rotate: "14"
    compress: "true"
    missingok: "true"
    notifempty: "true"
    create: "0640 root adm"
    postrotate: "/bin/systemctl reload httpd.service > /dev/null 2>&1 || true"
    when: "!os_family('debian')"
    depends_on: [install-apache-redhat]

  - name: apache-service-debian
    type: service
    service: apache2
    enabled: true
    state: running
    when: "os_family('debian')"
    depends_on: [apache-conf-debian]

  - name: apache-service-redhat
    type: service
    service: httpd
    enabled: true
    state: running
    when: "!os_family('debian')"
    depends_on: [apache-conf-redhat]
