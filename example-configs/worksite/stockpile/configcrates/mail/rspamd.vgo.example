#~ rspamd — spam filtering daemon. Composes with postfix via the milter
#~ interface. This module installs the package + redis backend + base
#~ config; operators tune scores via /etc/rspamd/local.d/.
name: rspamd

compliance:
  provides: [email-anti-malware]
resources:
  - name: install-rspamd
    type: package
    package: rspamd
    state: present
    when: "os_family('linux')"

  - name: install-redis
    type: package
    package: redis-server
    state: present
    when: "os_family('linux')"

  - name: rspamd-worker-proxy
    type: file
    target_path: "/etc/rspamd/local.d/worker-proxy.inc"
    owner: root
    group: _rspamd
    mode: "0644"
    content: |
      milter = yes;
      timeout = 120s;
      upstream "local" {
        default = yes;
        self_scan = yes;
      }
    when: "os_family('linux')"

  - name: redis-service
    type: service
    service: redis-server
    enabled: true
    state: running
    depends_on: [install-redis]
    when: "os_family('linux')"

  - name: rspamd-service
    type: service
    service: rspamd
    enabled: true
    state: running
    subscribes: [rspamd-worker-proxy]
    depends_on: [install-rspamd, redis-service]
    when: "os_family('linux')"
