name: motd

compliance:
  provides: [login-banner]
vars:
  org_name: "ACME Corp"
  contact_email: "ops@example.com"

resources:
  - name: motd
    type: file
    state: present
    target_path: /etc/motd
    content: |
      ========================================
        {{ .Vars.org_name }}
        Host: {{ .Traits.identity.hostname }}
        OS:   {{ .Traits.os.distro }} {{ .Traits.os.version }}
      ----------------------------------------
        Managed by Vigo. Unauthorized access
        is prohibited. Contact {{ .Vars.contact_email }}
      ========================================
    owner: root
    group: root
    mode: "0644"
