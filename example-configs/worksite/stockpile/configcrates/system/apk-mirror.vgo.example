name: apk-mirror

# Local Alpine apk mirror. rsync pulls the upstream Alpine archive into
# a local tree; nginx serves it over HTTP for the rest of the fleet to
# consume via apk.
#
# Pair with the `nginx` module on the same host: this module drops a
# server block into /etc/nginx/conf.d/ and notifies the nginx service
# for reload. Clients on other envoys point their /etc/apk/repositories
# at the mirror:
#
#   http://{{ .Vars.server_name }}/alpine/{{ .Vars.version }}/main
#   http://{{ .Vars.server_name }}/alpine/{{ .Vars.version }}/community
#
# The Alpine project recommends rsync over HTTP/FTP for mirror operators
# (https://wiki.alpinelinux.org/wiki/How_to_setup_a_Alpine_Linux_mirror).
# APKINDEX comes from upstream in the rsync — no apk-side regeneration
# step needed.

vars:
  base_path:       "/var/spool/apk-mirror/alpine"
  upstream:        "rsync://rsync.alpinelinux.org/alpine/"
  version:         "v3.20"
  rsync_excludes:  "--exclude='edge' --exclude='*/aarch64' --exclude='*/armhf' --exclude='*/armv7' --exclude='*/ppc64le' --exclude='*/s390x'"
  schedule:        "0 4 * * *"
  server_name:     "mirror.lab.local"

resources:
  - name: install-rsync
    type: package
    package: rsync
    state: present
    when: "os_family('alpine')"

  - name: mirror-tree-dir
    type: directory
    state: present
    target_path: "{{ .Vars.base_path }}"
    owner: root
    group: root
    mode: "0755"
    when: "os_family('alpine')"

  - name: apk-mirror-sync-script
    type: file
    state: present
    target_path: /usr/local/sbin/apk-mirror-sync
    owner: root
    group: root
    mode: "0755"
    content: |
      #!/bin/sh
      # Managed by Vigo — do not edit manually.
      set -eu
      rsync \
          --archive \
          --update \
          --hard-links \
          --delete \
          --delete-after \
          --timeout=600 \
          --contimeout=60 \
          {{ .Vars.rsync_excludes }} \
          "{{ .Vars.upstream }}" \
          "{{ .Vars.base_path }}/"
    when: "os_family('alpine')"
    depends_on: [install-rsync]

  - name: apk-mirror-cron
    type: cron
    command: "/usr/local/sbin/apk-mirror-sync"
    schedule: "{{ .Vars.schedule }}"
    user: root
    state: present
    when: "os_family('alpine')"
    depends_on: [apk-mirror-sync-script]

  - name: mirror-nginx-site
    type: file
    state: present
    target_path: /etc/nginx/conf.d/apk-mirror.conf
    owner: root
    group: root
    mode: "0644"
    content: |
      # Managed by Vigo — do not edit manually
      server {
          listen 80;
          server_name {{ .Vars.server_name }};

          root {{ .Vars.base_path }};
          autoindex on;
          access_log /var/log/nginx/apk-mirror.access.log;

          location /alpine/ {
              alias {{ .Vars.base_path }}/;
              try_files $uri $uri/ =404;
          }
      }
    when: "os_family('alpine')"
    notify: [nginx-service]
