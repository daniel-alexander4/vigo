name: systemd-units

vars:
  app_name: "myapp"
  app_binary: "/usr/local/bin/myapp"
  app_user: "myapp"
  app_workdir: "/opt/myapp"

resources:
  - name: app-user
    type: user
    username: myapp
    system: "true"
    shell: /usr/sbin/nologin
    state: present

  - name: app-workdir
    type: directory
    state: present
    target_path: /opt/myapp
    owner: myapp
    group: myapp
    mode: "0755"
    depends_on: [app-user]

  - name: app-unit-file
    type: file
    state: present
    target_path: /etc/systemd/system/myapp.service
    content: |
      [Unit]
      Description={{ .Vars.app_name }}
      After=network.target

      [Service]
      Type=simple
      User={{ .Vars.app_user }}
      WorkingDirectory={{ .Vars.app_workdir }}
      ExecStart={{ .Vars.app_binary }}
      Restart=on-failure
      RestartSec=5
      LimitNOFILE=65535

      [Install]
      WantedBy=multi-user.target
    owner: root
    group: root
    mode: "0644"
    depends_on: [app-workdir]
    notify: [daemon-reload]

  - name: daemon-reload
    type: exec
    command: "systemctl daemon-reload"
    when: changed
    onlyif: "true"
    depends_on: [app-unit-file]
    notify: [app-service]

  - name: app-service
    type: service
    service: myapp
    enabled: true
    state: running
    depends_on: [daemon-reload]
