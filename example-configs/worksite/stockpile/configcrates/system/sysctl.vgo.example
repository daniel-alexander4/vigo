name: sysctl-tuning
# Conflicts with CIS network modules: this sets ip_forward=1, CIS sets
# ip_forward=0. Use exclude_modules to drop the CIS network module on
# hosts that need forwarding, or remove ip_forward from this module.

vars:
  vm_swappiness: "10"
  somaxconn: "65535"
  ip_forward: "1"
  tcp_tw_reuse: "1"
  file_max: "2097152"
  rmem_max: "16777216"
  wmem_max: "16777216"

resources:
  - name: vm-swappiness
    type: sysctl
    key: vm.swappiness
    value: "10"

  - name: net-somaxconn
    type: sysctl
    key: net.core.somaxconn
    value: "65535"

  - name: ip-forward
    type: sysctl
    key: net.ipv4.ip_forward
    value: "1"

  - name: tcp-tw-reuse
    type: sysctl
    key: net.ipv4.tcp_tw_reuse
    value: "1"

  - name: file-max
    type: sysctl
    key: fs.file-max
    value: "2097152"

  - name: rmem-max
    type: sysctl
    key: net.core.rmem_max
    value: "16777216"

  - name: wmem-max
    type: sysctl
    key: net.core.wmem_max
    value: "16777216"
