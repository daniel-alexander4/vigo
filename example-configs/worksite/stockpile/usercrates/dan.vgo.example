# Usercrate for user `dan`. Lives under stockpile/usercrates/ — the
# directory is a library. A usercrate is inert until positively included
# via a carrier's `usercrates:` field (match block, common.vgo, role,
# or environments.vgo per-env). To apply this crate fleet-wide, add
# `usercrates: [dan]` to stockpile/common.vgo.
#
# The module-level `name:` field is omitted — it defaults to the
# filename stem, so this crate registers as `dan`. Only set `name:`
# explicitly if you want the identifier to differ from the filename.
#
# Shape rule: exactly one `type: user` resource per file (extra
# non-user resources permitted — typically a file: for authorized_keys
# or an exec: for post-create setup).
#
# For per-site scoping (MSP-style multi-customer stockpiles) nest the
# usercrate under the customer's directory, e.g.
# stockpile/customerA/usercrates/dan.vgo — then include it from the
# scoped carrier (customerA/common.vgo or envoys.vgo under customerA/).

compliance:
  cis-ubuntu:
    - CIS-5.4.1    # Ensure password creation requirements are configured
  cis-rhel:
    - CIS-5.4.1    # Ensure password creation requirements are configured
  nist-800-53:
    - AC-3         # Access Enforcement
  pci-dss:
    - "8.1.1"      # Identify and authenticate users
  soc2:
    - CC6.1        # Logical access controls
  hipaa:
    - 164.312      # Access controls

resources:
  - name: dan
    type: user
    username: dan
    comment: Dan Alexander

    # Per-envoy variation via lookup tables — one usercrate serves
    # every envoy type. See docs/concepts/lookups.md.
    shell:
      danlap:  /bin/fish
      default: /bin/bash
    groups:
      tag:workstation: [docker, virtualbox, kvm, wireshark]
      tag:mediaserver: [docker, plex]
      default:         [docker]
    sudo_nopasswd:
      tag:workstation: "true"
      default:         "false"
    password: secret:vigo/os-users/dan
    authorized_keys: |
      ssh-ed25519 AAAA... dan@workstation
      ssh-ed25519 BBBB... dan@laptop
