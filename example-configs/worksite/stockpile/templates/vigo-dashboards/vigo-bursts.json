{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Config Publishes",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "target": {
          "expr": "changes(vigo_config_publishes_total[1m]) > 0",
          "refId": "Anno"
        },
        "titleFormat": "Config publish"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Burst at a Glance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "In-flight CheckIns",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "graphMode": "area" },
      "targets": [{ "expr": "vigo_grpc_checkin_in_flight", "legendFormat": "" }]
    },
    {
      "title": "Active Nodes (wave-size proxy)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "vigo_nodes_active_total", "legendFormat": "" }]
    },
    {
      "title": "Outbound Bundle MB/s",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "MBs"
        }
      },
      "options": { "graphMode": "area" },
      "targets": [{ "expr": "sum(rate(vigo_policy_bundle_bytes_total[1m])) / 1048576", "legendFormat": "" }]
    },
    {
      "title": "Convergence %",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [{ "expr": "vigo_convergence_pct * 100", "legendFormat": "" }]
    },
    {
      "title": "gRPC Behaviour",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "gRPC Request Rate (by method, code)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (method, code) (rate(vigo_grpc_requests_total[1m]))", "legendFormat": "{{method}} {{code}}" }]
    },
    {
      "title": "gRPC Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vigo_grpc_request_duration_seconds_bucket[1m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vigo_grpc_request_duration_seconds_bucket[1m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vigo_grpc_request_duration_seconds_bucket[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "TLS Handshakes (by status)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (status) (rate(vigo_grpc_tls_handshakes_total[1m]))", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Policy Delivery",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "title": "Outbound Bundle Bytes/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (method) (rate(vigo_policy_bundle_bytes_total[1m]))", "legendFormat": "{{method}}" }]
    },
    {
      "title": "Bundle Size (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vigo_policy_bundle_size_bytes_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vigo_policy_bundle_size_bytes_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vigo_policy_bundle_size_bytes_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Force Pushes (by scope)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (scope) (rate(vigo_force_pushes_total[1m]))", "legendFormat": "{{scope}}" }]
    },
    {
      "title": "Convergence & Auth",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "title": "Configcrate Actions + Drift Corrections /s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(vigo_configcrate_actions_total[1m]))", "legendFormat": "configcrate actions" },
        { "expr": "sum(rate(vigo_drift_detected_total[1m]))", "legendFormat": "drift corrections" }
      ]
    },
    {
      "title": "Signature Verification Failures",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 }, "color": { "fixedColor": "red", "mode": "fixed" } } },
      "targets": [{ "expr": "sum(rate(vigo_sig_verify_failed_total[1m]))", "legendFormat": "sig-verify fail/s" }]
    },
    {
      "title": "Convergence % over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "fillOpacity": 10 },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] }
        }
      },
      "targets": [{ "expr": "vigo_convergence_pct * 100", "legendFormat": "convergence %" }]
    },
    {
      "title": "Time to Converge after Publish (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "description": "Seconds from a config version becoming current to each envoy first applying it (vigo_publish_convergence_seconds). One sample per envoy per forward version adoption — routine re-converges are excluded. The tail tracks the check-in cadence: long-interval fleets converge slower because envoys only notice at their next check-in.",
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vigo_publish_convergence_seconds_bucket[10m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vigo_publish_convergence_seconds_bucket[10m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vigo_publish_convergence_seconds_bucket[10m])))", "legendFormat": "p99" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["vigo", "bursts"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Vigo — Publish Bursts",
  "uid": "vigo-bursts",
  "version": 1
}
