name: nist-key-management
compliance:
  nist-800-53: [SC-12]
  pci-dss: [3.5.1, 3.5.1.1]
  iso-27001: [A.10.1.2]
  gdpr: [Art.32(1)(a), Art.32(2)]
  soc2: [C1.1, C1.2]
  hitrust: [10.f, 10.g]

resources:
  # SSH key permissions — daily cron.
  - name: ssh-key-permissions
    type: cron
    name: nist-ssh-key-permissions
    command: "find /home -name 'authorized_keys' -exec chmod 600 {} \\; && find /home -name '.ssh' -exec chmod 700 {} \\;"
    hour: "2"
    minute: "20"

  - name: root-ssh-key-permissions
    type: exec
    command: "chmod 600 /root/.ssh/authorized_keys 2>/dev/null; chmod 700 /root/.ssh 2>/dev/null"
    onlyif: "test -d /root/.ssh"

  # TLS certificate permissions
  - name: cert-permissions
    type: exec
    command: "find /etc/ssl/private -type f -exec chmod 600 {} \\; && chmod 700 /etc/ssl/private"
    onlyif: "test -d /etc/ssl/private && find /etc/ssl/private -type f -perm /go+r | grep -q ."

  # GPG key management
  - name: gnupg-package
    type: package
    package: gnupg2
    state: present

  # Crypto policy enforcement
  - name: crypto-policy
    type: file
    target_path: /etc/crypto-policies/config
    content: "FUTURE\n"
    owner: root
    group: root
    mode: "0644"
    notify: [apply-crypto-policy]

  - name: apply-crypto-policy
    type: exec
    command: update-crypto-policies
    onlyif: "test -f /etc/crypto-policies/config"
    when: "os_family('rhel')"
