name: hipaa-media-disposal
compliance:
  hipaa: [164.310(d)(2)(i)]
  nerc-cip: [CIP-011-2-R2]
  iso-27001: [A.8.1, A.8.2]
  nist-800-53: [SC-28]
  gdpr: [Art.17(1)]

resources:
  - name: secure-delete
    type: package
    package: secure-delete
    state: present

  - name: nwipe
    type: package
    package: nwipe
    state: present

  - name: shred-available
    type: exec
    command: "which shred"
    onlyif: "! which shred"

  - name: tmp-cleanup-cron
    type: cron
    command: "find /tmp -type f -mtime +7 -exec shred -u {} \\; 2>/dev/null"
    schedule: "0 2 * * *"
    hour: "2"
    minute: "30"
    user: root
