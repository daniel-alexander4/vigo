name: hipaa-media-disposal
bundle: [hipaa-media-disposal]

resources:
  - name: secure-delete
    type: package
    package: secure-delete
    state: present

  - name: nwipe
    type: package
    package: nwipe
    state: present

  - name: shred-available
    type: exec
    command: "which shred"
    onlyif: "! which shred"

  - name: tmp-cleanup-cron
    type: cron
    command: "find /tmp -type f -mtime +7 -exec shred -u {} \\; 2>/dev/null"
    schedule: "0 2 * * *"
    hour: "2"
    minute: "30"
    user: root
