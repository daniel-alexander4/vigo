name: pci-logging
bundle: [pci-logging]
resources:
  - name: auditd-package
    type: package
    package: auditd
    state: present

  - name: audit-rules
    type: file
    target_path: /etc/audit/rules.d/pci.rules
    content: |
      # PCI DSS 10.2.1 — Individual user access to cardholder data
      -a always,exit -F arch=b64 -S open,openat -F dir=/var/data -F success=1 -k cardholder-access

      # PCI DSS 10.2.2 — Actions by root or admin
      -a always,exit -F arch=b64 -S execve -F euid=0 -k admin-action

      # PCI DSS 10.2.3 — Access to audit trails
      -w /var/log/audit/ -p wa -k audit-trail-access
      -w /etc/audit/ -p wa -k audit-config

      # PCI DSS 10.2.4 — Invalid logical access attempts
      -a always,exit -F arch=b64 -S open,openat -F exit=-EACCES -k access-denied
      -a always,exit -F arch=b64 -S open,openat -F exit=-EPERM -k access-denied

      # PCI DSS 10.2.5 — Identification and authentication mechanisms
      -w /etc/pam.d/ -p wa -k auth-config
      -w /etc/shadow -p wa -k shadow-change
      -w /etc/passwd -p wa -k passwd-change

      # PCI DSS 10.2.6 — Initialization, stopping, or pausing of audit logs
      -w /sbin/auditctl -p x -k audit-tools
      -w /sbin/auditd -p x -k audit-tools

      # PCI DSS 10.2.7 — Privilege escalation
      -w /bin/su -p x -k privilege-escalation
      -w /usr/bin/sudo -p x -k privilege-escalation
      -w /etc/sudoers -p wa -k sudoers-change
    owner: root
    group: root
    mode: "0640"
    notify: [reload-auditd]

  - name: auditd-config
    type: file
    target_path: /etc/audit/auditd.conf
    content: |
      log_file = /var/log/audit/audit.log
      log_format = ENRICHED
      log_group = adm
      max_log_file = 50
      num_logs = 10
      max_log_file_action = rotate
      space_left = 75
      space_left_action = syslog
      admin_space_left = 50
      admin_space_left_action = halt
      disk_full_action = halt
      disk_error_action = halt
      flush = incremental_async
      freq = 50
    owner: root
    group: root
    mode: "0640"
    notify: [reload-auditd]

  - name: auditd-running
    type: service
    service: auditd
    state: running
    enabled: true

  - name: reload-auditd
    type: exec
    command: augenrules --load
    onlyif: "test -f /etc/audit/rules.d/pci.rules"
    when: "changed"

  # Protect audit logs from unauthorized modification
  - name: audit-log-permissions
    type: exec
    command: chmod 0640 /var/log/audit/audit.log && chown root:adm /var/log/audit/audit.log
    onlyif: "test -f /var/log/audit/audit.log && ! stat -c '%a' /var/log/audit/audit.log | grep -q 640"
