name: pci-file-integrity
compliance:
  bundle: [pci-file-integrity]
resources:
  - name: aide-package
    type: package
    package: aide
    state: present

  - name: aide-config
    type: file
    target_path: /etc/aide/aide.conf
    content: |
      database_in=file:/var/lib/aide/aide.db
      database_out=file:/var/lib/aide/aide.db.new
      database_new=file:/var/lib/aide/aide.db.new

      # Rule definitions
      NORMAL = p+i+n+u+g+s+m+c+acl+selinux+xattrs+sha256
      DIR = p+i+n+u+g+acl+selinux+xattrs
      LOG = p+u+g+i+n+S

      # Monitored paths
      /etc NORMAL
      /bin NORMAL
      /sbin NORMAL
      /usr/bin NORMAL
      /usr/sbin NORMAL
      /lib NORMAL
      /lib64 NORMAL
      /boot NORMAL

      # Excluded
      !/var/log
      !/var/spool
      !/tmp
      !/run
    owner: root
    group: root
    mode: "0600"
    notify: [init-aide-db]

  - name: init-aide-db
    type: exec
    command: aide --init && mv /var/lib/aide/aide.db.new /var/lib/aide/aide.db
    onlyif: "! test -f /var/lib/aide/aide.db"

  - name: aide-check-cron
    type: cron
    command: "/usr/bin/aide --check --config /etc/aide/aide.conf | /usr/bin/mail -s 'AIDE Report' root"
    schedule: "0 5 * * *"
    hour: "5"
    minute: "0"
    user: root
