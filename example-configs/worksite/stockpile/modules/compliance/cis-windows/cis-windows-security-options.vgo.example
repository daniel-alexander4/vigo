name: cis-windows-security-options
# CIS Windows Server 2022 Level 1 — Security Options & Windows Defender
# Status: ENFORCED by Vigo

bundle: [cis-windows-security-options]

resources:
  - name: disable-guest-account
    type: local_security_policy
    skip_validation: true
    policy: "EnableGuestAccount"
    value: "0"

  - name: interactive-logon-message-title
    type: registry
    skip_validation: true
    key: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    value_name: "legalnoticecaption"
    value_data: "Authorized Access Only"
    value_type: "REG_SZ"

  - name: interactive-logon-message-text
    type: registry
    skip_validation: true
    key: 'HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'
    value_name: "legalnoticetext"
    value_data: "This system is managed by Vigo. Unauthorized access is prohibited."
    value_type: "REG_SZ"

  - name: smb-signing-required
    type: registry
    skip_validation: true
    key: 'HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'
    value_name: "RequireSecuritySignature"
    value_data: "1"
    value_type: "REG_DWORD"

  - name: defender-realtime-protection
    type: windows_defender
    skip_validation: true
    realtime_monitoring: true

  - name: defender-behavior-monitoring
    type: windows_defender
    skip_validation: true
    behavior_monitoring: true
