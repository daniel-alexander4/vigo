name: gaming-availability
# Gaming Commission — System Availability & Resilience
# Status: ENFORCED by Vigo
# Ensures critical gaming infrastructure services are running,
# monitored, and recoverable.

compliance:
  bundle: [gaming-availability]
resources:
  - name: monitoring-agent
    type: service
    service: prometheus-node-exporter
    state: running
    enabled: true

  - name: ntp-sync
    type: service
    service: chrony
    state: running
    enabled: true
    when: "os_family('debian')"

  - name: syslog-running
    type: service
    service: rsyslog
    state: running
    enabled: true
