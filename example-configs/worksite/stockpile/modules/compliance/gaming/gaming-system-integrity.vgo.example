name: gaming-system-integrity
# Gaming Commission — System Integrity (Nevada NGC / Malta MGA / UK UKGC)
# Status: ENFORCED by Vigo
# Enforces system hardening, access controls, and change management
# on gaming infrastructure (servers, not gaming devices/RNG directly).

bundle: [gaming-system-integrity]

resources:
  - name: ssh-hardening
    type: file_line
    target_path: /etc/ssh/sshd_config
    line: "PermitRootLogin no"
    match_pattern: "^#?PermitRootLogin"

  - name: ssh-key-only
    type: file_line
    target_path: /etc/ssh/sshd_config
    line: "PasswordAuthentication no"
    match_pattern: "^#?PasswordAuthentication"

  - name: auditd-running
    type: service
    service: auditd
    state: running
    enabled: true

  - name: aide-installed
    type: package
    package: aide
    state: present
