name: gdpr-data-protection
compliance:
  bundle: [gdpr-data-protection]
resources:
  # Art 32(1)(a): Encryption of personal data
  - name: cryptsetup
    type: package
    package: cryptsetup
    state: present

  # Enforce strong TLS system-wide
  - name: tls-hardening
    type: file
    target_path: /etc/ssl/openssl-gdpr.cnf
    content: |
      [system_default_sect]
      MinProtocol = TLSv1.2
      CipherString = DEFAULT:!RC4:!3DES:!DES:!MD5:!PSK:!SRP
    owner: root
    group: root
    mode: "0644"

  # Art 25(1): Data protection by design — restrict core dumps (prevent data leaks)
  - name: disable-core-dumps
    type: file
    target_path: /etc/security/limits.d/99-gdpr-coredump.conf
    content: |
      * hard core 0
    owner: root
    group: root
    mode: "0644"

  - name: sysctl-core-dumps
    type: file
    target_path: /etc/sysctl.d/99-gdpr-coredump.conf
    content: |
      fs.suid_dumpable = 0
      kernel.core_pattern = |/bin/false
    owner: root
    group: root
    mode: "0644"
    notify: [apply-sysctl]

  - name: apply-sysctl
    type: exec
    command: sysctl --system
    onlyif: "test -f /etc/sysctl.d/99-gdpr-coredump.conf"
    when: "changed"

  # Art 5(1)(f): Integrity and confidentiality — file permissions
  - name: world-writable-check
    type: cron
    command: "find / -xdev -type f -perm -0002 -not -path '/proc/*' -not -path '/sys/*' 2>/dev/null | logger -t gdpr-world-writable"
    schedule: "0 2 * * *"
    user: root

  # Art 32(1)(b): Ensure ongoing confidentiality — restrict access to logs. Daily cron.
  - name: secure-log-permissions
    type: cron
    user: root
    name: gdpr-log-permissions
    command: "chmod -R o-rwx /var/log/"
    schedule: "45 2 * * *"
