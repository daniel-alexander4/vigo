name: hitrust-governance
bundle: [hitrust-governance]

resources:
  # 07.a: Asset inventory — hardware/software tracking
  - name: dmidecode
    type: package
    package: dmidecode
    state: present

  - name: lshw
    type: package
    package: lshw
    state: present

  - name: weekly-asset-inventory
    type: cron
    command: "lshw -short > /var/log/asset-inventory.txt 2>/dev/null && dpkg -l > /var/log/software-inventory.txt 2>/dev/null"
    schedule: "0 6 * * 1"
    weekday: "1"
    hour: "6"
    minute: "0"
    user: root

  # 06.c/06.g: Compliance monitoring — regular audits
  - name: lynis-package
    type: package
    package: lynis
    state: present

  - name: weekly-compliance-audit
    type: cron
    command: "/usr/bin/lynis audit system --cronjob --quiet"
    schedule: "0 3 * * 0"
    weekday: "0"
    hour: "3"
    minute: "0"
    user: root

  # 09.b/09.c/09.d: Capacity/system planning/acceptance
  - name: sysstat-package
    type: package
    package: sysstat
    state: present

  - name: sysstat-enabled
    type: service
    service: sysstat
    state: running
    enabled: true

  # 10.k/10.l/10.m: Crypto controls, key management, change control
  - name: openssl-package
    type: package
    package: openssl
    state: present

  - name: cert-expiry-check
    type: cron
    command: "find /etc/ssl/certs -name '*.pem' -exec openssl x509 -enddate -noout -in {} \\; 2>/dev/null | grep -i 'notafter' | logger -t cert-check"
    schedule: "0 7 * * 1"
    weekday: "1"
    hour: "7"
    minute: "0"
    user: root
