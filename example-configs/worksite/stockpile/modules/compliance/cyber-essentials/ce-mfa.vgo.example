name: ce-mfa
bundle: [ce-mfa]

resources:
  - name: libpam-google-authenticator
    type: package
    package: libpam-google-authenticator
    state: present

  - name: pam-sshd-totp
    type: file
    target_path: /etc/pam.d/sshd-totp
    content: |
      auth required pam_google_authenticator.so nullok
    owner: root
    group: root
    mode: "0644"

  - name: sshd-challenge-response
    type: file
    target_path: /etc/ssh/sshd_config.d/90-mfa.conf
    content: |
      ChallengeResponseAuthentication yes
      AuthenticationMethods publickey,keyboard-interactive
    owner: root
    group: root
    mode: "0644"
    notify: [restart-sshd-debian, restart-sshd-redhat]

  - name: restart-sshd-debian
    type: service
    service: ssh
    state: restarted
    when: "changed && os_family('debian')"

  - name: restart-sshd-redhat
    type: service
    service: sshd
    state: restarted
    when: "changed && !os_family('debian')"
