name: finra-bcp-monitoring
# FINRA Business Continuity Planning — Monitoring
# Status: MONITORED by Vigo
# Vigo verifies that backup configurations exist and DR services
# are running. Actual recovery capability requires external testing.

compliance:
  bundle: [finra-bcp-monitoring]
resources:
  - name: backup-config-exists
    type: file
    target_path: /etc/vigo-bcp-verified
    content: |
      # BCP verification marker
      # Vigo monitors that backup services are configured.
      # Actual recovery testing is an external validation requirement.
      last_checked: {{ .Traits.identity.hostname }}
    owner: root
    group: root
    mode: "0644"

  - name: cron-service-running
    type: service
    service: cron
    state: running
    enabled: true
