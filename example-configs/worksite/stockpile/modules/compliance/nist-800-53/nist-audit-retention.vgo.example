name: nist-audit-retention
bundle: [nist-audit-retention]

resources:
  # AU-8: Time source
  - name: chrony-package
    type: package
    package: chrony
    state: present

  - name: chrony-service
    type: service
    service: chronyd
    state: running
    enabled: true

  # AU-10: Non-repudiation — immutable audit rules
  - name: audit-immutable
    type: file
    target_path: /etc/audit/rules.d/99-finalize.rules
    content: |
      # Make the audit configuration immutable — requires reboot to change
      -e 2
    owner: root
    group: root
    mode: "0640"

  # AU-11: Audit retention — keep logs 1 year
  - name: audit-retention-config
    type: file
    target_path: /etc/audit/auditd.conf.d/retention.conf
    content: |
      max_log_file = 100
      num_logs = 52
      max_log_file_action = rotate
    owner: root
    group: root
    mode: "0640"

  - name: syslog-retention
    type: file
    target_path: /etc/logrotate.d/rsyslog-retention
    content: |
      /var/log/syslog /var/log/auth.log /var/log/kern.log {
        weekly
        rotate 52
        compress
        delaycompress
        notifempty
        missingok
        postrotate
          /usr/lib/rsyslog/rsyslog-rotate
        endscript
      }
    owner: root
    group: root
    mode: "0644"
