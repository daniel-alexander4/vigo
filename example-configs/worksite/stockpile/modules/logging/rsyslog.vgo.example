name: rsyslog

provides: [log-shipping]
# Prefer: cis-ubuntu-logging or cis-rhel-logging (compliance roles install
# rsyslog, enable the service, and set file permissions with compliance tags).
# Safe to combine if you need remote forwarding — this module uses a different
# drop-in file — but both manage the rsyslog service.

vars:
  remote_syslog_server: ""
  remote_syslog_port: "514"
  log_format: "RSYSLOG_TraditionalFileFormat"

resources:
  - name: install-rsyslog
    type: package
    package: rsyslog
    state: present

  - name: rsyslog-vigo-conf
    type: file
    target_path: /etc/rsyslog.d/50-vigo.conf
    content: |
      # Managed by Vigo — do not edit manually

      # Use configured log format
      $ActionFileDefaultTemplate {{ .Vars.log_format }}

      # Separate log files for key facilities
      auth,authpriv.*                 /var/log/auth.log
      mail.*                          /var/log/mail.log
      cron.*                          /var/log/cron.log

      {{ if ne .Vars.remote_syslog_server "" }}
      # Forward all logs to remote syslog server over UDP
      *.* @{{ .Vars.remote_syslog_server }}:{{ .Vars.remote_syslog_port }}
      {{ end }}
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-rsyslog]
    notify: [rsyslog-service]

  - name: rsyslog-service
    type: service
    service: rsyslog
    enabled: true
    state: running
    depends_on: [rsyslog-vigo-conf]
