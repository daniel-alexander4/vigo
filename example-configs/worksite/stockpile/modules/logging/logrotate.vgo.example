name: logrotate

compliance:
  provides: [log-rotation]
vars:
  rotate: 14
  rotate_size: 100M

resources:
  - name: install-logrotate
    type: package
    package: logrotate
    state: present

  - name: system-logrotate
    type: logrotate
    path: /var/log/*.log
    frequency: daily
    rotate: "{{ .Vars.rotate_count }}"
    size: "{{ .Vars.rotate_size }}"
    compress: "true"
    delaycompress: "true"
    missingok: "true"
    notifempty: "true"
    create: "0640 root adm"
    depends_on: [install-logrotate]

  - name: service-logrotate
    type: logrotate
    path: /var/log/*/*.log
    frequency: daily
    rotate: "{{ .Vars.rotate_count }}"
    size: "{{ .Vars.rotate_size }}"
    compress: "true"
    delaycompress: "true"
    missingok: "true"
    notifempty: "true"
    create: "0640 root adm"
    depends_on: [install-logrotate]
