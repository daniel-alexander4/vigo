name: pacman-mirror

# Local Arch Linux pacman mirror. rsync pulls a tier-1 Arch mirror into
# a local tree; nginx serves it over HTTP for the rest of the fleet to
# consume via pacman.
#
# Pair with the `nginx` module on the same host: this module drops a
# server block into /etc/nginx/conf.d/ and notifies the nginx service
# for reload. Clients on other envoys add a line to
# /etc/pacman.d/mirrorlist:
#
#   Server = http://{{ .Vars.server_name }}/archlinux/$repo/os/$arch
#
# Pick a tier-1 upstream from https://archlinux.org/mirrors/status/ —
# look for one that's geographically close and offers rsync. Respect
# the project's mirror-operator guidance: a 1-tier mirror should sync
# at least daily, and not more than 4 times per day.

vars:
  base_path:    "/var/spool/pacman-mirror/archlinux"
  upstream:     "rsync://mirror.rackspace.com/archlinux/"
  schedule:     "0 4 * * *"
  server_name:  "mirror.lab.local"

resources:
  - name: install-rsync
    type: package
    package: rsync
    state: present
    when: "os_family('arch')"

  - name: mirror-tree-dir
    type: directory
    target_path: "{{ .Vars.base_path }}"
    owner: root
    group: root
    mode: "0755"
    when: "os_family('arch')"

  - name: pacman-mirror-sync-script
    type: file
    target_path: /usr/local/sbin/pacman-mirror-sync
    owner: root
    group: root
    mode: "0755"
    content: |
      #!/bin/sh
      # Managed by Vigo — do not edit manually.
      set -eu
      # --safe-links so a malformed symlink upstream can't escape the
      # mirror tree; standard mirror-operator guidance.
      rsync \
          --archive \
          --update \
          --hard-links \
          --safe-links \
          --delete \
          --delete-after \
          --timeout=600 \
          --contimeout=60 \
          "{{ .Vars.upstream }}" \
          "{{ .Vars.base_path }}/"
    when: "os_family('arch')"
    depends_on: [install-rsync]

  - name: pacman-mirror-cron
    type: cron
    command: "/usr/local/sbin/pacman-mirror-sync"
    schedule: "{{ .Vars.schedule }}"
    user: root
    state: present
    when: "os_family('arch')"
    depends_on: [pacman-mirror-sync-script]

  - name: mirror-nginx-site
    type: file
    target_path: /etc/nginx/conf.d/pacman-mirror.conf
    owner: root
    group: root
    mode: "0644"
    content: |
      # Managed by Vigo — do not edit manually
      server {
          listen 80;
          server_name {{ .Vars.server_name }};

          root {{ .Vars.base_path }};
          autoindex on;
          access_log /var/log/nginx/pacman-mirror.access.log;

          location /archlinux/ {
              alias {{ .Vars.base_path }}/;
              try_files $uri $uri/ =404;
          }
      }
    when: "os_family('arch')"
    notify: [nginx-service]
