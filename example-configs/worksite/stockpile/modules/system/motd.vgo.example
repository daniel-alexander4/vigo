name: motd

compliance:
  cis-ubuntu: [1.7.1, 1.7.2, 1.7.3]
  cis-rhel: [1.7.1, 1.7.2, 1.7.3]
  nist-800-53: [AC-8]
  iso-27001: [A.9.1.2]

vars:
  org_name: "ACME Corp"
  contact_email: "ops@example.com"

resources:
  - name: motd
    type: file
    target_path: /etc/motd
    content: |
      ========================================
        {{ .Vars.org_name }}
        Host: {{ .Traits.identity.hostname }}
        OS:   {{ .Traits.os.distro }} {{ .Traits.os.version }}
      ----------------------------------------
        Managed by Vigo. Unauthorized access
        is prohibited. Contact {{ .Vars.contact_email }}
      ========================================
    owner: root
    group: root
    mode: "0644"
