#~ Writes a /etc/motd warning telling operators they've SSH'd into a
#~ Vigo control-plane host. Helps prevent the "I'll just bounce
#~ docker on this random box" mistake when a hosts.txt entry expires
#~ or DNS lies. Apply to the host running vigosrv. Linux-only.
name: vigo-motd

compliance:
  nist-800-53: [AC-8]
  iso-27001: [A.9.4.1]

vars:
  motd_text: |2

      ╔═══════════════════════════════════════════════════════════════════╗
      ║                  VIGO CONTROL-PLANE HOST                          ║
      ╚═══════════════════════════════════════════════════════════════════╝

      This machine runs vigosrv. Treat it as production infrastructure.

      DO NOT manually restart Docker or the vigo container — `vigocli` and
      `scripts/upgrade.sh` are the supported paths. A manual restart can
      drop the agent fleet's check-in window and trigger spurious
      offline-envoy notifications.

      Operator surface:    vigocli (host)  |  https://localhost:8443 (UI)
      Stockpile:           /srv/vigo/stacks/stockpile/
      Logs:                docker compose logs vigo


resources:
  - name: write-motd
    type: file
    target_path: "/etc/motd"
    owner: root
    group: root
    mode: "0644"
    content: "{{ .Vars.motd_text }}"
    when: "os_family('linux')"
