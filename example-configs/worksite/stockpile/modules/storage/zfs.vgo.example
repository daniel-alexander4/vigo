#~ ZFS filesystem support — installs zfs-dkms + zfsutils. Does not import
#~ or create pools (operator-specific). Use sysctl/zfs vars for tunables.
name: zfs

provides: [filesystem-encrypted-snapshots]

resources:
  - name: install-zfsutils
    type: package
    package: zfsutils-linux
    state: present
    when: "os_family('debian')"

  - name: install-zfs-rhel
    type: package
    package: zfs
    state: present
    when: "os_family('rhel')"

  - name: zfs-import-target
    type: service
    service: zfs-import-cache
    enabled: true
    state: running
    when: "os_family('linux')"

  - name: zfs-mount-target
    type: service
    service: zfs-mount
    enabled: true
    state: running
    when: "os_family('linux')"
