#~ Microsoft iSCSI Initiator on Windows — enables the built-in MSiSCSI
#~ service. Target portal discovery is operator-driven (use Connect-IscsiTarget
#~ in PowerShell or the iSCSI Initiator GUI).
name: iscsi-initiator-windows

compliance:
  provides: [iscsi-initiator]
resources:
  - name: msiscsi-service
    type: service
    service: MSiSCSI
    enabled: true
    state: running
    when: "os_family('windows')"
