name: node-exporter

compliance:
  nist-800-53: [SI-4, AU-12]
  soc2: [CC7.1]
  iso-27001: [A.12.4.1]

resources:
  - name: install-node-exporter
    type: package
    package: prometheus-node-exporter
    state: present

  - name: node-exporter-service
    type: service
    service: prometheus-node-exporter
    enabled: true
    state: running
    depends_on: [install-node-exporter]
