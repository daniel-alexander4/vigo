#~ Local health probe of the running vigosrv. Polls the unauthenticated
#~ /healthz endpoint every minute and restarts the vigo container if the
#~ probe fails three times in a row. Helps recover from the rare case
#~ where vigosrv has hung but Docker hasn't noticed (no exit code → no
#~ restart-on-failure trigger).
#~
#~ Backoff sentinel: after a restart, a 5-minute cooldown file prevents
#~ thrashing if the underlying problem is persistent. Operators
#~ investigating a deadloop should look at /var/log/vigo-healthcheck.log
#~ and `docker compose logs vigo`.
#~
#~ Apply to the host running vigosrv. Linux-only.
name: vigo-healthcheck

compliance:
  nist-800-53: [CP-2, SI-13, CP-10]
  hipaa: [164.308(a)(7)(i)]
  iso-27001: [A.12.1.3, A.17.1.2]
  soc2: [A1.2]

vars:
  vigo_root: "/srv/vigo"
  healthz_url: "https://localhost:8443/healthz"
  fail_threshold: "3"
  cooldown_seconds: "300"

resources:
  - name: install-curl
    type: package
    package: curl
    state: present
    when: "os_family('linux')"

  - name: healthcheck-script
    type: file
    target_path: "/usr/local/sbin/vigo-healthcheck.sh"
    owner: root
    group: root
    mode: "0755"
    content: |
      #!/bin/sh
      # Auto-generated by vigo-healthcheck module. Runs every minute via cron.
      set -eu
      LOG=/var/log/vigo-healthcheck.log
      STATE=/run/vigo-healthcheck.state
      COOLDOWN=/run/vigo-healthcheck.cooldown
      THRESHOLD={{ .Vars.fail_threshold }}
      COOLDOWN_SEC={{ .Vars.cooldown_seconds }}

      # In a cooldown? Bail.
      if [ -f "$COOLDOWN" ]; then
        AGE=$(( $(date +%s) - $(stat -c %Y "$COOLDOWN") ))
        if [ "$AGE" -lt "$COOLDOWN_SEC" ]; then
          exit 0
        fi
        rm -f "$COOLDOWN"
      fi

      if curl -sk --max-time 5 "{{ .Vars.healthz_url }}" >/dev/null 2>&1; then
        : > "$STATE"   # reset fail counter
        exit 0
      fi

      FAILS=$(cat "$STATE" 2>/dev/null || echo 0)
      FAILS=$((FAILS + 1))
      echo "$FAILS" > "$STATE"
      echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) healthz fail ($FAILS/$THRESHOLD)" >> "$LOG"

      if [ "$FAILS" -ge "$THRESHOLD" ]; then
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) restarting vigo container" >> "$LOG"
        cd "{{ .Vars.vigo_root }}" && docker compose restart vigo >> "$LOG" 2>&1 || true
        : > "$COOLDOWN"
        : > "$STATE"
      fi
    when: "os_family('linux')"

  - name: healthcheck-cron
    type: cron
    user: root
    name: vigo-healthcheck
    command: "/usr/local/sbin/vigo-healthcheck.sh"
    schedule: "* * * * *"
    depends_on: [install-curl, healthcheck-script]
    when: "os_family('linux')"
