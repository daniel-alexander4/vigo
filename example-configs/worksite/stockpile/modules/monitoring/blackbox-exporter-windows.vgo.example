#~ blackbox-exporter on Windows. Native binary registered as a Windows
#~ service. Same probe config shape as Linux.
name: blackbox-exporter-windows

provides: [monitoring-probe]

vars:
  blackbox_version: "0.25.0"

resources:
  - name: install-blackbox-exporter
    type: source_package
    url: "https://github.com/prometheus/blackbox_exporter/releases/download/v{{ .Vars.blackbox_version }}/blackbox_exporter-{{ .Vars.blackbox_version }}.windows-amd64.zip"
    target_path: "C:\\Program Files\\blackbox_exporter\\blackbox_exporter.exe"
    binary_path: "blackbox_exporter.exe"
    skip_validation: true
    when: "os_family('windows')"

  - name: blackbox-config
    type: file
    target_path: "C:\\ProgramData\\blackbox_exporter\\blackbox.yml"
    owner: SYSTEM
    group: Administrators
    mode: "0644"
    content: |
      modules:
        http_2xx:
          prober: http
          timeout: 5s
        tcp_connect:
          prober: tcp
          timeout: 5s
    when: "os_family('windows')"

  - name: install-blackbox-service
    type: powershell
    command: 'New-Service -Name VigoBlackboxExporter -BinaryPathName ''"C:\Program Files\blackbox_exporter\blackbox_exporter.exe" --config.file=C:\ProgramData\blackbox_exporter\blackbox.yml'' -StartupType Automatic'
    onlyif: 'if (Get-Service VigoBlackboxExporter -ErrorAction SilentlyContinue) { exit 1 } else { exit 0 }'
    skip_validation: true
    depends_on: [install-blackbox-exporter, blackbox-config]
    when: "os_family('windows')"

  - name: blackbox-service
    type: service
    service: VigoBlackboxExporter
    enabled: true
    state: running
    depends_on: [install-blackbox-service]
    when: "os_family('windows')"
