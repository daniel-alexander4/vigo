name: smartmontools

provides: [disk-health-monitoring]

vars:
  # Short self-test daily at 02:00, long self-test Saturdays at 03:00
  smartd_schedule: "-s (S/../.././02|L/../../6/03)"

resources:
  - name: install-smartmontools
    type: package
    package: smartmontools
    state: present

  - name: smartd-conf-debian
    type: file
    target_path: /etc/smartmontools/smartd.conf
    content: |
      # Managed by Vigo — do not edit manually
      #
      # DEVICESCAN: scan all devices and apply these directives
      #   -H   check SMART health status
      #   -l error   report ATA error log increases
      #   -l selftest   report self-test log failures
      #   -f   check for usage attribute failures
      #   -t   equivalent to -p and -u (track all attribute changes)
      #   -m root   send email alerts to root
      DEVICESCAN -H -l error -l selftest -f -t {{ .Vars.smartd_schedule }} -m root
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-smartmontools]
    notify: [smartd-service-debian]
    when: "os_family('debian')"

  - name: smartd-conf-redhat
    type: file
    target_path: /etc/smartd.conf
    content: |
      # Managed by Vigo — do not edit manually
      #
      # DEVICESCAN: scan all devices and apply these directives
      #   -H   check SMART health status
      #   -l error   report ATA error log increases
      #   -l selftest   report self-test log failures
      #   -f   check for usage attribute failures
      #   -t   equivalent to -p and -u (track all attribute changes)
      #   -m root   send email alerts to root
      DEVICESCAN -H -l error -l selftest -f -t {{ .Vars.smartd_schedule }} -m root
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-smartmontools]
    notify: [smartd-service-redhat]
    when: "!os_family('debian')"

  - name: smartd-service-debian
    type: service
    service: smartmontools
    enabled: true
    state: running
    depends_on: [smartd-conf-debian]
    when: "os_family('debian')"

  - name: smartd-service-redhat
    type: service
    service: smartd
    enabled: true
    state: running
    depends_on: [smartd-conf-redhat]
    when: "!os_family('debian')"
