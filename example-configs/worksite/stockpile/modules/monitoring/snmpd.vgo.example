#~ Net-SNMP daemon — exposes host metrics over SNMP for collection by
#~ a downstream poller. Read-only community by default.
name: snmpd

provides: [monitoring-probe]

vars:
  snmp_community: "public"
  snmp_location: "datacenter-1"
  snmp_contact: "ops@example.com"

resources:
  - name: install-snmpd
    type: package
    package: snmpd
    state: present
    when: "os_family('linux')"

  - name: snmpd-conf
    type: file
    target_path: "/etc/snmp/snmpd.conf"
    owner: root
    group: root
    mode: "0600"
    content: |
      agentAddress udp:161,udp6:[::1]:161
      rocommunity {{ .Vars.snmp_community }} default
      sysLocation {{ .Vars.snmp_location }}
      sysContact {{ .Vars.snmp_contact }}
      disk / 10000
      load 12 14 14
    when: "os_family('linux')"

  - name: snmpd-service
    type: service
    service: snmpd
    enabled: true
    state: running
    subscribes: [snmpd-conf]
    when: "os_family('linux')"
