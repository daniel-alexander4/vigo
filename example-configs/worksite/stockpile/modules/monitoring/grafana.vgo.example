name: grafana

provides: [dashboard]

vars:
  grafana_port: "3000"
  grafana_admin_password: "secret:vigo/grafana/admin-password"

resources:
  - name: grafana-repo
    type: repository
    repository: grafana
    key_url: https://apt.grafana.com/gpg.key
    repo: "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main"
    state: present

  - name: install-grafana
    type: package
    package: grafana
    state: present
    depends_on: [grafana-repo]

  - name: grafana-ini
    type: file
    target_path: /etc/grafana/grafana.ini
    content: |
      [server]
      http_port = {{ .Vars.grafana_port }}

      [auth.anonymous]
      enabled = false

      [log]
      mode = file
      level = info
    owner: root
    group: grafana
    mode: "0640"
    depends_on: [install-grafana]
    notify: [grafana-service]

  - name: grafana-set-password
    type: exec
    command: "grafana-cli admin reset-admin-password --password-from-stdin"
    stdin: "secret:vigo/grafana/admin-password"
    when: "changed"
    depends_on: [grafana-service]
    watch_secret: ["vigo/grafana/admin-password"]
    subscribes: [grafana-ini]

  - name: grafana-logrotate
    type: logrotate
    path: /var/log/grafana/*.log
    frequency: daily
    rotate: "7"
    compress: "true"
    missingok: "true"
    notifempty: "true"
    copytruncate: "true"
    depends_on: [install-grafana]

  - name: grafana-pip-deps
    type: pip
    package: grafana-client
    state: present

  - name: grafana-service
    type: service
    service: grafana-server
    enabled: true
    state: running
    depends_on: [grafana-ini]
