name: prometheus

compliance:
  nist-800-53: [SI-4, AU-12]
  soc2: [CC7.1]
  iso-27001: [A.12.4.1]

vars:
  prometheus_retention: "30d"
  prometheus_scrape_interval: "15s"
  alertmanager_port: "9093"

resources:
  - name: prometheus-user
    type: user
    username: prometheus
    system: "true"
    shell: /usr/sbin/nologin

  - name: install-prometheus
    type: package
    package: prometheus
    state: present

  - name: prometheus-conf
    type: file
    target_path: /etc/prometheus/prometheus.yml
    content: |
      global:
        scrape_interval: {{ .Vars.prometheus_scrape_interval }}
        evaluation_interval: 15s

      alerting:
        alertmanagers:
          - static_configs:
              - targets:
                  - localhost:{{ .Vars.alertmanager_port }}

      rule_files:
        - /etc/prometheus/rules/*.yml

      scrape_configs:
        - job_name: prometheus
          static_configs:
            - targets: ['localhost:9090']

        - job_name: node
          static_configs:
            - targets: ['localhost:9100']
    owner: prometheus
    group: prometheus
    mode: "0644"
    depends_on: [install-prometheus, prometheus-user]
    notify: [prometheus-service]

  - name: prometheus-service
    type: service
    service: prometheus
    enabled: true
    state: running
    depends_on: [prometheus-conf]
