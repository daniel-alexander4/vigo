#~ Kopia on Windows — native binary via chocolatey, scheduled task for
#~ daily snapshots. Repository password + URL come from the secret vault.
name: kopia-windows

provides: [host-backup-encrypted]

vars:
  source_paths: "C:\\Users C:\\ProgramData"
  kopia_password: "secret:vigo/backup/kopia_password"
  kopia_repo: "secret:vigo/backup/kopia_repo"

resources:
  - name: install-kopia
    type: package
    package: kopia
    state: present
    when: "os_family('windows')"

  - name: kopia-config
    type: file
    target_path: "C:\\ProgramData\\Vigo\\kopia\\kopia.env"
    owner: SYSTEM
    group: Administrators
    mode: "0600"
    content: |
      KOPIA_PASSWORD={{ .Vars.kopia_password }}
      KOPIA_CONFIG_PATH=C:\ProgramData\Vigo\kopia\repo.config
    when: "os_family('windows')"

  - name: kopia-snapshot-script
    type: file
    target_path: "C:\\ProgramData\\Vigo\\kopia\\kopia-snapshot.ps1"
    owner: SYSTEM
    group: Administrators
    mode: "0750"
    content: |
      $envFile = "C:\ProgramData\Vigo\kopia\kopia.env"
      Get-Content $envFile | ForEach-Object {
        if ($_ -match '^([^=]+)=(.*)$') {
          [System.Environment]::SetEnvironmentVariable($Matches[1], $Matches[2])
        }
      }
      if (-not (kopia repository status 2>$null)) {
        kopia repository connect from-config --token "{{ .Vars.kopia_repo }}"
      }
      kopia snapshot create {{ .Vars.source_paths }}
    when: "os_family('windows')"

  - name: kopia-scheduled-task
    type: powershell
    command: >-
      Register-ScheduledTask -TaskName 'VigoKopiaSnapshot' -Force
      -Action (New-ScheduledTaskAction -Execute 'powershell.exe'
        -Argument '-NoProfile -File C:\ProgramData\Vigo\kopia\kopia-snapshot.ps1')
      -Trigger (New-ScheduledTaskTrigger -Daily -At 02:15)
      -RunLevel Highest -User SYSTEM
    skip_validation: true
    when: "os_family('windows')"
