# ISC DHCP server — manages dhcpd with subnets, reservations, and options.
# Template-driven config: define subnets and hosts in vars, the template
# renders a complete dhcpd.conf.

name: dhcpd
description: ISC DHCP server with template-driven subnet and reservation config

vars:
  dhcpd_domain_name: example.com
  dhcpd_dns_servers: "1.1.1.1, 1.0.0.1"
  dhcpd_default_lease: 600
  dhcpd_max_lease: 7200
  dhcpd_interface: eth0
  dhcpd_subnets: |
    - subnet: 192.168.1.0
      netmask: 255.255.255.0
      range_start: 192.168.1.100
      range_end: 192.168.1.200
      routers: 192.168.1.1
      dns: "1.1.1.1, 1.0.0.1"
  dhcpd_reservations: |
    - hostname: printer
      mac: "00:11:22:33:44:55"
      ip: 192.168.1.10
    - hostname: nas
      mac: "AA:BB:CC:DD:EE:FF"
      ip: 192.168.1.20

resources:
  - name: dhcpd-package
    type: package
    package: isc-dhcp-server
    state: present

  - name: dhcpd-defaults
    type: file
    target_path: /etc/default/isc-dhcp-server
    content: |
      INTERFACESv4="{{ .Vars.dhcpd_interface }}"
      INTERFACESv6=""
    owner: root
    group: root
    mode: "0644"
    notify:
      - dhcpd-service
    depends_on:
      - dhcpd-package

  - name: dhcpd-config
    type: file
    target_path: /etc/dhcp/dhcpd.conf
    content: |
      # Managed by Vigo — do not edit manually.
      authoritative;

      option domain-name "{{ .Vars.dhcpd_domain_name }}";
      option domain-name-servers {{ .Vars.dhcpd_dns_servers }};

      default-lease-time {{ .Vars.dhcpd_default_lease }};
      max-lease-time {{ .Vars.dhcpd_max_lease }};
      min-secs 0;

      {{ range .Vars.dhcpd_subnets }}
      subnet {{ .subnet }} netmask {{ .netmask }} {
        range {{ .range_start }} {{ .range_end }};
        option routers {{ .routers }};
        {{ if .dns }}option domain-name-servers {{ .dns }};{{ end }}
      }
      {{ end }}

      {{ range .Vars.dhcpd_reservations }}
      host {{ .hostname }} {
        hardware ethernet {{ .mac }};
        fixed-address {{ .ip }};
      }
      {{ end }}
    owner: root
    group: root
    mode: "0644"
    notify:
      - dhcpd-service
    depends_on:
      - dhcpd-package

  - name: dhcpd-service
    type: service
    service: isc-dhcp-server
    state: running
    enabled: true
    depends_on:
      - dhcpd-package
      - dhcpd-config
      - dhcpd-defaults

provides: [dhcp-server]
