#~ Unbound — validating, recursive, caching DNS resolver. Suitable for
#~ a LAN-side resolver in front of authoritative upstream.
name: unbound

compliance:
  nist-800-53: [SC-20, SC-21]
  iso-27001: [A.13.1.1]

resources:
  - name: install-unbound
    type: package
    package: unbound
    state: present
    when: "os_family('linux')"

  - name: unbound-conf
    type: file
    target_path: "/etc/unbound/unbound.conf.d/local.conf"
    owner: root
    group: root
    mode: "0644"
    content: |
      server:
        interface: 0.0.0.0
        port: 53
        access-control: 127.0.0.0/8 allow
        access-control: 10.0.0.0/8 allow
        access-control: 192.168.0.0/16 allow
        access-control: 0.0.0.0/0 refuse
        verbosity: 1
        do-ip6: no
        prefetch: yes
        harden-glue: yes
        harden-dnssec-stripped: yes
        unwanted-reply-threshold: 10000
    depends_on: [install-unbound]
    when: "os_family('linux')"

  - name: unbound-service
    type: service
    service: unbound
    enabled: true
    state: running
    subscribes: [unbound-conf]
    when: "os_family('linux')"
