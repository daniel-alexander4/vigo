name: selinux

compliance:
  cis-rhel: [1.6.1.1, 1.6.1.2, 1.6.1.3, 1.6.1.4, 1.6.1.5]
  nist-800-53: [AC-3, SC-3]
  iso-27001: [A.9.4.1]
# Prefer: cis-rhel-access (compliance role includes SELinux enforcement with
# compliance tags). Only use this module if you are NOT using the cis-rhel
# role — both write /etc/selinux/config.

vars:
  selinux_mode: "enforcing"

resources:
  - name: selinux-config
    type: file
    target_path: /etc/selinux/config
    content: |
      # /etc/selinux/config — managed by vigo
      SELINUX={{ .Vars.selinux_mode }}
      SELINUXTYPE=targeted
    owner: root
    group: root
    mode: "0644"
    when: "os_family('redhat')"

  # Apply runtime mode without requiring reboot.
  # Only runs when getenforce is available (SELinux tooling installed).
  - name: selinux-enforce
    type: exec
    command: "setenforce enforcing"
    when: "os_family('redhat') && command_succeeds('which getenforce')"
    depends_on: [selinux-config]
    subscribes: [selinux-config]
