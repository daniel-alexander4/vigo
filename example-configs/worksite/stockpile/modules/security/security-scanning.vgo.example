#~ Deploys security scanning tools and runs scans in the background.
#~ Scans run once per day during the configured scan window. The
#~ `background: "true"` flag spawns each scan as a detached process so
#~ convergence is never blocked — even on slow hardware. Background
#~ commands auto-nice to CPU 19, which the agent promotes to ionice
#~ idle class (requires vigo 0.30.2+) — scans only run I/O when nothing
#~ else on the envoy wants the disk. Every run-* resource also has a
#~ `timeout:` ceiling so a wedged scan (e.g. aide on a full disk)
#~ can't linger forever; on expiry the agent SIGTERMs then SIGKILLs
#~ the process tree and the bg_pids slot is released for tomorrow's
#~ cycle to retry.
#~
#~ Per-tool timeout ceilings are conservative defaults for a mid-sized
#~ server. Override per-envoy in a hostcrate var — e.g. for a NAS with
#~ a giant AIDE index, `vars: { aide_check_timeout: "12h" }`.
#~
#~ Results are collected by the built-in security_scan trait collector
#~ and displayed on the Security dashboard.
#~
#~ Tools: Trivy (CVE), Lynis (hardening), chkrootkit, rkhunter,
#~        ClamAV (malware), AIDE (file integrity), debsecan (Debian CVEs).
#~
#~ Scan output: /var/lib/vigo/security/
name: security-scanning

compliance:
  nist-800-53: [RA-5, SI-2, SI-7]
  pci-dss: [6.3.1, 6.3.3, 11.5.2]
  iso-27001: [A.12.6.1]
  hipaa: [164.308(a)(1)(ii)(D)]

vars:
  scan_hour_start: "2"
  scan_hour_end: "5"
  scan_dir: "/var/lib/vigo/security"
  trivy_severity: "CRITICAL,HIGH,MEDIUM,LOW"
  trivy_timeout: "600"
  aide_db_path: "/var/lib/aide/aide.db"
  aide_db_new_path: "/var/lib/aide/aide.db.new"
  # Per-tool exec timeouts — see the module header for rationale.
  trivy_exec_timeout: "2h"
  lynis_timeout: "30m"
  chkrootkit_timeout: "15m"
  rkhunter_timeout: "30m"
  freshclam_timeout: "30m"
  clamscan_timeout: "4h"
  aide_init_timeout: "6h"
  aide_check_timeout: "6h"
  debsecan_timeout: "10m"

resources:
  # ── Output directory ──────────────────────────────────────────────

  - name: scan-dir
    type: directory
    target_path: "{{ .Vars.scan_dir }}"
    owner: root
    group: root
    mode: "0700"

  # ── Trivy (CVE scanner) ──────────────────────────────────────────

  - name: trivy-repo-key-debian
    type: exec
    command: >-
      sh -c 'wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key
      | gpg --dearmor -o /usr/share/keyrings/trivy.gpg'
    when: "os_family('debian')"
    onlyif: "! test -f /usr/share/keyrings/trivy.gpg"

  - name: trivy-repo-debian
    type: file
    target_path: /etc/apt/sources.list.d/trivy.list
    content: |
      deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main
    owner: root
    group: root
    mode: "0644"
    when: "os_family('debian')"
    depends_on: [trivy-repo-key-debian]

  - name: trivy-apt-update
    type: exec
    command: "apt-get update -qq"
    when: "os_family('debian')"
    onlyif: "! dpkg -s trivy >/dev/null 2>&1"
    depends_on: [trivy-repo-debian]

  - name: trivy-repo-rhel
    type: file
    target_path: /etc/yum.repos.d/trivy.repo
    content: |
      [trivy]
      name=Trivy
      baseurl=https://aquasecurity.github.io/trivy-repo/rpm/releases/$basearch/
      gpgcheck=0
      enabled=1
    owner: root
    group: root
    mode: "0644"
    when: "!os_family('debian')"

  - name: install-trivy
    type: package
    package: trivy
    state: present
    depends_on: [trivy-apt-update, trivy-repo-rhel]

  - name: run-trivy
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'trivy rootfs --format json --severity {{ .Vars.trivy_severity }}
      --scanners vuln --skip-files "*.log"
      --skip-dirs "/home/*/.cache,/root/.cache,/var/cache,/tmp,/var/lib/docker,/var/lib/containerd,/var/lib/snapd,/var/lib/flatpak,/proc,/sys,/dev"
      --cache-dir /var/cache/trivy --timeout {{ .Vars.trivy_timeout }}s
      --output {{ .Vars.scan_dir }}/trivy.json /
      && rm -rf /tmp/trivy-* /tmp/trivy /root/.cache/trivy 2>/dev/null
      && touch /tmp/.vigo-trivy-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-trivy-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.trivy_exec_timeout }}"
    depends_on: [install-trivy, scan-dir]

  # ── Lynis (security audit) ───────────────────────────────────────

  - name: install-lynis
    type: package
    package: lynis
    state: present

  - name: run-lynis
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'lynis audit system --no-colors --quiet
      --logfile {{ .Vars.scan_dir }}/lynis.log
      --report-file {{ .Vars.scan_dir }}/lynis-report.dat
      && touch /tmp/.vigo-lynis-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-lynis-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.lynis_timeout }}"
    depends_on: [install-lynis, scan-dir]

  # ── chkrootkit ───────────────────────────────────────────────────

  - name: install-chkrootkit
    type: package
    package: chkrootkit
    state: present

  - name: run-chkrootkit
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'chkrootkit > {{ .Vars.scan_dir }}/chkrootkit.log 2>&1 || true;
      touch /tmp/.vigo-chkrootkit-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-chkrootkit-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.chkrootkit_timeout }}"
    depends_on: [install-chkrootkit, scan-dir]

  # ── rkhunter ─────────────────────────────────────────────────────

  - name: install-rkhunter
    type: package
    package: rkhunter
    state: present

  - name: run-rkhunter
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'rkhunter --check --skip-keypress --report-warnings-only
      --logfile {{ .Vars.scan_dir }}/rkhunter.log || true;
      touch /tmp/.vigo-rkhunter-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-rkhunter-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.rkhunter_timeout }}"
    depends_on: [install-rkhunter, scan-dir]

  # ── ClamAV ───────────────────────────────────────────────────────

  - name: install-clamav-debian
    type: package
    package: clamav
    state: present
    when: "os_family('debian')"

  - name: install-clamav-daemon-debian
    type: package
    package: clamav-daemon
    state: present
    when: "os_family('debian')"
    depends_on: [install-clamav-debian]

  - name: install-clamav-rhel
    type: package
    package: clamav
    state: present
    when: "!os_family('debian')"

  - name: install-clamd-rhel
    type: package
    package: clamd
    state: present
    when: "!os_family('debian')"
    depends_on: [install-clamav-rhel]

  - name: freshclam-update
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'freshclam --quiet || true;
      touch /tmp/.vigo-freshclam-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-freshclam-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.freshclam_timeout }}"
    depends_on: [install-clamav-daemon-debian, install-clamd-rhel]

  - name: run-clamscan
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'clamscan --recursive --infected --no-summary
      --log={{ .Vars.scan_dir }}/clamav.log
      /etc /usr/bin /usr/sbin /usr/local/bin || true;
      touch /tmp/.vigo-clamscan-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-clamscan-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.clamscan_timeout }}"
    depends_on: [freshclam-update, scan-dir]

  # ── AIDE (file integrity) ────────────────────────────────────────

  - name: install-aide
    type: package
    package: aide
    state: present

  - name: aide-conf
    type: file
    target_path: /etc/aide/aide.conf
    source: templates/aide.conf.tmpl
    owner: root
    group: root
    mode: "0600"
    depends_on: [install-aide]

  - name: aide-reinit
    type: exec
    command: "sh -c 'aide --init && cp {{ .Vars.aide_db_new_path }} {{ .Vars.aide_db_path }}'"
    depends_on: [aide-conf]
    subscribes: [aide-conf]
    when: changed

  - name: aide-init
    type: exec
    command: "sh -c 'if command -v aideinit >/dev/null 2>&1; then aideinit; else aide --init && cp {{ .Vars.aide_db_new_path }} {{ .Vars.aide_db_path }}; fi'"
    onlyif: "! test -f {{ .Vars.aide_db_path }}"
    background: "true"
    timeout: "{{ .Vars.aide_init_timeout }}"
    depends_on: [aide-conf]

  - name: run-aide
    type: exec
    when: "hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'aide --check --config /etc/aide/aide.conf
      > {{ .Vars.scan_dir }}/aide.log 2>&1 || true;
      touch /tmp/.vigo-aide-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-aide-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.aide_check_timeout }}"
    depends_on: [aide-init, aide-reinit, scan-dir]

  # ── debsecan (Debian/Ubuntu CVEs) ────────────────────────────────

  - name: install-debsecan
    type: package
    package: debsecan
    state: present
    when: "os_family('debian')"

  - name: run-debsecan
    type: exec
    when: "os_family('debian') and hour_range('{{ .Vars.scan_hour_start }}','{{ .Vars.scan_hour_end }}')"
    command: >-
      sh -c 'debsecan --format detail > {{ .Vars.scan_dir }}/debsecan.log 2>&1 || true;
      touch /tmp/.vigo-debsecan-$(date +%Y%m%d)'
    onlyif: "! test -f /tmp/.vigo-debsecan-$(date +%Y%m%d)"
    background: "true"
    timeout: "{{ .Vars.debsecan_timeout }}"
    depends_on: [install-debsecan, scan-dir]
