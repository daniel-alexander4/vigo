#~ Windows audit policy — equivalent to Linux auditd-rules. Sets up
#~ auditing of credential changes, privilege use, and process creation
#~ via auditpol. Events land in Security event log.
name: auditd-rules-windows

provides: [audit-rules]

resources:
  - name: enable-account-mgmt-audit
    type: powershell
    command: "auditpol /set /category:'Account Management' /success:enable /failure:enable"
    skip_validation: true
    when: "os_family('windows')"

  - name: enable-privilege-use-audit
    type: powershell
    command: "auditpol /set /category:'Privilege Use' /success:enable /failure:enable"
    skip_validation: true
    when: "os_family('windows')"

  - name: enable-process-tracking
    type: powershell
    command: "auditpol /set /subcategory:'Process Creation' /success:enable /failure:enable"
    skip_validation: true
    when: "os_family('windows')"
