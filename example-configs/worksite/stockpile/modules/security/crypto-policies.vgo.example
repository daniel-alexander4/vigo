#~ RHEL system-wide crypto policy via update-crypto-policies. Sets the
#~ minimum TLS + cipher baseline for OpenSSL, GnuTLS, BIND, OpenSSH, etc.
#~ Available profiles: DEFAULT, LEGACY, FUTURE, FIPS.
name: crypto-policies

provides: [system-crypto-policy]

vars:
  policy: "FUTURE"

resources:
  - name: install-crypto-policies
    type: package
    package: crypto-policies
    state: present
    when: "os_family('rhel')"

  - name: apply-policy
    type: exec
    command: "update-crypto-policies --set {{ .Vars.policy }}"
    unless: "update-crypto-policies --show | grep -q '^{{ .Vars.policy }}$'"
    depends_on: [install-crypto-policies]
    when: "os_family('rhel')"
