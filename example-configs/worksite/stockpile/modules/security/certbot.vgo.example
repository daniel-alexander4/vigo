#~ Generic Let's Encrypt cert management via certbot. Issues + renews a
#~ cert for the named hostname. Operators wanting Vigo-server-specific
#~ wiring (auto-restart vigosrv on renew) use security/vigo-tls-public
#~ instead — this module is for any other host.
name: certbot

compliance:
  nist-800-53: [SC-8, SC-13, SC-17]
  iso-27001: [A.10.1.1, A.13.2.1]
  pci-dss: [4.1, 4.2]

vars:
  cert_hostname: "host.example.com"
  cert_email: "ops@example.com"
  cert_method: "standalone"

resources:
  - name: install-certbot
    type: package
    package: certbot
    state: present
    when: "os_family('linux')"

  - name: issue-cert
    type: exec
    command: 'certbot certonly --{{ .Vars.cert_method }} --non-interactive --agree-tos -m "{{ .Vars.cert_email }}" -d "{{ .Vars.cert_hostname }}"'
    onlyif: 'test ! -f "/etc/letsencrypt/live/{{ .Vars.cert_hostname }}/fullchain.pem"'
    depends_on: [install-certbot]
    when: "os_family('linux')"

  - name: certbot-renewal-timer
    type: service
    service: certbot.timer
    state: running
    enabled: true
    depends_on: [install-certbot]
    when: "os_family('linux')"
