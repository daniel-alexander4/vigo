#~ win-acme — the Windows-native Let's Encrypt client. Functional analog
#~ of the Linux certbot module. Installs via chocolatey, registers a
#~ daily scheduled task for renewal.
name: certbot-windows

compliance:
  nist-800-53: [SC-8, SC-13, SC-17]
  iso-27001: [A.10.1.1, A.13.2.1]
  pci-dss: [4.1, 4.2]

vars:
  cert_hostname: "host.example.com"
  cert_email: "ops@example.com"

resources:
  - name: install-win-acme
    type: package
    package: win-acme
    state: present
    when: "os_family('windows')"

  - name: issue-cert
    type: powershell
    command: 'wacs.exe --target manual --host "{{ .Vars.cert_hostname }}" --emailaddress "{{ .Vars.cert_email }}" --accepttos --validation selfhosting'
    onlyif: 'if (-not (Test-Path "C:\ProgramData\win-acme\httpsacme-v02.api.letsencrypt.org\Certificates\{{ .Vars.cert_hostname }}*.pfx")) { exit 0 } else { exit 1 }'
    skip_validation: true
    depends_on: [install-win-acme]
    when: "os_family('windows')"
