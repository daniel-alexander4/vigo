#~ Locks down the permissions on the Vigo secret vault.
#~
#~ vigosrv's local secrets backend stores AES-256-GCM-wrapped secret files
#~ under /srv/vigo/secrets/, all derived from the master key at
#~ /srv/vigo/secrets/.master.key. If that key is readable by anyone but
#~ the vigosrv runtime user, every wrapped secret is effectively cleartext.
#~ This module enforces mode 0600 on the master key + verifier and 0700 on
#~ the parent dir, without touching the file contents (which vigosrv owns).
#~
#~ Only meaningful on hosts running vigosrv with the `local` secrets
#~ backend (the default; ignore if using `isopass`). Linux-only.
name: vigo-secrets-perms

compliance:
  nist-800-53: [AC-3, AC-6, SC-12, SC-28]
  hipaa: [164.312(a)(2)(iv)]
  iso-27001: [A.9.4.1, A.10.1.1]
  pci-dss: [3.4, 3.5.1, 7.1]
  soc2: [CC6.1]

vars:
  vigo_root: "/srv/vigo"

resources:
  - name: secrets-dir-perms
    type: directory
    target_path: "{{ .Vars.vigo_root }}/secrets"
    owner: root
    group: root
    mode: "0700"
    when: "os_family('linux')"

  #~ chmod-only resources for the wrapped key files. vigosrv writes/rotates
  #~ these on its own schedule, so we don't manage content — just enforce
  #~ that the perms come back to 0600 if anything drifts.
  - name: master-key-perms
    type: exec
    command: 'chmod 0600 "{{ .Vars.vigo_root }}/secrets/.master.key" && chown root:root "{{ .Vars.vigo_root }}/secrets/.master.key"'
    unless: 'test "$(stat -c %a:%U:%G "{{ .Vars.vigo_root }}/secrets/.master.key" 2>/dev/null)" = "600:root:root"'
    when: "os_family('linux')"
    depends_on: [secrets-dir-perms]

  - name: master-verifier-perms
    type: exec
    command: 'chmod 0600 "{{ .Vars.vigo_root }}/secrets/.master.verifier" && chown root:root "{{ .Vars.vigo_root }}/secrets/.master.verifier"'
    unless: 'test "$(stat -c %a:%U:%G "{{ .Vars.vigo_root }}/secrets/.master.verifier" 2>/dev/null)" = "600:root:root"'
    when: "os_family('linux')"
    depends_on: [secrets-dir-perms]
