name: openssh

compliance:
  cis-ubuntu: [5.2.1, 5.2.4, 5.2.6, 5.2.7, 5.2.10, 5.2.13, 5.2.14, 5.2.15, 5.2.20]
  cis-rhel: [5.2.1, 5.2.4, 5.2.6, 5.2.7, 5.2.10, 5.2.13, 5.2.14, 5.2.15, 5.2.20]
  nist-800-53: [AC-17, IA-2]
  pci-dss: [2.2.7, 8.3.1]
  hipaa: [164.312(a)(1), 164.312(d), 164.312(e)(1)]
  iso-27001: [A.9.4.2, A.13.2.1]
# Prefer: cis-ubuntu-access or cis-rhel-access (compliance roles include SSH
# hardening with stronger crypto, compliance tags, and more settings).
# Only use this module if you are NOT using CIS compliance roles — both manage
# SSH config and will conflict.

vars:
  ssh_port: "22"
  ssh_permit_root: "no"
  ssh_max_auth_tries: "3"
  ssh_allow_groups: "sshusers sudo"

resources:
  - name: install-openssh
    type: package
    package: openssh-server
    state: present

  - name: sshd-config
    type: file
    target_path: /etc/ssh/sshd_config
    content: |
      Port {{ .Vars.ssh_port }}
      Protocol 2
      HostKey /etc/ssh/ssh_host_ed25519_key
      HostKey /etc/ssh/ssh_host_rsa_key

      # Authentication
      PermitRootLogin {{ .Vars.ssh_permit_root }}
      MaxAuthTries {{ .Vars.ssh_max_auth_tries }}
      PubkeyAuthentication yes
      PasswordAuthentication no
      PermitEmptyPasswords no
      ChallengeResponseAuthentication no

      # Access control
      AllowGroups {{ .Vars.ssh_allow_groups }}

      # Security
      X11Forwarding no
      AllowTcpForwarding no
      AllowAgentForwarding no
      ClientAliveInterval 300
      ClientAliveCountMax 2
      LoginGraceTime 30
      MaxStartups 10:30:60

      # Logging
      SyslogFacility AUTH
      LogLevel VERBOSE

      # Subsystems
      Subsystem sftp /usr/lib/openssh/sftp-server
    owner: root
    group: root
    mode: "0600"
    depends_on: [install-openssh]
    notify: [sshd-service-debian, sshd-service-redhat]

  - name: sshd-service-debian
    type: service
    service: ssh
    enabled: true
    state: running
    depends_on: [sshd-config]
    when: "os_family('debian')"

  - name: sshd-service-redhat
    type: service
    service: sshd
    enabled: true
    state: running
    depends_on: [sshd-config]
    when: "!os_family('debian')"
