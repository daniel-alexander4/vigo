name: fail2ban

compliance:
  nist-800-53: [AC-7]
  pci-dss: [8.3.4]
  hipaa: [164.308(a)(5)(ii)(D)]
  iso-27001: [A.9.4.2]

resources:
  - name: install-fail2ban
    type: package
    package: fail2ban
    state: present

  - name: fail2ban-jail
    type: file
    target_path: /etc/fail2ban/jail.local
    content: |
      [DEFAULT]
      bantime = 3600
      findtime = 600
      maxretry = 5

      [sshd]
      enabled = true
      port = {{ .Vars.ssh_port }}
      filter = sshd
      logpath = /var/log/auth.log
      maxretry = 3
      bantime = 7200
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-fail2ban]
    notify: [fail2ban-service]

  - name: fail2ban-logrotate
    type: logrotate
    path: /var/log/fail2ban.log
    frequency: daily
    rotate: "7"
    compress: "true"
    missingok: "true"
    notifempty: "true"
    copytruncate: "true"
    depends_on: [install-fail2ban]

  - name: fail2ban-service
    type: service
    service: fail2ban
    enabled: true
    state: running
    depends_on: [fail2ban-jail]
