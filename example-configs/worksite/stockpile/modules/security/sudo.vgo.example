name: sudo

compliance:
  cis-ubuntu: [5.3.1, 5.3.2, 5.3.3, 5.3.4]
  cis-rhel: [5.3.1, 5.3.2, 5.3.3, 5.3.4]
  nist-800-53: [AC-6, AU-2]
  pci-dss: [7.2.1, 7.2.2, 7.2.3, 8.2.1, 10.2.1.2]
  hipaa: [164.308(a)(4)(ii)(B), 164.312(a)(1)]
  iso-27001: [A.9.2.3, A.9.4.4]

vars:
  passwordless: "false"
  env_keep: "SSH_AUTH_SOCK EDITOR VISUAL"

resources:
  - name: install-sudo
    type: package
    package: sudo
    state: present

  - name: sudoers
    type: file
    target_path: /etc/sudoers
    content: |
      # /etc/sudoers — managed by vigo
      Defaults    env_reset
      Defaults    mail_badpass
      Defaults    secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      Defaults    logfile="/var/log/sudo.log"
      Defaults    log_input, log_output
      Defaults    env_keep += "{{ .Vars.env_keep }}"

      root ALL=(ALL:ALL) ALL

      #includedir /etc/sudoers.d
    owner: root
    group: root
    mode: "0440"
    depends_on: [install-sudo]

  - name: sudoers-vigo
    type: file
    target_path: /etc/sudoers.d/vigo
    content: |
      # /etc/sudoers.d/vigo — managed by vigo
      {{ if eq .Traits.os.family "redhat" -}}
      {{ if eq .Vars.passwordless "true" -}}
      %wheel ALL=(ALL:ALL) NOPASSWD: ALL
      {{ else -}}
      %wheel ALL=(ALL:ALL) ALL
      {{ end -}}
      {{ else -}}
      {{ if eq .Vars.passwordless "true" -}}
      %sudo ALL=(ALL:ALL) NOPASSWD: ALL
      {{ else -}}
      %sudo ALL=(ALL:ALL) ALL
      {{ end -}}
      {{ end -}}
    owner: root
    group: root
    mode: "0440"
    depends_on: [install-sudo]
