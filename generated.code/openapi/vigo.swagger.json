          "format": "int32"
        },
        "changed": {
          "type": "integer",
          "format": "int32",
          "description": "Drift axis (orthogonal to failure; diverged is a subset of changed)."
        },
        "diverged": {
          "type": "integer",
          "format": "int32"
        },
        "offline": {
          "type": "integer",
          "format": "int32",
          "description": "Reachability."
        },
        "convergencePct": {
          "type": "number",
          "format": "float"
        },
        "snapshotAgeSeconds": {
          "type": "string",
          "format": "int64",
          "description": "snapshot_age_seconds is the age, in seconds, of the oldest peer\nfleet-snapshot that contributed to this aggregate (spanner Slice\n2-ii-a). Zero when the answer is purely local (standalone, or the\nhub-fan-out / fanout paths which query peers live). Operators read\nit to gauge how stale a gossip-aggregated answer is."
        }
      }
    },
