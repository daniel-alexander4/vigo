# Per-environment overrides — modules and vars that differ by environment.
# Place this file at any directory level. The environment: field on each
# match block determines which block applies.
#
# See: docs/concepts/multi-axis-config.md

env:
  production:
    configcrates: [hardening, audit-logging]
    vars:
      log_level: "warn"
      backup_schedule: "0 */4 * * *"

  staging:
    configcrates: [debug-tools]
    exclude_configcrates: [hardening]
    vars:
      log_level: "debug"

  dev:
    configcrates: [debug-tools, mock-services]
    exclude_configcrates: [hardening, audit-logging]
    vars:
      log_level: "debug"
