#~ Manages timezone resources
name: timezone

compliance:
  cis: [6.1.1]
  nist-800-53: [AU-8, AU-8(1)]
  pci-dss: [10.4, 10.4.1, 10.4.3]
  soc2: [CC7.2]
  hipaa: [164.312(b)]
  disa-stig: [V-238330]

resources:
  #~ Manage set-timezone (timezone)
  - name: set-timezone
    type: timezone
    timezone: "{{.Vars.system_timezone}}"
