# Configcrates and vars defined here are inherited by all envoy entries
# in subdirectories. Edit this file to set your fleet-wide baseline.
#
# Example:
#   configcrates: [sshd, ntp, monitoring, motd]
#   vars:
#     dns_server: "1.1.1.1"
#     ntp_server: pool.ntp.org
#
# See docs/reference/configcrate-language.md (directory inheritance).

configcrates: []
