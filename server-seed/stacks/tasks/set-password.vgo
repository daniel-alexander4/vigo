name: set-password
description: Change a user's password via chpasswd.
timeout: 30
parameters:
  username:
    type: string
    required: true
    description: Username to change password for
  new_password:
    type: string
    required: true
    description: New password (use secret resolution)
script: |
  echo "${PARAM_USERNAME}:${PARAM_NEW_PASSWORD}" | chpasswd
