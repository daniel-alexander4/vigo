name: sysctl-tuning
# NOTE: If using CIS compliance roles (cis-ubuntu, cis-rhel), review for
# conflicts — those roles set net.ipv4.ip_forward=0 and other network sysctls
# via /etc/sysctl.d/60-cis-network.conf. This module sets ip_forward=1.
# Safe to use together if you override the CIS network module or exclude it,
# but assigning both with conflicting values will cause convergence flip-flop.

vars:
  vm_swappiness: "10"
  somaxconn: "65535"
  ip_forward: "1"
  tcp_tw_reuse: "1"
  file_max: "2097152"
  rmem_max: "16777216"
  wmem_max: "16777216"

resources:
  - name: vm-swappiness
    type: sysctl
    key: vm.swappiness
    value: "10"

  - name: net-somaxconn
    type: sysctl
    key: net.core.somaxconn
    value: "65535"

  - name: ip-forward
    type: sysctl
    key: net.ipv4.ip_forward
    value: "1"

  - name: tcp-tw-reuse
    type: sysctl
    key: net.ipv4.tcp_tw_reuse
    value: "1"

  - name: file-max
    type: sysctl
    key: fs.file-max
    value: "2097152"

  - name: rmem-max
    type: sysctl
    key: net.core.rmem_max
    value: "16777216"

  - name: wmem-max
    type: sysctl
    key: net.core.wmem_max
    value: "16777216"
