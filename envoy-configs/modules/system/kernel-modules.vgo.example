name: kernel-modules
# NOTE: If using CIS compliance roles (cis-ubuntu, cis-rhel), review for
# overlap — those roles blacklist cramfs and 7 other unused filesystems via
# /etc/modprobe.d/cis-filesystems.conf. This module also disables cramfs.
# Safe to use together (both blacklist cramfs), but the CIS module covers
# more filesystem types.

resources:
  # Container networking (required for Kubernetes, Docker Swarm)
  - name: br-netfilter
    type: kernel_module
    module: br_netfilter
    state: present

  # Container storage driver (overlay2)
  - name: overlay
    type: kernel_module
    module: overlay
    state: present

  # IPVS for load balancing (kube-proxy IPVS mode)
  - name: ip-vs
    type: kernel_module
    module: ip_vs
    state: present

  # Disable cramfs — rarely needed, reduces attack surface
  - name: disable-cramfs
    type: kernel_module
    module: cramfs
    state: absent

  # Reboot if kernel module changes require it
  - name: reboot-after-kmod
    type: reboot
    delay: "1"
    message: "Kernel module changes require reboot"
    reboot_required_file: /var/run/reboot-required
    subscribes: [br-netfilter, overlay, ip-vs, disable-cramfs]
