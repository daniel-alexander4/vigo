#~ Manages directory, file, exec resources for server backup
name: vigo-server-backup

vars:
  backup_dest: "/srv/backups.vigo"
  backup_db_src: "/srv/vigo/db/vigo.db"
  backup_src: "/srv/vigo"
  backup_hour_start: "2"
  backup_hour_end: "4"

resources:
  #~ Create backup destination directory
  - name: backup-dir
    type: directory
    target_path: "{{ .Vars.backup_dest }}"
    owner: root
    group: root
    mode: "0555"

  #~ Deploy backup script
  - name: backup-script
    type: file
    target_path: /usr/local/bin/vigo-backup.sh
    owner: root
    group: root
    mode: "0700"
    content: |
      #!/bin/sh
      set -e
      DEST="{{ .Vars.backup_dest }}"
      DB_SRC="{{ .Vars.backup_db_src }}"
      SRC="{{ .Vars.backup_src }}"
      STAMP="/tmp/.vigo-backup-$(date +%Y%m%d)"

      # Consistent SQLite snapshot first.
      if [ -f "$DB_SRC" ]; then
        SNAP_DIR="$DEST/db"
        mkdir -p "$SNAP_DIR"
        sqlite3 "$DB_SRC" "VACUUM INTO '$SNAP_DIR/vigo.db'"
      fi

      # Unlock backup dir.
      chmod 755 "$DEST"

      # Rsync everything except the live DB files (we snapshot those above).
      rsync -a --delete \
        --exclude 'db/vigo.db' \
        --exclude 'db/vigo.db-wal' \
        --exclude 'db/vigo.db-shm' \
        "$SRC/" "$DEST/"

      # Lock backup dir.
      chmod 555 "$DEST"

      # Write daily sentinel so we only run once per day.
      touch "$STAMP"
    depends_on: [backup-dir]

  #~ Run backup once daily during the configured hour window
  - name: run-backup
    type: exec
    command: /usr/local/bin/vigo-backup.sh
    when: "hour_range('{{ .Vars.backup_hour_start }}','{{ .Vars.backup_hour_end }}')"
    onlyif: "! test -f /tmp/.vigo-backup-$(date +%Y%m%d)"
    depends_on: [backup-script]
