name: standard-users

compliance:
  cis: ["5.4.1", "5.4.2", "5.5.1", "5.5.3"]
  nist-800-53: [AC-2, AC-3, AC-5, AC-6, AC-6(1), IA-2, IA-5]
  pci-dss: ["8.1.1", "8.1.2", "8.1.4", "8.2.1", "8.3.1", "8.6.1"]
  soc2: [CC6.1, CC6.2, CC6.3]
  hipaa: ["164.312(a)(1)", "164.312(a)(2)(i)", "164.312(d)"]
  disa-stig: [V-238342, V-238343, V-238345]

resources:
  # --- Admin user with SSH access and sudo ---
  - name: dan
    type: user
    username: dan
    comment: "Dan Smith"
    password: "secret:vigo/users/dan-password-hash"
    shell: /bin/bash
    groups: "sudo,docker"
    authorized_keys: |
      ssh-ed25519 AAAA... dan@workstation
      ssh-ed25519 AAAA... dan@phone
    state: present

  # --- Deploy user for CI/CD (no interactive login) ---
  - name: deploy
    type: user
    username: deploy
    comment: "CI/CD Deploy"
    shell: /usr/sbin/nologin
    groups: "docker"
    authorized_keys: |
      ssh-ed25519 AAAA... ci@github-actions
    state: present

  # --- System user for an application (no home, no login) ---
  - name: appuser
    type: user
    username: appuser
    system: "true"
    uid: "900"
    shell: /usr/sbin/nologin
    group: nogroup
    state: present

  # --- Remove a former employee ---
  - name: olduser
    type: user
    username: olduser
    state: absent
