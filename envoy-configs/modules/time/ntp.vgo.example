name: ntp
# Prefer: cis-ubuntu-services or cis-rhel-services (CIS benchmarks require
# chrony, not ntpd). Only use this module on systems that cannot run chrony.

vars:
  ntp_server_1: "0.pool.ntp.org"
  ntp_server_2: "1.pool.ntp.org"
  ntp_server_3: "2.pool.ntp.org"

resources:
  - name: install-ntp
    type: package
    package: ntp
    state: present

  - name: ntp-conf
    type: file
    target_path: /etc/ntp.conf
    content: |
      # Managed by Vigo — do not edit manually
      driftfile /var/lib/ntp/ntp.drift

      # Restrict default access
      restrict default kod nomodify notrap nopeer noquery
      restrict -6 default kod nomodify notrap nopeer noquery
      restrict 127.0.0.1
      restrict ::1

      # NTP servers
      server {{ .Vars.ntp_server_1 }} iburst
      server {{ .Vars.ntp_server_2 }} iburst
      server {{ .Vars.ntp_server_3 }} iburst
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-ntp]
    notify: [ntp-service-debian, ntp-service-redhat]

  - name: ntp-service-debian
    type: service
    service: ntp
    enabled: true
    state: running
    depends_on: [ntp-conf]
    when: "os_family('debian')"

  - name: ntp-service-redhat
    type: service
    service: ntpd
    enabled: true
    state: running
    depends_on: [ntp-conf]
    when: "!os_family('debian')"
