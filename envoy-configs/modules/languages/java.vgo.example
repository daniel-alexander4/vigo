name: java

vars:
  java_home: "/usr/lib/jvm/default-java"

resources:
  - name: install-java-debian
    type: package
    package: openjdk-17-jdk
    state: present
    when: "os_family('debian')"

  - name: install-java-redhat
    type: package
    package: java-17-openjdk-devel
    state: present
    when: "!os_family('debian')"

  - name: set-java-alternative-debian
    type: alternatives
    path: "/usr/lib/jvm/java-17-openjdk-{{ .Traits.os.arch }}/bin/java"
    link: /usr/bin/java
    priority: "100"
    depends_on: [install-java-debian]
    when: "os_family('debian')"

  - name: set-java-alternative-redhat
    type: alternatives
    path: /usr/lib/jvm/java-17-openjdk/bin/java
    link: /usr/bin/java
    priority: "100"
    depends_on: [install-java-redhat]
    when: "!os_family('debian')"

  - name: java-profile
    type: file
    target_path: /etc/profile.d/java.sh
    content: |
      # Managed by Vigo — do not edit manually
      export JAVA_HOME="{{ .Vars.java_home }}"
      export PATH="$JAVA_HOME/bin:$PATH"
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-java-debian, install-java-redhat]
