name: lvm

vars:
  lvm_disk: "/dev/sdb"
  vg_name: "data_vg"
  lv_name: "data_lv"
  lv_size: "100%FREE"
  fs_type: "ext4"
  mount_point: "/data"

resources:
  - name: install-lvm
    type: package
    package: lvm2
    state: present

  # --- Physical volume ---

  - name: create-pv
    type: exec
    command: "pvcreate /dev/sdb"
    when: "!command_succeeds('pvs /dev/sdb')"
    depends_on: [install-lvm]

  # --- Volume group ---

  - name: create-vg
    type: exec
    command: "vgcreate data_vg /dev/sdb"
    when: "!command_succeeds('vgs data_vg')"
    depends_on: [create-pv]

  # --- Logical volume ---

  - name: create-lv
    type: exec
    command: "lvcreate -l 100%FREE -n data_lv data_vg"
    when: "!command_succeeds('lvs data_vg/data_lv')"
    depends_on: [create-vg]

  # --- Filesystem ---

  - name: format-lv
    type: exec
    command: "mkfs.ext4 /dev/data_vg/data_lv"
    when: "!command_succeeds('blkid /dev/data_vg/data_lv')"
    depends_on: [create-lv]

  # --- Mount ---

  - name: mount-dir
    type: directory
    target_path: /data
    owner: root
    group: root
    mode: "0755"

  - name: mount-lv
    type: mount
    path: /data
    device: /dev/data_vg/data_lv
    fstype: ext4
    options: "defaults,noatime"
    state: mounted
    depends_on: [format-lv, mount-dir]
