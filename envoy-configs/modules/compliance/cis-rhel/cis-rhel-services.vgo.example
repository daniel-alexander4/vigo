name: cis-rhel-services
# CIS Red Hat Enterprise Linux Benchmark — Section 2: Services
# Level 1 + Level 2 controls
# Applies to: RHEL 8/9, CentOS Stream 8/9, Rocky Linux 8/9, AlmaLinux 8/9

compliance:
  cis-rhel: ["2.1.1", "2.1.2", "2.1.3", "2.1.4", "2.1.5", "2.1.6", "2.1.7", "2.1.8", "2.1.9", "2.1.10", "2.1.11", "2.2.1", "2.2.2", "2.2.3", "2.2.4", "2.2.5"]
  cis: [2.1.x, 2.2.x, 2.3.x]
  nist-800-53: [CM-7]
  pci-dss: ["2.2.2", "2.2.3"]

vars:
  ntp_server: "time.cloudflare.com"

resources:
  # --- 2.1: Time synchronization ---

  - name: 2.1.1-chrony-installed
    type: package
    package: chrony
    state: present

  - name: 2.1.1-chrony-config
    type: file
    target_path: /etc/chrony.conf.d/cis.conf
    content: |
      # CIS 2.1.1 — NTP via chrony
      server {{ .Vars.ntp_server }} iburst
    owner: root
    group: root
    mode: "0644"
    depends_on: [2.1.1-chrony-installed]
    notify: [2.1.1-chrony-service]

  - name: 2.1.1-chrony-service
    type: service
    service: chronyd
    state: running
    enabled: true

  # --- 2.1.2–2.1.11: Disable unnecessary services ---

  - name: 2.1.2-remove-xorg
    type: package
    package: xorg-x11-server-Xorg
    state: absent

  - name: 2.1.3-disable-avahi
    type: service
    service: avahi-daemon
    state: stopped
    enabled: false

  - name: 2.1.4-disable-cups
    type: service
    service: cups
    state: stopped
    enabled: false

  - name: 2.1.5-disable-dhcpd
    type: service
    service: dhcpd
    state: stopped
    enabled: false

  - name: 2.1.6-disable-slapd
    type: service
    service: slapd
    state: stopped
    enabled: false

  - name: 2.1.7-disable-nfs
    type: service
    service: nfs-server
    state: stopped
    enabled: false

  - name: 2.1.8-disable-named
    type: service
    service: named
    state: stopped
    enabled: false

  - name: 2.1.9-disable-vsftpd
    type: service
    service: vsftpd
    state: stopped
    enabled: false

  - name: 2.1.10-disable-httpd
    type: service
    service: httpd
    state: stopped
    enabled: false

  - name: 2.1.11-disable-dovecot
    type: service
    service: dovecot
    state: stopped
    enabled: false

  # --- 2.2: Remove unnecessary packages ---

  - name: 2.2.1-remove-ypbind
    type: package
    package: ypbind
    state: absent

  - name: 2.2.2-remove-telnet
    type: package
    package: telnet
    state: absent

  - name: 2.2.3-remove-rsh
    type: package
    package: rsh
    state: absent

  - name: 2.2.4-remove-talk
    type: package
    package: talk
    state: absent

  - name: 2.2.5-remove-openldap-clients
    type: package
    package: openldap-clients
    state: absent
