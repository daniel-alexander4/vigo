name: hitrust-governance
compliance:
  hitrust: [06.c, 06.g, 06.h, 06.i, 07.a, 09.b, 09.c, 09.d, 09.l, 10.f, 10.g, 10.k, 10.l, 10.m]
  iso-27001: [A.5.1, A.6.1, A.14.1.2, A.14.2.2, A.18.2.2, A.18.2.3]
  nist-800-53: [CM-8, CA-7]
  soc2: [CC3.1, CC3.2, CC3.3, CC4.1, CC4.2, CC5.1, CC5.2, CC5.3]

resources:
  # 07.a: Asset inventory — hardware/software tracking
  - name: dmidecode
    type: package
    package: dmidecode
    state: present

  - name: lshw
    type: package
    package: lshw
    state: present

  - name: weekly-asset-inventory
    type: cron
    job: "lshw -short > /var/log/asset-inventory.txt 2>/dev/null && dpkg -l > /var/log/software-inventory.txt 2>/dev/null"
    schedule: "0 6 * * 1"
    weekday: "1"
    hour: "6"
    minute: "0"
    user: root

  # 06.c/06.g: Compliance monitoring — regular audits
  - name: lynis-package
    type: package
    package: lynis
    state: present

  - name: weekly-compliance-audit
    type: cron
    job: "/usr/bin/lynis audit system --cronjob --quiet"
    schedule: "0 3 * * 0"
    weekday: "0"
    hour: "3"
    minute: "0"
    user: root

  # 09.b/09.c/09.d: Capacity/system planning/acceptance
  - name: sysstat-package
    type: package
    package: sysstat
    state: present

  - name: sysstat-enabled
    type: service
    service: sysstat
    state: running
    enabled: true

  # 10.k/10.l/10.m: Crypto controls, key management, change control
  - name: openssl-package
    type: package
    package: openssl
    state: present

  - name: cert-expiry-check
    type: cron
    job: "find /etc/ssl/certs -name '*.pem' -exec openssl x509 -enddate -noout -in {} \\; 2>/dev/null | grep -i 'notafter' | logger -t cert-check"
    schedule: "0 7 * * 1"
    weekday: "1"
    hour: "7"
    minute: "0"
    user: root
