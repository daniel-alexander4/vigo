name: nist-system-integrity
compliance:
  cyber-essentials: [CE-MW-1, CE-SU-2]
  hipaa: [164.308(a)(5)(ii)(D)]
  iso-27001: [A.12.2.1, A.12.6.1]
  nist-800-53: [SI-2, SI-3, SI-4, SI-7]
  pci-dss: [5.2.1, 5.2.2, 6.3.3, 11.5.1, 11.5.1.1]
  soc2: [CC7.1, CC8.1]
resources:
  # SI-3: Malicious code protection
  - name: clamav-package
    type: package
    package: clamav
    state: present

  - name: clamav-daemon
    type: package
    package: clamav-daemon
    state: present

  - name: clamav-service
    type: service
    service: clamav-daemon
    state: running
    enabled: true

  - name: freshclam-service
    type: service
    service: clamav-freshclam
    state: running
    enabled: true

  # SI-4: System monitoring — process accounting
  - name: acct-package
    type: package
    package: acct
    state: present

  - name: acct-service
    type: service
    service: acct
    state: running
    enabled: true

  # SI-7: Software integrity — debsums for package verification
  - name: debsums-package
    type: package
    package: debsums
    state: present

  - name: debsums-cron
    type: cron
    job: "/usr/bin/debsums --changed --silent 2>&1 | logger -t debsums-check"
    hour: "4"
    minute: "30"
    user: root

  # SI-2: Flaw remediation — ensure security updates are applied
  - name: apt-security-check
    type: cron
    job: "/usr/bin/apt-get update -q && /usr/lib/update-notifier/apt-check --human-readable | logger -t security-updates"
    hour: "6"
    minute: "0"
    user: root
