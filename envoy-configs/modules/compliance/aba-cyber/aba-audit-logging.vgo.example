name: aba-audit-logging
# ABA Cybersecurity — Audit Logging
# Covers: ABA-477R-9 (audit logging)

compliance:
  aba-cyber: [ABA-477R-9]

resources:
  - name: auditd-installed
    type: package
    package: auditd
    state: present
    when: "os_family('debian') || os_family('redhat')"

  - name: auditd-running
    type: service
    service: auditd
    state: running
    enabled: true
    when: "os_family('debian') || os_family('redhat')"

  - name: audit-rules-logins
    type: file_line
    target_path: /etc/audit/rules.d/vigo-aba.rules
    line: "-w /var/log/faillog -p wa -k logins"
    when: "os_family('debian') || os_family('redhat')"

  - name: audit-rules-sudo
    type: file_line
    target_path: /etc/audit/rules.d/vigo-aba.rules
    line: "-w /etc/sudoers -p wa -k scope"
    when: "os_family('debian') || os_family('redhat')"

  - name: audit-rules-passwd
    type: file_line
    target_path: /etc/audit/rules.d/vigo-aba.rules
    line: "-w /etc/passwd -p wa -k identity"
    when: "os_family('debian') || os_family('redhat')"
