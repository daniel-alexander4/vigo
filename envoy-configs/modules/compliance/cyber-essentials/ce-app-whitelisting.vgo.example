name: ce-app-whitelisting
compliance:
  cyber-essentials: [CE-MW-4, CE-MW-5]
  nist-800-53: [CM-11]
  iso-27001: [A.12.5.1]

resources:
  - name: fapolicyd-package
    type: package
    package: fapolicyd
    state: present
    when: "os_family('rhel')"

  - name: fapolicyd-service
    type: service
    service: fapolicyd
    state: running
    enabled: true
    when: "os_family('rhel')"

  - name: apparmor-package
    type: package
    package: apparmor
    state: present
    when: "os_family('debian')"

  - name: apparmor-utils
    type: package
    package: apparmor-utils
    state: present
    when: "os_family('debian')"

  - name: apparmor-service
    type: service
    service: apparmor
    state: running
    enabled: true
    when: "os_family('debian')"

  - name: apparmor-enforce
    type: exec
    command: aa-enforce /etc/apparmor.d/*
    onlyif: "aa-status 2>/dev/null | grep -q 'complain mode'"
    when: "os_family('debian')"
