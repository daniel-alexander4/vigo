name: ce-secure-config
compliance:
  cis: [1.1.1, 5.2.x]
  cyber-essentials: [CE-SC-1, CE-SC-2, CE-SC-3, CE-SC-4, CE-SC-5, CE-SC-6]
  nist-800-53: [CM-6, CM-7]
  pci-dss: [2.2.1, 2.2.4, 2.2.5]
resources:
  # Remove unnecessary packages
  - name: remove-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-rsh-client
    type: package
    package: rsh-client
    state: absent

  - name: remove-talk
    type: package
    package: talk
    state: absent

  # Disable unnecessary accounts
  - name: disable-guest-account
    type: exec
    command: usermod -L guest
    onlyif: "getent passwd guest && ! passwd -S guest | grep -q L"

  # Disable USB autorun
  - name: disable-usb-storage
    type: file
    target_path: /etc/modprobe.d/usb-storage.conf
    content: "install usb-storage /bin/true\nblacklist usb-storage\n"
    mode: "0644"

  # Screen lock timeout (15 minutes)
  - name: tmout-profile
    type: file
    target_path: /etc/profile.d/tmout.sh
    content: |
      readonly TMOUT=900
      export TMOUT
    mode: "0644"

  # Login banner
  - name: login-banner
    type: file
    target_path: /etc/issue.net
    content: |
      Authorized users only. All activity is monitored and recorded.
      Unauthorized access is prohibited and will be prosecuted.
    mode: "0644"
