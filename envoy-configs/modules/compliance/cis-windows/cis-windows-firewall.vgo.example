name: cis-windows-firewall
# CIS Windows Server 2022 Level 1 — Windows Firewall
# Status: ENFORCED by Vigo

compliance:
  cis-windows: [9.1.1, 9.1.2, 9.1.3, 9.2.1, 9.2.2, 9.3.1, 9.3.2]

resources:
  - name: firewall-domain-on
    type: firewall_windows
    profile: domain
    enabled: true
    default_inbound: block
    default_outbound: allow

  - name: firewall-private-on
    type: firewall_windows
    profile: private
    enabled: true
    default_inbound: block
    default_outbound: allow

  - name: firewall-public-on
    type: firewall_windows
    profile: public
    enabled: true
    default_inbound: block
    default_outbound: allow
