name: cis-ssh-hardening
compliance:
  cis: [5.2.x]
  cyber-essentials: [CE-SC-5, CE-AC-3]
  hipaa: [164.312(e)(1)]
  iso-27001: [A.9.4.1, A.13.1.1]
  nist-800-53: [AC-17, IA-2, SC-8]
  pci-dss: [2.2.1, 2.2.4, 2.2.5, 8.3.1, 8.3.6]
vars:
  ssh_port: "22"
  max_auth_tries: "4"
  client_alive_interval: "300"
  client_alive_count_max: "3"
  login_grace_time: "60"

resources:
  - name: openssh-server
    type: package
    package: openssh-server
    state: present

  # CIS 5.2.1: Permissions on sshd_config
  - name: 5.2.1-sshd-config-perms
    type: exec
    command: chmod 0600 /etc/ssh/sshd_config && chown root:root /etc/ssh/sshd_config
    onlyif: "! stat -c '%a %U:%G' /etc/ssh/sshd_config | grep -q '600 root:root'"

  # CIS 5.2.2-5.2.6: SSH server configuration
  - name: cis-sshd-config
    type: file
    target_path: /etc/ssh/sshd_config.d/90-cis-hardening.conf
    content: |
      # CIS 5.2.2: SSH Protocol
      Protocol 2

      # CIS 5.2.3: SSH LogLevel
      LogLevel VERBOSE

      # CIS 5.2.4: Disable root login
      PermitRootLogin no

      # CIS 5.2.5: MaxAuthTries
      MaxAuthTries {{.Vars.max_auth_tries}}

      # CIS 5.2.6: IgnoreRhosts
      IgnoreRhosts yes

      # Additional hardening
      Port {{.Vars.ssh_port}}
      LoginGraceTime {{.Vars.login_grace_time}}
      PermitEmptyPasswords no
      ClientAliveInterval {{.Vars.client_alive_interval}}
      ClientAliveCountMax {{.Vars.client_alive_count_max}}
      X11Forwarding no
      AllowTcpForwarding no
      MaxStartups 10:30:60
      Banner /etc/issue.net
      UsePAM yes

      # Strong crypto
      Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com,aes256-ctr
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512
    mode: "0644"
    notify: [restart-sshd]

  - name: restart-sshd
    type: service
    service: sshd
    state: restarted
    when: "changed"
