name: cis-kernel-hardening
# NOTE: This is the legacy generic CIS kernel module. Prefer the distro-specific
# modules (cis-ubuntu-filesystem, cis-rhel-filesystem) which cover the same
# sysctls plus filesystem blacklisting, bootloader permissions, and more.
# Do not assign both this module and a distro-specific CIS filesystem module.
compliance:
  cis: [1.5.1, 1.5.3, 3.2.x]
  cyber-essentials: [CE-SC-5]
  iso-27001: [A.13.1.1]
  nist-800-53: [SC-7, CM-6]
  pci-dss: [2.2.1, 2.2.4, 2.2.5]
resources:
  # CIS 1.5.1: Ensure ASLR enabled
  - name: 1.5.1-enable-aslr
    type: file
    target_path: /etc/sysctl.d/99-cis-kernel.conf
    content: |
      # CIS 1.5.1 — ASLR
      kernel.randomize_va_space = 2

      # CIS 1.5.2 — Restrict ptrace
      kernel.yama.ptrace_scope = 1

      # CIS 1.5.3 — Restrict core dumps
      fs.suid_dumpable = 0

      # CIS 3.2.1 — Disable IP forwarding
      net.ipv4.ip_forward = 0
      net.ipv6.conf.all.forwarding = 0

      # CIS 3.2.2 — Disable packet redirect sending
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0

      # Network hardening
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv4.conf.default.secure_redirects = 0
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      net.ipv4.tcp_syncookies = 1
      net.ipv6.conf.all.accept_ra = 0
      net.ipv6.conf.default.accept_ra = 0
    mode: "0644"
    notify: [apply-sysctl]

  - name: apply-sysctl
    type: exec
    command: sysctl --system
    when: "changed"

  # CIS 1.5.3: Core dump restriction via limits
  - name: 1.5.3-disable-core-dumps
    type: file
    target_path: /etc/security/limits.d/99-cis-coredump.conf
    content: |
      * hard core 0
    mode: "0644"
