name: cis-windows-hardening
# NOTE: This is the legacy combined CIS Windows module. Prefer the granular
# modules in cis-windows/ (account-policies, audit-policies, firewall,
# security-options, user-rights, network, system-services, components) which
# cover more controls and use the cis-windows compliance tag.
# Do not assign both this module and the cis-windows role.
compliance:
  cis: [W-1.1.x, W-1.2.x, W-2.3.x, W-17.x]
  pci-dss: [2.2.1, 2.2.4, 8.3.9]
  nist-800-53: [CM-6, AC-8]
  cyber-essentials: [CE-SC-5, CE-SC-6]

resources:
  # W-1.1.x: Account policies — password policy
  - name: w-password-length
    type: local_security_policy
    policy: MinimumPasswordLength
    value: "14"

  - name: w-password-history
    type: local_security_policy
    policy: PasswordHistorySize
    value: "24"

  - name: w-password-complexity
    type: local_security_policy
    policy: PasswordComplexity
    value: "1"

  - name: w-password-max-age
    type: local_security_policy
    policy: MaximumPasswordAge
    value: "90"

  # W-1.2.x: Account lockout policies
  - name: w-lockout-threshold
    type: local_security_policy
    policy: LockoutBadCount
    value: "5"

  - name: w-lockout-duration
    type: local_security_policy
    policy: ResetLockoutCount
    value: "15"

  # W-2.3.x: Security options
  - name: w-interactive-logon-message-title
    type: registry
    key: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System
    value: legalnoticecaption
    data: "WARNING"
    reg_type: REG_SZ

  - name: w-interactive-logon-message-text
    type: registry
    key: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System
    value: legalnoticetext
    data: "This system is for authorized use only. All activity is monitored."
    reg_type: REG_SZ

  # W-17.x: Advanced audit policy
  - name: w-audit-logon
    type: powershell
    command: "auditpol /set /subcategory:'Logon' /success:enable /failure:enable"
    onlyif: "auditpol /get /subcategory:'Logon' | Select-String 'No Auditing'"

  - name: w-audit-account-management
    type: powershell
    command: "auditpol /set /subcategory:'User Account Management' /success:enable /failure:enable"
    onlyif: "auditpol /get /subcategory:'User Account Management' | Select-String 'No Auditing'"

  - name: w-audit-policy-change
    type: powershell
    command: "auditpol /set /subcategory:'Audit Policy Change' /success:enable /failure:enable"
    onlyif: "auditpol /get /subcategory:'Audit Policy Change' | Select-String 'No Auditing'"
