name: cis-audit-logging
# NOTE: This is the legacy generic CIS logging module. Prefer the distro-specific
# modules (cis-ubuntu-logging, cis-rhel-logging) which include the same audit
# rules plus distro-correct paths and boot-time audit configuration.
# Do not assign both this module and a distro-specific CIS logging module.
compliance:
  cis: [4.1.x, 4.1.immutable, 4.2.x, 5.4.x, 5.4.4, 5.4.5]
  nist-800-53: [AU-2, AU-3, AU-12]
  pci-dss: [10.2.1, 10.2.2]
  iso-27001: [A.12.4.1, A.12.4.3]
  soc2: [CC7.2]

resources:
  # CIS 4.1.x: Audit system configuration
  - name: auditd-package
    type: package
    package: auditd
    state: present

  - name: auditd-service
    type: service
    service: auditd
    state: running
    enabled: true

  - name: cis-audit-rules
    type: file
    target_path: /etc/audit/rules.d/cis.rules
    content: |
      # CIS 4.1.3: Events that modify date/time
      -a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time-change
      -a always,exit -F arch=b64 -S clock_settime -k time-change
      -w /etc/localtime -p wa -k time-change

      # CIS 4.1.4: Events that modify user/group
      -w /etc/group -p wa -k identity
      -w /etc/passwd -p wa -k identity
      -w /etc/gshadow -p wa -k identity
      -w /etc/shadow -p wa -k identity

      # CIS 4.1.5: Events that modify network
      -a always,exit -F arch=b64 -S sethostname -S setdomainname -k system-locale
      -w /etc/hostname -p wa -k system-locale
      -w /etc/hosts -p wa -k system-locale

      # CIS 4.1.6: Events that modify MAC policy
      -w /etc/apparmor/ -p wa -k MAC-policy
      -w /etc/apparmor.d/ -p wa -k MAC-policy

      # CIS 4.1.8: Login/logout events
      -w /var/log/faillog -p wa -k logins
      -w /var/log/lastlog -p wa -k logins
      -w /var/log/tallylog -p wa -k logins

      # CIS 4.1.9: Session initiation
      -w /var/run/utmp -p wa -k session
      -w /var/log/wtmp -p wa -k logins
      -w /var/log/btmp -p wa -k logins
    mode: "0640"
    notify: [reload-auditd]

  # CIS 4.1.immutable: Make rules immutable
  - name: audit-immutable-rules
    type: file
    target_path: /etc/audit/rules.d/99-finalize.rules
    content: |
      -e 2
    mode: "0640"

  - name: reload-auditd
    type: exec
    command: augenrules --load
    when: "changed"

  # CIS 4.2.x: Syslog configuration
  - name: rsyslog-service
    type: service
    service: rsyslog
    state: running
    enabled: true

  # CIS 5.4.4/5.4.5: Default umask and shell timeout
  - name: default-umask
    type: file
    target_path: /etc/profile.d/cis-umask.sh
    content: |
      umask 027
    mode: "0644"

  - name: shell-timeout
    type: file
    target_path: /etc/profile.d/cis-tmout.sh
    content: |
      readonly TMOUT=900
      export TMOUT
    mode: "0644"
