name: cis-services
compliance:
  cis: [2.1.1, 2.2.x, 2.3.x, 3.3.x, 3.4.x, 5.5.x, 6.1.x, 6.2.1, 6.2.7]
  nist-800-53: [CM-7]
  pci-dss: [2.2.2, 2.2.3]
  iso-27001: [A.12.5.1]
  cyber-essentials: [CE-SC-1]

resources:
  # CIS 2.1.1: Disable inetd services
  - name: remove-xinetd
    type: package
    package: xinetd
    state: absent

  - name: remove-openbsd-inetd
    type: package
    package: openbsd-inetd
    state: absent

  # CIS 2.2.x: Disable unnecessary services
  - name: disable-avahi
    type: service
    service: avahi-daemon
    state: stopped
    enabled: false

  - name: disable-cups
    type: service
    service: cups
    state: stopped
    enabled: false

  - name: disable-dhcp-server
    type: service
    service: isc-dhcp-server
    state: stopped
    enabled: false

  - name: disable-slapd
    type: service
    service: slapd
    state: stopped
    enabled: false

  - name: disable-nfs
    type: service
    service: nfs-server
    state: stopped
    enabled: false

  # CIS 2.3.x: Remove unnecessary client packages
  - name: remove-nis
    type: package
    package: nis
    state: absent

  - name: remove-rsh-client
    type: package
    package: rsh-client
    state: absent

  - name: remove-talk
    type: package
    package: talk
    state: absent

  - name: remove-telnet
    type: package
    package: telnet
    state: absent

  - name: remove-ldap-utils
    type: package
    package: ldap-utils
    state: absent

  # CIS 3.3.x: Disable IPv6 router advertisements
  - name: ipv6-router-ads
    type: file
    target_path: /etc/sysctl.d/99-cis-ipv6.conf
    content: |
      net.ipv6.conf.all.accept_ra = 0
      net.ipv6.conf.default.accept_ra = 0
    mode: "0644"
    notify: [apply-sysctl]

  # CIS 3.4.x: TCP wrappers / firewall
  - name: iptables-persistent
    type: package
    package: iptables-persistent
    state: present

  - name: apply-sysctl
    type: exec
    command: sysctl --system
    when: "changed"

  # CIS 5.5.x: Root login restrictions
  - name: securetty-restrict
    type: file
    target_path: /etc/securetty
    content: ""
    mode: "0600"

  # CIS 6.1.x: File permissions
  - name: passwd-permissions
    type: exec
    command: chmod 644 /etc/passwd && chown root:root /etc/passwd
    onlyif: "! stat -c '%a %U:%G' /etc/passwd | grep -q '644 root:root'"

  - name: shadow-permissions
    type: exec
    command: chmod 640 /etc/shadow && chown root:shadow /etc/shadow
    onlyif: "! stat -c '%a' /etc/shadow | grep -q '640'"

  - name: group-permissions
    type: exec
    command: chmod 644 /etc/group && chown root:root /etc/group
    onlyif: "! stat -c '%a %U:%G' /etc/group | grep -q '644 root:root'"

  # CIS 6.2.1: Password fields not empty
  - name: no-empty-passwords
    type: exec
    command: "true"
    onlyif: "! awk -F: '($2 == \"\") {print $1}' /etc/shadow | grep -q ."

  # CIS 6.2.7: No duplicate UIDs
  - name: no-duplicate-uids
    type: exec
    command: "true"
    onlyif: "! awk -F: '{print $3}' /etc/passwd | sort | uniq -d | grep -q ."
