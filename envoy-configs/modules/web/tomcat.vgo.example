name: tomcat

# Requires the java module — add both to your role:
#   roles:
#     - modules: [java, tomcat]

vars:
  tomcat_port: "8080"
  tomcat_heap_min: "512m"
  tomcat_heap_max: "1024m"
  tomcat_max_threads: "200"

resources:
  - name: tomcat-user
    type: user
    username: tomcat
    system: "true"
    shell: /usr/sbin/nologin
    group: tomcat
    state: present

  - name: install-tomcat-debian
    type: package
    package: tomcat10
    state: present
    when: "os_family('debian')"
    depends_on: [tomcat-user]

  - name: install-tomcat-redhat
    type: package
    package: tomcat
    state: present
    when: "!os_family('debian')"
    depends_on: [tomcat-user]

  - name: tomcat-server-xml-debian
    type: file
    target_path: /etc/tomcat10/server.xml
    content: |
      <?xml version="1.0" encoding="UTF-8"?>
      <!-- Managed by Hobnob — do not edit manually -->
      <Server port="8005" shutdown="SHUTDOWN">

        <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
        <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />
        <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
        <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

        <Service name="Catalina">
          <Connector port="{{ .Vars.tomcat_port }}"
                     protocol="org.apache.coyote.http11.Http11NioProtocol"
                     maxThreads="{{ .Vars.tomcat_max_threads }}"
                     connectionTimeout="20000"
                     redirectPort="8443"
                     URIEncoding="UTF-8" />

          <Engine name="Catalina" defaultHost="localhost">
            <Host name="localhost" appBase="webapps"
                  unpackWARs="true" autoDeploy="true">
              <Valve className="org.apache.catalina.valves.AccessLogValve"
                     directory="logs"
                     prefix="access_log"
                     suffix=".txt"
                     pattern="%h %l %u %t &quot;%r&quot; %s %b" />
            </Host>
          </Engine>
        </Service>
      </Server>
    owner: root
    group: tomcat
    mode: "0640"
    when: "os_family('debian')"
    depends_on: [install-tomcat-debian]
    notify: [tomcat-service-debian]

  - name: tomcat-server-xml-redhat
    type: file
    target_path: /etc/tomcat/server.xml
    content: |
      <?xml version="1.0" encoding="UTF-8"?>
      <!-- Managed by Hobnob — do not edit manually -->
      <Server port="8005" shutdown="SHUTDOWN">

        <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
        <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />
        <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
        <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

        <Service name="Catalina">
          <Connector port="{{ .Vars.tomcat_port }}"
                     protocol="org.apache.coyote.http11.Http11NioProtocol"
                     maxThreads="{{ .Vars.tomcat_max_threads }}"
                     connectionTimeout="20000"
                     redirectPort="8443"
                     URIEncoding="UTF-8" />

          <Engine name="Catalina" defaultHost="localhost">
            <Host name="localhost" appBase="webapps"
                  unpackWARs="true" autoDeploy="true">
              <Valve className="org.apache.catalina.valves.AccessLogValve"
                     directory="logs"
                     prefix="access_log"
                     suffix=".txt"
                     pattern="%h %l %u %t &quot;%r&quot; %s %b" />
            </Host>
          </Engine>
        </Service>
      </Server>
    owner: root
    group: tomcat
    mode: "0640"
    when: "!os_family('debian')"
    depends_on: [install-tomcat-redhat]
    notify: [tomcat-service-redhat]

  - name: tomcat-defaults-debian
    type: file
    target_path: /etc/default/tomcat10
    content: |
      # Managed by Hobnob — do not edit manually
      JAVA_OPTS="-Djava.awt.headless=true"
      CATALINA_OPTS="-Xms{{ .Vars.tomcat_heap_min }} -Xmx{{ .Vars.tomcat_heap_max }} -XX:+UseG1GC"
    owner: root
    group: tomcat
    mode: "0640"
    when: "os_family('debian')"
    depends_on: [install-tomcat-debian]
    notify: [tomcat-service-debian]

  - name: tomcat-defaults-redhat
    type: file
    target_path: /etc/sysconfig/tomcat
    content: |
      # Managed by Hobnob — do not edit manually
      JAVA_OPTS="-Djava.awt.headless=true"
      CATALINA_OPTS="-Xms{{ .Vars.tomcat_heap_min }} -Xmx{{ .Vars.tomcat_heap_max }} -XX:+UseG1GC"
    owner: root
    group: tomcat
    mode: "0640"
    when: "!os_family('debian')"
    depends_on: [install-tomcat-redhat]
    notify: [tomcat-service-redhat]

  - name: tomcat-service-debian
    type: service
    service: tomcat10
    enabled: true
    state: running
    when: "os_family('debian')"
    depends_on: [tomcat-server-xml-debian, tomcat-defaults-debian]

  - name: tomcat-service-redhat
    type: service
    service: tomcat
    enabled: true
    state: running
    when: "!os_family('debian')"
    depends_on: [tomcat-server-xml-redhat, tomcat-defaults-redhat]
