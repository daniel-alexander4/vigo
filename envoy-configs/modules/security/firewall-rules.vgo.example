name: firewall-rules
# NOTE: If using the cis-ubuntu compliance role, review for overlap — that role
# installs UFW with default-deny incoming via cis-ubuntu-network. This module
# also enables UFW and sets default-deny. Safe to use together only if you need
# additional allow rules beyond what the CIS module provides.

vars:
  ssh_port: "22"
  http_port: "80"
  https_port: "443"

resources:
  # Ensure ufw is installed and enabled before adding rules
  - name: install-ufw
    type: package
    package: ufw
    state: present

  - name: enable-ufw
    type: exec
    command: "ufw --force enable"
    onlyif: "ufw status | grep -q inactive"
    depends_on: [install-ufw]

  - name: allow-ssh
    type: firewall
    port: "22"
    proto: tcp
    action: allow
    comment: "vigo: allow SSH"
    depends_on: [enable-ufw]

  - name: allow-http
    type: firewall
    port: "80"
    proto: tcp
    action: allow
    comment: "vigo: allow HTTP"
    depends_on: [enable-ufw]

  - name: allow-https
    type: firewall
    port: "443"
    proto: tcp
    action: allow
    comment: "vigo: allow HTTPS"
    depends_on: [enable-ufw]

  # ICMP uses a ufw application-level rule rather than a port
  - name: allow-icmp
    type: exec
    command: |
      ufw allow proto icmp from any to any
    onlyif: "! iptables -L ufw-user-input -n 2>/dev/null | grep -q icmp"
    depends_on: [enable-ufw]

  # Default deny incoming — ufw's default policy for anything not explicitly allowed
  - name: deny-incoming-default
    type: exec
    command: "ufw default deny incoming"
    onlyif: "! ufw status verbose | grep -q 'Default: deny (incoming)'"
    depends_on: [allow-ssh, allow-http, allow-https, allow-icmp]
