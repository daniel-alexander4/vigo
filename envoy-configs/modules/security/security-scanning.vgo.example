#~ Deploys security scanning tools and schedules scans every 30 minutes.
#~ A lock file prevents overlapping runs — if the previous scan is still
#~ running, the current cycle skips it.
#~
#~ Results are collected by the built-in security_scan trait collector
#~ and displayed on the Compliance & Security dashboard.
#~
#~ Tools: Trivy (CVE), Lynis (hardening), chkrootkit, rkhunter,
#~        ClamAV (malware), AIDE (file integrity), debsecan (Debian CVEs).
#~
#~ Scan output: /var/lib/vigo/security/
name: security-scanning

vars:
  scan_dir: "/var/lib/vigo/security"
  lock_file: "/var/lib/vigo/security/.scan.lock"
  scan_stale_min: "30"
  trivy_severity: "CRITICAL,HIGH,MEDIUM,LOW"
  trivy_timeout: "600"
  scan_timeout: "900"
  aide_db_path: "/var/lib/aide/aide.db"
  aide_db_new_path: "/var/lib/aide/aide.db.new"

resources:
  # ── Output directory ──────────────────────────────────────────────

  - name: scan-dir
    type: directory
    target_path: "{{ .Vars.scan_dir }}"
    owner: root
    group: root
    mode: "0700"

  # ── Lock acquisition ──────────────────────────────────────────────
  # Acquire a lock file before running scans. If the lock already exists
  # and is younger than scan_stale_min, skip this cycle entirely. If
  # older (stale), remove it and re-acquire — the previous run crashed.

  - name: scan-lock
    type: exec
    command: >-
      sh -c 'LAST="{{ .Vars.scan_dir }}/.scan.last";
      if [ -f "$LAST" ]; then
        age=$(( $(date +%s) - $(cat "$LAST") ));
        if [ "$age" -lt $(( {{ .Vars.scan_stale_min }} * 60 )) ]; then
          echo "Last scan was ${age}s ago, waiting for {{ .Vars.scan_stale_min }}m cooldown"; exit 1;
        fi;
      fi;
      if [ -f {{ .Vars.lock_file }} ]; then
        lock_age=$(( $(date +%s) - $(stat -c %Y {{ .Vars.lock_file }} 2>/dev/null || echo 0) ));
        if [ "$lock_age" -lt $(( {{ .Vars.scan_stale_min }} * 60 * 2 )) ]; then
          echo "Lock held (${lock_age}s), previous scan still running"; exit 1;
        fi;
        echo "Stale lock (${lock_age}s), removing";
        rm -f {{ .Vars.lock_file }};
      fi;
      echo $$ > {{ .Vars.lock_file }}'
    depends_on: [scan-dir]

  # ── Trivy (CVE scanner) ──────────────────────────────────────────

  - name: trivy-repo-key-debian
    type: exec
    command: >-
      sh -c 'wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key
      | gpg --dearmor -o /usr/share/keyrings/trivy.gpg'
    when: "os_family('debian')"
    onlyif: "! test -f /usr/share/keyrings/trivy.gpg"

  - name: trivy-repo-debian
    type: file
    target_path: /etc/apt/sources.list.d/trivy.list
    content: |
      deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main
    owner: root
    group: root
    mode: "0644"
    when: "os_family('debian')"
    depends_on: [trivy-repo-key-debian]

  - name: trivy-apt-update
    type: exec
    command: "apt-get update -qq"
    when: "os_family('debian')"
    onlyif: "! dpkg -s trivy >/dev/null 2>&1"
    depends_on: [trivy-repo-debian]

  - name: trivy-repo-rhel
    type: file
    target_path: /etc/yum.repos.d/trivy.repo
    content: |
      [trivy]
      name=Trivy
      baseurl=https://aquasecurity.github.io/trivy-repo/rpm/releases/$basearch/
      gpgcheck=0
      enabled=1
    owner: root
    group: root
    mode: "0644"
    when: "!os_family('debian')"

  - name: install-trivy
    type: package
    package: trivy
    state: present
    depends_on: [trivy-apt-update, trivy-repo-rhel]

  - name: run-trivy
    type: exec
    command: >-
      trivy rootfs --format json --severity {{ .Vars.trivy_severity }}
      --scanners vuln --skip-files '*.log'
      --timeout {{ .Vars.trivy_timeout }}s
      --output {{ .Vars.scan_dir }}/trivy.json /
    timeout: "{{ .Vars.trivy_timeout }}"
    depends_on: [install-trivy, scan-lock]

  # ── Lynis (security audit) ───────────────────────────────────────

  - name: install-lynis
    type: package
    package: lynis
    state: present

  - name: run-lynis
    type: exec
    command: >-
      lynis audit system --no-colors --quiet
      --logfile {{ .Vars.scan_dir }}/lynis.log
      --report-file {{ .Vars.scan_dir }}/lynis-report.dat
    timeout: "{{ .Vars.scan_timeout }}"
    depends_on: [install-lynis, scan-lock]

  # ── chkrootkit ───────────────────────────────────────────────────

  - name: install-chkrootkit
    type: package
    package: chkrootkit
    state: present

  - name: run-chkrootkit
    type: exec
    command: "chkrootkit > {{ .Vars.scan_dir }}/chkrootkit.log 2>&1 || true"
    depends_on: [install-chkrootkit, scan-lock]

  # ── rkhunter ─────────────────────────────────────────────────────

  - name: install-rkhunter
    type: package
    package: rkhunter
    state: present

  - name: run-rkhunter
    type: exec
    command: >-
      rkhunter --check --skip-keypress --report-warnings-only
      --logfile {{ .Vars.scan_dir }}/rkhunter.log || true
    timeout: "{{ .Vars.scan_timeout }}"
    depends_on: [install-rkhunter, scan-lock]

  # ── ClamAV ───────────────────────────────────────────────────────

  - name: install-clamav-debian
    type: package
    package: clamav
    state: present
    when: "os_family('debian')"

  - name: install-clamav-daemon-debian
    type: package
    package: clamav-daemon
    state: present
    when: "os_family('debian')"
    depends_on: [install-clamav-debian]

  - name: install-clamav-rhel
    type: package
    package: clamav
    state: present
    when: "!os_family('debian')"

  - name: install-clamd-rhel
    type: package
    package: clamd
    state: present
    when: "!os_family('debian')"
    depends_on: [install-clamav-rhel]

  - name: freshclam-update
    type: exec
    command: "freshclam --quiet || true"
    depends_on: [install-clamav-daemon-debian, install-clamd-rhel, scan-lock]

  - name: run-clamscan
    type: exec
    command: >-
      clamscan --recursive --infected --no-summary
      --log={{ .Vars.scan_dir }}/clamav.log
      /etc /usr/bin /usr/sbin /usr/local/bin || true
    timeout: "{{ .Vars.scan_timeout }}"
    depends_on: [freshclam-update, scan-dir]

  # ── AIDE (file integrity) ────────────────────────────────────────

  - name: install-aide
    type: package
    package: aide
    state: present

  - name: aide-conf
    type: file
    target_path: /etc/aide/aide.conf
    source: templates/aide.conf.tmpl
    owner: root
    group: root
    mode: "0600"
    depends_on: [install-aide]

  - name: aide-reinit
    type: exec
    command: "sh -c 'aide --init && cp {{ .Vars.aide_db_new_path }} {{ .Vars.aide_db_path }}'"
    depends_on: [aide-conf]
    subscribes: [aide-conf]
    when: changed

  - name: aide-init
    type: exec
    command: "sh -c 'if command -v aideinit >/dev/null 2>&1; then aideinit; else aide --init && cp {{ .Vars.aide_db_new_path }} {{ .Vars.aide_db_path }}; fi'"
    onlyif: "! test -f {{ .Vars.aide_db_path }}"
    depends_on: [aide-conf]

  - name: run-aide
    type: exec
    command: >-
      aide --check --config /etc/aide/aide.conf > {{ .Vars.scan_dir }}/aide.log 2>&1 || true
    timeout: "{{ .Vars.scan_timeout }}"
    depends_on: [aide-init, aide-reinit, scan-lock]

  # ── debsecan (Debian/Ubuntu CVEs) ────────────────────────────────

  - name: install-debsecan
    type: package
    package: debsecan
    state: present
    when: "os_family('debian')"

  - name: run-debsecan
    type: exec
    command: >-
      debsecan --format detail > {{ .Vars.scan_dir }}/debsecan.log 2>&1 || true
    when: "os_family('debian')"
    depends_on: [install-debsecan, scan-lock]

  # ── Lock release ──────────────────────────────────────────────────

  - name: scan-unlock
    type: exec
    command: "sh -c 'date +%s > {{ .Vars.scan_dir }}/.scan.last && rm -f {{ .Vars.lock_file }}'"
    depends_on: [run-trivy, run-lynis, run-chkrootkit, run-rkhunter, run-clamscan, run-aide, run-debsecan]
