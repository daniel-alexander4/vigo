name: charm-tools

resources:
  - name: charm-repo
    type: repository
    key_url: https://repo.charm.sh/apt/gpg.key
    repo: "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *"
    state: present

  - name: install-glow
    type: package
    package: glow
    state: present
    depends_on: [charm-repo]
