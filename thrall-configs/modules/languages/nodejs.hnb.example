name: nodejs

resources:
  - name: nodesource-repo-debian
    type: repository
    key_url: "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key"
    repo: "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main"
    state: present
    when: "os_family('debian')"

  - name: nodesource-repo-rhel
    type: repository
    key_url: "https://rpm.nodesource.com/pub_20.x/nodistro/repo/nodesource-repo.gpg.key"
    repo: "nodesource-20"
    state: present
    when: "os_family('redhat')"

  - name: install-nodejs
    type: package
    package: nodejs
    state: present
    depends_on: [nodesource-repo-debian, nodesource-repo-rhel]

  - name: install-pm2
    type: npm
    package: pm2
    state: present
    depends_on: [install-nodejs]

  - name: install-yarn
    type: npm
    package: yarn
    state: present
    depends_on: [install-nodejs]
