name: nodejs

vars:
  nodejs_version: "20"
  npm_global_packages: "pm2"

resources:
  - name: nodesource-repo-debian
    type: repository
    key_url: "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key"
    repo: "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_{{ .Vars.nodejs_version }}.x nodistro main"
    state: present
    when: "os_family('debian')"

  - name: nodesource-repo-rhel
    type: repository
    key_url: "https://rpm.nodesource.com/pub_{{ .Vars.nodejs_version }}.x/nodistro/repo/nodesource-repo.gpg.key"
    repo: "nodesource-{{ .Vars.nodejs_version }}"
    state: present
    when: "os_family('redhat')"

  - name: install-nodejs
    type: package
    package: nodejs
    state: present
    depends_on: [nodesource-repo-debian, nodesource-repo-rhel]

  - name: install-npm-globals
    type: exec
    command: "npm install -g {{ .Vars.npm_global_packages }}"
    when: "!command_succeeds('npm list -g --depth=0 2>/dev/null | grep -q {{ .Vars.npm_global_packages }}')"
    depends_on: [install-nodejs]
