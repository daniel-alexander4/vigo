name: server-backup

vars:
  backup_dest: "/srv/backups.hobnob"
  backup_db_src: "/srv/hobnob/db/hobnob.db"
  backup_src: "/srv/hobnob"

resources:
  - name: backup-dir
    type: directory
    path: "{{ .Vars.backup_dest }}"
    owner: root
    group: root
    mode: "0555"

  - name: backup-script
    type: file
    targetpath: /usr/local/bin/hobnob-backup.sh
    mode: "0700"
    owner: root
    content: |
      #!/bin/sh
      set -e
      DEST="{{ .Vars.backup_dest }}"
      DB_SRC="{{ .Vars.backup_db_src }}"
      SRC="{{ .Vars.backup_src }}"

      # Consistent SQLite snapshot first.
      if [ -f "$DB_SRC" ]; then
        SNAP_DIR="$DEST/db"
        mkdir -p "$SNAP_DIR"
        sqlite3 "$DB_SRC" "VACUUM INTO '$SNAP_DIR/hobnob.db'"
      fi

      # Unlock backup dir.
      chmod 755 "$DEST"

      # Rsync everything except the live DB files (we snapshot those above).
      rsync -a --delete \
        --exclude 'db/hobnob.db' \
        --exclude 'db/hobnob.db-wal' \
        --exclude 'db/hobnob.db-shm' \
        "$SRC/" "$DEST/"

      # Lock backup dir.
      chmod 555 "$DEST"
    depends_on: [backup-dir]

  - name: backup-cron
    type: cron
    name: hobnob-backup
    job: /usr/local/bin/hobnob-backup.sh
    special: "@daily"
    user: root
    depends_on: [backup-script]
