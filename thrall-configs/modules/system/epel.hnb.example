name: epel

resources:
  - conditional_block:
    when: "os_family('redhat')"
    resources:
      - name: epel-repo
        type: repository
        key_url: "https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ .Traits.os.version_major }}"
        repo: "epel"
        state: present

      - name: install-epel-release
        type: package
        package: epel-release
        state: present
        depends_on: [epel-repo]
