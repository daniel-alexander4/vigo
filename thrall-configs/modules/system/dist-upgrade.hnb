name: dist-upgrade

vars:
  dist_upgrade_reboot: true
  dist_upgrade_auto_remove: true
  dist_upgrade_hold_packages: ""

resources:
  - name: apt-update
    type: exec
    command: "apt-get update -qq"
    when: "os_family('debian')"
    creates: /var/lib/apt/periodic/update-success-stamp

  - name: apt-dist-upgrade
    type: exec
    command: "DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y -o Dpkg::Options::='--force-confold' -o Dpkg::Options::='--force-confdef'"
    when: "os_family('debian')"
    unless: "apt-get dist-upgrade --simulate 2>/dev/null | grep -q '0 upgraded, 0 newly installed'"
    depends_on: [apt-update]
    timeout: 600
    notify: [autoremove, reboot-if-needed]

  - name: autoremove
    type: exec
    command: "apt-get autoremove -y -qq"
    when: "os_family('debian')"
    refreshonly: true

  - name: reboot-if-needed
    type: exec
    command: "[ -f /var/run/reboot-required ] && shutdown -r +1 'Rebooting after dist-upgrade' || true"
    when: "os_family('debian')"
    refreshonly: true
