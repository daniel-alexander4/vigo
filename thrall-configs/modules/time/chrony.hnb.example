name: chrony

vars:
  chrony_server_1: "0.pool.ntp.org"
  chrony_server_2: "1.pool.ntp.org"
  chrony_allow_network: ""

resources:
  - name: install-chrony
    type: package
    package: chrony
    state: present

  - name: chrony-conf
    type: file
    # /etc/chrony/chrony.conf on Debian, /etc/chrony.conf on RHEL
    targetpath: "{{ if eq .Traits.os.family \"debian\" }}/etc/chrony/chrony.conf{{ else }}/etc/chrony.conf{{ end }}"
    content: |
      # Managed by Hobnob — do not edit manually

      # NTP servers
      server {{ .Vars.chrony_server_1 }} iburst
      server {{ .Vars.chrony_server_2 }} iburst

      # Step the clock if offset exceeds 1 second during first 3 updates
      makestep 1.0 3

      # Sync the RTC
      rtcsync

      # Drift file
      driftfile /var/lib/chrony/drift

      # Log tracking, measurements, and statistics
      logdir /var/log/chrony
      {{ if ne .Vars.chrony_allow_network "" }}
      # Allow NTP clients on this network
      allow {{ .Vars.chrony_allow_network }}
      {{ end }}
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-chrony]
    notify: [chrony-service]

  - name: chrony-service
    type: service
    # chrony on Debian, chronyd on RHEL
    service: "{{ if eq .Traits.os.family \"debian\" }}chrony{{ else }}chronyd{{ end }}"
    enabled: true
    state: running
    depends_on: [chrony-conf]
    subscribes: [chrony-conf]
