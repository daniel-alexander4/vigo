name: php-fpm

vars:
  php_version: "8.2"
  pm_max_children: "50"
  pm_start_servers: "5"
  pm_min_spare: "5"
  pm_max_spare: "35"
  listen_socket: "/run/php/php-fpm.sock"

resources:
  - name: install-php-fpm-debian
    type: package
    package: php8.2-fpm
    state: present
    when: "os_family('debian')"

  - name: install-php-fpm-redhat
    type: package
    package: php-fpm
    state: present
    when: "!os_family('debian')"

  - name: php-fpm-pool-debian
    type: file
    targetpath: /etc/php/8.2/fpm/pool.d/www.conf
    content: |
      ; Managed by Hobnob — do not edit manually
      [www]

      user = www-data
      group = www-data

      listen = {{ .Vars.listen_socket }}
      listen.owner = www-data
      listen.group = www-data
      listen.mode = 0660

      ; Process manager
      pm = dynamic
      pm.max_children = {{ .Vars.pm_max_children }}
      pm.start_servers = {{ .Vars.pm_start_servers }}
      pm.min_spare_servers = {{ .Vars.pm_min_spare }}
      pm.max_spare_servers = {{ .Vars.pm_max_spare }}
      pm.max_requests = 500

      ; Status page (restrict access in web server config)
      pm.status_path = /fpm-status
      ping.path = /fpm-ping

      ; Logging
      php_admin_value[error_log] = /var/log/php-fpm/www-error.log
      php_admin_flag[log_errors] = on
    owner: root
    group: root
    mode: "0644"
    when: "os_family('debian')"
    depends_on: [install-php-fpm-debian]
    notify: [php-fpm-service-debian]

  - name: php-fpm-pool-redhat
    type: file
    targetpath: /etc/php-fpm.d/www.conf
    content: |
      ; Managed by Hobnob — do not edit manually
      [www]

      user = apache
      group = apache

      listen = {{ .Vars.listen_socket }}
      listen.owner = apache
      listen.group = apache
      listen.mode = 0660

      ; Process manager
      pm = dynamic
      pm.max_children = {{ .Vars.pm_max_children }}
      pm.start_servers = {{ .Vars.pm_start_servers }}
      pm.min_spare_servers = {{ .Vars.pm_min_spare }}
      pm.max_spare_servers = {{ .Vars.pm_max_spare }}
      pm.max_requests = 500

      ; Status page (restrict access in web server config)
      pm.status_path = /fpm-status
      ping.path = /fpm-ping

      ; Logging
      php_admin_value[error_log] = /var/log/php-fpm/www-error.log
      php_admin_flag[log_errors] = on
    owner: root
    group: root
    mode: "0644"
    when: "!os_family('debian')"
    depends_on: [install-php-fpm-redhat]
    notify: [php-fpm-service-redhat]

  - name: php-fpm-log-dir-debian
    type: file
    targetpath: /var/log/php-fpm
    state: directory
    owner: www-data
    group: www-data
    mode: "0755"
    when: "os_family('debian')"

  - name: php-fpm-log-dir-redhat
    type: file
    targetpath: /var/log/php-fpm
    state: directory
    owner: apache
    group: apache
    mode: "0755"
    when: "!os_family('debian')"

  - name: php-fpm-service-debian
    type: service
    service: php8.2-fpm
    enabled: true
    state: running
    when: "os_family('debian')"
    depends_on: [php-fpm-pool-debian, php-fpm-log-dir-debian]
    subscribes: [php-fpm-pool-debian]

  - name: php-fpm-service-redhat
    type: service
    service: php-fpm
    enabled: true
    state: running
    when: "!os_family('debian')"
    depends_on: [php-fpm-pool-redhat, php-fpm-log-dir-redhat]
    subscribes: [php-fpm-pool-redhat]
