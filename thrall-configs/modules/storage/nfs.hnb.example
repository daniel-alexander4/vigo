name: nfs

vars:
  nfs_export_path: "/srv/nfs"
  nfs_export_clients: "10.0.0.0/24(rw,sync,no_subtree_check,no_root_squash)"
  nfs_mount_source: "10.0.0.1:/srv/nfs"
  nfs_mount_point: "/mnt/nfs"

resources:
  # --- Package (distro-specific) ---

  - name: install-nfs-debian
    type: package
    package: nfs-kernel-server
    state: present
    when: "os_family('debian')"

  - name: install-nfs-redhat
    type: package
    package: nfs-utils
    state: present
    when: "!os_family('debian')"

  # --- Export directory ---

  - name: nfs-export-dir
    type: directory
    targetpath: /srv/nfs
    owner: root
    group: root
    mode: "0755"

  # --- Exports config ---

  - name: nfs-exports
    type: file
    targetpath: /etc/exports
    content: |
      # Managed by Hobnob — do not edit manually
      {{ .Vars.nfs_export_path }} {{ .Vars.nfs_export_clients }}
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-nfs-debian, install-nfs-redhat, nfs-export-dir]
    notify: [reload-exports]

  # Re-export shares when /etc/exports changes
  - name: reload-exports
    type: exec
    command: "exportfs -ra"
    depends_on: [nfs-exports]
    subscribes: [nfs-exports]
    when: "changed"

  # --- Service (distro-specific) ---

  - name: nfs-service-debian
    type: service
    service: nfs-kernel-server
    enabled: true
    state: running
    when: "os_family('debian')"
    depends_on: [nfs-exports]
    subscribes: [nfs-exports]

  - name: nfs-service-redhat
    type: service
    service: nfs-server
    enabled: true
    state: running
    when: "!os_family('debian')"
    depends_on: [nfs-exports]
    subscribes: [nfs-exports]

  # --- Client mount ---

  - name: nfs-mount-dir
    type: directory
    targetpath: /mnt/nfs
    owner: root
    group: root
    mode: "0755"

  - name: nfs-mount
    type: mount
    path: /mnt/nfs
    device: "10.0.0.1:/srv/nfs"
    fstype: nfs
    options: "rw,hard,intr,timeo=600"
    state: mounted
    depends_on: [nfs-mount-dir]
