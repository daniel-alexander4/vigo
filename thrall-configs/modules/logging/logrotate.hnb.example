name: logrotate

vars:
  log_path: "/var/log/app/*.log"
  rotate_count: "14"
  rotate_size: "100M"
  compress: "true"

resources:
  - name: install-logrotate
    type: package
    package: logrotate
    state: present

  - name: app-logrotate
    type: logrotate
    path: "/var/log/app/*.log"
    frequency: daily
    rotate: "14"
    size: "100M"
    compress: "true"
    delaycompress: "true"
    missingok: "true"
    notifempty: "true"
    create: "0640 root adm"
    postrotate: "/usr/lib/rsyslog/rsyslog-rotate 2>/dev/null || true"
    depends_on: [install-logrotate]
