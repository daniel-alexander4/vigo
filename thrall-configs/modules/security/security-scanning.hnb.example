#~ Deploys security scanning tools and schedules daily/weekly scans.
#~ Results are collected by the built-in security_scan trait collector
#~ and displayed on the Compliance & Security dashboard.
#~
#~ Tools: Trivy (CVE), Lynis (hardening), chkrootkit, rkhunter,
#~        ClamAV (malware), AIDE (file integrity), debsecan (Debian CVEs).
#~
#~ Scan output: /var/lib/hobnob/security/
#~
#~ Note: when: expressions use literal values, not Go templates.
#~ To change the scan window, edit the hour values directly in this file.
name: security-scanning

resources:
  # ── Output directory ──────────────────────────────────────────────

  - name: scan-dir
    type: directory
    target_path: /var/lib/hobnob/security
    owner: root
    group: root
    mode: "0700"

  # ── Trivy (CVE scanner) ──────────────────────────────────────────

  - name: trivy-repo-key-debian
    type: exec
    command: >-
      sh -c 'wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key
      | gpg --dearmor -o /usr/share/keyrings/trivy.gpg'
    when: "os_family('debian')"
    onlyif: "! test -f /usr/share/keyrings/trivy.gpg"

  - name: trivy-repo-debian
    type: file
    target_path: /etc/apt/sources.list.d/trivy.list
    content: |
      deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main
    owner: root
    group: root
    mode: "0644"
    when: "os_family('debian')"
    depends_on: [trivy-repo-key-debian]
    notify: [trivy-apt-update]

  - name: trivy-apt-update
    type: exec
    command: "apt-get update -qq"
    when: "os_family('debian')"
    depends_on: [trivy-repo-debian]

  - name: trivy-repo-rhel
    type: file
    target_path: /etc/yum.repos.d/trivy.repo
    content: |
      [trivy]
      name=Trivy
      baseurl=https://aquasecurity.github.io/trivy-repo/rpm/releases/$basearch/
      gpgcheck=0
      enabled=1
    owner: root
    group: root
    mode: "0644"
    when: "!os_family('debian')"

  - name: install-trivy
    type: package
    package: trivy
    state: present
    depends_on: [trivy-apt-update, trivy-repo-rhel]

  - name: run-trivy
    type: exec
    command: >-
      trivy rootfs --format json --severity CRITICAL,HIGH,MEDIUM,LOW
      --output /var/lib/hobnob/security/trivy.json /
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-trivy-$(date +%Y%m%d)"
    depends_on: [install-trivy, scan-dir]

  - name: trivy-sentinel
    type: exec
    command: "touch /tmp/.hobnob-trivy-$(date +%Y%m%d)"
    depends_on: [run-trivy]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-trivy-$(date +%Y%m%d)"

  # ── Lynis (security audit) ───────────────────────────────────────

  - name: install-lynis
    type: package
    package: lynis
    state: present

  - name: run-lynis
    type: exec
    command: >-
      lynis audit system --no-colors --quiet
      --logfile /var/lib/hobnob/security/lynis.log
      --report-file /var/lib/hobnob/security/lynis-report.dat
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-lynis-$(date +%Y%m%d)"
    depends_on: [install-lynis, scan-dir]

  - name: lynis-sentinel
    type: exec
    command: "touch /tmp/.hobnob-lynis-$(date +%Y%m%d)"
    depends_on: [run-lynis]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-lynis-$(date +%Y%m%d)"

  # ── chkrootkit ───────────────────────────────────────────────────

  - name: install-chkrootkit
    type: package
    package: chkrootkit
    state: present

  - name: run-chkrootkit
    type: exec
    command: "chkrootkit > /var/lib/hobnob/security/chkrootkit.log 2>&1 || true"
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-chkrootkit-$(date +%Y%m%d)"
    depends_on: [install-chkrootkit, scan-dir]

  - name: chkrootkit-sentinel
    type: exec
    command: "touch /tmp/.hobnob-chkrootkit-$(date +%Y%m%d)"
    depends_on: [run-chkrootkit]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-chkrootkit-$(date +%Y%m%d)"

  # ── rkhunter ─────────────────────────────────────────────────────

  - name: install-rkhunter
    type: package
    package: rkhunter
    state: present

  - name: run-rkhunter
    type: exec
    command: >-
      rkhunter --check --skip-keypress --report-warnings-only
      --logfile /var/lib/hobnob/security/rkhunter.log || true
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-rkhunter-$(date +%Y%m%d)"
    depends_on: [install-rkhunter, scan-dir]

  - name: rkhunter-sentinel
    type: exec
    command: "touch /tmp/.hobnob-rkhunter-$(date +%Y%m%d)"
    depends_on: [run-rkhunter]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-rkhunter-$(date +%Y%m%d)"

  # ── ClamAV ───────────────────────────────────────────────────────

  - name: install-clamav-debian
    type: package
    package: clamav
    state: present
    when: "os_family('debian')"

  - name: install-clamav-daemon-debian
    type: package
    package: clamav-daemon
    state: present
    when: "os_family('debian')"
    depends_on: [install-clamav-debian]

  - name: install-clamav-rhel
    type: package
    package: clamav
    state: present
    when: "!os_family('debian')"

  - name: install-clamd-rhel
    type: package
    package: clamd
    state: present
    when: "!os_family('debian')"
    depends_on: [install-clamav-rhel]

  - name: freshclam-update
    type: exec
    command: "freshclam --quiet || true"
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-freshclam-$(date +%Y%m%d)"
    depends_on: [install-clamav-daemon-debian, install-clamd-rhel]

  - name: freshclam-sentinel
    type: exec
    command: "touch /tmp/.hobnob-freshclam-$(date +%Y%m%d)"
    depends_on: [freshclam-update]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-freshclam-$(date +%Y%m%d)"

  - name: run-clamscan
    type: exec
    command: >-
      clamscan --recursive --infected --no-summary
      --log=/var/lib/hobnob/security/clamav.log
      /etc /usr/bin /usr/sbin /usr/local/bin || true
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-clamscan-$(date +%Y%m%d)"
    depends_on: [freshclam-update, scan-dir]

  - name: clamscan-sentinel
    type: exec
    command: "touch /tmp/.hobnob-clamscan-$(date +%Y%m%d)"
    depends_on: [run-clamscan]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-clamscan-$(date +%Y%m%d)"

  # ── AIDE (file integrity) ────────────────────────────────────────

  - name: install-aide
    type: package
    package: aide
    state: present

  - name: aide-init
    type: exec
    command: "aideinit || true"
    onlyif: "! test -f /var/lib/aide/aide.db"
    depends_on: [install-aide]

  - name: run-aide
    type: exec
    command: >-
      aide --check --config /etc/aide/aide.conf > /var/lib/hobnob/security/aide.log 2>&1 || true
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-aide-$(date +%Y%m%d)"
    depends_on: [aide-init, scan-dir]

  - name: aide-sentinel
    type: exec
    command: "touch /tmp/.hobnob-aide-$(date +%Y%m%d)"
    depends_on: [run-aide]
    when: "hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-aide-$(date +%Y%m%d)"

  # ── debsecan (Debian/Ubuntu CVEs) ────────────────────────────────

  - name: install-debsecan
    type: package
    package: debsecan
    state: present
    when: "os_family('debian')"

  - name: run-debsecan
    type: exec
    command: >-
      debsecan --format detail > /var/lib/hobnob/security/debsecan.log 2>&1 || true
    when: "os_family('debian') and hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-debsecan-$(date +%Y%m%d)"
    depends_on: [install-debsecan, scan-dir]

  - name: debsecan-sentinel
    type: exec
    command: "touch /tmp/.hobnob-debsecan-$(date +%Y%m%d)"
    depends_on: [run-debsecan]
    when: "os_family('debian') and hour_range('2','5')"
    onlyif: "! test -f /tmp/.hobnob-debsecan-$(date +%Y%m%d)"
