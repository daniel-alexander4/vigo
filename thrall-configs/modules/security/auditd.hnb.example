name: auditd

vars:
  audit_log_file: "/var/log/audit/audit.log"
  audit_max_log_file: "8"
  audit_num_logs: "5"
  audit_space_left_action: "SYSLOG"

resources:
  - name: install-auditd
    type: package
    package: auditd
    state: present

  - name: auditd-conf
    type: file
    targetpath: /etc/audit/auditd.conf
    content: |
      # /etc/audit/auditd.conf — managed by hobnob
      log_file = {{ .Vars.audit_log_file }}
      log_format = ENRICHED
      log_group = root
      priority_boost = 4
      flush = INCREMENTAL_ASYNC
      freq = 50
      max_log_file = {{ .Vars.audit_max_log_file }}
      num_logs = {{ .Vars.audit_num_logs }}
      max_log_file_action = ROTATE
      space_left = 75
      space_left_action = {{ .Vars.audit_space_left_action }}
      admin_space_left = 50
      admin_space_left_action = SUSPEND
      disk_full_action = SUSPEND
      disk_error_action = SUSPEND
      name_format = HOSTNAME
    owner: root
    group: root
    mode: "0640"
    depends_on: [install-auditd]
    notify: [auditd-service]

  - name: auditd-rules
    type: file
    targetpath: /etc/audit/rules.d/hobnob.rules
    content: |
      # /etc/audit/rules.d/hobnob.rules — managed by hobnob

      # Monitor identity files
      -w /etc/passwd -p wa -k identity
      -w /etc/shadow -p wa -k identity
      -w /etc/group -p wa -k identity
      -w /etc/gshadow -p wa -k identity

      # Monitor sudo usage
      -w /usr/bin/sudo -p x -k privileged
      -w /etc/sudoers -p wa -k sudoers
      -w /etc/sudoers.d/ -p wa -k sudoers

      # Monitor mount operations
      -a always,exit -F arch=b64 -S mount -S umount2 -k mounts

      # Monitor kernel module loading
      -w /sbin/insmod -p x -k modules
      -w /sbin/rmmod -p x -k modules
      -w /sbin/modprobe -p x -k modules
      -a always,exit -F arch=b64 -S init_module -S delete_module -k modules
    owner: root
    group: root
    mode: "0640"
    depends_on: [install-auditd]
    notify: [auditd-service]

  - name: auditd-service
    type: service
    service: auditd
    enabled: true
    state: running
    depends_on: [auditd-conf, auditd-rules]
