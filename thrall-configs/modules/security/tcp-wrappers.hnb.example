name: tcp-wrappers

vars:
  allowed_sshd_networks: "LOCAL"
  allowed_services: "sshd"

resources:
  - name: install-tcp-wrappers-debian
    type: package
    package: tcpd
    state: present
    when: "os_family('debian')"

  - name: install-tcp-wrappers-redhat
    type: package
    package: tcp_wrappers
    state: present
    when: "!os_family('debian')"

  - name: hosts-allow
    type: file
    target_path: /etc/hosts.allow
    content: |
      # /etc/hosts.allow — managed by hobnob
      {{ .Vars.allowed_services }}: {{ .Vars.allowed_sshd_networks }}
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-tcp-wrappers-debian, install-tcp-wrappers-redhat]

  - name: hosts-deny
    type: file
    target_path: /etc/hosts.deny
    content: |
      # /etc/hosts.deny — managed by hobnob
      ALL: ALL
    owner: root
    group: root
    mode: "0644"
    depends_on: [install-tcp-wrappers-debian, install-tcp-wrappers-redhat]
