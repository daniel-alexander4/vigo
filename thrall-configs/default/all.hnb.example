# Thrall-to-module mappings. First match wins.
# Each entry maps a hostname (or glob pattern) to roles and/or modules.
# Thrall-level vars override module defaults; environment_overrides override per-environment.
#
# These entries inherit modules/vars from common.hnb files in parent directories.
# Put specific hosts before patterns.

thralls:
  # --- Explicit hosts ---

  - match: "web01.example.com"
    environment: production
    roles: [webserver]
    environment_overrides:
      staging:
        worker_processes: "2"

  - match: "db01.example.com"
    environment: production
    roles: [database]
    environment_overrides:
      production:
        pg_max_connections: "200"
        pg_shared_buffers: "4GB"
      staging:
        pg_max_connections: "50"
        pg_shared_buffers: "256MB"

  - match: "docker01.example.com"
    environment: production
    modules: [docker]

  - match: "mon01.example.com"
    environment: production
    roles: [monitoring]

  - match: "bastion01.example.com"
    environment: production
    roles: [bastion]

  - match: "plex01.example.com"
    environment: production
    roles: [mediaserver]
    vars:
      plex_media_dir: "/mnt/storage/media"

  # --- Pattern-based entries ---

  - match: "web-*"
    environment: production
    roles: [webserver]

  - match: "db-*"
    environment: production
    roles: [database]

  - match: "docker-*"
    environment: production
    modules: [docker]

  - match: "mon-*"
    environment: production
    roles: [monitoring]

  - match: "*.staging.example.com"
    environment: staging
