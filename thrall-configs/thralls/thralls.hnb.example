# Thrall-to-module mappings. First match wins.
# Entries can reference roles (thrall-configs/roles/) or modules (thrall-configs/modules/) by name.
# Thrall-level vars override module default vars.
#
# vars_from: loads vars from external files (relative to thrall-configs/).
# Precedence: module defaults < vars_from files (in order) < inline vars.
# Accepts a single path or a list. Inline vars always win (last-writer-wins).

thralls:
  # --- Explicit hosts (specific overrides before patterns) ---

  # vars_from example: common web vars from file, host-specific overrides from another file.
  # web01's worker_processes ("4" from web01.hnb) overrides web-common.hnb's "auto".
  # Inline vars (if any) would override both.
  - match: "web01.example.com"
    environment: production
    roles: [webserver]
    vars_from:
      - "vars/web-common.hnb"
      - "vars/web01.hnb"
    env_vars:
      staging:
        worker_processes: "2"
        keepalive_timeout: "30"

  # vars_from with inline override: db-common.hnb provides defaults,
  # env_vars overrides per-environment tuning.
  - match: "db01.example.com"
    environment: production
    roles: [database]
    vars_from: "vars/db-common.hnb"
    env_vars:
      production:
        pg_max_connections: "200"
        pg_shared_buffers: "4GB"
        pg_effective_cache_size: "12GB"
        pg_work_mem: "64MB"
      staging:
        pg_max_connections: "50"
        pg_shared_buffers: "256MB"
        pg_effective_cache_size: "1GB"
        pg_work_mem: "16MB"

  # - match: "cache01.example.com"
  #   environment: production
  #   modules: [redis]
  #   vars:
  #     redis_password: "secret:hobnob/redis/password"  # add HOBNOB_REDIS_PASSWORD to .env
  #   env_vars:
  #     production:
  #       redis_maxmemory: "4gb"

  - match: "docker01.example.com"
    environment: production
    modules: [docker]

  - match: "mon01.example.com"
    environment: production
    roles: [monitoring]

  # - match: "lb01.example.com"
  #   environment: production
  #   modules: [haproxy]
  #   vars:
  #     haproxy_stats_password: "secret:hobnob/haproxy/stats_password"  # add HOBNOB_HAPROXY_STATS_PASSWORD to .env

  - match: "bastion01.example.com"
    environment: production
    roles: [bastion]

  # - match: "mysql01.example.com"
  #   environment: production
  #   modules: [mysql]
  #   vars:
  #     mysql_root_password: "secret:hobnob/mysql/root_password"  # add HOBNOB_MYSQL_ROOT_PASSWORD to .env

  - match: "plex01.example.com"
    environment: production
    roles: [mediaserver]
    vars:
      plex_media_dir: "/mnt/storage/media"
      plex_transcode_dir: "/mnt/nvme/plex-transcode"
    env_vars:
      production:
        plex_max_transcode_sessions: "5"
      staging:
        plex_max_transcode_sessions: "2"

  - match: "dev01.example.com"
    environment: production
    modules: [charm-tools, github-tools]

  # --- Pattern-based entries (catch-all for hostnames matching globs) ---

  - match: "web-*"
    environment: production
    roles: [webserver]

  - match: "db-*"
    environment: production
    roles: [database]

  - match: "mysql-*"
    environment: production
    modules: [mysql]

  - match: "cache-*"
    environment: production
    modules: [redis]

  - match: "lb-*"
    environment: production
    modules: [haproxy]

  - match: "docker-*"
    environment: production
    modules: [docker]

  - match: "mon-*"
    environment: production
    roles: [monitoring]

  - match: "bastion-*"
    environment: production
    roles: [bastion]

  - match: "plex-*"
    environment: production
    roles: [mediaserver]

  - match: "*.staging.example.com"
    environment: staging
