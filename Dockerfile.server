FROM rust:alpine AS rust-builder

RUN apk add --no-cache musl-dev protobuf-dev

WORKDIR /build

# ADR-031 agent self-update verification pubkey. Threaded through to
# build.rs via env so the constant baked into the agent matches the
# private key used to sign .sig files (Makefile and upgrade.sh both
# derive it from SIGN_KEY). Unset → build.rs falls back to the all-zero
# sentinel pubkey, agent refuses self-update at runtime.
ARG VIGO_AGENT_SIGNING_PUBKEY=
ENV VIGO_AGENT_SIGNING_PUBKEY=$VIGO_AGENT_SIGNING_PUBKEY

# Cache Rust dependencies: copy manifests + proto, build with dummy source.
COPY agent/Cargo.toml agent/Cargo.lock agent/
COPY agent/build.rs agent/
COPY agent/proto/ agent/proto/
COPY protobuf/ protobuf/
RUN mkdir -p agent/src && echo "fn main() {}" > agent/src/main.rs \
    && cd agent && cargo build --release --target x86_64-unknown-linux-musl \
    && rm -rf src

# Now build real source (dependencies already compiled). Also extract the
# agent's compiled-in version into a sidecar file so the runtime stage can
# advertise it via /api/v1/agent/latest. Without this, cross-arch envoys can
# end up in update loops — the server can't run a foreign-arch binary to
# probe its version, so it relies on this sidecar.
COPY agent/src/ agent/src/
RUN cd agent && touch src/main.rs \
    && cargo build --release --target x86_64-unknown-linux-musl \
    && grep -m1 '^version' Cargo.toml | sed 's/.*"\(.*\)".*/\1/' > /build/agent/vigo.version

FROM golang:1.25-alpine AS go-builder

RUN apk add --no-cache gcc musl-dev git

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

ARG CACHEBUST=0
RUN echo "$CACHEBUST" > /dev/null
COPY . .

# Hardened build flags:
# -trimpath strips source paths, -s -w strips symbols/debug, -buildid= removes build ID.
# -tags 'netgo osusergo' uses Go's pure-Go DNS + user resolvers (no libnss cgo dep).
# -linkmode external -extldflags=-static produces a fully-static binary so the
# host-installed vigocli runs on any Linux server without needing a musl loader
# (stock GCP / AWS / Azure Debian / Ubuntu / RHEL images lack one). vigosrv gets
# the same treatment for build symmetry — it never leaves the container, but a
# single build pattern is cheaper to maintain than two. -buildmode=pie is
# dropped for the static path: PIE + fully-static needs -static-pie which has
# musl-toolchain edge cases; static binaries already get image-base ASLR.
# CGO_CFLAGS/CGO_LDFLAGS: stack protectors, FORTIFY_SOURCE, full RELRO, no-execstack.
ENV CGO_CFLAGS="-D_FORTIFY_SOURCE=2 -fstack-protector-strong -O2" \
    CGO_LDFLAGS="-Wl,-z,relro,-z,now,-z,noexecstack"

RUN CGO_ENABLED=1 go build \
    -tags 'netgo osusergo' -trimpath \
    -ldflags="-s -w -buildid= -linkmode external -extldflags=-static -X main.version=$(cat VERSION 2>/dev/null || echo dev)" \
    -o vigosrv ./server

RUN CGO_ENABLED=1 go build \
    -tags 'netgo osusergo' -trimpath \
    -ldflags="-s -w -buildid= -linkmode external -extldflags=-static -X main.version=$(cat VERSION 2>/dev/null || echo dev)" \
    -o vigocli ./cli

# Guard against silent regressions: a future cgo dep sneaking back in via a
# go.mod bump could re-introduce dynamic linkage and break host-installed
# vigocli on stock cloud VMs all over again. Fail the build loudly here.
RUN apk add --no-cache file >/dev/null \
    && for bin in vigosrv vigocli; do \
        if ! file "$bin" | grep -q 'statically linked'; then \
            echo "FATAL: $bin is not statically linked — check go build flags." >&2; \
            file "$bin" >&2; \
            exit 1; \
        fi; \
    done

# Stage the freshly-built linux/amd64 agent binary + version sidecar from
# rust-builder, then produce its ED25519 detached signature using the
# operator's SIGN_KEY supplied as a BuildKit secret (--secret id=signing_key).
# Pubkey from VIGO_AGENT_SIGNING_PUBKEY (ARG to rust-builder) must derive
# from the same private key — agents verify the .sig against their baked-in
# pubkey, so a mismatch fail-closes auto-update.
# When the secret is absent the build still succeeds; the agent built in
# this stage carries the sentinel pubkey (ADR-031 dev mode) and refuses
# self-update at runtime. Use this mode only for dev builds.
RUN mkdir -p /build/dist/agent/linux/amd64
COPY --from=rust-builder /build/agent/target/x86_64-unknown-linux-musl/release/vigo /build/dist/agent/linux/amd64/vigo
COPY --from=rust-builder /build/agent/vigo.version /build/dist/agent/linux/amd64/vigo.version
RUN --mount=type=secret,id=signing_key,target=/run/secrets/signing_key \
    if [ -s /run/secrets/signing_key ]; then \
        go run ./server/hardening/cmd/sign \
            -key /run/secrets/signing_key \
            -binary /build/dist/agent/linux/amd64/vigo \
            -output /build/dist/agent/linux/amd64/vigo.sig; \
        echo "signed /build/dist/agent/linux/amd64/vigo"; \
    else \
        echo "WARNING: no SIGN_KEY secret supplied — built unsigned agent binary (ADR-031 agents will refuse auto-update); supply via 'docker build --secret id=signing_key,src=<path>'"; \
    fi

# --- Runtime image ---

FROM alpine:3.21

RUN apk add --no-cache ca-certificates libarchive-tools \
    weasyprint ttf-liberation font-dejavu

# Install litestream for SQLite WAL replication (optional backup feature).
ARG LITESTREAM_VERSION=v0.3.13
RUN wget -q "https://github.com/benbjohnson/litestream/releases/download/${LITESTREAM_VERSION}/litestream-${LITESTREAM_VERSION}-linux-amd64.tar.gz" -O /tmp/litestream.tar.gz \
    && tar -xzf /tmp/litestream.tar.gz -C /usr/local/bin/ litestream \
    && rm /tmp/litestream.tar.gz \
    && chmod +x /usr/local/bin/litestream

COPY --from=go-builder /build/vigosrv /usr/local/sbin/vigosrv
COPY --from=go-builder /build/vigocli /usr/local/bin/vigocli
RUN chmod 0700 /usr/local/bin/vigocli
# Migrations are embedded in the vigosrv binary (migrations.FS) — no on-disk copy.

# Agent binaries — host-built cross-compiled platforms first (arm64, freebsd,
# windows, darwin — each with its .sig if SIGN_KEY was supplied to upgrade.sh),
# then the in-image-built linux/amd64 set (binary + version + signed .sig) on
# top so it always wins over any stale copy in dist/.
# Bootstrap serves /api/v1/agent/download/{os}/{arch}. Missing binaries return 404.
# Build additional platforms with: make dist-agent dist-agent-macos dist-agent-freebsd etc.
# A fresh clone has no dist/agent/ (dist/ is gitignored), so the host-built
# set is optional: copy it when present rather than failing the build.
RUN --mount=type=bind,source=.,target=/ctx \
    mkdir -p /dist/agent/linux/amd64 && \
    if [ -d /ctx/dist/agent ]; then cp -a /ctx/dist/agent/. /dist/agent/; fi
COPY --from=go-builder /build/dist/agent/linux/amd64/ /dist/agent/linux/amd64/

# Apache-2.0 LICENSE and NOTICE — seeded into /srv/vigo/ and served to agents.
COPY LICENSE /seed/LICENSE
COPY NOTICE /seed/NOTICE

# Seed configs — copied to /srv/vigo on first run by entrypoint.
COPY server-seed/server.yaml /seed/server.yaml
COPY docker-compose.prod.yml /seed/docker-compose.yml
COPY example-configs/ /seed/example-configs/
COPY server-seed/stacks/ /seed/stacks/

# Documentation — seeded into /srv/vigo/docs/ by entrypoint.
COPY docs/ /seed/docs/

# CLI test script — seeded into /srv/vigo/scripts/ by entrypoint.
# Only scripts that work without the source tree belong here.
# test-unit.sh requires the repo and should be run from the checkout.
RUN mkdir -p /seed/scripts
COPY scripts/test-cli.sh /seed/scripts/

COPY entrypoint.sh /entrypoint.sh

EXPOSE 1530 8443

ENTRYPOINT ["/entrypoint.sh"]
