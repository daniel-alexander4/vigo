FROM rust:alpine AS rust-builder

RUN apk add --no-cache musl-dev protobuf-dev

WORKDIR /build

# Cache Rust dependencies: copy manifests + proto, build with dummy source.
COPY agent-rs/Cargo.toml agent-rs/Cargo.lock agent-rs/
COPY agent-rs/build.rs agent-rs/
COPY agent-rs/proto/ agent-rs/proto/
COPY proto/ proto/
RUN mkdir -p agent-rs/src && echo "fn main() {}" > agent-rs/src/main.rs \
    && cd agent-rs && cargo build --release --target x86_64-unknown-linux-musl \
    && rm -rf src

# Now build real source (dependencies already compiled).
COPY agent-rs/src/ agent-rs/src/
RUN cd agent-rs && touch src/main.rs \
    && cargo build --release --target x86_64-unknown-linux-musl

# Pin to Go 1.25 — garble does not yet support Go 1.26 linker patches.
# Revisit when garble releases a version with Go 1.26 support.
FROM golang:1.25-alpine AS go-builder

RUN apk add --no-cache gcc musl-dev
RUN go install mvdan.cc/garble@latest

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

ARG CACHEBUST=0
RUN echo "$CACHEBUST" > /dev/null
COPY . .

# Hardened build: garble obfuscates identifiers and string literals.
# -trimpath strips source paths, -s -w strips symbols/debug, -buildid= removes build ID.
# -buildmode=pie enables Position Independent Executable (full ASLR).
# CGO_CFLAGS/CGO_LDFLAGS: stack protectors, FORTIFY_SOURCE, full RELRO, no-execstack.
ENV CGO_CFLAGS="-D_FORTIFY_SOURCE=2 -fstack-protector-strong -O2" \
    CGO_LDFLAGS="-Wl,-z,relro,-z,now,-z,noexecstack"

RUN CGO_ENABLED=1 garble -literals -tiny build \
    -buildmode=pie -trimpath \
    -ldflags="-s -w -buildid= -X main.version=$(cat VERSION 2>/dev/null || echo dev)" \
    -o vigosrv ./server

RUN CGO_ENABLED=1 garble -literals -tiny build \
    -buildmode=pie -trimpath \
    -ldflags="-s -w -buildid= -X main.version=$(cat VERSION 2>/dev/null || echo dev)" \
    -o vigogo ./cli

RUN CGO_ENABLED=1 garble -literals -tiny build \
    -buildmode=pie -trimpath \
    -ldflags="-s -w -buildid= -X main.version=$(cat VERSION 2>/dev/null || echo dev)" \
    -o vigo-license-manager ./license-manager

# --- Runtime image ---

FROM alpine:3.21

RUN apk add --no-cache ca-certificates sqlite-libs libpq

# Install litestream for SQLite WAL replication (optional backup feature).
ARG LITESTREAM_VERSION=v0.3.13
RUN wget -q "https://github.com/benbjohnson/litestream/releases/download/${LITESTREAM_VERSION}/litestream-${LITESTREAM_VERSION}-linux-amd64.tar.gz" -O /tmp/litestream.tar.gz \
    && tar -xzf /tmp/litestream.tar.gz -C /usr/local/bin/ litestream \
    && rm /tmp/litestream.tar.gz \
    && chmod +x /usr/local/bin/litestream

COPY --from=go-builder /build/vigosrv /usr/local/sbin/vigosrv
COPY --from=go-builder /build/vigogo /usr/local/bin/vigogo
COPY --from=go-builder /build/vigo-license-manager /usr/local/sbin/vigo-license-manager
COPY --from=go-builder /build/migrations /migrations

# Agent binaries — pre-built cross-compiled binaries first, then the freshly built
# linux/amd64 binary on top so it always wins over any stale copy in dist/.
# Bootstrap serves /api/v1/agent/download/{os}/{arch}. Missing binaries return 404.
# Build additional platforms with: make dist-agent dist-agent-macos dist-agent-freebsd etc.
RUN mkdir -p /dist/agent/linux/amd64
COPY dist/agent/ /dist/agent/
COPY --from=rust-builder /build/agent-rs/target/x86_64-unknown-linux-musl/release/vigo /dist/agent/linux/amd64/vigo

# Seed configs — copied to /srv/vigo on first run by entrypoint.
COPY server-configs/server.yaml /seed/server.yaml
COPY docker-compose.prod.yml /seed/docker-compose.yml
COPY envoy-configs/ /seed/envoy-configs/
COPY server-configs/policy/ /seed/policy/
COPY server-configs/push/ /seed/push/

# Documentation — seeded into /srv/vigo/docs/ by entrypoint.
COPY docs/ /seed/docs/

# CLI test script — seeded into /srv/vigo/scripts/ by entrypoint.
# Only scripts that work without the source tree belong here.
# test-unit.sh requires the repo and should be run from the checkout.
RUN mkdir -p /seed/scripts
COPY scripts/test-cli.sh /seed/scripts/

COPY entrypoint.sh /entrypoint.sh

EXPOSE 1530 8443

ENTRYPOINT ["/entrypoint.sh"]
