FROM golang:1.26-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o hobd ./server

FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/hobd /usr/local/bin/hobd
COPY --from=builder /build/migrations /migrations

EXPOSE 1530 8080

ENTRYPOINT ["hobd"]
