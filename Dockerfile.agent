FROM rust:alpine AS builder

RUN apk add --no-cache musl-dev protobuf-dev

WORKDIR /build
COPY agent-rs/ agent-rs/
COPY proto/ proto/

RUN cd agent-rs && cargo build --release --target x86_64-unknown-linux-musl

FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=builder /build/agent-rs/target/x86_64-unknown-linux-musl/release/hobnob /usr/local/bin/hobnob

ENTRYPOINT ["hobnob"]
