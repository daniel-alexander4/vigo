{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Fleet Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Total Nodes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_nodes_total", "legendFormat": "" }]
    },
    {
      "title": "Active Nodes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_nodes_active_total", "legendFormat": "" }]
    },
    {
      "title": "Compliance %",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [{ "expr": "hobnob_compliance_pct", "legendFormat": "" }]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "s"
        }
      },
      "targets": [{ "expr": "hobnob_uptime_seconds", "legendFormat": "" }]
    },
    {
      "title": "License Usage",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "short"
        },
        "overrides": [{
          "matcher": { "id": "byName", "options": "Max" },
          "properties": [{ "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } }]
        }]
      },
      "targets": [
        { "expr": "hobnob_license_thralls_used", "legendFormat": "Used" },
        { "expr": "hobnob_license_thralls_max", "legendFormat": "Max" }
      ]
    },
    {
      "title": "License Days Remaining",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_license_days_remaining", "legendFormat": "" }]
    },
    {
      "title": "Active Streams",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "purple", "value": null }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_streams_active", "legendFormat": "" }]
    },
    {
      "title": "Database Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "bytes"
        }
      },
      "targets": [{ "expr": "hobnob_database_size_bytes", "legendFormat": "" }]
    },
    {
      "title": "Compliance Breakdown",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "Compliance Status by Type",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "compliant" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "drifted" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "failing" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "stale" }, "properties": [{ "id": "color", "value": { "fixedColor": "gray", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "unknown" }, "properties": [{ "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } }] }
        ]
      },
      "targets": [{ "expr": "hobnob_compliance_status", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Compliance % Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "custom": { "fillOpacity": 10 },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] }
        }
      },
      "targets": [{ "expr": "hobnob_compliance_pct", "legendFormat": "Compliance %" }]
    },
    {
      "title": "Check-in & gRPC",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "title": "Check-ins / min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_checkins_total[5m]) * 60", "legendFormat": "Check-ins/min" }]
    },
    {
      "title": "gRPC Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_grpc_requests_total[5m])", "legendFormat": "{{method}}" }]
    },
    {
      "title": "gRPC Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(hobnob_grpc_request_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(hobnob_grpc_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(hobnob_grpc_request_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Convergence & Drift",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "title": "Run Duration (p50 / p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(hobnob_run_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(hobnob_run_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Drift Corrections / min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 }, "color": { "fixedColor": "yellow", "mode": "fixed" } } },
      "targets": [{ "expr": "rate(hobnob_drift_detected_total[5m]) * 60", "legendFormat": "Drift corrections" }]
    },
    {
      "title": "Module Actions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_module_actions_total[5m]) * 60", "legendFormat": "{{action}}" }]
    },
    {
      "title": "Operations",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "title": "Enrollments",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 }, "color": { "fixedColor": "green", "mode": "fixed" } } },
      "targets": [{ "expr": "rate(hobnob_enrollments_total[1h]) * 60", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Push Runs",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_push_runs_total[5m]) * 60", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Workflow Runs",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 33 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_workflow_runs_total[5m]) * 60", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Signature Verification Failures",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 33 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_sig_verify_failed_total", "legendFormat": "" }]
    },
    {
      "title": "Infrastructure",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false
    },
    {
      "title": "Config Reload Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "hobnob_config_reload_duration_seconds", "legendFormat": "Reload" }]
    },
    {
      "title": "Config Reload Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_config_reload_errors_total", "legendFormat": "" }]
    },
    {
      "title": "FleetIndex Flush Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(hobnob_fleetindex_flush_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(hobnob_fleetindex_flush_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "FleetIndex Dirty Count",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 41 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "hobnob_fleetindex_dirty_count", "legendFormat": "Dirty entries" }]
    },
    {
      "title": "Webhooks & SMTP",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "collapsed": false
    },
    {
      "title": "Webhook Deliveries / min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_webhook_deliveries_total[5m]) * 60", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Webhook Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(hobnob_webhook_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(hobnob_webhook_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "SMTP Sends",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 49 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_smtp_sends_total[5m]) * 60", "legendFormat": "{{status}}" }]
    },
    {
      "title": "Secrets",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "collapsed": false
    },
    {
      "title": "Secret Rotations",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 57 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{ "expr": "hobnob_secret_rotations_total", "legendFormat": "" }]
    },
    {
      "title": "Secret Resolution Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 57 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_secret_resolution_errors_total", "legendFormat": "" }]
    },
    {
      "title": "AI Assistant",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 62 },
      "collapsed": false
    },
    {
      "title": "AI Requests / min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 63 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(hobnob_ai_requests_total[5m]) * 60", "legendFormat": "Requests" }]
    },
    {
      "title": "AI Tokens Used",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 63 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "purple", "value": null }] } } },
      "targets": [{ "expr": "hobnob_ai_tokens_total", "legendFormat": "" }]
    },
    {
      "title": "AI Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 63 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(hobnob_ai_request_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(hobnob_ai_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "AI Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 63 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        }
      },
      "targets": [{ "expr": "hobnob_ai_errors_total", "legendFormat": "" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hobnob"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Hobnob — Fleet Overview",
  "uid": "hobnob-overview",
  "version": 1
}
