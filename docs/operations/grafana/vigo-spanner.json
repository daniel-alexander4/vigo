{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Spoke Status",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Spoke Availability",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [{ "expr": "hobnob_spanner_spoke_up", "legendFormat": "{{spoke_id}}" }]
    },
    {
      "title": "Spoke Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(hobnob_spanner_spoke_latency_seconds_bucket[5m]))", "legendFormat": "{{spoke_id}} p50" },
        { "expr": "histogram_quantile(0.95, rate(hobnob_spanner_spoke_latency_seconds_bucket[5m]))", "legendFormat": "{{spoke_id}} p95" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hobnob", "spanner"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "Hobnob — Spanner",
  "uid": "hobnob-spanner",
  "version": 1
}
