        }
      },
      "targets": [{ "expr": "vigo_lockbox_files", "legendFormat": "" }]
    },
    {
      "title": "Longdrawer Files",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
