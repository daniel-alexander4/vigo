    {
      "title": "Trends",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false
    },
    {
      "title": "Cross-Envoy Divergence Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "vigo_gitback_divergent_refs", "legendFormat": "Gitback refs" },
        { "expr": "vigo_lockbox_divergent_files", "legendFormat": "Lockbox files" },
        { "expr": "vigo_longdrawer_divergent_files", "legendFormat": "Longdrawer files" }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["vigo", "swarm"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Vigo — Swarm & Spanner",
  "uid": "vigo-swarm",
  "version": 1
