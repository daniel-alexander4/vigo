# Isogov environment configuration
# Copy this to .env and fill in values.

# PostgreSQL connection string
HOBNOB_DB_DSN=postgres://hobnob:secret@localhost:5432/hobnob?sslmode=disable

# TLS certificate paths (resolved from secret:hobnob/tls/* in server.yaml)
HOBNOB_TLS_CERT=./certs/server.crt
HOBNOB_TLS_KEY=./certs/server.key
HOBNOB_TLS_CA=./certs/ca.crt
