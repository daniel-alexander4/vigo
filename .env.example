# Hobnob environment configuration
# This file is OPTIONAL. The server starts out of the box with built-in
# defaults (hobnob.db, certs/ directory). Copy to .env to override.
#
# IMPORTANT: This file must NOT contain secrets. Use the secret: prefix
# in server.yaml and store secrets via the secrets provider
# (default: /etc/hobnob-server/secrets/).

# Config file location (the one env var that bootstraps everything else)
# HOBNOB_CONFIG_FILE=server.yaml

# Server version metadata
# HOBNOB_VERSION=dev

# Docker Compose profiles (comma-separated: ollama, postgres)
# COMPOSE_PROFILES=ollama
