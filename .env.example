# Vigo environment — optional services only.
# All other configuration belongs in server.yaml.
#
# COMPOSE_PROFILES=ollama              # local AI assistant
# COMPOSE_PROFILES=postgres            # Postgres instead of SQLite
# COMPOSE_PROFILES=ollama,postgres     # both
#
# Required with the postgres profile; the Postgres container will not
# initialise without it. Use a long random value.
# VIGO_POSTGRES_PASSWORD=
