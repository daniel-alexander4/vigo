# Hobnob environment configuration
# Copy this to .env and fill in values.

# SQLite database file path
HOBNOB_DB_DSN=db/hobnob.db

# TLS certificate paths (resolved from secret:hobnob/tls/* in server.yaml)
HOBNOB_TLS_CERT=./certs/server.crt
HOBNOB_TLS_KEY=./certs/server.key
HOBNOB_TLS_CA=./certs/ca.crt

# Isopass bearer token (required when secrets.backend is "isopass")
# HOBNOB_SECRETS_TOKEN=your-service-account-bearer-token

# AI assistant API key (required for claude/openai providers)
# HOBNOB_AI_API_KEY=sk-...
