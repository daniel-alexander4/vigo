# Isogov environment configuration
# Copy this to .env and fill in values.

# PostgreSQL connection string
ISOGOV_DB_DSN=postgres://isogov:secret@localhost:5432/isogov?sslmode=disable

# TLS certificate paths (resolved from secret:isogov/tls/* in server.yaml)
ISOGOV_TLS_CERT=./certs/server.crt
ISOGOV_TLS_KEY=./certs/server.key
ISOGOV_TLS_CA=./certs/ca.crt
